﻿//
// Created by dave on 4/21/17.
//

#include "PeriodicExecutor.h"

namespace FastTransport {
    namespace Protocol {

        PeriodicExecutor::PeriodicExecutor(std::function<void()> func, std::chrono::microseconds interval) : _function(func), _interval(interval){
            auto now = std::chrono::steady_clock::now().time_since_epoch();
            this->_start = std::chrono::duration_cast<std::chrono::microseconds>(now);
        }

        void PeriodicExecutor::execute() const{
            while(true){
                auto now = std::chrono::steady_clock::now().time_since_epoch();
                auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(now).count();

                if(elapsed > _start.count() + _interval.count()){
                    _start = std::chrono::duration_cast<std::chrono::microseconds>(now);
                    _function();
                }
            }
        }


    }
} 
