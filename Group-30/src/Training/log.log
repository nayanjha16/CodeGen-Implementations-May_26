import numpy as np

def ones_like(expr, dtype=None):
    """
    Create an array filled with ones that has the same shape and data type as a given input expression.

    Parameters:
    expr (array-like): A constant reference to the input expression whose shape and data type the output array will mimic.
    dtype (type, optional): An optional parameter specifying the data type of the output array. If not provided, it defaults to the data type of the input expression.

    Returns:
    numpy.ndarray: An array filled with ones, having the same shape and data type as the input expression.
    """
    if dtype is None:
        dtype = expr.dtype
    return np.ones(expr.shape, dtype=dtype)
