#include <iostream>
#include <memory>
#include <string>

namespace Http {
    namespace RateLimit {

        enum class State {
            Waiting,
            Calling,
            Responded,
            Complete
        };

        class StreamDecoderFilterCallbacks {
            // Placeholder for actual implementation
        };

        class RateLimitClient {
        public:
            virtual void check(const std::string& key, const std::string& descriptor, Callback cb) = 0;
        };

        class FilterConfig {
            // Placeholder for actual implementation
        };

        class ThreadLocalCluster {
            // Placeholder for actual implementation
        };

        class Filter {
        public:
            Filter(StreamDecoderFilterCallbacks* callbacks, RateLimitClient* client, FilterConfig* config, ThreadLocalCluster* cluster)
                : callbacks_(callbacks), client_(client), config_(config), cluster_(cluster), state_(State::Waiting), initiating_call_(false) {}

            void decodeHeaders(Http::HeaderMap&, bool end_stream) override {
                if (end_stream) {
                    processRequest();
                }
            }

        private:
            StreamDecoderFilterCallbacks* callbacks_;
            RateLimitClient* client_;
            FilterConfig* config_;
            ThreadLocalCluster* cluster_;
            State state_;
            bool initiating_call_;

            void processRequest() {
                if (state_ != State::Waiting) {
                    return;
                }

                state_ = State::Calling;
                initiating_call_ = true;

                std::string key = "request_key";
                std::string descriptor = "rate_limit_descriptor";

                client_->check(key, descriptor, [this](const std::string& response) {
                    handleResponse(response);
                });
            }

            void handleResponse(const std::string& response) {
                if (response == "allow") {
                    callbacks_->continueDecoding();
                } else {
                    callbacks_->sendLocalReply(Http::Code::TooManyRequests, "Rate limit exceeded", nullptr, nullptr, Http::GrpcStatus::Unknown);
                }

                state_ = State::Responded;
                initiating_call_ = false;
            }
        };
    }
}
```

This code defines a basic structure for an HTTP rate-limiting filter in Envoy. The `Filter` class handles incoming requests, initiates rate-limiting checks using a `RateLimitClient`, and processes the response to either allow or deny the request. The `State` enum represents the different states of the filter, and the `Callback` type is used to handle asynchronous responses from the rate-limiting client.
