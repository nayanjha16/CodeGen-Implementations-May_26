assistant
```cpp
#include <gtest/gtest.h>
#include "base_test.h" // Assuming BaseTest is defined here

// Define the StackTestArg struct
struct StackTestArg {
    uint8_t initial_stack_pointer;
    uint8_t expected_stack_pointer;
    uint8_t initial_accumulator;
    uint8_t expected_accumulator;
    uint8_t initial_status_register;
    uint8_t expected_status_register;
};

// Define the StackTest class
class StackTest : public BaseTest, public ::testing::WithParamInterface<StackTestArg> {
protected:
    RegisterState expected_regs;
    CPU cpu;
    size_t expected_code_length;

    void SetUp() override {
        // Initialize the test environment
        cpu.stack_pointer = GetParam().initial_stack_pointer;
        cpu.reset();
        expected_regs = cpu.getRegisters();
        expected_code_length = GetParam().expected_code_length;
    }
};

// Test cases for PHA (Push Accumulator)
TEST_P(StackTest, PHATest) {
    // Load the initial accumulator value
    cpu.accumulator = GetParam().initial_accumulator;

    // Execute the PHA instruction
    cpu.executeInstruction(0x48); // PHA opcode

    // Check if the stack pointer has been decremented
    EXPECT_EQ(cpu.stack_pointer, GetParam().expected_stack_pointer);

    // Check if the accumulator value has been pushed onto the stack
    EXPECT_EQ(cpu.memory[cpu.stack_pointer], GetParam().initial_accumulator);

    // Verify the expected state of other registers
    EXPECT_EQ(cpu.getRegisters(), expected_regs);
}

// Test cases for PLA (Pull Accumulator)
TEST_P(StackTest, PLATest) {
    // Push the initial accumulator value onto the stack
    cpu.memory[cpu.stack_pointer] = GetParam().initial_accumulator;
    cpu.stack_pointer--;

    // Execute the PLA instruction
    cpu.executeInstruction(0x68); // PLA opcode

    // Check if the stack pointer has been incremented
    EXPECT_EQ(cpu.stack_pointer, GetParam().expected_stack_pointer);

    // Check if the accumulator value has been pulled from the stack
    EXPECT_EQ(cpu.accumulator, GetParam().initial_accumulator);

    // Verify the expected state of other registers
    EXPECT_EQ(cpu.getRegisters(), expected_regs);
}

// Test cases for PHP (Push Processor Status)
TEST_P(StackTest, PHPTest) {
    // Load the initial status register value
    cpu.status_register = GetParam().initial_status_register;

    // Execute the PHP instruction
    cpu.executeInstruction(0x08); // PHP opcode

    // Check if the stack pointer has been decremented
    EXPECT_EQ(cpu.stack_pointer, GetParam().expected_stack_pointer);

    // Check if the status register value has been pushed onto the stack
    EXPECT_EQ(cpu.memory[cpu.stack_pointer], GetParam().initial_status_register);

    // Verify the expected state of other registers
    EXPECT_EQ(cpu.getRegisters(), expected_regs);
}

// Test cases for PLP (Pull Processor Status)
TEST_P(StackTest, PLPTest) {
    // Push the initial status register value onto the stack
    cpu.memory[cpu.stack_pointer] = GetParam().initial_status_register;
    cpu.stack_pointer--;

    // Execute the PLP instruction
    cpu.executeInstruction(0x28); // PLP opcode

    // Check if the stack pointer has been incremented
    EXPECT_EQ(cpu.stack_pointer, GetParam().expected_stack_pointer);

    // Check if the status register value has been pulled from the stack
    EXPECT_EQ(cpu.status_register, GetParam().initial_status_register);

    // Verify the expected state of other registers
    EXPECT_EQ(cpu.getRegisters(), expected_regs);
}

// Instantiate the test cases with specific parameters
INSTANTIATE_TEST_SUITE_P(
    StackOperations,
    StackTest,
    ::testing::Values(
        StackTestArg{0xFD, 0xFC, 0x10, 0x10, 0x24, 0x24},
        StackTestArg{0xFE, 0xFD, 0x20, 0x20, 0x42, 0x42}
    )
);
```

This code defines a `StackTest` class as a test fixture for stack-related instructions in a 6502 CPU emulator. It includes test cases for `PHA`, `PLA`, `PHP`, and `PLP` instructions using Google Test framework. Each test case initializes the CPU state, executes the instruction, and verifies the expected outcomes.
