import torch
from mpi4py import MPI

def test_1():
    worker_shape = [2, 2]
    world = MPI.COMM_WORLD
    num_workers = world.Get_size()
    comm = world.Split(color=world.Get_rank(), key=0)
    
    if world.Get_rank() == 0:
        x = torch.arange(8).reshape(worker_shape[0], worker_shape[1])
    else:
        x = torch.zeros_like(x)
    
    e = torch.tensor([0, 1, 2, 3, 4, 5, 6, 7])
    
    y = comm.allreduce(x, op=MPI.SUM)
    
    assert torch.equal(y, e), "Test 1 failed"

def test_2():
