import hashlib
import zlib

# Define the size of the data chunk read from the file at a time
CHUNK = 2 ** 20

def crc(path):
    """
    Computes the cyclic redundancy check (CRC) checksum of a file using the zlib library.
    
    Parameters:
        path (str): The path to the file for which the CRC checksum is to be computed.
        
    Returns:
        str: String representing the CRC checksum in hexadecimal format.
    """
    crc_value = 0
    with open(path, 'rb') as f:
        while True:
            data = f.read(CHUNK)
            if not data:
                break
            crc_value = zlib.crc32(data, crc_value)
    return format(crc_value & 0xFFFFFFFF, '08x')

def md5(path):
    """
    Computes the MD5 checksum of a file.
    
    Parameters:
        path (str): The path to the file for which the MD5 checksum is to be computed.
        
    Returns:
        str: String representing the MD5 checksum in hexadecimal format.
    """
    hasher = hashlib.md5()
    with open(path, 'rb') as f:
        while True:
            data = f.read(CHUNK)
            if not data:
                break
            hasher.update(data)
    return hasher.hexdigest()

def sha1(path):
    """
    Computes the SHA-1 checksum of a file.
    
    Parameters:
        path (str): The path to the file for which the SHA-1 checksum is to be computed.
        
    Returns:
        str: String representing the SHA-1 checksum in hexadecimal format.
    """
    hasher = hashlib.sha1()
    with open(path, 'rb') as f:
        while True:
            data = f.read(CHUNK)
            if not data:
                break
            hasher.update(data)
    return hasher.hexdigest()

def sha224(path):
    """
    Computes the SHA-224 checksum of a file.
    
    Parameters:
        path (str): The path to the file for which the SHA-224 checksum is to be computed.
        
    Returns:
        str: String representing the SHA-224 checksum in hexadecimal format.
    """
    hasher = hashlib.sha224()
    with open(path, 'rb') as f:
        while True:
            data = f.read(CHUNK)
            if not data:
                break
            hasher.update(data)
    return hasher.hexdigest()

def sha256(path):
    """
    Computes the SHA-256 checksum of a file.
    
    Parameters:
        path (str): The path to the file for which the SHA-256 checksum is to be computed.
        
    Returns:
        str: String representing the SHA-256 checksum in hexadecimal format.
    """
    hasher = hashlib.sha256()
    with open(path, 'rb') as f:
        while True:
            data = f.read(CHUNK)
            if not data:
                break
            hasher.update(data)
    return hasher.hexdigest()

def sha384(path):
    """
    Computes the SHA-384 checksum of a file.
    
    Parameters:
        path (str): The path to the file for which the SHA-384 checksum is to be computed.
        
    Returns:
        str: String representing the SHA-384 checksum in hexadecimal format.
    """
    hasher = hashlib.sha384()
    with open(path, 'rb') as f:
        while True:
            data = f.read(CHUNK)
            if not data:
                break
            hasher.update(data)
    return hasher.hexdigest()

def sha512(path):
    """
    Computes the SHA-512 checksum of a file.
    
    Parameters:
        path (str): The path to the file for which the SHA-512 checksum is to be computed.
        
    Returns:
