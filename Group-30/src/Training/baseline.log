```python
import sys
from contextlib import contextmanager

class _stdchannel_redirected:
    def __init__(self, stdchannel, dest_filename, mode="w"):
        self.stdchannel = stdchannel
        self.dest_filename = dest_filename
        self.mode = mode
        self._original = None

    @contextmanager
    def __call__(self):
        if self.stdchannel is None:
            yield None
        else:
            with open(self.dest_filename, self.mode) as dest_file:
                self._original = self.stdchannel
                self.stdchannel = dest_file
                try:
                    yield None
                finally:
                    self.stdchannel = self._original

class RedirectStdout(_stdchannel_redirected):
    def __init__(self, dest_filename, mode="w"):
        super().__init__(sys.stdout, dest_filename, mode)
```

This code defines two classes: `_stdchannel_redirected` and `RedirectStdout`. The `_stdchannel_redirected` class is a private class used internally to handle the redirection of standard channels like `stdout` and `stderr`. The `RedirectStdout` class inherits from `_stdchannel_redirected` and specifically handles the redirection of `stdout`. The `__call__` method of both classes uses a context manager to temporarily redirect the specified standard channel to the given destination file.
