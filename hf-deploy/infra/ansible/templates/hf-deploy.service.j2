[Unit]
Description=CodeGen multi-adapter FastAPI (hf-deploy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ service_user }}
Group={{ service_group }}
WorkingDirectory={{ hf_deploy_dir }}
EnvironmentFile=/etc/hf-deploy/hf-deploy.env
ExecStart={{ venv_path }}/bin/uvicorn hf_deploy.api.app:app --host {{ api_host }} --port {{ api_port }}
Restart=on-failure
RestartSec=5
# Model load + first Hub download can take several minutes on CPU.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
