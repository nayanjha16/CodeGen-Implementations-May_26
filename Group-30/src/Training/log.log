        self.mname = mname
        self.lname = lname
        self.nick = nick
        self.title = title
        self.comp = comp
        self.address = address
        self.phones = phones if phones else []
        self.emails = emails if emails else []
        self.homepage = homepage
        self.bday = bday
        self.anniv = anniv
        self.sec_addr = sec_addr
        self.sec_phone = sec_phone
        self.notes = notes

    def __repr__(self):
        return f"Contact(fname={self.fname}, mname={self.mname}, lname={self.lname}, nick={self.nick}, " \
               f"title={self.title}, comp={self.comp}, address={self.address}, phones={self.phones}, " \
               f"emails={self.emails}, homepage={self.homepage}, bday={self.bday}, anniv={self.anniv}, " \
               f"sec_addr={self.sec_addr}, sec_phone={self.sec_phone}, notes={self.notes})"

    def __eq__(self, other):
        if not isinstance(other, Contact):
            return NotImplemented
        return (self.fname == other.fname and self.mname == other.mname and self.lname == other.lname and
                self.nick == other.nick and self.title == other.title and self.comp == other.comp and
                self.address == other.address and self.phones == other.phones and self.emails == other.emails and
                self.homepage == other.homepage and self.bday == other.bday and self.anniv == other.anniv and
                self.sec_addr == other.sec_addr and self.sec_phone == other.sec_phone and self.notes == other.notes)

    @staticmethod
    def id_or_max(id, max_id):
        if id is None:
            return max_id
        else:
            return id
```

