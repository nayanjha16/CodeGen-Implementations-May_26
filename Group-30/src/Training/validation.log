assistant
```python
from django.core.management.base import BaseCommand
import jsonschema
from jsonschema import Draft4Validator

class Command(BaseCommand):
    help = 'Validate JSON schemas defined in the project\'s settings'

    @property
    def _jsonschema_exists(self) -> bool:
        return hasattr(settings, 'SIMPLE_JSONSCHEMA')

    @property
    def _jsonschema_errors(self) -> list:
        if not self._jsonschema_exists:
            return []

        errors = []
        for schema_name, schema_content in settings.SIMPLE_JSONSCHEMA.items():
            try:
                Draft4Validator.check_schema(schema_content)
                self.stdout.write(f'Success: Schema "{schema_name}" is valid.')
            except jsonschema.exceptions.SchemaError as e:
                errors.append({
                    'path': str(e.path),
                    'message': str(e),
                    'schema': schema_content
                })
                self.stderr.write(f'Error: Schema "{schema_name}" is invalid - {e}')
        
        return errors

    def handle(self, *args, **kwargs):
        if not self._jsonschema_exists:
            self.stdout.write('No JSON schemas found in settings.')
            return

        errors = self._jsonschema_errors
        if not errors:
            self.stdout.write('All JSON schemas are valid.')
        else:
            self.stdout.write('Some JSON schemas are invalid:')
            for error in errors:
                self.stderr.write(f'Path: {error["path"]}, Message: {error["message"]}, Schema: {error["schema"]}')
```

This code defines a Django management command that validates JSON schemas specified in the project's settings. The `Command` class extends `BaseCommand`, providing the necessary functionality to check the validity of each schema using the `jsonschema` library. The `_jsonschema_exists` property checks if the `SIMPLE_JSONSCHEMA` setting is present, while the `_jsonschema_errors` property validates all schemas and collects any errors encountered during the validation process. The `handle` method orchestrates the execution of the command, printing success or error messages accordingly.
