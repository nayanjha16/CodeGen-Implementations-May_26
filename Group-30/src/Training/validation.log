```python
from dataclasses import dataclass, field
from typing import List

@dataclass
class Car:
    id: int
    position: int = 0

@dataclass
class Bridge:
    capacity: int = 5
    length: int = 10
    cars: List[Car] = field(default_factory=list)

    def add_car(self, car: Car):
        if len(self.cars) < self.capacity:
            self.cars.append(car)
        else:
            raise ValueError("Bridge is at full capacity")

    def move_cars(self):
        for car in self.cars:
            car.position += 1
            if car.position >= self.length:
                self.cars.remove(car)

    def check_for_collapses(self):
        # Simple collapse condition: if more than half the cars are at the end
        return len([car for car in self.cars if car.position == self.length]) > len(self.cars) // 2

# Example usage:
bridge = Bridge()
bridge.add_car(Car(id=1))
bridge.add_car(Car(id=2))

print(f"Initial bridge state: {bridge.cars}")
bridge.move_cars()
print(f"After moving cars: {bridge.cars}")

if bridge.check_for_collapses():
    print("Bridge has collapsed!")
else:
    print("Bridge is stable.")
```

This code defines two classes: `Car` and `Bridge`. The `Car` class represents a car with an ID and a current position. The `Bridge` class manages a list of cars, allowing them to be added, moved, and checked for collapses based on a simple condition.
