```python
import ctypes
from typing import Any, Dict, List, Optional

class clib:
    class Session:
        def __init__(self):
            self.session_pointer = None
            self.info: Dict[str, Any] = {}

        def create(self, name: str) -> None:
            # Create a new GMT session with the specified name
            self.session_pointer = ctypes.c_void_p()
            # Assuming gmt_create_session is a function that creates a GMT session
            gmt_create_session(ctypes.byref(self.session_pointer), name.encode('utf-8'))

        def destroy(self) -> None:
            # Destroy the current GMT session
            if self.session_pointer:
                # Assuming gmt_destroy_session is a function that destroys a GMT session
                gmt_destroy_session(self.session_pointer)
                self.session_pointer = None

        def call_module(self, module: str, args: List[str]) -> None:
            # Call a GMT module with the specified arguments
            arg_list = [arg.encode('utf-8') for arg in args]
            # Assuming gmt_call_module is a function that calls a GMT module
            gmt_call_module(self.session_pointer, module.encode('utf-8'), arg_list)

        def _parse_constant(self, value: Any, valid: List[str], valid_modifiers: List[str]) -> Any:
            # Parse a constant value based on valid families and modifiers
            if value not in valid:
                raise ValueError(f"Invalid value: {value}. Valid values are: {valid}")
            return value

        def put_matrix(self, dataset: str, matrix: List[List[float]]) -> None:
            # Put a matrix into a GMT dataset
            # Assuming gmt_put_matrix is a function that puts a matrix into a GMT dataset
            gmt_put_matrix(self.session_pointer, dataset.encode('utf-8'), matrix)

        def open_virtual_file(self, family: str, mode: str) -> str:
            # Open a virtual file with the specified family and mode
            # Assuming gmt_open_virtual_file is a function that opens a virtual file
            vfile_id = gmt_open_virtual_file(self.session_pointer, family.encode('utf-8'), mode.encode('utf-8'))
            return vfile_id.decode('utf-8')

# Example usage
if __name__ == "__main__":
    session = clib.Session()
    session.create("test_session")
    session.call_module("grdmath", ["A=1", "B=2", "C=A+B"])
    session.put_matrix("matrix.dat", [[1.0, 2.0], [3.0, 4.0]])
    vfile_id = session.open_virtual_file("GMT_VFILE_INOUT", "w")
    print(vfile_id)
    session.destroy()
```

Note: The actual implementation of the GMT C API functions (`gmt_create_session`, `gmt_destroy_session`, `gmt_call_module`, `gmt_put_matrix`, `gmt_open_virtual_file`) is assumed to be available as part of the `pygmt` library or through other means. This example provides a framework for how these functions might be called using Python's `ctypes` module to interact with C libraries.
