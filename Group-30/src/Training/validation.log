from ENGINE import APPDATA, UTILS
from Fogoso.MAIN.ClassesUtils import UpDownButton
from Fogoso.MAIN import DefaultCnt

# Global variables
OptionsScreen_DebugModeEnabled = UpDownButton("Debug Mode Enabled")
OptionsScreen_RandomWindowTitle = UpDownButton("Random Window Title")
OptionsScreen_NumberFormatting = UpDownButton("Number Formatting")

class SettingsManager:
    def __init__(self):
        self.debug_mode_enabled = False
        self.random_window_title = False
        self.number_formatting = "Standard"

    def update_settings(self):
        if OptionsScreen_DebugModeEnabled.value_changed():
            self.debug_mode_enabled = OptionsScreen_DebugModeEnabled.get_value()
        
        if OptionsScreen_RandomWindowTitle.value_changed():
            self.random_window_title = OptionsScreen_RandomWindowTitle.get_value()
        
        if OptionsScreen_NumberFormatting.value_changed():
            self.number_formatting = OptionsScreen_NumberFormatting.get_value()

    def render_settings(self, screen):
        # Render the settings options on the screen
        pass

    def handle_events(self, events):
        for event in events:
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    pygame.quit()
                    sys.exit()

def main():
    pygame.init()
    screen = pygame.display.set_mode((800, 600))
    pygame.display.set_caption("Settings Manager")

    settings_manager = SettingsManager()

    clock = pygame.time.Clock()

    while True:
        events = pygame.event.get()
        settings_manager.handle_events(events)
        settings_manager.update_settings()
        screen.fill((255, 255, 255))
        settings_manager.render_settings(screen)
        pygame.display.flip()
        clock.tick(60)

if __name__ == "__main__":
    main()
