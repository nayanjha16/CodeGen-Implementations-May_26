```cpp
#include <iostream>
#include <string>
#include <thread>
#include <mutex>
#include <condition_variable>
#include <fcntl.h>
#include <unistd.h>
#include <sys/ioctl.h>
#include <linux/videodev2.h>

enum class MipiPort {
    PortA,
    PortB
};

enum class MipiMode {
    Mode0,
    Mode1
};

enum class V4L2Format {
    YUYV,
    MJPEG
};

class v4l2Device {
public:
    v4l2Device(const std::string& devname, int height, int width, int numBuffers, MipiPort mipiPort, MipiMode mipiMode, V4L2Format v4l2Format)
        : m_devname(devname), m_height(height), m_width(width), m_num_buffers(numBuffers),
          m_MipiPort(mipiPort), m_MipiMode(mipiMode), m_v4l2Format(v4l2Format), m_fd(-1) {}

    ~v4l2Device() {
        closeDevice();
    }

    bool openDevice() {
        m_fd = open(m_devname.c_str(), O_RDWR);
        if (m_fd == -1) {
            perror("Failed to open device");
            return false;
        }
        return true;
    }

    void closeDevice() {
        if (m_fd != -1) {
            close(m_fd);
            m_fd = -1;
        }
    }

    bool setVideoParameters() {
        struct v4l2_format fmt;
        memset(&fmt, 0, sizeof(fmt));
        fmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        fmt.fmt.pix.width = m_width;
        fmt.fmt.pix.height = m_height;
        fmt.fmt.pix.pixelformat = static_cast<uint32_t>(m_v4l2Format);
        fmt.fmt.pix.field = V4L2_FIELD_NONE;

        if (ioctl(m_fd, VIDIOC_S_FMT, &fmt) == -1) {
            perror("Failed to set video format");
            return false;
        }
        return true;
    }

    bool allocateBuffers() {
        struct v4l2_requestbuffers req;
        memset(&req, 0, sizeof(req));
        req.count = m_num_buffers;
        req.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        req.memory = V4L2_MEMORY_MMAP;

        if (ioctl(m_fd, VIDIOC_REQBUFS, &req) == -1) {
            perror("Failed to request buffers");
            return false;
        }

        for (int i = 0; i < req.count; ++i) {
            struct v4l2_buffer buf;
            memset(&buf, 0, sizeof(buf));
            buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
            buf.memory = V4L2_MEMORY_MMAP;
            buf.index = i;

            if (ioctl(m_fd, VIDIOC_QUERYBUF, &buf) == -1) {
                perror("Failed to query buffer");
                return false;
            }

            void* addr = mmap(NULL, buf.length, PROT_READ | PROT_WRITE, MAP_SHARED, m_fd, buf.m.offset);
            if (addr == MAP_FAILED) {
                perror("Failed to map buffer");
                return false;
            }
            m_buffers.push_back(addr);
        }
        return true;
    }

    void startPollingThread() {
        m_pollingThread = std::thread(&v4l2Device::pollForFrames, this);
    }

    void stopPollingThread() {
        {
            std::unique_lock<std::mutex> lock(m_cvMutex);
            m_stopPolling = true;
        }
        m_cv.notify_all();
        if (m_pollingThread.joinable()) {
            m_pollingThread.join();
        }
    }

private:
    void pollForFrames() {
        while (true) {
            struct v4l2_buffer buf;
            memset(&buf, 0, sizeof(buf));
            buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
            buf.memory = V4L2_MEMORY_MMAP;

            if (ioctl(m_fd, VIDIOC_DQBUF, &buf) == -1) {
                perror("Failed to dequeue buffer");
                continue;
            }

            // Process the frame here
            processFrame(static_cast<char*>(m_buffers[buf.index]), buf.bytesused);

            if (ioctl(m_fd, VIDIOC_QBUF, &buf) == -1) {
                perror("Failed to queue buffer");
                continue;
            }

            std::unique_lock<std::mutex> lock(m_cvMutex);
            if (m_stopPolling) {
                break;
            }
            m_cv.wait(lock);
        }
    }

    void processFrame(char* data, size_t length) {
        // Placeholder for frame processing logic
        std::cout << "Processing frame of size " << length << std::endl;
    }

    std::string m_devname;
    int m_height;
    int m_width;
    int m_num_buffers;
    MipiPort m_MipiPort;
    MipiMode m_MipiMode;
    V4L2Format m_v4l2Format;
    int m_fd;
    std::vector<void*> m_buffers;
    std::thread m_pollingThread;
    std::mutex m_cvMutex;
    std::condition_variable m_cv;
    bool m_stopPolling = false;
};
```

This code defines a `v4l2Device` class that encapsulates the functionality for interacting with a V4L2 device. It includes methods for opening and closing the device, setting video parameters, allocating buffers, and starting a polling thread to capture video frames. The polling thread waits for new frames and processes them using a placeholder function `processFrame`.
