from django.core.management.base import BaseCommand
import jsonschema
from jsonschema import Draft4Validator

class Command(BaseCommand):
    help = 'Validate JSON schemas defined in the project\'s settings'

    @property
    def _jsonschema_exists(self) -> bool:
        """Check if the SIMPLE_JSONSCHEMA setting exists in the Django settings."""
        return hasattr(self.settings, 'SIMPLE_JSONSCHEMA')

    @property
    def _jsonschema_errors(self) -> list:
        """Validate all JSON schemas defined in the SIMPLE_JSONSCHEMA setting."""
        if not self._jsonschema_exists:
            return []

        errors = []
        for schema_name, schema_content in self.settings.SIMPLE_JSONSCHEMA.items():
            try:
                Draft4Validator.check_schema(schema_content)
                self.stdout.write(f'Success: Schema "{schema_name}" is valid.')
            except jsonschema.exceptions.SchemaError as e:
                errors.append({
                    'path': str(e.path),
                    'message': str(e.message),
                    'schema': schema_content
                })
                self.stderr.write(f'Error: Schema "{schema_name}" is invalid - {e.message}')

        return errors

    def handle(self, *args, **options):
        """Handle the command execution."""
        if not self._jsonschema_exists:
            self.stderr.write('No JSON schemas found in settings.')
            return

        errors = self._jsonschema_errors
        if errors:
            self.stderr.write('Validation completed with errors:')
            for error in errors:
                self.stderr.write(f'Path: {error["path"]}')
                self.stderr.write(f'Message: {error["message"]}')
                self.stderr.write(f'Schema: {json.dumps(error["schema"], indent=2)}')
                self.stderr.write('-' * 80)
        else:
            self.stdout.write('All JSON schemas are valid.')

```

This code defines a Django management command named `Command` that validates JSON schemas defined in the project's settings. The command checks if the `SIMPLE_JSONSCHEMA` setting exists and then validates each schema using the `Draft4Validator` from the `jsonschema` library. It outputs the results to the console, indicating whether each schema is valid or listing any validation errors along with the schema content.
