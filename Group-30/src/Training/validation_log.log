static void get_grid_dims(const Shape &region,
                         dim3 &grid_dims,
                         int &thread_work_size)
{
  const unsigned nd = region.dims.size();
  // Fixed block size
  const unsigned bs = 16;

  if (nd == 0) {
    grid_dims.x = 1;
    grid_dims.y = 1;
    grid_dims.z = 1;
    thread_work_size = 1;
    return;
  }

  if (nd == 1) {
    thread_work_size = std::min<int>(bs, region.dims[0]);
    grid_dims.x = (region.dims[0] + thread_work_size - 1) / thread_work_size;
    grid_dims.y = 1;
    grid_dims.z = 1;
