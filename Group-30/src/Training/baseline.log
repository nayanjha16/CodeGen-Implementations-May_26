    public:
        std::string txtRecord1;
        std::string txtRecord2;

        ContInf() : txtRecord1(""), txtRecord2("") {}

        void setTxtRecord1(const std::string& txt) { txtRecord1 = txt; }
        void setTxtRecord2(const std::string& txt) { txtRecord2 = txt; }
    };
};

