import chainerx as chx
import unittest

class TestScalar(unittest.TestCase):
    def _check_cast_scalar_equals_data(self, scalar, data):
        self.assertEqual(scalar.bool(), bool(data))
        self.assertEqual(scalar.int(), int(data))
        self.assertAlmostEqual(scalar.float(), float(data))

    def test_init_without_dtype(self):
        value = 42
        scalar = chx.Scalar(value)
        self._check_cast_scalar_equals_data(scalar, value)

    def test_cast_to_int(self):
        value = 3.14
        scalar = chx.Scalar(value)
        int_value = int(scalar)
        self.assertEqual(int_value, int(value))

    def test_cast_to_float(self):
        value = 42
        scalar = chx.Scalar(value)
        float_value = float(scalar)
        self.assertEqual(float_value, float(value))

    def test_equality_check(self):
        value1 = 10
        value2 = 10
        scalar1 = chx.Scalar(value1)
        scalar2 = chx.Scalar(value2)
        self.assertTrue(scalar1 == scalar2)

    def test_inequality_check(self):
        value1 = 10
        value2 = 20
        scalar1 = chx.Scalar(value1)
        scalar2 = chx.Scalar(value2)
        self.assertFalse(scalar1 == scalar2)

    def test_invalid_input(self):
        with self.assertRaises(ValueError):
            chx.Scalar('not_a_number')

if __name__ == '__main__':
    unittest.main()
```

This code includes a test class `TestScalar` that inherits from `unittest.TestCase`. It defines several test methods to cover the initialization without specifying a data type, casting to different data types, equality checks, inequality checks, and handling invalid input. The `_check_cast_scalar_equals_data` helper method is used to verify that the scalar's boolean, integer, and floating-point representations match those of the original data value.
