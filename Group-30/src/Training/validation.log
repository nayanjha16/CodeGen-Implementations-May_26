```python
import patsy
from patsy.eval_env import EvalEnvironment
import pandas as pd

def test_issue_11():
    """
    This function serves as a regression test to ensure that the Patsy library correctly handles errors related to level mismatches in categorical variables when building design matrices.
    """

    # Capture evaluation environment
    env = EvalEnvironment.capture()

    # Define data and formula
    data = {
        "X": [1, 2, 3],
        "C": ["a", "b", "c"]
    }
    formula = "X + C"

    # Create design matrix
    try:
        X = patsy.dmatrix(formula, data=data, eval_env=env)
    except Exception as e:
        error_message = str(e)

    # Expand data with additional levels
    expanded_data = {
        "X": [1, 2, 3, 4],
        "C": ["a", "b", "c", "d"]
    }

    # Attempt to create new design matrix with expanded data
    try:
        _ = patsy.dmatrix(formula, data=expanded_data, eval_env=env)
    except Exception as e:
        new_error_message = str(e)

    # Assert that the error message indicates a level mismatch
    assert "level mismatch" in error_message, f"Expected 'level mismatch' in error message, but got '{error_message}'"
    assert "level mismatch" in new_error_message, f"Expected 'level mismatch' in error message, but got '{new_error_message}'"

# Run the test function
test_issue_11()
```

This code defines a function `test_issue_11` that captures the current evaluation environment, creates a design matrix using a formula, and then attempts to build a new design matrix from expanded data. It asserts that an appropriate error message is raised when there is a mismatch between the levels of categorical variables in the original and new datasets.
