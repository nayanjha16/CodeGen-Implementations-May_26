import torch
import torch.nn as nn

class FullyConnectedHead(nn.Module):
    def __init__(self, unique_id: str, num_classes: int = None, in_plane: int = 512):
        super(FullyConnectedHead, self).__init__()
        self.unique_id = unique_id
        self.num_classes = num_classes
        self.in_plane = in_plane
        
        if num_classes is not None:
            self.avgpool = nn.AdaptiveAvgPool2d((1, 1))
            self.fc = nn.Linear(in_plane, num_classes)
    
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if hasattr(self, 'avgpool'):
            x = self.avgpool(x)
            x = x.view(x.size(0), -1)
            x = self.fc(x)
        return x

# Example usage:
if __name__ == "__main__":
    config = {
        "unique_id": "head_1",
        "num_classes": 10,
        "in_plane": 512
    }
    
    head = FullyConnectedHead(**config)
    input_tensor = torch.randn(1, 512, 7, 7)
    output = head(input_tensor)
    print(output.shape)  # Should print torch.Size([1, 10])
```

