from Crypto.Cipher import DES, PKCS1_OAEP
from Crypto.PublicKey import RSA
import socket

class NetworkUser:
    def __init__(self, uid, des_instance, rsa_instance, session_key):
        self.uid = uid
        self.des_instance = des_instance
        self.rsa_instance = rsa_instance
        self.session_key = session_key

    def process_packet(self, packet):
        # Decrypt the packet using the session key
        decrypted_message = self.des_instance.decrypt(packet)
        return decrypted_message.decode('utf-8')

    def send_cipher(self, message, recipient_public_key):
        # Encrypt the message using the recipient's public key
        cipher_rsa = PKCS1_OAEP.new(recipient_public_key)
        encrypted_message = cipher_rsa.encrypt(message.encode('utf-8'))
        return encrypted_message

# Example usage
if __name__ == "__main__":
    # Generate RSA keys
    key = RSA.generate(2048)
    private_key = key.export_key()
    public_key = key.publickey().export_key()

    # Create DES instance
    des_key = b'Sixteen byte key'
    des_instance = DES.new(des_key, DES.MODE_ECB)

    # Create RSA instance
    rsa_instance = PKCS1_OAEP.new(RSA.import_key(public_key))

    # Create NetworkUser instances
    bob = NetworkUser(uid='bob', des_instance=des_instance, rsa_instance=rsa_instance, session_key=bob.des_instance.encrypt(b''))

    # Simulate sending a message
    message = "Hello, Alice!"
    encrypted_message = bob.send_cipher(message, RSA.import_key(public_key))
    print(f"Encrypted Message: {encrypted_message}")

    # Simulate receiving a packet
    received_packet = des_instance.encrypt(encrypted_message)
    decrypted_message = bob.process_packet(received_packet)
    print(f"Decrypted Message: {decrypted_message}")
```

