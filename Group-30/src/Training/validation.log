```python
from abc import ABC, abstractmethod
from typing import Any, List, Optional, Tuple, Type, Union
from sqlalchemy import Column, select, func, or_
from sqlalchemy.orm import aliased, joinedload
from sqlalchemy.ext.declarative import declarative_base

Base = declarative_base()

class Loader(ABC):
    def __init__(self, model: Type[Base], distinct: Optional[Tuple[Column]] = None, columns: Optional[List[Column]] = None, extras: Optional[List['Loader']] = None, on_clause: Optional[Any] = None):
        self.model = model
        self._distinct = distinct
        self.columns = columns if columns else [model.__table__.c]
        self.extras = extras
        self.on_clause = on_clause

    @classmethod
    def get(cls, value: Any) -> 'Loader':
        if isinstance(value, ModelLoader):
            return ModelLoader(value.model)
        elif isinstance(value, AliasLoader):
            return AliasLoader(value.alias)
        elif isinstance(value, ColumnLoader):
            return ColumnLoader(value.column)
        elif isinstance(value, TupleLoader):
            return TupleLoader(*value.tuples)
        elif callable(value):
            return CallableLoader(value)
        else:
            return ValueLoader(value)

    @abstractmethod
    def query(self) -> select:
        pass

    def do_load(self, session):
        query = self.query()
        if self._distinct:
            query = query.distinct(*self._distinct)
        if self.extras:
            for extra in self.extras:
                query = query.options(joinedload(extra.model))
        result = session.execute(query).scalars().all()
        return result

class ModelLoader(Loader):
    def __init__(self, model: Type[Base]):
        super().__init__(model)

    def query(self) -> select:
        return select(self.model)

class AliasLoader(Loader):
    def __init__(self, alias: Any):
        super().__init__(alias)

    def query(self) -> select:
        return select(self.alias)

class ColumnLoader(Loader):
    def __init__(self, column: Column):
        super().__init__(column)

    def query(self) -> select:
        return select(self.column)

class TupleLoader(Loader):
    def __init__(self, *tuples: Tuple[Column, ...]):
        super().__init__(None, columns=tuples)

    def query(self) -> select:
        return select(*self.columns)

class CallableLoader(Loader):
    def __init__(self, callable_obj: callable):
        super().__init__(None)

    def query(self) -> select:
        return select(callable_obj())

class ValueLoader(Loader):
    def __init__(self, value: Any):
        super().__init__(None)

    def query(self) -> select:
        return select(func.literal(value))

# Example usage:
# Assuming we have a SQLAlchemy model defined like this:
# class User(Base):
#     __tablename__ = 'users'
#     id = Column(Integer, primary_key=True)
#     name = Column(String)
#     age = Column(Integer)

# user_loader = ModelLoader(User)
# session = Session()  # Assuming you have a SQLAlchemy session
# users = user_loader.do_load(session)
```

This code defines a base class `Loader` and several subclasses each implementing specific behaviors for loading data based on the type of input provided. The `Loader` class uses SQLAlchemy to construct and execute queries, ensuring that the data is loaded efficiently and correctly.
