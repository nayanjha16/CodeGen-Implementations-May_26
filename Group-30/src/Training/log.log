import os
from datetime import datetime
from typing import Optional

class ContractCode:
    def __init__(self):
        self.code: str = ""
        self.abi: str = ""
        self.description: str = ""
        self.name: str = ""
        self.level: int = 0
        self.version: int = 0
        self.deploy_time: datetime = datetime.now()
        self.deployer: str = ""
        self.deployer_name: str = ""
        self.deployer_address: str = ""
        self.deployer_balance: float = 0.0
        self.deployer_balance_asset_id: int = 0
        self.deployer_balance_precision: int = 0

class DataPtr:
    def is_valid_contract_description(self, contract_desc: str) -> bool:
        # Placeholder implementation
        return True

    def get_contract_code_path(self, contract_id: int) -> str:
        # Placeholder implementation
        return f"path/to/contract/code/{contract_id}.cpp"

    def get_contract_abi_path(self, contract_id: int) -> str:
        # Placeholder implementation
        return f"path/to/contract/abi/{contract_id}.json"

    def get_balance(self, owner_key: str) -> float:
        # Placeholder implementation
        return 1000.0

    def get_asset_precision(self, asset_id: int) -> int:
        # Placeholder implementation
        return 8

def create_new_contract(data_ptr: DataPtr, contract_id: int, new_contract_name: str, new_contract_desc: str, upgrader_owner_key: str, upgrader_name: str) -> ContractCode:
    if not data_ptr.is_valid_contract_description(new_contract_desc):
        raise ValueError("Contract description illegal")

    new_contract_code = ContractCode()
    codefile = data_ptr.get_contract_code_path(contract_id)
    with open(codefile, 'r') as file:
        new_contract_code.code = file.read()

    new_contract_code.abi = data_ptr.get_contract_abi_path(contract_id)
    new_contract_code.description = new_contract_desc
    new_contract_code.name = new_contract_name
    new_contract_code.level = 0  # Assuming level is always 0 for simplicity
    new_contract_code.version = 1  # Assuming version starts at 1
    new_contract_code.deploy_time = datetime.now()
    new_contract_code.deployer = upgrader_owner_key
    new_contract_code.deployer_name = upgrader_name
    new_contract_code.deployer_address = upgrader_owner_key
    new_contract_code.deployer_balance = data_ptr.get_balance(upgrader_owner_key)
    new_contract_code.deployer_balance_asset_id = 0
    new_contract_code.deployer_balance_precision = data_ptr.get_asset_precision(0)

    return new_contract_code
