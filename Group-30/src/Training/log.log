import time
from PIL import Image

class BlinkyTape:
    def __init__(self, port, n_leds):
        self.port = port
        self.n_leds = n_leds
        # Simulated connection setup
        print(f"Connected to Blinky Tape at {self.port} with {self.n_leds} LEDs")

    def displayColor(self, r, g, b):
        # Simulate setting all LEDs to the same color
        print(f"Displaying color ({r}, {g}, {b}) on all LEDs")

    def sendPixel(self, r, g, b):
        # Simulate sending a single pixel color
        print(f"Sending pixel color ({r}, {g}, {b})")

    def show(self):
        # Simulate updating the Blinky Tape with sent pixel data
        print("Updating Blinky Tape with sent pixel data")

# Constants
MAX_ERRORS = 3
num_errors = 0

def read_bathymetric_data(image_path):
    try:
        image = Image.open(image_path)
        width, height = image.size
        return image, width, height
    except Exception as e:
        global num_errors
        num_errors += 1
        if num_errors >= MAX_ERRORS:
            print("Maximum errors reached. Exiting.")
            exit(1)
        else:
            print(f"Error reading image: {e}")
            return None, None, None

def process_image_data(image, width, height):
    # Simplified processing: convert each pixel to grayscale and map to RGB
    processed_data = []
    for y in range(height):
        for x in range(width):
            r, g, b = image.getpixel((x, y))
            gray = (r + g + b) // 3
            processed_data.append((gray, gray, gray))
    return processed_data

def main(location, update_interval, latitude_shift):
    blinky_tape = BlinkyTape("/dev/ttyUSB0", 100)

    while True:
        image_path = f"{location}_bathymetry.png"
        image, width, height = read_bathymetric_data(image_path)
        if image is not None:
            processed_data = process_image_data(image, width, height)
            for r, g, b in processed_data:
                blinky_tape.sendPixel(r, g, b)
            blinky_tape.show()
        
        time.sleep(update_interval)

if __name__ == "__main__":
    location = "example_location"
    update_interval = 5  # seconds
    latitude_shift = 0.5
    main(location, update_interval, latitude_shift)
```

### Explanation:

1. **Classes**:
   - `BlinkyTape`: Represents the Blinky Tape device. Methods include `displayColor`, `sendPixel`, and `show`.

2. **Global Variables**:
   - `MAX_ERRORS` and `num_errors`: Track error handling.

3. **Functions**:
   - `read_bathymetric_data`: Reads the PNG image and handles errors.
   - `process_image_data`: Converts each pixel to grayscale and maps it to RGB.
   - `main`: Orchestrates the reading, processing, and displaying of the image data on the Blinky Tape.

4. **Main Execution**:
   - Calls the `main` function with example parameters.

This code provides a basic framework for reading and displaying bathymetric data on a Blinky Tape using a PNG image. Adjustments may be needed based on actual hardware and requirements.
