from datetime import datetime
from typing import Optional
from wyzeapy import Client, Device

class WyzeCameraMotion:
    def __init__(self, wyzeapi_client: Client, device: Device):
        self._client = wyzeapi_client
        self._device = device
        self._last_event: Optional[datetime] = None
        self._on: bool = False
        self._available: bool = True

    @property
    def client(self) -> Client:
        return self._client

    @property
    def device(self) -> Device:
        return self._device

    @property
    def last_event(self) -> Optional[datetime]:
        return self._last_event

    @property
    def on(self) -> bool:
        return self._on

    @property
    def available(self) -> bool:
        return self._available

    def update_motion_status(self):
        # Simulate fetching motion status from the WyzeCam device
        current_time = datetime.now()
        if self._client.is_motion_detected(self._device.device_id):
            if not self._on:
                self._on = True
                self._last_event = current_time
        else:
            self._on = False

    def check_device_availability(self):
        # Simulate checking device availability
        self._available = self._client.is_device_connected(self._device.device_id)
```
This code defines a class `WyzeCameraMotion` that represents a single WyzeCam motion sensor within Home Assistant. It includes properties for accessing the client, device, last event time, motion status, and availability. Additionally, it provides methods to update the motion status and check the device's availability.
