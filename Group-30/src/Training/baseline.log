```python
import os
import cv2
import numpy as np
import tensorflow as tf
import sys

# Constants
MODEL_NAME = 'inference_graph'
IMAGE_NAME = 'test_image.jpg'
CWD_PATH = os.getcwd()
PATH_TO_CKPT = os.path.join(CWD_PATH, MODEL_NAME, 'frozen_inference_graph.pb')
PATH_TO_LABELS = os.path.join(CWD_PATH, MODEL_NAME, 'label_map.pbtxt')
PATH_TO_IMAGE = os.path.join(CWD_PATH, IMAGE_NAME)
NUM_CLASSES = 90

def load_label_map():
    """Loads the label map."""
    label_map = {}
    label_map_path = PATH_TO_LABELS
    with open(label_map_path, 'r') as f:
        lines = f.readlines()
    
    for line in lines:
        if line.startswith('item'):
            parts = line.split(':')
            class_id = int(parts[1].strip().split('"')[1])
            display_name = parts[2].strip().split('"')[1]
            label_map[class_id] = display_name
    
    return label_map

def load_model():
    """Loads the TensorFlow model."""
    detection_graph = tf.Graph()
    with detection_graph.as_default():
        od_graph_def = tf.compat.v1.GraphDef()
        with tf.io.gfile.GFile(PATH_TO_CKPT, 'rb') as fid:
            serialized_graph = fid.read()
            od_graph_def.ParseFromString(serialized_graph)
            tf.import_graph_def(od_graph_def, name='')
    
    sess = tf.compat.v1.Session(graph=detection_graph)
    return detection_graph, sess

def run_inference_for_single_image(image, graph):
    """Runs inference for a single image."""
    with graph.as_default():
        with tf.compat.v1.Session() as sess:
            # Get handles to input and output tensors
            ops = tf.compat.v1.get_default_graph().get_operations()
            all_tensor_names = {output.name for op in ops for output in op.outputs}
            tensor_dict = {}
            for key in [
                'num_detections', 'detection_boxes', 'detection_scores',
                'detection_classes', 'detection_masks'
            ]:
                tensor_name = key + ':0'
                if tensor_name in all_tensor_names:
                    tensor_dict[key] = tf.compat.v1.get_default_graph().get_tensor_by_name(tensor_name)
            
            if 'detection_masks' in tensor_dict:
                # The following processing is only for single image
                detection_boxes = tf.squeeze(tensor_dict['detection_boxes'], [0])
                detection_masks = tf.squeeze(tensor_dict['detection_masks'], [0])
                real_num_detection = tf.cast(tensor_dict['num_detections'][0], tf.int32)
                detection_boxes = tf.slice(detection_boxes, [0, 0], [real_num_detection, -1])
                detection_masks = tf.slice(detection_masks, [0, 0, 0], [real_num_detection, -1, -1])
                detection_masks_reframed = utils_ops.reframe_box_masks_to_image_masks(
                    detection_masks, detection_boxes, image.shape[0], image.shape[1])
                detection_masks_reframed = tf.cast(
                    tf.greater(detection_masks_reframed, 0.5), tf.uint8)
                
                # Follow the convention by adding back the batch dimension
                tensor_dict['detection_masks'] = tf.expand_dims(
                    detection_masks_reframed, 0)
            
            image_tensor = tf.compat.v1.get_default_graph().get_tensor_by_name('image_tensor:0')
            
            # Run inference
            output_dict = sess.run(tensor_dict,
                                   feed_dict={image_tensor: np.expand_dims(image, 0)})
            
            # All outputs are float32 numpy arrays, so convert types as appropriate
            output_dict['num_detections'] = int(output_dict['num_detections'][0])
            output_dict['detection_classes'] = output_dict[
                'detection_classes'][0].astype(np.uint8)
            output_dict['detection_boxes'] = output_dict['detection_boxes'][0]
            output_dict['detection_scores'] = output_dict['detection_scores'][0]
            if 'detection_masks' in output_dict:
                output_dict['detection_masks'] = output_dict['detection_masks'][0]
    
    return output_dict

def visualize_results(image_np, output_dict, category_index):
    """Visualizes the results on the image."""
    vis_util.visualize_boxes_and_labels_on_image_array(
        image_np,
        output_dict['detection_boxes'],
        output_dict['detection_classes'],
        output_dict['detection_scores'],
        category_index,
        instance_masks=output_dict.get('detection_masks'),
        use_normalized_coordinates=True,
        line_thickness=8)
    return image_np

def main():
    # Load label map
    label_map = load_label_map()
    categories = list(label_map.values())
    category_index = dict(enumerate(categories, 1))
    
    # Load model
    detection_graph, sess = load_model()
    
    # Read image
    image_np = cv2.imread(PATH_TO_IMAGE)
    
    # Run inference
    output_dict = run_inference_for_single_image(image_np, detection_graph)
    
    # Visualize results
    result_image = visualize_results(image_np.copy(), output_dict, category_index)
    
    # Save or display the result
    cv2.imwrite('result_image.jpg', result_image)
    cv2.imshow('Result Image', result_image)
    cv2.waitKey(0)

if __name__ == '__main__':
    main()
```

This code includes the necessary imports, constants, and functions to perform object detection on an image using a pre-trained TensorFlow model. The `load_label_map` function reads the label map file, `load_model` loads the TensorFlow model, `run_inference_for_single_image` runs inference on a given image, and `visualize_results` draws bounding boxes and labels on the image. The `main` function orchestrates these steps to process an image and display the results.
