#include <iostream>
#include <systemc.h>

// Function prototypes
void p3();
void p2();

int sc_main(int argc, char* argv[]) {
    // Spawn p2 as the top-level process
    sc_spawn(sc_bind(&p2));

    // Start the simulation
    sc_start();

    return 0;
}

// Function implementation for p3
void p3() {
    std::cout << sc_time_stamp() << " entering p3" << std::endl;
    wait(30, SC_NS); // Wait for 30 nanoseconds
    std::cout << sc_time_stamp() << " exiting p3" << std::endl;
}

// Function implementation for p2
void p2() {
    std::cout << sc_time_stamp() << " entering p2" << std::endl;
    sc_spawn(sc_bind(&p3)); // Spawn p3
    wait(20, SC_NS); // Wait for 20 nanoseconds
    std::cout << sc_time_stamp() << " exiting p2" << std::endl;
}
```

