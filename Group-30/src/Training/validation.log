import urllib.request
import json

class DBClient:
    def __init__(self, host='localhost', port=11211):
        self.host = host
        self.port = port
        self.base_url = f"http://{host}:{port}/"

    def set_key(self, bucket, key, value):
        """Sets a key-value pair in the specified bucket."""
        check_bucket(bucket)
        url = f"{self.base_url}set/{bucket}/{key}"
        response = urllib.request.urlopen(f"{url}?value={value}")
        return response.read().decode()

    def get_key(self, bucket, key):
        """Retrieves the value associated with the specified key in the bucket."""
        check_bucket(bucket)
        url = f"{self.base_url}get/{bucket}/{key}"
        response = urllib.request.urlopen(url)
        data = response.read().decode()
        return json.loads(data)['value']

    def manage_buckets(self, action, bucket=None):
        """Manages buckets by creating or deleting them."""
        check_bucket(bucket) if action == 'delete' else None
        url = f"{self.base_url}{action}/{bucket}" if bucket else f"{self.base_url}{action}"
        response = urllib.request.urlopen(url)
        return response.read().decode()

    def retrieve_statistics(self):
        """Retrieves statistics from the Memcached server."""
        url = f"{self.base_url}stats"
        response = urllib.request.urlopen(url)
        return response.read().decode()

    def perform_garbage_collection(self):
        """Performs garbage collection on the Memcached server."""
        url = f"{self.base_url}gc"
        response = urllib.request.urlopen(url)
        return response.read().decode()

def get_url_content(url):
    """Fetches the content of a given URL using urllib.urlopen."""
    response = urllib.request.urlopen(url)
    return response.read().decode()

def check_bucket(bucket):
    """Asserts that the provided bucket number is within the valid range (0-15)."""
    assert 0 <= bucket <= 15, "Bucket number must be between 0 and 15."

def dir_to_dict(dir_str):
    """Converts a directory string into a dictionary where keys are filenames and values are file contents."""
    # This function is not fully implemented based on the provided documentation.
    pass

# Test function to demonstrate usage
def test_db_client():
    db_client = DBClient()
    bucket = 0
    key = "test_key"
    value = "test_value"

    # Set key-value pair
    print(db_client.set_key(bucket, key, value))

    # Get key-value pair
    print(db_client.get_key(bucket, key))

    # Manage buckets
    print(db_client.manage_buckets('create', bucket))
    print(db_client.manage_buckets('delete', bucket))

    # Retrieve statistics
    print(db_client.retrieve_statistics())

    # Perform garbage collection
    print(db_client.perform_garbage_collection())

if __name__ == "__main__":
    test_db_client()
```

