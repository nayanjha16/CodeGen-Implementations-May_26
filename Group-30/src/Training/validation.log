#include <iostream>
#include <vector>
#include <memory>

// Forward declarations
class CThorGraphResult;
class CThorBoundLoopGraph;
class CIOConnection;
class CGraphElementBase;

// Interface for row writers
class IRowWriter {
public:
    virtual void writeRow(const std::vector<int>& row) = 0;
    virtual ~IRowWriter() {}
};

// Interface for result retrieval
class IResultRetriever {
public:
    virtual std::vector<std::vector<int>> getResults() const = 0;
    virtual ~IResultRetriever() {}
};

// Class representing the result of a graph computation
class CThorGraphResult : public IRowWriter, public IResultRetriever {
private:
    std::vector<std::vector<int>> rows;
    std::vector<char*> rowBuffers;
    int bufferSize;

public:
    CThorGraphResult(int initialBufferSize)
        : bufferSize(initialBufferSize), rowBuffers(initialBufferSize, nullptr) {}

    ~CThorGraphResult() {
        for (char* buffer : rowBuffers) {
            delete[] buffer;
        }
    }

    void writeRow(const std::vector<int>& row) override {
        if (rows.size() >= rowBuffers.size()) {
            resizeBuffers();
        }
        char* buffer = new char[row.size() * sizeof(int)];
        memcpy(buffer, row.data(), row.size() * sizeof(int));
        rowBuffers[rows.size()] = buffer;
        rows.push_back(row);
    }

    std::vector<std::vector<int>> getResults() const override {
        return rows;
    }

private:
    void resizeBuffers() {
        int newSize = rowBuffers.size() * 2;
        std::vector<char*> newRowBuffers(newSize, nullptr);
        for (size_t i = 0; i < rowBuffers.size(); ++i) {
            newRowBuffers[i] = rowBuffers[i];
        }
        rowBuffers = newRowBuffers;
        bufferSize = newSize;
    }
};

// Class managing bounded loops within a graph
class CThorBoundLoopGraph {
private:
    int counter;
    bool loopAgain;

public:
    CThorBoundLoopGraph() : counter(0), loopAgain(false) {}

    void prepareCounterAndLoopAgain() {
        counter++;
        loopAgain = (counter % 2 == 0);
    }

    bool shouldLoopAgain() const {
        return loopAgain;
    }
};

