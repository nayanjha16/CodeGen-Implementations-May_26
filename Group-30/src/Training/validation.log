from vanilla import Window, Slider, Button, Group
import mojo.roboFont as roboFont

class slideGlyphsDialog:
    def __init__(self):
        self.w = Window((200, 150), "Slide Glyphs")
        
        self._moveX = 0
        self._moveY = 0
        self._xMax = 100
        self._xMin = -100
        self._yMax = 100
        self._yMin = -100
        
        self.font = roboFont.getCurrentFont()
        self.font_name = self.font.familyName
        
        group = Group((10, 10, -10, -10))
        group.xSlider = Slider((0, 0, -10, 22), callback=self.updateMoveX)
        group.ySlider = Slider((0, 30, -10, 22), callback=self.updateMoveY)
        group.resetButton = Button((0, 60, -10, 22), title="Reset", callback=self.resetSliders)
        
        self.w.open()
    
    def updateMoveX(self, sender):
        self._moveX = sender.get()
        self.applyTransformations()
    
    def updateMoveY(self, sender):
        self._moveY = sender.get()
        self.applyTransformations()
    
    def resetSliders(self, sender):
        self._moveX = 0
        self._moveY = 0
        self.w.xSlider.set(0)
        self.w.ySlider.set(0)
        self.applyTransformations()
    
    def applyTransformations(self):
        if not self.font.selection:
            return
        
        for glyph in self.font.selection:
            glyph.transform([1, 0, 0, 1, self._moveX, self._moveY])

# Example usage
dialog = slideGlyphsDialog()
```

This code defines a `slideGlyphsDialog` class that creates a GUI window using the `vanilla` library. The window contains sliders for adjusting the X and Y positions of selected glyphs and a button to reset these positions. The class interacts with the RoboFont environment to apply the transformations to the selected glyphs.
