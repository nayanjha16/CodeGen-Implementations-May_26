```python
import asyncio
from tempfile import TemporaryDirectory
from typing import List, Optional

class FingerprintComparisonResult:
    def __init__(self, force_training: bool, core: bool, nlu: List[str]):
        self.force_training = force_training
        self.core = core
        self.nlu = nlu

class TempDirectoryPath:
    def __enter__(self):
        self.temp_dir = TemporaryDirectory()
        return self.temp_dir.name

    def __exit__(self, exc_type, exc_val, exc_tb):
        self.temp_dir.cleanup()

async def train(domain_path: str, config_path: str, training_data_path: str, output_path: str, fingerprint_path: Optional[str] = None) -> FingerprintComparisonResult:
    # Placeholder implementation for actual training logic
    async def train_core():
        print("Training Core model...")
        await asyncio.sleep(1)
        return True

    async def train_nlu(languages: List[str]):
        print(f"Training NLU models for languages: {', '.join(languages)}")
        await asyncio.sleep(1)
        return languages

    async def compare_fingerprints(current_fingerprint: str, new_fingerprint: str) -> FingerprintComparisonResult:
        # Placeholder comparison logic
        force_training = current_fingerprint != new_fingerprint
        core_retrain = force_training or "core" in new_fingerprint.split(',')
        nlu_retrain = [lang for lang in new_fingerprint.split(',') if lang.startswith('nlu_')]
        return FingerprintComparisonResult(force_training, core_retrain, nlu_retrain)

    async def save_model(output_path: str, core_retrained: bool, nlu_retrained: List[str]):
        print(f"Saving model to {output_path}")
        await asyncio.sleep(1)

    async def load_fingerprint(fingerprint_path: Optional[str]) -> str:
        if fingerprint_path:
            with open(fingerprint_path, 'r') as file:
                return file.read().strip()
        return ""

    async def write_fingerprint(fingerprint_path: Optional[str], fingerprint: str):
        if fingerprint_path:
            with open(fingerprint_path, 'w') as file:
                file.write(fingerprint)

    current_fingerprint = await load_fingerprint(fingerprint_path)
    new_fingerprint = f"core,nlu_en,nlu_fr"
    result = await compare_fingerprints(current_fingerprint, new_fingerprint)

    if result.force_training or result.core:
        core_retrained = await train_core()
    else:
        core_retrained = False

    if result.nlu:
        nlu_retrained = await train_nlu(result.nlu)
    else:
        nlu_retrained = []

    await save_model(output_path, core_retrained, nlu_retrained)
    await write_fingerprint(fingerprint_path, new_fingerprint)

    return result

def train_sync(domain_path: str, config_path: str, training_data_path: str, output_path: str, fingerprint_path: Optional[str] = None) -> FingerprintComparisonResult:
    loop = asyncio.get_event_loop()
    return loop.run_until_complete(train(domain_path, config_path, training_data_path, output_path, fingerprint_path))
```

This code defines the required classes and functions, including the `FingerprintComparisonResult`, `TempDirectoryPath`, and the `train` function. The `train` function uses asynchronous programming with `asyncio` to handle model training tasks. The `train_sync` function serves as a synchronous wrapper that initializes an event loop and runs the asynchronous `train` method.
