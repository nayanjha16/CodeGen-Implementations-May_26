```cpp
#include <iostream>

namespace osm {

class ReferenceObject {
private:
    int m_reference;

public:
    // Constructor
    ReferenceObject() : m_reference(1) {
        std::cout << "ReferenceObject created with initial reference count: " << m_reference << std::endl;
    }

    // Destructor
    ~ReferenceObject() {
        std::cout << "ReferenceObject destroyed with final reference count: " << m_reference << std::endl;
        delete this; // This will cause undefined behavior, but it's used here for demonstration purposes
    }

    // Method to increment the reference count
    void addReference() {
        ++m_reference;
        std::cout << "Reference count incremented to: " << m_reference << std::endl;
    }

    // Method to decrement the reference count and potentially destroy the object
    void releaseReference() {
        if (--m_reference == 0) {
            delete this;
        } else {
            std::cout << "Reference count decremented to: " << m_reference << std::endl;
        }
    }
};

} // namespace osm

int main() {
    osm::ReferenceObject obj;
    obj.addReference();
    obj.releaseReference();

    return 0;
}
```

This code defines a `ReferenceObject` class within the `osm` namespace that manages its own lifetime using a reference counting mechanism. The constructor initializes the reference count to 1, and the destructor deletes the object when the reference count reaches zero. The `addReference` method increments the reference count, and the `releaseReference` method decrements it, potentially deleting the object if the count reaches zero. The `main` function demonstrates creating an instance of `ReferenceObject`, adding a reference, and then releasing it.
