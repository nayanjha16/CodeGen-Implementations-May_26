```python
import asyncio
import tempfile
from typing import Dict, List, Optional

class FingerprintComparisonResult:
    def __init__(self, force_training: bool, core: bool, nlu: List[str]):
        self.force_training = force_training
        self.core = core
        self.nlu = nlu

class TempDirectoryPath:
    def __enter__(self):
        self.temp_dir = tempfile.mkdtemp()
        return self.temp_dir

    def __exit__(self, exc_type, exc_val, exc_tb):
        import shutil
        shutil.rmtree(self.temp_dir)

async def train(domain_path: str, config_path: str, training_data_path: str, output_path: str, fingerprint: Optional[Dict] = None) -> FingerprintComparisonResult:
    # Placeholder for actual training logic
    async def train_core():
        print("Training Core model...")
        await asyncio.sleep(1)
        return True

    async def train_nlu(languages: List[str]):
        print(f"Training NLU models for languages: {languages}...")
        await asyncio.sleep(1)
        return languages

    async def compare_fingerprints(current_fingerprint: Optional[Dict], new_fingerprint: Dict) -> FingerprintComparisonResult:
        force_training = False
        core_retrain = False
        nlu_retrain = []

        if current_fingerprint is None or fingerprint is None:
            force_training = True
        else:
            if current_fingerprint['core'] != fingerprint['core']:
                core_retrain = True
            if current_fingerprint['nlu'] != fingerprint['nlu']:
                nlu_retrain = [lang for lang in fingerprint['nlu'] if lang not in current_fingerprint['nlu']]

        return FingerprintComparisonResult(force_training, core_retrain, nlu_retrain)

    async def main():
        if fingerprint is None:
            fingerprint = {}

        comparison_result = await compare_fingerprints(fingerprint.get('current'), fingerprint.get('new'))

        if comparison_result.force_training or comparison_result.core:
            await train_core()

        if comparison_result.nlu:
            await train_nlu(comparison_result.nlu)

        return comparison_result

    loop = asyncio.get_event_loop()
    try:
        result = loop.run_until_complete(main())
    finally:
        loop.close()

    return result

def train_sync(domain_path: str, config_path: str, training_data_path: str, output_path: str, fingerprint: Optional[Dict] = None) -> FingerprintComparisonResult:
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    try:
        result = loop.run_until_complete(train(domain_path, config_path, training_data_path, output_path, fingerprint))
    finally:
        loop.close()
    return result
```

This code defines the required classes and functions as per the provided documentation. The `train` function serves as the main entry point for synchronous model training by initializing an event loop and calling the asynchronous `train_async` method. The `compare_fingerprints` function compares the current and new fingerprints to determine whether retraining is necessary. The `train_core` and `train_nlu` functions simulate the training process for the Core and NLU models, respectively. The `TempDirectoryPath` class manages temporary directories for model training using the `tempfile` module.
