#include <spdlog/spdlog.h>
#include <memory>

namespace Hazel {

class Ref {
public:
    template<typename T>
    static std::shared_ptr<T> create(T* ptr) {
        return std::shared_ptr<T>(ptr);
    }
};

class Log {
private:
    static std::shared_ptr<spdlog::logger> s_CoreLogger;
    static std::shared_ptr<spdlog::logger> s_ClientLogger;

public:
    static void Init();
};

std::shared_ptr<spdlog::logger> Log::s_CoreLogger = nullptr;
std::shared_ptr<spdlog::logger> Log::s_ClientLogger = nullptr;

void Log::Init() {
    if (s_CoreLogger == nullptr && s_ClientLogger == nullptr) {
        spdlog::set_pattern("%^[%T] %n: %v%$");
        s_CoreLogger = spdlog::stdout_color_mt("HAZEL", spdlog::level::trace);
        s_ClientLogger = spdlog::stdout_color_mt("APP", spdlog::level::trace);
    }
}

} // namespace Hazel
```

