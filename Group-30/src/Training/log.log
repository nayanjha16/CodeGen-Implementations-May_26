```python
import rospy
from sensor_msgs.msg import PointCloud2
import pcl
from pcl_ros import PointCloud2Converter

class VoxelGridOutlierFilterComponent:
    def __init__(self):
        self.voxel_size_x_ = 0.01  # Default voxel size along X-axis
        self.voxel_size_y_ = 0.01  # Default voxel size along Y-axis
        self.voxel_size_z_ = 0.01  # Default voxel size along Z-axis
        self.voxel_points_threshold_ = 1  # Minimum number of points per voxel
        self.voxel_filter = pcl.VoxelGrid()
        self.converter = PointCloud2Converter()

        # Initialize ROS node and subscribers/publishers
        rospy.init_node('voxel_grid_outlier_filter')
        self.subscriber = rospy.Subscriber('/input_point_cloud', PointCloud2, self.filter_point_cloud)
        self.publisher = rospy.Publisher('/filtered_point_cloud', PointCloud2, queue_size=1)

    def set_param_res_(self, param_name, value):
        if param_name == 'voxel_size_x':
            self.voxel_size_x_ = value
        elif param_name == 'voxel_size_y':
            self.voxel_size_y_ = value
        elif param_name == 'voxel_size_z':
            self.voxel_size_z_ = value
        elif param_name == 'voxel_points_threshold':
            self.voxel_points_threshold_ = value
        else:
            rospy.logwarn(f"Unknown parameter name: {param_name}")

    def filter_point_cloud(self, input_cloud):
        # Convert ROS PointCloud2 message to PCL point cloud
        pcl_input_cloud = self.converter.toPCL(input_cloud)

        # Set voxel grid parameters
        self.voxel_filter.setInputCloud(pcl_input_cloud)
        self.voxel_filter.setLeafSize(self.voxel_size_x_, self.voxel_size_y_, self.voxel_size_z_)
        
        # Apply voxel grid filter
        pcl_filtered_cloud = self.voxel_filter.filter()

        # Filter out voxels with fewer than the threshold number of points
        filtered_points = []
        for point in pcl_filtered_cloud:
            if pcl_filtered_cloud.getPointCount(point) >= self.voxel_points_threshold_:
                filtered_points.append(point)

        # Convert filtered PCL point cloud back to ROS PointCloud2 message
        output_cloud = self.converter.fromPCL(filtered_points)
        output_cloud.header = input_cloud.header

        # Publish the filtered point cloud
        self.publisher.publish(output_cloud)

if __name__ == '__main__':
    try:
        voxel_filter_component = VoxelGridOutlierFilterComponent()
        rospy.spin()
    except rospy.ROSInterruptException:
        pass
```

This Python code defines a class `VoxelGridOutlierFilterComponent` that implements a voxel grid outlier filter for point cloud data. It includes methods for setting parameters, filtering point clouds, and publishing the filtered results. The class uses the PCL library for point cloud processing and ROS for communication.
