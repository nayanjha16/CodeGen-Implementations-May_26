#include <iostream>
#include <fstream>
#include <string>
#include "nlohmann/json.hpp"

namespace server {

class ConfigWrapper {
public:
    // Method to initialize the configuration from a specified JSON file
    void init(const std::string& path) {
        std::ifstream file(path);
        if (file.is_open()) {
            file >> config_;
            file.close();
        } else {
            throw std::runtime_error("Failed to open configuration file");
        }
    }

    // Method to retrieve a value from the configuration based on a key
    template<typename T>
    T get(const std::string& key) const {
        auto it = config_.find(key);
        if (it != config_.end()) {
            return it->get<T>();
        } else {
            throw std::runtime_error("Key not found in configuration");
        }
    }

private:
    nlohmann::json config_; // JSON object to store the configuration settings
};

} // namespace server
```

This code defines a `ConfigWrapper` class within the `server` namespace that loads configuration settings from a JSON file and provides methods to retrieve these settings. The `init` method reads the JSON file and stores the contents in a private `nlohmann::json` object. The `get` method retrieves a value associated with a given key, throwing an exception if the key is not found.
