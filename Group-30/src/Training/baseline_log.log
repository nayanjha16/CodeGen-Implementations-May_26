class PosKioskConfig:
    def __init__(self):
        self.metadata = {}
        self.permissions = {}
        self.notifications = {}

    def add_metadata(self, key, value):
        """
        Adds metadata to the application configuration.

        Args:
            key (str): The key for the metadata.
            value (any): The value associated with the key.
        """
        self.metadata[key] = value

    def add_permission(self, role, doctype, permission_type):
        """
        Adds a permission rule to the application configuration.

        Args:
            role (str): The role that has the permission.
            doctype (str): The document type affected by the permission.
            permission_type (str): The type of permission ('read', 'write', etc.).
        """
        if role not in self.permissions:
            self.permissions[role] = {}
        if doctype not in self.permissions[role]:
            self.permissions[role][doctype] = []
        self.permissions[role][doctype].append(permission_type)

    def add_notification(self, event, action, recipients):
        """
        Adds a notification rule to the application configuration.

        Args:
            event (str): The event that triggers the notification.
            action (str): The action performed that triggers the notification.
            recipients (list): A list of users who will receive the notification.
        """
        if event not in self.notifications:
            self.notifications[event] = {}
        if action not in self.notifications[event]:
            self.notifications[event][action] = []
        self.notifications[event][action].extend(recipients)
