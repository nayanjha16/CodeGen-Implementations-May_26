#include <iostream>

int main() {
    // Input Section
    std::cout << "Enter an integer: ";
    int n;
    std::cin >> n;

    // Reversing the Number
    int reversedNumber = 0;
    while (n != 0) {
        int remainder = n % 10;
        reversedNumber = reversedNumber * 10 + remainder;
        n /= 10;
    }

    // Display the Reversed Number
    std::cout << "Reversed Number: " << reversedNumber << std::endl;

    return 0;
}
