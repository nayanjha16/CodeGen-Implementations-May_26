#include <iostream>
#include <CORBA.h>

class Grid_i {
public:
    // Constructor
    Grid_i(void) : width_(0), height_(0), array_(nullptr) {}

    // Constructor with specified dimensions
    Grid_i(CORBA::Short x, CORBA::Short y, CORBA::Environment &ACE_TRY_ENV) 
        : width_(x), height_(y) {
        ACE_NEW(array_, int*[width_]);
        for (int i = 0; i < width_; ++i) {
            ACE_NEW(array_[i], int[height_]);
        }
    }

    // Destructor
    ~Grid_i() {
        if (array_) {
            for (int i = 0; i < width_; ++i) {
                delete[] array_[i];
            }
            delete[] array_;
        }
    }

    // Set value at position (x, y)
    void setValue(CORBA::Short x, CORBA::Short y, int value, CORBA::Environment &ACE_TRY_ENV) {
        if (x >= 0 && x < width_ && y >= 0 && y < height_) {
            array_[x][y] = value;
        } else {
            ACE_THROW(ACE_NEW_CORBA_EXCEPTION(CORBA::BAD_PARAM, CORBA::COMPLETED_NO));
        }
    }

    // Get value at position (x, y)
    int getValue(CORBA::Short x, CORBA::Short y, CORBA::Environment &ACE_TRY_ENV) const {
        if (x >= 0 && x < width_ && y >= 0 && y < height_) {
            return array_[x][y];
        } else {
            ACE_THROW(ACE_NEW_CORBA_EXCEPTION(CORBA::BAD_PARAM, CORBA::COMPLETED_NO));
        }
    }

    // Resize the grid
    void resize(CORBA::Short newWidth, CORBA::Short newHeight, CORBA::Environment &ACE_TRY_ENV) {
        int** newArray = nullptr;
        ACE_NEW(newArray, int*[newWidth]);
        for (int i = 0; i < newWidth; ++i) {
            ACE_NEW(newArray[i], int[newHeight]);
        }

        for (int i = 0; i < std::min(width_, newWidth); ++i) {
            for (int j = 0; j < std::min(height_, newHeight); ++j) {
                newArray[i][j] = array_[i][j];
            }
        }

        for (int i = 0; i < width_; ++i) {
            delete[] array_[i];
        }
        delete[] array_;

        array_ = newArray;
        width_ = newWidth;
        height_ = newHeight;
    }

private:
    int width_;
    int height_;
    int** array_;
};

class Grid_Factory_i {
public:
    // Create a new instance of Grid_i
    static Grid_i* createGrid(CORBA::Short x, CORBA::Short y, CORBA::Environment &ACE_TRY_ENV) {
        return new Grid_i(x, y, ACE_TRY_ENV);
    }

    // Destroy an instance of Grid_i
    static void destroyGrid(Grid_i* grid) {
        delete grid;
    }
};
```

This code includes the `Grid_i` class with constructors, destructor, and methods to set and get values, as well as resize the grid. The `Grid_Factory_i` class provides static methods to create and destroy instances of `Grid_i`. Note that error handling is done using CORBA exceptions, and dynamic memory management is handled using `ACE_NEW` and manual deletion.
