import os
from datetime import datetime

class ContentItem:
    def __init__(self, dir_name):
        self.name = dir_name
        self.is_dir = True
        self.mod_time = None
        self.mod_time_string = ""
        self.file_type = "directory"
        self.file_type_string = "Directory"
        self.file_size = 0
        self.file_size_string = ""
        self.selected = False

    def update_from_file_info(self, file_info):
        self.name = file_info.filename
        self.is_dir = file_info.isdir
        self.mod_time = file_info.mtime
        self.mod_time_string = datetime.fromtimestamp(file_info.mtime).strftime('%Y-%m-%d %H:%M:%S')
        self.file_type = file_info.type
        self.file_type_string = f"{file_info.type.capitalize()} File"
        self.file_size = file_info.size
        self.file_size_string = f"{file_info.size} bytes"

class FileDialog:
    def __init__(self):
        self.left_panel = []
        self.right_panel = []

    def add_directory(self, dir_path):
        item = ContentItem(dir_path)
        self.left_panel.append(item)

    def add_file(self, file_path):
        file_info = FileInfo(file_path)
        item = ContentItem("")
        item.update_from_file_info(file_info)
        self.left_panel.append(item)

    def browse_directories(self, root_dir):
        for root, dirs, files in os.walk(root_dir):
            for dir_name in dirs:
                self.add_directory(os.path.join(root, dir_name))
            for file_name in files:
                self.add_file(os.path.join(root, file_name))

class FileInfo:
    def __init__(self, path):
        self.path = path
        self.filename = os.path.basename(path)
        self.isdir = os.path.isdir(path)
        self.mtime = os.path.getmtime(path)
        self.type = os.path.splitext(path)[1][1:] if not self.isdir else 'dir'
        self.size = os.path.getsize(path) if not self.isdir else 0

# Example usage
dialog = FileDialog()
dialog.browse_directories('/path/to/start/directory')
for item in dialog.left_panel:
    print(f"Name: {item.name}, IsDir: {item.is_dir}, ModTime: {item.mod_time_string}, FileType: {item.file_type_string}, FileSize: {item.file_size_string}")
```

