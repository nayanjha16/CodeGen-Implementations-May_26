#include <iostream>
#include <cmath>

// Constants
const long long INF = 1e18;
const double EPS = 1e-10;

// Macros
#define _USE_MATH_DEFINES
#define FOR(i, a, b) for (int i = (a); i < (b); ++i)
#define ROF(i, a, b) for (int i = (b) - 1; i >= (a); --i)
#define FORE(a, x) for (auto& a : x)
#define eb emplace_back
#define mp make_pair

long long findSmallestNumber(long long a, int n, long long b) {
    // Calculate the smallest number with 'n' digits
    long long smallestNDigitNumber = static_cast<long long>(std::pow(10, n - 1));
    
    // Find the smallest number greater than or equal to 'a' that ends with 'n' digits
    long long candidate = std::max(a, smallestNDigitNumber);
    
    // Adjust the candidate to end with 'n' digits
    candidate += (smallestNDigitNumber - (candidate % smallestNDigitNumber)) % smallestNDigitNumber;
    
    // Check if the candidate is divisible by 'b'
    while (candidate < INF && candidate % b != 0) {
        candidate += smallestNDigitNumber;
    }
    
    // Return the result
    return candidate == INF ? -1 : candidate;
}

int main() {
    long long a;
    int n;
    long long b;
    
    std::cin >> a >> n >> b;
    
    long long result = findSmallestNumber(a, n, b);
    
    std::cout << result << std::endl;
    
    return 0;
}
```

