        # M is odd
        for i in range(1, (M + 1) // 2 + 1):
            print((i, M + 1 - i))
    else:
        # M is even
        start_first_element = M + 2
        end_first_element = M + (M / 2) + 1
        start_second_element = 2 * M + 1
