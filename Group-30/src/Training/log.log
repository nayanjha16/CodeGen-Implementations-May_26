import unittest
from IECore import BasicPreset, Parameterised, BoolParameter, FloatParameter, ClassParameter, CompoundVectorParameter

class TestBasicPreset(unittest.TestCase):
    def testCopy(self):
        # Create a source object with some parameters
        source = Parameterised()
        source.parameters().add(BoolParameter("boolParam", "A boolean parameter", True))
        source.parameters().add(FloatParameter("floatParam", "A float parameter", 3.14))
        
        # Create a destination object
        destination = Parameterised()
        
        # Create a preset and copy parameters from source to destination
        preset = BasicPreset(source)
        preset.apply(destination)
        
        # Verify that the parameters have been copied correctly
        self.assertTrue(destination.parameters()["boolParam"].getTypedValue())
        self.assertEqual(destination.parameters()["floatParam"].getTypedValue(), 3.14)

    def testLoadSave(self):
        # Create an object with some parameters
        obj = Parameterised()
        obj.parameters().add(BoolParameter("boolParam", "A boolean parameter", True))
        obj.parameters().add(FloatParameter("floatParam", "A float parameter", 3.14))
        
        # Save the preset to a file
        preset = BasicPreset(obj)
        preset.save("test_preset.json")
        
        # Load the preset from the file
        loaded_obj = Parameterised()
        loaded_preset = BasicPreset(loaded_obj)
        loaded_preset.load("test_preset.json")
        
        # Verify that the parameters have been loaded correctly
        self.assertTrue(loaded_obj.parameters()["boolParam"].getTypedValue())
        self.assertEqual(loaded_obj.parameters()["floatParam"].getTypedValue(), 3.14)

    def testClassParameter(self):
        # Create an object with a class parameter
        obj = Parameterised()
        class_param = ClassParameter("classParam", "A class parameter", None)
        class_param.setValidClasses([Parameterised])
        obj.parameters().add(class_param)
        
        # Set the value of the class parameter
        obj.parameters()["classParam"].setValue(obj)
        
        # Create a preset and apply it to another object
        preset = BasicPreset(obj)
        new_obj = Parameterised()
        preset.apply(new_obj)
        
        # Verify that the class parameter has been applied correctly
        self.assertIs(new_obj.parameters()["classParam"].getValue(), new_obj)

    def testCompoundVectorParameter(self):
        # Create an object with a compound vector parameter
        obj = Parameterised()
        compound_vector_param = CompoundVectorParameter("compoundVectorParam", "A compound vector parameter", [])
        compound_vector_param.addMember(IntParameter("intMember", "An integer member", 0))
        compound_vector_param.addMember(StringParameter("stringMember", "A string member", ""))
        obj.parameters().add(compound_vector_param)
        
        # Set the value of the compound vector parameter
        obj.parameters()["compoundVectorParam"].setTypedValue([(1, "hello"), (2, "world")])
        
        # Create a preset and apply it to another object
        preset = BasicPreset(obj)
        new_obj = Parameterised()
        preset.apply(new_obj)
        
        # Verify that the compound vector parameter has been applied correctly
        self.assertEqual(new_obj.parameters()["compoundVectorParam"].getTypedValue(), [(1, "hello"), (2, "world")])

if __name__ == '__main__':
    unittest.main()
```

This code defines a test suite for the `IECore.BasicPreset` class using Python's built-in `unittest` framework. The suite includes four test methods: `testCopy`, `testLoadSave`, `testClassParameter`, and `testCompoundVectorParameter`. Each method demonstrates a specific aspect of the `BasicPreset` class's functionality, including copying parameters, loading and saving presets, handling class parameters, and handling compound vector parameters.
