# Version information and release notes for the RLBot project

__version__ = "1.0.0"
release_notes = {
    "1.0.0": "Initial release with basic bot functionality.",
    "1.1.0": "Added support for custom game modes.",
    "1.2.0": "Improved performance and stability."
}
release_banner = """
RLBot Project Release Notes
===========================
"""

def get_current_release_notes():
    """Retrieves the release notes for the current version of the RLBot project."""
    if __version__ in release_notes:
        return release_notes[__version__]
    else:
        return ""

def print_release_notes_and_help():
    """Prints the release notes and help text."""
    print(release_banner)
    print("Release Notes:")
    for version, notes in release_notes.items():
        print(f"Version {version}:")
        print(notes)
    print("\nHelp Text:")
    print("Use 'get_current_release_notes()' to retrieve release notes for the current version.")

# Example usage
if __name__ == "__main__":
    print(get_current_release_notes())
    print_release_notes_and_help()
```

