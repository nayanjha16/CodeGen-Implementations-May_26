import pytest
import xarray as xr
import numpy as np

# Fixture to generate xarray DataArray objects
@pytest.fixture
def generate_data(data, dims, reduce_by=None, as_list=False):
    """
    Constructs an xarray DataArray object based on provided parameters.

    Parameters:
    - data (list): A nested list representing the data.
    - dims (tuple): A tuple defining the dimensions of the DataArray.
    - reduce_by (str, optional): A string indicating which dimension to reduce. Defaults to None.
    - as_list (bool, optional): A boolean indicating whether to return the data as a list instead of a DataArray. Defaults to False.

    Returns:
    - xarray.DataArray or list: The constructed DataArray or its list representation.
    """
    # Create the DataArray
    da = xr.DataArray(data, dims=dims)
    
    if reduce_by:
        # Reduce the array by the specified dimension
        da = da.reduce(np.sum, dim=reduce_by)
    
    if as_list:
        # Convert the DataArray to a list
        return da.values.tolist()
    
    return da

# Test function to check the array_element process
def test_array_element(generate_data):
    """
    Tests the array_element process using the OpenEO API.

    Parameters:
    - generate_data (fixture): A fixture that constructs xarray DataArray objects based on provided parameters.
    """
    # Test case 1: Handling a simple list
    data = [[1, 2], [3, 4]]
    dims = ('x', 'y')
    result = generate_data(data, dims)
    assert (result == xr.DataArray([[1, 2], [3, 4]], dims=('x', 'y'))).all()

    # Test case 2: Handling an xarray DataArray
    data = [[1, 2], [3, 4]]
    dims = ('x', 'y')
    result = generate_data(data, dims)
    assert (result == xr.DataArray([[1, 2], [3, 4]], dims=('x', 'y'))).all()

    # Test case 3: Reducing by a dimension
    data = [[1, 2], [3, 4]]
    dims = ('x', 'y')
    result = generate_data(data, dims, reduce_by='x')
    assert (result == xr.DataArray([4, 6], dims='y')).all()

    # Test case 4: Returning as a list
    data = [[1, 2], [3, 4]]
    dims = ('x', 'y')
    result = generate_data(data, dims, as_list=True)
    assert result == [[1, 2], [3, 4]]

    # Test case 5: Out-of-bounds index
    data = [[1, 2], [3, 4]]
    dims = ('x', 'y')
    with pytest.raises(IndexError):
        generate_data(data, dims)[10]

if __name__ == "__main__":
    pytest.main()
```

