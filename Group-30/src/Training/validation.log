```cpp
#ifndef UTILITY_HPP
#define UTILITY_HPP

#include <cstddef> // For std::size_t

namespace utility {

    /**
     * @brief Allocates memory for an array of 'count' elements of type 'T'.
     *
     * @param count The number of elements to allocate.
     * @return T* A pointer to the allocated memory block, cast to T*. Returns nullptr if allocation fails.
     */
    template<typename T>
    T * allocate(std::size_t count) {
        void *raw_ptr = malloc(count * sizeof(T));
        return raw_ptr ? static_cast<T*>(raw_ptr) : nullptr;
    }

    /**
     * @brief Reallocates memory for an existing array of 'count' elements of type 'T'.
     *
     * @param ptr A pointer to the previously allocated memory block.
     * @param count The new number of elements to allocate.
     * @return T* A pointer to the reallocated memory block, cast to T*. Returns nullptr if reallocation fails.
     */
    template<typename T>
    T * reallocate(T *ptr, std::size_t count) {
        void *raw_ptr = realloc(ptr, count * sizeof(T));
        return raw_ptr ? static_cast<T*>(raw_ptr) : nullptr;
    }

} // namespace utility

#endif // UTILITY_HPP
```
