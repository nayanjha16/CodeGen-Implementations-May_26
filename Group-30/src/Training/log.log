# Program 1: Checking Armstrong Numbers

def check_armstrong_numbers(start, end):
    """
    Checks for Armstrong numbers within a given range.
    
    Args:
        start (int): The starting number of the range (inclusive).
        end (int): The ending number of the range (exclusive).
        
    Returns:
        None
    """
    for n in range(start, end):
        i = n // 100  # Hundreds digit
        j = (n // 10) % 10  # Tens digit
        k = n % 10  # Units digit
        
        if n == i**3 + j**3 + k**3:
            print(n)

# Example usage
