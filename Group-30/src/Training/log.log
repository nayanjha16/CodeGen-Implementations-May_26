import serial
import time

class MDC2250:
    def __init__(self, debug=False):
        self.debug = debug
        self.serial_connection = None

    def connect(self, port):
        try:
            self.serial_connection = serial.Serial(port, baudrate=9600, timeout=1)
            if self.debug:
                print(f"Connected to {port}")
        except serial.SerialException as e:
            if self.debug:
                print(f"Failed to connect to {port}: {e}")

    def configure_telemetry(self, settings):
        if self.serial_connection:
            # Simulate sending telemetry configuration
            command = f"CONFIGURE_TELEMETRY {settings}\n"
            self.serial_connection.write(command.encode())
            if self.debug:
                print(f"Sent telemetry configuration: {settings}")
        else:
            if self.debug:
                print("Not connected to device")

    def command_motor(self, motor_id, direction, speed):
        if self.serial_connection:
            # Simulate sending motor command
            command = f"COMMAND_MOTOR {motor_id} {direction} {speed}\n"
            self.serial_connection.write(command.encode())
            if self.debug:
                print(f"Commanded motor {motor_id} with direction {direction} and speed {speed}")
        else:
            if self.debug:
                print("Not connected to device")

    def handle_emergency_stop(self):
        if self.serial_connection:
            # Simulate sending emergency stop command
            command = "EMERGENCY_STOP\n"
            self.serial_connection.write(command.encode())
            if self.debug:
                print("Emergency stop commanded")
        else:
            if self.debug:
                print("Not connected to device")

    def read_sensor_data(self):
        if self.serial_connection:
            # Simulate reading sensor data
            response = self.serial_connection.readline().decode().strip()
            if self.debug:
                print(f"Read sensor data: {response}")
            return response
        else:
            if self.debug:
                print("Not connected to device")
            return None

# Example usage
if __name__ == "__main__":
    mdc_device = MDC2250(debug=True)
    mdc_device.connect("/dev/ttyUSB0")
    mdc_device.configure_telemetry("HIGH")
    mdc_device.command_motor(1, "FORWARD", 50)
    mdc_device.handle_emergency_stop()
    sensor_data = mdc_device.read_sensor_data()
```

