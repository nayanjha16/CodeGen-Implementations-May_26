#include <iostream>
#include <string>
#include <cstring>
#include <dirent.h> // For POSIX systems
#ifdef _WIN32
#include <io.h>
#include <direct.h>
#endif

#define OF_MAX_PATH_LEN 1024

class OFDirent {
public:
    OFDirent(const char *path);
    ~OFDirent();
    bool read(std::string &entry);

private:
    char m_path[OF_MAX_PATH_LEN];
    void* m_dir;
    int m_first;
#ifdef _WIN32
    struct _finddata_t m_data;
#endif
};

OFDirent::OFDirent(const char *path) : m_dir(nullptr), m_first(1) {
    strncpy(m_path, path, OF_MAX_PATH_LEN - 1);
    m_path[OF_MAX_PATH_LEN - 1] = '\0';
}

OFDirent::~OFDirent() {
    if (m_dir != nullptr) {
        close();
    }
}

bool OFDirent::read(std::string &entry) {
    if (m_dir == nullptr) {
        return false;
    }

#ifdef _WIN32
    if (m_first) {
        std::string searchPath = std::string(m_path) + "\\*";
        long hFile = _findfirst(searchPath.c_str(), &m_data);
        if (hFile == -1L) {
            return false;
        }
        m_first = 0;
    } else {
        if (_findnext(reinterpret_cast<long*>(&m_data), m_path) == -1L) {
            return false;
        }
    }
    entry = m_data.name;
#else
    struct dirent *dirEntry;
    while ((dirEntry = readdir(static_cast<DIR*>(m_dir))) != nullptr) {
        entry = dirEntry->d_name;
        return true;
    }
    closedir(static_cast<DIR*>(m_dir));
    m_dir = nullptr;
#endif

    return false;
}

int main() {
    OFDirent dir("/path/to/directory");
    std::string entry;
    while (dir.read(entry)) {
        std::cout << "Found entry: " << entry << std::endl;
    }
    return 0;
}
```

This code defines the `OFDirent` class, which provides a platform-independent way to iterate through the contents of a directory. It includes constructors, destructor, and a method to read directory entries. The implementation uses conditional compilation to support both Windows and POSIX systems.
