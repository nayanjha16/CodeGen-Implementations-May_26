assistant
```cpp
#include <iostream>
#include <fstream>
#include <vector>
#include <string>
#include <sstream>

enum PlyFormat {
    PlyFormat_ascii,
    PlyFormat_binary_little_endian,
    PlyFormat_binary_big_endian
};

struct PlyProperty {
    std::string name;
    std::string type;
};

struct PlyElementDetails {
    std::string name;
    int num_items;
    int stride_bytes;
    std::vector<PlyProperty> properties;
};

struct PlyHeaderDetails {
    PlyFormat format;
    std::string version;
    std::vector<PlyElementDetails> elements;
};

class Geometry {
public:
    struct Vertex {
        float x, y, z;
    };

    struct Face {
        std::vector<int> vertex_indices;
    };

    std::vector<Vertex> vertices;
    std::vector<Face> faces;

    void addVertex(const Vertex& v) {
        vertices.push_back(v);
    }

    void addFace(const Face& f) {
        faces.push_back(f);
    }
};

class PlyParser {
private:
    PlyHeaderDetails header;
    Geometry geometry;

    void parseHeader(std::ifstream& file) {
        // Parse the PLY header to populate the header structure
        std::string line;
        while (std::getline(file, line)) {
            if (line.find("element") != std::string::npos) {
                // Parse element details
                PlyElementDetails elem;
                std::istringstream iss(line);
                std::string token;
                iss >> token >> token >> elem.name >> elem.num_items;
                header.elements.push_back(elem);
            } else if (line.find("property") != std::string::npos) {
                // Parse property details
                PlyProperty prop;
                std::istringstream iss(line);
                std::string token;
                iss >> token >> token >> prop.type >> prop.name;
                header.elements.back().properties.push_back(prop);
            } else if (line.find("end_header") != std::string::npos) {
                break;
            }
        }
    }

    void parseAscii(std::ifstream& file) {
        // Parse ASCII data based on the header information
        for (const auto& elem : header.elements) {
            if (elem.name == "vertex") {
                for (int i = 0; i < elem.num_items; ++i) {
                    Geometry::Vertex v;
                    std::string line;
                    std::getline(file, line);
                    std::istringstream iss(line);
                    iss >> v.x >> v.y >> v.z;
                    geometry.addVertex(v);
                }
            } else if (elem.name == "face") {
                for (int i = 0; i < elem.num_items; ++i) {
                    Geometry::Face f;
                    std::string line;
                    std::getline(file, line);
                    std::istringstream iss(line);
                    int count;
                    iss >> count;
                    f.vertex_indices.resize(count);
                    for (int j = 0; j < count; ++j) {
                        iss >> f.vertex_indices[j];
                    }
                    geometry.addFace(f);
                }
            }
        }
    }

    void parseBinary(std::ifstream& file) {
        // Parse binary data based on the header information
        for (const auto& elem : header.elements) {
            if (elem.name == "vertex") {
                char buffer[elem.stride_bytes];
                for (int i = 0; i < elem.num_items; ++i) {
                    file.read(buffer, elem.stride_bytes);
                    Geometry::Vertex v;
                    std::memcpy(&v.x, buffer, sizeof(float));
                    std::memcpy(&v.y, buffer + sizeof(float), sizeof(float));
                    std::memcpy(&v.z, buffer + 2 * sizeof(float), sizeof(float));
                    geometry.addVertex(v);
                }
            } else if (elem.name == "face") {
                char buffer[elem.stride_bytes];
                for (int i = 0; i < elem.num_items; ++i) {
                    file.read(buffer, elem.stride_bytes);
                    Geometry::Face f;
                    int count;
                    std::memcpy(&count, buffer, sizeof(int));
                    f.vertex_indices.resize(count);
                    for (int j = 0; j < count; ++j) {
                        std::memcpy(&f.vertex_indices[j], buffer + (j + 1) * sizeof(int), sizeof(int));
                    }
                    geometry.addFace(f);
                }
            }
        }
    }

public:
    Geometry parseFile(const std::string& filename) {
        std::ifstream file(filename, std::ios::binary);
        if (!file.is_open()) {
            throw std::runtime_error("Failed to open file");
        }

        // Read the first few bytes to determine the format
        char magic[4];
        file.read(magic, 4);
        if (magic[0] == 'p' && magic[1] == 'l' && magic[2] == 'y') {
            if (magic[3] == '\n') {
                header.format = PlyFormat_ascii;
            } else if (magic[3] == 'b') {
                header.format = PlyFormat_binary_little_endian;
            } else if (magic[3] == 'B') {
                header.format = PlyFormat_binary_big_endian;
            }
        } else {
            throw std::runtime_error("Invalid PLY file format");
        }

        // Parse the header
        parseHeader(file);

        // Seek back to the beginning of the file
        file.seekg(0);

        // Parse the data based on the format
        if (header.format == PlyFormat_ascii) {
            parseAscii(file);
        } else {
            parseBinary(file);
        }

        return geometry;
    }
};
```

This code defines the necessary structures and classes to parse PLY files, including handling both ASCII and binary formats. The `PlyParser` class reads the PLY file, extracts the header details, and then parses the data into a `Geometry` object. The `Geometry` class contains vectors to store vertices and faces.
