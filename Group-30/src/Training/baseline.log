#include <string>

class AprAutoPool {
public:
    apr_pool_t* pool;

    AprAutoPool(apr_pool_t* parent = NULL) {
        apr_pool_create(&pool, parent);
    }

    ~AprAutoPool() {
        if (pool) {
            apr_pool_destroy(pool);
        }
    }

    void clear() {
        apr_pool_clear(pool);
    }

    apr_pool_t* data() const {
        return pool;
    }

    operator apr_pool_t*() const {
