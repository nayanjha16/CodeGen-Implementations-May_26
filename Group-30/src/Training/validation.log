    "sp2": "Species 2",
    "sp3": "Species 3"
}
FONTSIZE_TITLE = 18
FONTSIZE_LABEL = 14
MAX_LINES = 10
MIN_FRACTION = 0.05
THRESHOLD_FRAC = 0.1
MAX_SIGLVL = 0.05
COLORBAR_MIN = 0.0
COLORBAR_MAX = 1.0

class MutationLinePlot:
    def __init__(self, data: pd.DataFrame, species_id: str):
        """
        Initialize the MutationLinePlot with mutation data and species identifier.

        Parameters:
        - data (pd.DataFrame): DataFrame containing mutation data.
        - species_id (str): Identifier for the species.
        """
        self.data = data
        self.species_id = species_id
        self.species_name = SPECIES.get(species_id, "Unknown Species")
    
    def filter_mutations(self) -> pd.DataFrame:
        """
        Filter mutations based on minimum fraction and threshold fraction.

        Returns:
        - pd.DataFrame: Filtered DataFrame containing relevant mutations.
        """
        filtered_data = self.data[
            (self.data['fraction'] >= MIN_FRACTION) &
            (self.data['fraction'] <= THRESHOLD_FRAC)
        ]
        return filtered_data
    
    def plot_mutation_frequencies(self):
        """
        Plot the frequency of mutations across different isolates.
        """
        filtered_data = self.filter_mutations()
        plt.figure(figsize=(12, 8))
        sns.lineplot(data=filtered_data, x='isolate', y='fraction', hue='mutation', palette=COLORS)
        plt.title(f"Mutation Frequencies for {self.species_name}", fontsize=FONTSIZE_TITLE)
        plt.xlabel("Isolate", fontsize=FONTSIZE_LABEL)
        plt.ylabel("Fraction", fontsize=FONTSIZE_LABEL)
        plt.legend(title="Mutation", title_fontsize=FONTSIZE_LABEL)
        plt.show()
    
    def plot_co_occurrence_matrix(self):
        """
        Plot the co-occurrence matrix of mutations.
        """
        filtered_data = self.filter_mutations()
        co_occurrence_matrix = filtered_data.pivot_table(index='isolate', columns='mutation', aggfunc='size', fill_value=0)
        plt.figure(figsize=(12, 8))
        sns.heatmap(co_occurrence_matrix, annot=True, cmap="YlGnBu", cbar_kws={'label': 'Count'})
        plt.title(f"Co-Occurrence Matrix for {self.species_name}", fontsize=FONTSIZE_TITLE)
        plt.xlabel("Mutation", fontsize=FONTSIZE_LABEL)
        plt.ylabel("Isolate", fontsize=FONTSIZE_LABEL)
        plt.show()
    
    def plot_significance_levels(self):
        """
        Plot the significance levels of mutations.
        """
        filtered_data = self.filter_mutations()
        plt.figure(figsize=(12, 8))
        sns.scatterplot(data=filtered_data, x='isolate', y='significance_level', hue='mutation', palette=COLORS)
        plt.title(f"Significance Levels for {self.species_name}", fontsize=FONTSIZE_TITLE)
        plt.xlabel("Isolate", fontsize=FONTSIZE_LABEL)
        plt.ylabel("Significance Level", fontsize=FONTSIZE_LABEL)
        plt.legend(title="Mutation", title_fontsize=FONTSIZE_LABEL)
        plt.ylim(0, MAX_SIGLVL)
        plt.colorbar(label='Significance Level')
        plt.show()

# Example usage
if __name__ == "__main__":
    # Sample data
    data = pd.DataFrame({
        'isolate': ['A', 'B', 'C', 'D', 'E'],
        'mutation': ['mut1', 'mut2', 'mut1', 'mut3', 'mut2'],
        'fraction': [0.03, 0.12, 0.07, 0.09, 0.15],
        'significance_level': [0.02, 0.04, 0.03, 0.05, 0.06]
    })
    
    # Create instance of MutationLinePlot
    plotter = MutationLinePlot(data, 'sp1')
    
    # Generate plots
    plotter.plot_mutation_frequencies()
    plotter.plot_co_occurrence_matrix()
    plotter.plot_significance_levels()
```

This code defines the `MutationLinePlot` class with methods to filter mutations, plot mutation frequencies, co-occurrence matrices, and significance levels. The example usage at the bottom demonstrates how to create an instance of the class and generate the plots using sample data.
