// Problem: http://codeforces.com/contest/764/problem/D
// Author: github.com/lzl124631x
// Time: O(NlogN)
// Space: O(N)
class Solution {
public:
    typedef long long LL;
    int findSmallestNumber(int n, int b, int a) {
        if (b == 1) return a; // Special case when b is 1
        vector<LL> q = { 1 }; // Initialize queue with starting number 1
        while (q.size() < n) {
            vector<LL> tmp;
            LL sz = q.size();
            FOR(i, 0, sz) {
                LL num = q[i];
                LL d = num % 10; // Get the last digit of the current number
                ROF(j, 0, d + 1) {
                    LL next = num * 10 + j; // Form the next number by appending digit j
                    if (next >= a && next % b == 0) return next; // Check if the new number meets the criteria
                    tmp.eb(next); // Add the new number to temporary list
                }
            }
