```python
import sys
from contextlib import contextmanager

class _stdchannel_redirected:
    def __init__(self, stdchannel, dest_filename, mode="w"):
        self.stdchannel = stdchannel
        self.dest_filename = dest_filename
        self.mode = mode
        self._original = None

    @contextmanager
    def __call__(self):
        if self.stdchannel is None:
            yield None
        else:
            with open(self.dest_filename, self.mode) as dest_file:
                self._original = self.stdchannel
                self.stdchannel = dest_file
                try:
                    yield None
                finally:
                    self.stdchannel = self._original

class RedirectStdout(_stdchannel_redirected):
    def __init__(self, dest_filename, mode="w"):
        super().__init__(sys.stdout, dest_filename, mode)
```

This code defines two classes, `_stdchannel_redirected` and `RedirectStdout`, as described in the documentation. The `_stdchannel_redirected` class is a private utility class used for redirecting standard channels, while `RedirectStdout` is a public class specifically for redirecting `stdout`. Both classes use a context manager to handle the redirection logic.
