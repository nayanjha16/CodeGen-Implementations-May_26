        ConcatElimination::ConcatElimination() : GraphRewrite(), m_ops() {
            construct_concat_elimination();
        }

        void ConcatElimination::construct_concat_elimination() {
            auto concat = wrap_type<opset1::Concat>(InputVector{any_input(), any_input()}, true);

            auto callback = [](pattern::Matcher &m) {
                NGRAPH_CHECK(m.get_match_root(),
                            "Expected Concat as root node",
                            "but got ",
                            m.get_match_root()->get_type_info());
                return false;
            };

            auto concat_callback = make_shared<Matcher>(concat, "ConcatElimination");
            this->add_matcher(concat_callback, callback);
        }

