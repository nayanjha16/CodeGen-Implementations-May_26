```python
import r2pipe
import base64

def precompute_hash(r2, offset, size):
    """
    Computes a hash of a specified function in the binary using XOR operation on each byte of the function's body.

    Parameters:
    - r2: An instance of `r2pipe`, which provides access to Radare2 commands.
    - offset: The starting offset of the function in the binary.
    - size: The size of the function in bytes.

    Return Value: The computed hash value as a hexadecimal string.
    """
    print("Computing hash...")
    
    # Execute Radare2 command to retrieve the function body in base64 format
    r2.cmd(f"pdf @ {offset}")
    func_body_base64 = r2.cmdj("eI")
    
    if "bin" in func_body_base64 and "objdump" in func_body_base64["bin"]:
        func_body_hex = func_body_base64["bin"]["objdump"]
    else:
        raise ValueError("Failed to retrieve function body from Radare2 output.")
    
    # Decode the base64 data to obtain the raw bytes
    func_body_bytes = base64.b64decode(func_body_hex)
    
    # Compute the hash using XOR operation
    hash_value = 0
    for byte in func_body_bytes:
        hash_value ^= byte
    
    # Convert the hash value to a hexadecimal string
    return format(hash_value, '08x')

# Example usage:
# Assuming you have already opened a Radare2 session with your binary
# r2 = r2pipe.open("/path/to/binary")
# hash_result = precompute_hash(r2, 0x1000, 0x100)
# print(f"Computed Hash: {hash_result}")
```

