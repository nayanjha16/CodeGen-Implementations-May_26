    struct sigaction sa;
    sa.sa_handler = ExitOnAlarm;
    sigemptyset(&sa.sa_mask);
    sa.sa_flags = 0;
    if (sigaction(SIGALRM, &sa, nullptr) == -1) {
        perror("sigaction");
        return 1;
