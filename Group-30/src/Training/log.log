```cpp
#include <array>
#include <cmath>
#include <iostream>
#include <functional>

template <size_t N, typename T>
class Vector {
public:
    // Constructor that initializes the vector from an array
    constexpr Vector(const std::array<T, N>& data) : data_(data) {}

    // Method to calculate the magnitude of the vector
    T length(std::function<T(T)> sqrt_function = std::sqrt) const {
        T sum = 0;
        for (const auto& elem : data_) {
            sum += elem * elem;
        }
        return sqrt_function(sum);
    }

    // Accessor for the underlying data
    const std::array<T, N>& data() const { return data_; }

private:
    std::array<T, N> data_;
};

// Specialization for 2D vectors
template <typename T>
class Vector2 : public Vector<2, T> {
public:
    using Vector<2, T>::Vector;

    // Constructors for convenience
    constexpr Vector2(T x, T y) : Vector({x, y}) {}
    constexpr Vector2(const std::array<T, 2>& data) : Vector(data) {}

    // Getter for the x component
    T x() const { return this->data()[0]; }

    // Getter for the y component
    T y() const { return this->data()[1]; }
};

// Specialization for 3D vectors
template <typename T>
class Vector3 : public Vector<3, T> {
public:
    using Vector<3, T>::Vector;

    // Constructors for convenience
    constexpr Vector3(T x, T y, T z) : Vector({x, y, z}) {}
    constexpr Vector3(const std::array<T, 3>& data) : Vector(data) {}

    // Getter for the x component
    T x() const { return this->data()[0]; }

    // Getter for the y component
    T y() const { return this->data()[1]; }

    // Getter for the z component
    T z() const { return this->data()[2]; }
};

// Specialization for 4D vectors
template <typename T>
class Vector4 : public Vector<4, T> {
public:
    using Vector<4, T>::Vector;

    // Constructors for convenience
    constexpr Vector4(T x, T y, T z, T w) : Vector({x, y, z, w}) {}
    constexpr Vector4(const std::array<T, 4>& data) : Vector(data) {}

    // Getter for the x component
    T x() const { return this->data()[0]; }

    // Getter for the y component
    T y() const { return this->data()[1]; }

    // Getter for the z component
    T z() const { return this->data()[2]; }

    // Getter for the w component
    T w() const { return this->data()[3]; }
};

// Utility function to output a vector as a string
template <size_t N, typename T>
std::ostream& operator<<(std::ostream& os, const Vector<N, T>& vec) {
    os << "(";
    for (size_t i = 0; i < N; ++i) {
        if (i > 0) os << ", ";
        os << vec.data()[i];
    }
    os << ")";
    return os;
}

// Linear interpolation between two vectors
template <size_t N, typename T>
constexpr Vector<N, T> lerp(const Vector<N, T>& v1, const Vector<N, T>& v2, T t) {
    Vector<N, T> result;
    for (size_t i = 0; i < N; ++i) {
        result.data()[i] = v1.data()[i] + t * (v2.data()[i] - v1.data()[i]);
    }
    return result;
}
```

This code defines a generic `Vector` class template along with specializations for 2D, 3D, and 4D vectors. It includes methods for constructing vectors, calculating their magnitudes, accessing individual components, and utility functions for outputting vectors as strings and performing linear interpolation.
