            cfg = SimpleLSTM.default_config()
        super(SimpleLSTM, self).__init__(cfg)

    def _create_network_(self, story, question):
        inputs_story = Input(shape=(None,), dtype='int32')
        inputs_question = Input(shape=(None,), dtype='int32')

        embedding_dim = 100
        lstm_units = self.cfg['hidden']

        x_story = Embedding(input_dim=10000, output_dim=embedding_dim)(inputs_story)
        x_question = Embedding(input_dim=10000, output_dim=embedding_dim)(inputs_question)

        x_story = LSTM(lstm_units)(x_story)
        x_question = LSTM(lstm_units)(x_question)

        x = x_story + x_question
        outputs = Dense(1, activation='sigmoid')(x)

        model = Model(inputs=[inputs_story, inputs_question], outputs=outputs)
        return model

