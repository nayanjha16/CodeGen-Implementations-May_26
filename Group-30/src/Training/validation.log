import unittest
from slr_parser.grammar import Grammar

class TestGrammar(unittest.TestCase):
    def test_grammar(self):
        # Path to a valid grammar file
        grammar_file_path = 'path/to/valid_grammar.txt'
        
        try:
            # Attempt to construct a Grammar object from the valid grammar file
            grammar = Grammar(grammar_file_path)
            
            # Perform assertions to validate the grammar object
            self.assertIsNotNone(grammar)
            self.assertTrue(grammar.is_valid())
            self.assertGreater(len(grammar.rules), 0)
            self.assertGreater(len(grammar.terminals), 0)
            self.assertGreater(len(grammar.non_terminals), 0)
            self.assertIn('S', grammar.start_symbol)
        except Exception as e:
            # If an exception occurs, it should not happen for a valid grammar file
            self.fail(f"Exception occurred: {e}")

if __name__ == '__main__':
    unittest.main()
```

