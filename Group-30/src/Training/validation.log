class IpEndpointName {
public:
    // Constants
    static const unsigned long ANY_ADDRESS = 0x00000000;
    static const unsigned short ANY_PORT = 0;

    // Fields
    unsigned long address;
    unsigned short port;

    // Constructor
    IpEndpointName(unsigned long ip = ANY_ADDRESS, unsigned short port = ANY_PORT)
        : address(ip), port(port) {}

    // Getter for address
    unsigned long getAddress() const {
        return address;
    }

    // Setter for address
    void setAddress(unsigned long ip) {
        address = ip;
    }

    // Getter for port
    unsigned short getPort() const {
        return port;
    }

    // Setter for port
    void setPort(unsigned short p) {
        port = p;
    }

    // Equality operator
    bool operator==(const IpEndpointName& other) const {
        return address == other.address && port == other.port;
    }

    // Inequality operator
    bool operator!=(const IpEndpointName& other) const {
        return !(*this == other);
    }
};

int main() {
