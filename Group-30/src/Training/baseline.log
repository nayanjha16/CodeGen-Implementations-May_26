import torch
import torch.nn as nn
from typing import List, Optional

class BaseBackbone(nn.Module):
    def __init__(self, data_channel: int, num_cells: int, num_planes: int, block: str, activation_name: str, bn_name: str, first_output: int):
        super(BaseBackbone, self).__init__()
        self.data_channel = data_channel
        self.num_cells = num_cells
        self.num_planes = num_planes
        self.block = block
        self.activation_name = activation_name
        self.bn_name = bn_name
        self.first_output = first_output

class CellA(nn.Module):
    def __init__(self, num_planes: int, reduction: float):
        super(CellA, self).__init__()
        # Implementation of CellA goes here
        pass

class CellB(nn.Module):
    def __init__(self, num_planes: int, reduction: float):
        super(CellB, self).__init__()
        # Implementation of CellB goes here
        pass

class PNASNet(BaseBackbone):
    def __init__(self, data_channel: int, num_cells: List[int], num_planes: List[int], block: str, activation_name: str, bn_name: str, first_output: int):
        super(PNASNet, self).__init__(data_channel, sum(num_cells), num_planes[0], block, activation_name, bn_name, first_output)
        self.cells = nn.ModuleList()
        for i, n_cells in enumerate(num_cells):
            for j in range(n_cells):
                if block == 'CellA':
                    cell = CellA(num_planes[i], reduction=0.5)
                elif block == 'CellB':
                    cell = CellB(num_planes[i], reduction=0.5)
                else:
                    raise ValueError(f"Unsupported block type: {block}")
                self.cells.append(cell)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        # Forward pass through the PNASNet
        for cell in self.cells:
            x = cell(x)
        return x

def pnasnet_A(data_channel: int, num_cells: List[int], num_planes: List[int], activation_name: str, bn_name: str, first_output: int) -> PNASNet:
    return PNASNet(data_channel, num_cells, num_planes, 'CellA', activation_name, bn_name, first_output)

def pnasnet_B(data_channel: int, num_cells: List[int], num_planes: List[int], activation_name: str, bn_name: str, first_output: int) -> PNASNet:
    return PNASNet(data_channel, num_cells, num_planes, 'CellB', activation_name, bn_name, first_output)
