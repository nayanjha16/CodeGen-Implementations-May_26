    enableAEC = enable;
}

// Enable or disable noise suppression
void EchoCanceller::setEnableNS(bool enable) {
    enableNS = enable;
}

// Enable or disable automatic gain control
void EchoCanceller::setEnableAGC(bool enable) {
    enableAGC = enable;
}

// Check if the echo canceller is active
bool EchoCanceller::isActive() const {
    return isOn;
}
