```python
import json
from string import Template

class gn_to_bp_utils:
    @staticmethod
    def GenerateJSONFromGN(gn_config):
        # Simulate generating JSON from GN config
        return json.loads(gn_config)

    @staticmethod
    def GrabDependentValues(json_data, key):
        # Simulate grabbing dependent values from JSON
        return json_data.get(key, [])

    @staticmethod
    def CleanupCFlags(cflags):
        # Simulate cleaning up C flags
        return [flag.strip() for flag in cflags if flag]

    @staticmethod
    def GetArchSources(arch):
        # Simulate getting architecture-specific sources
        arch_sources = {
            'x86': ['src/core/SkX86.cpp'],
            'arm': ['src/core/SkARM.cpp']
        }
        return arch_sources.get(arch, [])

# Global variables and standalone functions
bp_template = Template("""
cc_library {
    name: '${name}',
    srcs: ${srcs},
    cflags: ${cflags},
    cppflags: ${cppflags},
    export_include_dirs: ${export_include_dirs},
    local_include_dirs: ${local_include_dirs},
}
""")

gn_args = {
    'build_tools': True,
    'enable_features': ['feature1', 'feature2'],
    'target_os': 'android',
    'cpu_arch': 'x86'
}

def generate_android_bp(bp_template, gn_args):
    # Simulate generating Android.bp content
    json_data = gn_to_bp_utils.GenerateJSONFromGN('{"key": "value"}')
    srcs = gn_to_bp_utils.GrabDependentValues(json_data, 'sources')
    cflags = gn_to_bp_utils.CleanupCFlags(['-Wall', '-Wextra'])
    cppflags = []
    export_include_dirs = []
    local_include_dirs = []

    if gn_args['build_tools']:
        srcs.extend(gn_to_bp_utils.GetArchSources(gn_args['cpu_arch']))

    android_bp_content = bp_template.substitute({
        'name': 'skia_lib',
        'srcs': str(srcs),
        'cflags': str(cflags),
        'cppflags': str(cppflags),
        'export_include_dirs': str(export_include_dirs),
        'local_include_dirs': str(local_include_dirs)
    })

    with open('Android.bp', 'w') as f:
        f.write(android_bp_content)

# Main execution
generate_android_bp(bp_template, gn_args)
```

This code defines a class `gn_to_bp_utils` with static methods to simulate generating JSON from GN config, grabbing dependent values, cleaning up C flags, and getting architecture-specific sources. It also includes global variables and a function `generate_android_bp` to generate the `Android.bp` file using a template and provided arguments.
