#include <iostream>
#include <vector>
#include <string>
#include <memory>

class StartupFlag {
public:
    virtual ~StartupFlag() = default;
    virtual bool NeedsParameter() const = 0;
    virtual bool IsValid(const std::string& arg) const = 0;
};

class UnaryStartupFlag : public StartupFlag {
public:
    bool NeedsParameter() const override { return true; }
    bool IsValid(const std::string& arg) const override {
        // Simple check for non-empty string
        return !arg.empty();
    }
};

class NullaryStartupFlag : public StartupFlag {
public:
    bool NeedsParameter() const override { return false; }
    bool IsValid(const std::string& arg) const override {
        // Always valid for nullary flags
        return true;
    }
};

class StartupOptions {
private:
    std::vector<std::unique_ptr<StartupFlag>> flags;

public:
    void AddFlag(std::unique_ptr<StartupFlag> flag) {
        flags.push_back(std::move(flag));
    }

    bool ProcessArguments(int argc, char* argv[]) {
        for (int i = 1; i < argc; ++i) {
            const std::string arg = argv[i];
            bool found = false;
            for (const auto& flag : flags) {
                if (flag->IsValid(arg)) {
                    if (flag->NeedsParameter()) {
                        if (i + 1 < argc) {
                            ++i; // Skip next argument as it's a parameter
                        } else {
                            std::cerr << "Error: Parameter required for flag " << arg << std::endl;
                            return false;
                        }
                    }
                    found = true;
                    break;
                }
            }
            if (!found) {
                std::cerr << "Error: Unknown flag " << arg << std::endl;
                return false;
            }
        }
        return true;
    }
};

int main(int argc, char* argv[]) {
    StartupOptions options;
    options.AddFlag(std::make_unique<UnaryStartupFlag>());
    options.AddFlag(std::make_unique<NullaryStartupFlag>());

    if (options.ProcessArguments(argc, argv)) {
        std::cout << "All flags processed successfully." << std::endl;
    } else {
        std::cerr << "Failed to process flags." << std::endl;
        return 1;
    }

    return 0;
}
```

### Explanation:

1. **StartupFlag Class**:
   - A pure virtual base class with two pure virtual methods: `NeedsParameter()` and `IsValid(const std::string& arg)`.

2. **UnaryStartupFlag Class**:
   - Inherits from `StartupFlag`.
   - Implements `NeedsParameter()` to return `true`, indicating it requires a parameter.
   - Implements `IsValid(const std::string& arg)` to check if the argument is non-empty.

3. **NullaryStartupFlag Class**:
   - Inherits from `StartupFlag`.
   - Implements `NeedsParameter()` to return `false`, indicating it does not require a parameter.
   - Implements `IsValid(const std::string& arg)` to always return `true`.

4. **StartupOptions Class**:
   - Manages a list of `StartupFlag` objects.
   - Provides a method `AddFlag(std::unique_ptr<StartupFlag> flag)` to add new flags.
   - Provides a method `ProcessArguments(int argc, char* argv[])` to process command-line arguments and validate them using the added flags.

5. **main Function**:
   - Creates instances of `StartupOptions` and adds both `UnaryStartupFlag` and `NullaryStartupFlag`.
   - Calls `ProcessArguments` to process command-line arguments and prints success or failure messages accordingly.
