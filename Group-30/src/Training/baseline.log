assistant
```cpp
#include <iostream>
#include <string>
#include <variant>

class Variant {
private:
    std::variant<std::monostate, bool, signed int, unsigned int, float, double, std::string> _godot_variant;

public:
    // Default constructor initializing with a nil value (std::monostate)
    Variant() : _godot_variant(std::monostate{}) {}

    // Copy constructor
    Variant(const Variant &v) : _godot_variant(v._godot_variant) {}

    // Constructor for bool
    explicit Variant(bool v) : _godot_variant(v) {}

    // Constructor for signed int
    explicit Variant(signed int v) : _godot_variant(v) {}

    // Constructor for unsigned int
    explicit Variant(unsigned int v) : _godot_variant(v) {}

    // Constructor for float
    explicit Variant(float v) : _godot_variant(v) {}

    // Constructor for double
    explicit Variant(double v) : _godot_variant(v) {}

    // Constructor for String
    explicit Variant(const std::string &v) : _godot_variant(v) {}

    // Getter for bool
    bool get_bool() const {
        return std::get<bool>(_godot_variant);
    }

    // Getter for signed int
    signed int get_signed_int() const {
        return std::get<signed int>(_godot_variant);
    }

    // Getter for unsigned int
    unsigned int get_unsigned_int() const {
        return std::get<unsigned int>(_godot_variant);
    }

    // Getter for float
    float get_float() const {
        return std::get<float>(_godot_variant);
    }

    // Getter for double
    double get_double() const {
        return std::get<double>(_godot_variant);
    }

    // Getter for String
    std::string get_string() const {
        return std::get<std::string>(_godot_variant);
    }

    // Check if the variant holds a specific type
    template<typename T>
    bool is_type() const {
        return std::holds_alternative<T>(_godot_variant);
    }
};

int main() {
    Variant var1 = true;
    Variant var2 = 42;
    Variant var3 = 3.14f;
    Variant var4 = "Hello, World!";

    std::cout << "var1 is bool: " << var1.is_type<bool>() << ", Value: " << var1.get_bool() << std::endl;
    std::cout << "var2 is signed int: " << var2.is_type<signed int>() << ", Value: " << var2.get_signed_int() << std::endl;
    std::cout << "var3 is float: " << var3.is_type<float>() << ", Value: " << var3.get_float() << std::endl;
    std::cout << "var4 is string: " << var4.is_type<std::string>() << ", Value: " << var4.get_string() << std::endl;

    return 0;
}
```

This code defines a `Variant` class that can hold various data types using `std::variant`. It includes constructors for each supported type and getter methods to retrieve the stored values. The `is_type` method checks if the variant currently holds a specific type. The `main` function demonstrates how to use the `Variant` class with different data types.
