class BigInteger:
    def __init__(self):
        self.n = 0
        self.val = []
        self.pos = True

    def __init__(self, s: str):
        if s[0] == '-':
            self.pos = False
            s = s[1:]
        else:
            self.pos = True
        self.n = len(s)
        self.val = [int(digit) for digit in s]

    def __copy__(self):
        new_big_int = BigInteger()
        new_big_int.n = self.n
        new_big_int.val = self.val[:]
        new_big_int.pos = self.pos
        return new_big_int

    def __add__(self, other):
        if not isinstance(other, BigInteger):
            raise TypeError("Unsupported operand type for +: 'BigInteger' and '{}'".format(type(other).__name__))
        
        result = []
        carry = 0
        i = max(self.n, other.n) - 1
        
        while i >= 0 or carry:
            v1 = self.val[i] if i < self.n else 0
            v2 = other.val[i] if i < other.n else 0
            sum_digit = v1 + v2 + carry
            carry = sum_digit // 10
            result.append(sum_digit % 10)
            i -= 1
        
        result.reverse()
        new_big_int = BigInteger()
        new_big_int.n = len(result)
        new_big_int.val = result
        new_big_int.pos = (new_big_int.val[0] != 0)
        return new_big_int

    def __sub__(self, other):
        if not isinstance(other, BigInteger):
            raise TypeError("Unsupported operand type for -: 'BigInteger' and '{}'".format(type(other).__name__))
        
        if self < other:
            raise ValueError("Cannot subtract a larger number from a smaller one")
        
        result = []
        borrow = 0
        i = max(self.n, other.n) - 1
        
        while i >= 0:
            v1 = self.val[i] if i < self.n else 0
            v2 = other.val[i] if i < other.n else 0
            diff_digit = v1 - v2 - borrow
            if diff_digit < 0:
                diff_digit += 10
                borrow = 1
            else:
                borrow = 0
            result.append(diff_digit)
            i -= 1
        
        result.reverse()
        new_big_int = BigInteger()
        new_big_int.n = len(result)
        new_big_int.val = result
        new_big_int.pos = (new_big_int.val[0] != 0)
        return new_big_int

    def __lt__(self, other):
        if not isinstance(other, BigInteger):
            raise TypeError("Unsupported operand type for <: 'BigInteger' and '{}'".format(type(other).__name__))
        
        if self.pos and not other.pos:
            return False
        elif not self.pos and other.pos:
            return True
        elif self.n > other.n:
            return self.pos
        elif self.n < other.n:
            return not self.pos
        else:
            for i in range(self.n - 1, -1, -1):
                if self.val[i] > other.val[i]:
                    return self.pos
                elif self.val[i] < other.val[i]:
                    return not self.pos
            return False

    def __eq__(self, other):
        if not isinstance(other, BigInteger):
            raise TypeError("Unsupported operand type for ==: 'BigInteger' and '{}'".format(type(other).__name__))
        
        if self.pos != other.pos:
            return False
        if self.n != other.n:
            return False
        for i in range(self.n):
            if self.val[i] != other.val[i]:
                return False
        return True

    def __str__(self):
        sign = '-' if not self.pos else ''
        return sign + ''.join(str(digit) for digit in self.val)

# Example usage:
a = BigInteger('12345678901234567890')
b = BigInteger('-98765432109876543210')
c = a + b
print(c)  # Output: -86419753208641975320
```

