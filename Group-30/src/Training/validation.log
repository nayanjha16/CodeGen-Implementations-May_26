    KYBRD_INPUT_BUFFER = 0x60,
    KYBRD_COMMAND_REGISTER = 0x64
};

enum KYBRD_ENC_CMDS {
    SET_LEDS = 0xED,
    ECHO_CMD = 0xEE,
    SCAN_CODE_SET_1 = 0xF0,
    SCAN_CODE_SET_2 = 0xF1,
    SCAN_CODE_SET_3 = 0xF2
};

enum KYBRD_CTRL_IO {
    KYBRD_STATISTICS_REGISTER = 0x60,
    KYBRD_COMMAND_REGISTER_CTRL = 0x64
};

enum KYBRD_CTRL_STATS_MASK {
    BUFFER_OVERFLOW = 0x01,
    INPUT_BUFFER_AVAILABILITY = 0x02,
    PARITY_ERROR = 0x04
};

enum KYBRD_CTRL_CMDS {
    READ_DATA = 0x20,
    WRITE_DATA = 0x60,
    SELF_TEST = 0xAA,
    ENABLE_KEYBOARD = 0xAE,
    DISABLE_KEYBOARD = 0xAD
};

enum KYBRD_ERROR {
    NO_ERROR = 0,
    BUFFER_OVERFLOW_ERROR = 1,
    INPUT_BUFFER_UNAVAILABLE_ERROR = 2,
    PARITY_ERROR_OCCURRED = 3
};

class KeyboardDriver {
public:
    KeyboardDriver() : ledState(0) {}

    void initialize() {
        // Initialize the keyboard controller and encoder
        writeCommand(KYBRD_CTRL_CMDS::ENABLE_KEYBOARD);
        setScanCodeSet(SCAN_CODE_SET_1);
    }

    void setLEDs(uint8_t leds) {
        ledState = leds;
        sendCommandToEncoder(SET_LEDS, ledState);
    }

    uint8_t getKeyboardStatus() const {
        return readDataFromController();
    }

    void handleInterrupt() {
        uint8_t scancode = readInputBuffer();
        processScanCode(scancode);
    }

private:
    uint8_t ledState;

    void writeCommand(uint8_t cmd) {
        outb(cmd, KYBRD_COMMAND_REGISTER_CTRL);
    }

    void sendCommandToEncoder(uint8_t cmd, uint8_t data) {
        outb(cmd, KYBRD_COMMAND_REGISTER);
        outb(data, KYBRD_INPUT_BUFFER);
    }

    uint8_t readDataFromController() const {
        while (!(inb(KYBRD_STATISTICS_REGISTER) & INPUT_BUFFER_AVAILABILITY));
        return inb(KYBRD_INPUT_BUFFER);
    }

    uint8_t readInputBuffer() const {
        while (!(inb(KYBRD_STATISTICS_REGISTER) & INPUT_BUFFER_AVAILABILITY));
        return inb(KYBRD_INPUT_BUFFER);
    }

    void processScanCode(uint8_t scancode) {
        // Placeholder for scan code processing logic
        std::cout << "Received scan code: " << static_cast<int>(scancode) << std::endl;
    }

    void setScanCodeSet(uint8_t set) {
        sendCommandToEncoder(SCAN_CODE_SET_1 + (set - 1), 0);
    }
};

// Helper functions for I/O operations
void outb(uint8_t value, uint16_t port) {
    asm volatile ("outb %0, %1" : : "a"(value), "Nd"(port));
}

uint8_t inb(uint16_t port) {
    uint8_t ret;
    asm volatile ("inb %1, %0" : "=a"(ret) : "Nd"(port));
    return ret;
}

int main() {
    KeyboardDriver driver;
    driver.initialize();

    // Simulate an interrupt
    driver.handleInterrupt();

    return 0;
}
```

