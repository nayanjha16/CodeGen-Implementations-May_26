#include <iostream>
#include <cmath>

// Define a simple Matrix4 class for demonstration purposes
class Matrix4 {
public:
    float data[4][4];

    Matrix4() {
        for (int i = 0; i < 4; ++i) {
            for (int j = 0; j < 4; ++j) {
                data[i][j] = (i == j) ? 1.0f : 0.0f;
            }
        }
    }

    void print() const {
        for (int i = 0; i < 4; ++i) {
            for (int j = 0; j < 4; ++j) {
                std::cout << data[i][j] << " ";
            }
            std::cout << std::endl;
        }
    }
};

class Camera {
private:
    Matrix4 m_projectionMatrix;
    float m_FOV;
    float m_nearPlane;
    float m_farPlane;

public:
    Camera(float fov, float nearPlane, float farPlane)
        : m_FOV(fov), m_nearPlane(nearPlane), m_farPlane(farPlane) {}

    void UpdateProjectionMatrix() {
        // Calculate the half of the FOV in radians
        float halfFovRad = m_FOV * 0.5f * M_PI / 180.0f;

        // Calculate the tangent of half the FOV
        float tanHalfFov = std::tan(halfFovRad);

        // Calculate the aspect ratio assuming width is 1 unit and height is determined by FOV
        float aspectRatio = 1.0f / tanHalfFov;

        // Update the projection matrix
        m_projectionMatrix.data[0][0] = aspectRatio;
        m_projectionMatrix.data[1][1] = 1.0f / tanHalfFov;
        m_projectionMatrix.data[2][2] = -(m_farPlane + m_nearPlane) / (m_farPlane - m_nearPlane);
        m_projectionMatrix.data[2][3] = -2.0f * m_farPlane * m_nearPlane / (m_farPlane - m_nearPlane);
        m_projectionMatrix.data[3][2] = -1.0f;
        m_projectionMatrix.data[3][3] = 0.0f;
    }

    void PrintProjectionMatrix() const {
        m_projectionMatrix.print();
    }
};

int main() {
    Camera camera(90.0f, 0.1f, 100.0f);
    camera.UpdateProjectionMatrix();
    camera.PrintProjectionMatrix();
    return 0;
}
```

