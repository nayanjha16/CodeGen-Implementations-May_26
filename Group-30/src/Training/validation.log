#include <iostream>
#include <vector>
#include <memory>
#include <string>

// Forward declaration of StreamIndexedIO
class StreamIndexedIO;

// Define ConstCharVectorDataPtr as a shared pointer to a vector of const characters
using ConstCharVectorDataPtr = std::shared_ptr<const std::vector<char>>;

// Define EntryIDList as a vector of strings representing entry IDs
using EntryIDList = std::vector<std::string>;

// Enumerate OpenMode for different file access modes
enum class OpenMode {
    Read,
    Write,
    Append
};

// Forward declaration of MemoryIndexedIO
class MemoryIndexedIO;

// Base class StreamIndexedIO
class StreamIndexedIO {
public:
    virtual ~StreamIndexedIO() {}
    virtual void read(const EntryIDList& path, std::vector<char>& buffer) = 0;
    virtual void write(const EntryIDList& path, const std::vector<char>& buffer) = 0;
};

// Derived class MemoryIndexedIO
class MemoryIndexedIO : public StreamIndexedIO {
private:
    ConstCharVectorDataPtr buffer_;
    EntryIDList root_;
    OpenMode mode_;

public:
    // Constructor for MemoryIndexedIO
    MemoryIndexedIO(ConstCharVectorDataPtr buf, const EntryIDList& root, OpenMode mode)
        : buffer_(buf), root_(root), mode_(mode) {}

    // Implementation of the read method
    void read(const EntryIDList& path, std::vector<char>& buffer) override {
        if (mode_ != OpenMode::Read && mode_ != OpenMode::Append) {
            throw std::invalid_argument("Invalid mode for read operation");
        }
        // Simulate reading from memory buffer
        buffer.assign(buffer_->begin(), buffer_->end());
    }

    // Implementation of the write method
    void write(const EntryIDList& path, const std::vector<char>& buffer) override {
        if (mode_ != OpenMode::Write && mode_ != OpenMode::Append) {
            throw std::invalid_argument("Invalid mode for write operation");
        }
        // Simulate writing to memory buffer
        buffer_ = std::make_shared<std::vector<char>>(buffer);
    }
};
```

This code snippet defines the `MemoryIndexedIO` class, which inherits from `StreamIndexedIO`. It includes a constructor that initializes the memory buffer, root directory structure, and open mode. The `read` and `write` methods are implemented to simulate reading from and writing to the memory buffer based on the specified open mode.
