```python
import unittest
import tensorflow as tf
import tflearn

PLACES = 6

class TestActivations(unittest.TestCase):
    def test_linear(self):
        # Test the linear activation function
        with tf.Graph().as_default():
            x = tf.placeholder(tf.float32)
            y = tflearn.linear(x)
            self.assertEqual(y, x)

            x_int = tf.placeholder(tf.int64)
            y_int = tflearn.linear(x_int)
            self.assertEqual(y_int, x_int)

    def test_tanh(self):
        # Test the hyperbolic tangent activation function
        with tf.Graph().as_default():
            x = tf.placeholder(tf.float32)
            y = tflearn.tanh(x)
            with tf.Session() as sess:
                sess.run(tf.global_variables_initializer())
                result = sess.run(y, feed_dict={x: [0.0, 1.0, -1.0]})
                self.assertAlmostEqual(result[0], 0.0, places=PLACES)
                self.assertAlmostEqual(result[1], 0.761594, places=PLACES)
                self.assertAlmostEqual(result[2], -0.761594, places=PLACES)

    def test_leaky_relu(self):
        # Test the leaky ReLU activation function
        alpha = 0.1
        with tf.Graph().as_default():
            x = tf.placeholder(tf.float32)
            y = tflearn.leaky_relu(x, alpha)
            with tf.Session() as sess:
                sess.run(tf.global_variables_initializer())
                result = sess.run(y, feed_dict={x: [-1.0, 0.0, 1.0]})
                self.assertAlmostEqual(result[0], -0.1, places=PLACES)
                self.assertAlmostEqual(result[1], 0.0, places=PLACES)
                self.assertAlmostEqual(result[2], 1.0, places=PLACES)

if __name__ == '__main__':
    unittest.main()
```

This code defines a `TestActivations` class that inherits from `unittest.TestCase`. It includes three test methods: `test_linear`, `test_tanh`, and `test_leaky_relu`. Each method tests a specific activation function from the `tflearn` library and uses assertions to verify the correctness of the outputs. The `PLACES` constant specifies the number of decimal places to consider when comparing floating-point numbers during tests.
