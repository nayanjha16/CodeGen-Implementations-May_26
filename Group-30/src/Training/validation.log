assistant
```python
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch_geometric.nn import GCNConv

class DGI(nn.Module):
    def __init__(self, ft_size, hid_units, nonlinearity='prelu'):
        super(DGI, self).__init__()
        self.ft_size = ft_size
        self.hid_units = hid_units
        self.nonlinearity = nonlinearity
        
        # Define model layers
        self.conv1 = GCNConv(ft_size, hid_units)
        if nonlinearity == 'prelu':
            self.nonlin = nn.PReLU()
    
    def forward(self, features, shuf_fts, adj, sparse, pos_weight, neg_weight, mask):
        # First layer convolution
        h = self.conv1(features, adj, sparse=sparse)
        
        if self.nonlinearity == 'prelu':
            h = self.nonlin(h)
        
        # Compute positive and negative scores
        pos_score = torch.sum(h[mask] * shuf_fts[mask], dim=1)
        neg_score = torch.sum(h[~mask] * shuf_fts[~mask], dim=1)
        
        # Compute loss
        loss = -torch.mean(pos_score * pos_weight + neg_score * neg_weight)
        
        return loss, h

class LogReg(nn.Module):
    def __init__(self, ft_size, num_classes):
        super(LogReg, self).__init__()
        self.fc = nn.Linear(ft_size, num_classes)
    
    def forward(self, x):
        return self.fc(x)

# Example usage
if __name__ == "__main__":
    # Dummy data for demonstration
    ft_size = 10
    hid_units = 20
    num_classes = 5
    batch_size = 32
    
    # Create instances of DGI and LogReg
    dgi_model = DGI(ft_size, hid_units)
    logreg_model = LogReg(hid_units, num_classes)
    
    # Dummy input tensors
    features = torch.randn(batch_size, ft_size)
    shuf_fts = torch.randn(batch_size, ft_size)
    adj = torch.eye(batch_size)
    sparse = False
    pos_weight = torch.tensor(1.0)
    neg_weight = torch.tensor(1.0)
    mask = torch.randint(0, 2, (batch_size,), dtype=torch.bool)
    
    # Forward pass through DGI
    loss, embeddings = dgi_model(features, shuf_fts, adj, sparse, pos_weight, neg_weight, mask)
    
    # Forward pass through LogReg
    logits = logreg_model(embeddings)
    predictions = torch.argmax(logits, dim=1)
    
    print(f"Loss: {loss.item()}")
    print(f"Predictions: {predictions}")
```

This code defines the `DGI` and `LogReg` classes as described in the documentation. The `DGI` class includes a forward method that computes the loss based on the mutual information between positive and negative pairs of nodes. The `LogReg` class is a simple logistic regression model for classification tasks. The example usage at the bottom demonstrates how to create instances of these models and perform a forward pass with dummy data.
