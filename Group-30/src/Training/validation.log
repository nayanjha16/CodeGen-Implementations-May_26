    JSON_TYPES = {
        "string": str,
        "number": float,
        "integer": int,
        "boolean": bool,
        "object": dict,
        "array": list,
        "null": type(None)
    }

    def __init__(self, jsonschema):
        self.types = self.JSON_TYPES
        self.schema = {}
        self.parse_schema(jsonschema)

    def parse_schema(self, jsonschema):
        if isinstance(jsonschema, dict):
            self.parse_object_schema(jsonschema)
        elif isinstance(jsonschema, list):
            self.parse_array_schema(jsonschema)
        elif isinstance(jsonschema, str) and jsonschema.startswith("#/"):
            self.parse_reference_schema(jsonschema)
        else:
