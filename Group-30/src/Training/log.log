import matplotlib.pyplot as plt
from brokenaxes import brokenaxes
import numpy as np

# Create a figure object with specified size
fig = plt.figure(figsize=(5, 2))

# Initialize the brokenaxes object with specified x and y limits and horizontal space
bax = brokenaxes(xlims=((0, .1), (.4, .7)), ylims=((-1, .7), (.79, 1)), hspace=.05)

# Generate an array of 100 points between 0 and 1
x = np.linspace(0, 1, 100)

# Plot sine function over the generated x values
bax.plot(x, np.sin(2 * np.pi * x), label='Sine')

# Plot cosine function over the generated x values
bax.plot(x, np.cos(2 * np.pi * x), label='Cosine')

# Add a legend to the plot
bax.legend()

# Display the plot
plt.show()
