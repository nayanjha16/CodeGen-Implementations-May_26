```python
import unittest
from IECore import BasicPreset, Parameterised, BoolParameter, FloatParameter, ClassParameter, CompoundVectorParameter

class TestBasicPreset(unittest.TestCase):
    def testCopy(self):
        # Create a source object with some parameters
        source = Parameterised()
        source.parameters().add(BoolParameter("boolParam", "A boolean parameter", True))
        source.parameters().add(FloatParameter("floatParam", "A float parameter", 3.14))
        
        # Create a destination object
        destination = Parameterised()
        
        # Create a preset and copy parameters from source to destination
        preset = BasicPreset(source)
        preset.apply(destination)
        
        # Verify that the parameters have been copied correctly
        self.assertTrue(destination.parameters()["boolParam"].getTypedValue())
        self.assertEqual(destination.parameters()["floatParam"].getTypedValue(), 3.14)

    def testLoadSave(self):
        # Create a parameterized object with some parameters
        obj = Parameterised()
        obj.parameters().add(BoolParameter("boolParam", "A boolean parameter", False))
        obj.parameters().add(FloatParameter("floatParam", "A float parameter", 0.0))
        
        # Save the preset to a file
        preset = BasicPreset(obj)
        preset.save("test_preset.json")
        
        # Load the preset from the file
        loaded_preset = BasicPreset.load("test_preset.json")
        
        # Apply the loaded preset to a new object
        new_obj = Parameterised()
        loaded_preset.apply(new_obj)
        
        # Verify that the parameters have been loaded correctly
        self.assertFalse(new_obj.parameters()["boolParam"].getTypedValue())
        self.assertEqual(new_obj.parameters()["floatParam"].getTypedValue(), 0.0)
        
        # Clean up the temporary file
        import os
        os.remove("test_preset.json")

    def testClassParameter(self):
        # Create a parameterized object with a class parameter
        obj = Parameterised()
        obj.parameters().add(ClassParameter("classParam", "A class parameter", None))
        
        # Set the value of the class parameter
        obj.parameters()["classParam"].setTypedValue(SomeClass())
        
        # Create a preset and apply it to a new object
        preset = BasicPreset(obj)
        new_obj = Parameterised()
        preset.apply(new_obj)
        
        # Verify that the class parameter has been applied correctly
        self.assertIsInstance(new_obj.parameters()["classParam"].getTypedValue(), SomeClass)

    def testCompoundVectorParameter(self):
        # Create a parameterized object with a compound vector parameter
        obj = Parameterised()
        obj.parameters().add(CompoundVectorParameter("compoundVectorParam", "A compound vector parameter", []))
        
        # Set the value of the compound vector parameter
        obj.parameters()["compoundVectorParam"].setTypedValue([1, 2, 3])
        
        # Create a preset and apply it to a new object
        preset = BasicPreset(obj)
        new_obj = Parameterised()
        preset.apply(new_obj)
        
        # Verify that the compound vector parameter has been applied correctly
        self.assertEqual(new_obj.parameters()["compoundVectorParam"].getTypedValue(), [1, 2, 3])

if __name__ == '__main__':
    unittest.main()
```

In this solution, we've created a test suite for the `IECore.BasicPreset` class using Python's built-in `unittest` framework. The test cases cover copying parameters, loading and saving presets, handling class parameters, and handling compound vector parameters. Each test method demonstrates how the `BasicPreset` class can be used to manage parameters of different types.
