```cpp
#include <iostream>
#include <vector>
#include <string>
#include <memory>

class StartupFlag {
public:
    virtual ~StartupFlag() = default;
    virtual bool NeedsParameter() const = 0;
    virtual bool IsValid(const std::string& arg) const = 0;
};

class UnaryStartupFlag : public StartupFlag {
public:
    bool NeedsParameter() const override { return true; }
    bool IsValid(const std::string& arg) const override {
        // Example implementation: Check if the argument starts with "--"
        return arg.substr(0, 2) == "--";
    }
};

class NullaryStartupFlag : public StartupFlag {
public:
    bool NeedsParameter() const override { return false; }
    bool IsValid(const std::string& arg) const override {
        // Example implementation: Check if the argument starts with "-"
        return arg[0] == '-';
    }
};

class StartupOptions {
private:
    std::vector<std::unique_ptr<StartupFlag>> flags;

public:
    void AddFlag(std::unique_ptr<StartupFlag> flag) {
        flags.push_back(std::move(flag));
    }

    bool ProcessArguments(int argc, char* argv[]) {
        for (int i = 1; i < argc; ++i) {
            const std::string arg = argv[i];
            bool found = false;
            for (const auto& flag : flags) {
                if (flag->IsValid(arg)) {
                    if (flag->NeedsParameter()) {
                        if (i + 1 >= argc) {
                            std::cerr << "Error: Missing parameter for flag " << arg << std::endl;
                            return false;
                        }
                        ++i; // Skip the next argument as it's the parameter
                    }
                    found = true;
                    break;
                }
            }
            if (!found) {
                std::cerr << "Error: Unknown flag " << arg << std::endl;
                return false;
            }
        }
        return true;
    }
};

int main(int argc, char* argv[]) {
    StartupOptions options;
    options.AddFlag(std::make_unique<UnaryStartupFlag>());
    options.AddFlag(std::make_unique<NullaryStartupFlag>());

    if (options.ProcessArguments(argc, argv)) {
        std::cout << "All flags processed successfully." << std::endl;
    } else {
        std::cerr << "Failed to process flags." << std::endl;
        return 1;
    }

    return 0;
}
```

### Explanation:

1. **StartupFlag Class**:
   - This is an abstract base class with pure virtual methods `NeedsParameter` and `IsValid`.

2. **UnaryStartupFlag Class**:
   - Inherits from `StartupFlag` and implements `NeedsParameter` to return `true`, indicating that it requires a parameter.
   - Implements `IsValid` to check if the argument starts with `--`.

3. **NullaryStartupFlag Class**:
   - Inherits from `StartupFlag` and implements `NeedsParameter` to return `false`, indicating that it does not require a parameter.
   - Implements `IsValid` to check if the argument starts with `-`.

4. **StartupOptions Class**:
   - Manages a list of `StartupFlag` objects.
   - Provides methods to add flags and process command-line arguments.
   - Validates each argument against the registered flags and handles parameters accordingly.

5. **main Function**:
   - Creates instances of `StartupOptions` and adds both `UnaryStartupFlag` and `NullaryStartupFlag`.
   - Processes the command-line arguments and prints success or failure messages based on the outcome.
