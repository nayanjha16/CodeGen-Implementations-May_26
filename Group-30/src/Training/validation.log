import numpy as np
import matplotlib.pyplot as plt

def plot_silhouette(X, figure_fp, n_clusters, silhouette_values, cluster_labels, silhouette_avg):
    """
    Plots the silhouette analysis for a given dataset and clustering result.

    Parameters:
        X (np.ndarray): NumPy array of shape (n_samples, n_features) representing the dataset.
        figure_fp (str): String representing the file path where the plot will be saved.
        n_clusters (int): Integer representing the number of clusters.
        silhouette_values (np.ndarray): NumPy array of silhouette scores.
        cluster_labels (np.ndarray): NumPy array of cluster labels.
        silhouette_avg (float): Float representing the average silhouette score.
    """
    # Create a subplot for the silhouette plot
    fig, ax1 = plt.subplots(1, 1)
    
    # The 1st subplot is the silhouette plot
    ax1.set_xlim([-0.1, 1])
    ax1.set_ylim([0, len(X) + 10])
    
    y_lower = 10
    
    for i in range(n_clusters):
        # Aggregate the silhouette scores for samples belonging to
        # cluster i, and sort them
        ith_cluster_silhouette_values = silhouette_values[cluster_labels == i]
        
        ith_cluster_silhouette_values.sort()
        
        size_cluster_i = ith_cluster_silhouette_values.shape[0]
        
        y_upper = y_lower + size_cluster_i
        
        color = plt.cm.Spectral(float(i) / n_clusters)
        ax1.fill_betweenx(np.arange(y_lower, y_upper),
                          0, ith_cluster_silhouette_values,
                          facecolor=color, edgecolor=color, alpha=0.7)
        
        # Label the silhouette plots with their cluster numbers at the middle
        ax1.text(-0.05, y_lower + 0.5 * size_cluster_i, str(i))
        
        y_lower = y_upper + 10  # 10 for the 0 samples
    
    # The vertical line for average silhouette score of all the values
    ax1.axvline(x=silhouette_avg, color="red", linestyle="--")
    
    ax1.set_yticks([])  # Clear the yaxis labels / ticks
    ax1.set_xlabel("Silhouette coefficient values")
    ax1.set_title(f"Silhouette plot for {n_clusters} clusters")
    
    # Create a subplot for the cluster assignments
    ax2 = fig.add_subplot(1, 2, 2)
    colors = plt.cm.Spectral(cluster_labels.astype(float) / n_clusters)
    ax2.scatter(X[:, 0], X[:, 1], marker='.', s=30, lw=0, alpha=0.7, c=colors)
    
    ax2.set_title('Cluster assignment')
    ax2.set_xlabel('Feature 1')
    ax2.set_ylabel('Feature 2')
    
    plt.suptitle(f'Average silhouette score: {silhouette_avg:.2f}', fontsize=15)
    plt.savefig(figure_fp)
    plt.close(fig)

