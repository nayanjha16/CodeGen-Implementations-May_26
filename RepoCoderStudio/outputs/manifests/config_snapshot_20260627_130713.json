{
  "runtime": {
    "run_mode": "demo",
    "use_google_drive": true,
    "auto_resume": true,
    "overwrite_existing": false,
    "random_seed": 42
  },
  "storage": {
    "drive_mount_point": "/content/drive",
    "drive_project_root": "/content/drive/MyDrive/RepoCoderStudio",
    "notebooks_dir": "notebooks",
    "src_dir": "src",
    "configs_dir": "configs",
    "datasets_dir": "datasets",
    "outputs_dir": "outputs",
    "candidate_corpus_dir": "outputs/candidate_corpus",
    "approved_corpus_dir": "outputs/approved_corpus",
    "rejected_corpus_dir": "outputs/rejected_corpus",
    "trusted_tests_dir": "outputs/trusted_tests",
    "task_datasets_dir": "outputs/task_datasets",
    "checkpoints_dir": "outputs/checkpoints",
    "adapters_dir": "outputs/adapters",
    "evaluation_dir": "outputs/evaluation",
    "reports_dir": "outputs/reports",
    "logs_dir": "outputs/logs",
    "manifests_dir": "outputs/manifests"
  },
  "dataset": {
    "use_xlcost": true,
    "use_avatar": false,
    "xlcost_dataset_name": "codeparrot/xlcost-text-to-code",
    "xlcost_python_config": "Python-program-level",
    "xlcost_java_config": "Java-program-level",
    "avatar_local_dir": "datasets/avatar",
    "demo_train_limit": 300,
    "demo_validation_limit": 60,
    "demo_test_limit": 60,
    "full_train_limit": null,
    "full_validation_limit": null,
    "full_test_limit": null,
    "expected_splits": [
      "train",
      "validation",
      "test"
    ]
  },
  "corpus": {
    "corpus_version": "combined_stage_v1.0",
    "enable_deduplication": true,
    "remove_exact_duplicates": true,
    "remove_structural_duplicates": true,
    "min_python_chars": 20,
    "min_java_chars": 20,
    "min_nl_words": 4,
    "save_candidate_corpus": true,
    "save_duplicate_report": true,
    "save_corpus_statistics": true
  },
  "validation": {
    "enable_python_validation": true,
    "enable_java_validation": true,
    "enable_trusted_test_builder": true,
    "enable_execution_validation": true,
    "enable_csr_validation": true,
    "enable_nl_validation": true,
    "allow_execution_not_feasible": true,
    "min_csr_similarity": 0.3,
    "max_repair_attempts_per_component": 3,
    "enable_nl_repair": true,
    "enable_python_repair": false,
    "enable_java_wrapper_repair": true,
    "enable_teacher_repair": false,
    "java_compile_timeout_seconds": 10,
    "python_parse_timeout_seconds": 5,
    "max_execution_tests_per_row": 5
  },
  "models": {
    "student_model_name": "Qwen/Qwen2.5-Coder-0.5B-Instruct",
    "teacher_model_name": "Qwen/Qwen2.5-Coder-0.5B-Instruct",
    "use_4bit": true,
    "use_flash_attention": false,
    "max_seq_length": 1024,
    "max_new_tokens": 384
  },
  "training": {
    "enable_training": true,
    "num_train_epochs_demo": 1.0,
    "num_train_epochs_full": 2.0,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.0002,
    "warmup_ratio": 0.03,
    "weight_decay": 0.0,
    "lora_rank": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "logging_steps": 10,
    "save_steps_demo": 50,
    "save_steps_full": 100,
    "save_total_limit": 3,
    "auto_resume_from_checkpoint": true,
    "final_adapter_name": "RepoCoderStudio_CombinedStage_LoRA_v1_0"
  },
  "evaluation": {
    "enable_evaluation": true,
    "demo_eval_examples_per_task": 10,
    "full_eval_examples_per_task": 100,
    "save_prediction_logs": true,
    "save_metric_rows": true,
    "save_summary_reports": true
  },
  "logging": {
    "log_to_console": true,
    "log_to_file": true,
    "log_level": "INFO",
    "log_filename": "repocoder_combined_stage.log"
  }
}