#include <iostream>
#include <vector>
#include <string>

// Forward declaration for HloComputation
class HloComputation;

// Enum to represent different opcodes
enum class Opcode {
    ADD,
    MULTIPLY,
    DATA_MOVEMENT,
    CONTROL_FLOW,
    // Add other opcodes as needed
};

// Class representing the shape of the output
class Shape {
public:
    Shape(int dimensions) : dimensions_(dimensions) {}
    int getDimensions() const { return dimensions_; }
private:
    int dimensions_;
};

// Class representing an HLO instruction
class HloInstruction {
public:
    HloInstruction(Opcode opcode, Shape shape, std::string name)
        : unique_id_(next_unique_id++), opcode_(opcode), shape_(shape), name_(name) {}

    void addParameter(HloInstruction* parameter) {
        parameters_.push_back(parameter);
    }

    void addControlSuccessor(HloInstruction* successor) {
        control_successors_.push_back(successor);
    }

    void addControlPredecessor(HloInstruction* predecessor) {
        control_predecessors_.push_back(predecessor);
    }

    int getUniqueId() const { return unique_id_; }
    Opcode getOpcode() const { return opcode_; }
    Shape getShape() const { return shape_; }
    std::string getName() const { return name_; }
    const std::vector<HloInstruction*>& getParameters() const { return parameters_; }
    const std::vector<HloInstruction*>& getControlSuccessors() const { return control_successors_; }
    const std::vector<HloInstruction*>& getControlPredecessors() const { return control_predecessors_; }

private:
    static int next_unique_id;
    int unique_id_;
    Opcode opcode_;
    Shape shape_;
    std::string name_;
    std::vector<HloInstruction*> parameters_;
    std::vector<HloInstruction*> control_successors_;
    std::vector<HloInstruction*> control_predecessors_;
};

int HloInstruction::next_unique_id = 0;

// Example usage
int main() {
    Shape input_shape(2);
    HloInstruction add_instruction(Opcode::ADD, input_shape, "add");
    HloInstruction multiply_instruction(Opcode::MULTIPLY, input_shape, "multiply");

    add_instruction.addParameter(&multiply_instruction);

    std::cout << "Instruction ID: " << add_instruction.getUniqueId() << std::endl;
    std::cout << "Opcode: " << static_cast<int>(add_instruction.getOpcode()) << std::endl;
    std::cout << "Name: " << add_instruction.getName() << std::endl;
    std::cout << "Shape Dimensions: " << add_instruction.getShape().getDimensions() << std::endl;

    if (!add_instruction.getParameters().empty()) {
        std::cout << "Parameter Instruction Name: " << add_instruction.getParameters()[0]->getName() << std::endl;
    }

    return 0;
}
```

