```python
import json
import logging
import numpy as np
import torch
from snorkel.data import Dataset, Example, Field, LabelField
from transformers import PreTrainedTokenizer

# Global Variables
TASK_NAME = "WSC"

# Standalone Functions
def get_char_index(text, span_text, span_index):
    """
    Calculates the character indices of a given span within a text.
    
    Args:
        text (str): The original text.
        span_text (str): The span text to find within the original text.
        span_index (int): The index of the span if found exactly.
        
    Returns:
        tuple: A tuple of start and end character indices of the span.
    """
    if span_index != -1:
        return span_index, span_index + len(span_text)
    
    # Fuzzy matching
    start_index = text.find(span_text)
    if start_index == -1:
        raise ValueError(f"Span '{span_text}' not found in text.")
    return start_index, start_index + len(span_text)

def parse(jsonl_path, tokenizer, max_data_samples=None, max_sequence_length=512):
    """
    Reads data from a JSONL file, processes it, and returns a MultitaskDataset object.
    
    Args:
        jsonl_path (str): Path to the JSONL file.
        tokenizer (PreTrainedTokenizer): Tokenizer to use for tokenization.
        max_data_samples (int, optional): Maximum number of samples to load. Defaults to None.
        max_sequence_length (int, optional): Maximum sequence length for tokenized inputs. Defaults to 512.
        
    Returns:
        Dataset: A Snorkel Dataset object with processed data.
    """
    dataset = Dataset()
    
    with open(jsonl_path, 'r') as f:
        for line in f:
            data = json.loads(line)
            if max_data_samples is not None and len(dataset) >= max_data_samples:
                break
            
            sentence = data['sentence']
            target_start = data['target']['start']
            target_end = data['target']['end']
            target_word = data['target']['word']
            
            tokens = tokenizer.tokenize(sentence)
            input_ids = tokenizer.convert_tokens_to_ids(tokens)
            attention_mask = [1] * len(input_ids)
            
            if len(input_ids) > max_sequence_length:
                input_ids = input_ids[:max_sequence_length]
                attention_mask = attention_mask[:max_sequence_length]
            
            char_start, char_end = get_char_index(sentence, target_word, target_start)
            
            example = Example(
                id=len(dataset),
                sentence=sentence,
                input_ids=torch.tensor(input_ids, dtype=torch.long),
                attention_mask=torch.tensor(attention_mask, dtype=torch.long),
                char_start=torch.tensor(char_start, dtype=torch.long),
                char_end=torch.tensor(char_end, dtype=torch.long),
                label=torch.tensor(data['label'], dtype=torch.long)
            )
            
            dataset.add_example(example)
    
    return dataset
```

This code defines the global variable `TASK_NAME`, two standalone functions `get_char_index` and `parse`, and a class structure based on the provided documentation. The `parse` function reads data from a JSONL file, tokenizes sentences using a provided tokenizer, calculates character indices for spans, and converts the data into a format suitable for a machine learning model using Snorkel's `Dataset` and `Example` classes.
