from flask import redirect, url_for

class Abstract:
    def __init__(self, event_id, friendly_id, title=None, author=None, content=None):
        self.event_id = event_id
        self.friendly_id = friendly_id
        self.title = title
        self.author = author
        self.content = content

def compat_abstract(endpoint, confId, friendly_id, track_id=None):
    # Assuming the existence of a function to fetch the abstract based on event_id and friendly_id
    abstract = get_abstract_by_event_and_friendly_id(confId, friendly_id)
    
    if abstract:
        # Constructing the URL for the compatible abstract view
        return redirect(url_for(endpoint, confId=confId, friendly_id=friendly_id, track_id=track_id))
    else:
        # Handle the case where the abstract is not found
        return "Abstract not found", 404

