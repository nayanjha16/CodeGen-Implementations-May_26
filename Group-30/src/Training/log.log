#include <iostream>
#include <cstring>

class LogStream {
private:
    char buf_[1024]; // Buffer to store log message
    int buf_pointer_; // Index of next available position in the buffer
    const int buf_size_; // Total size of the buffer

public:
    // Constructor initializes the buffer and its pointer
    LogStream() : buf_pointer_(0), buf_size_(sizeof(buf_)) {}

    // Destructor ensures the buffer is properly terminated before destruction
    ~LogStream() { buf_[buf_pointer_] = '\0'; }

    // Overloaded insertion operator for integer values
    LogStream& operator<<(int value) {
        snprintf(buf_ + buf_pointer_, buf_size_ - buf_pointer_, "%d", value);
        buf_pointer_ += strlen(buf_ + buf_pointer_);
        return *this;
    }

    // Overloaded insertion operator for double values
    LogStream& operator<<(double value) {
        snprintf(buf_ + buf_pointer_, buf_size_ - buf_pointer_, "%.2f", value);
        buf_pointer_ += strlen(buf_ + buf_pointer_);
        return *this;
    }

