#include <iostream>
#include <string>
#include <thread>
#include <mutex>
#include <condition_variable>
#include <fcntl.h>
#include <sys/ioctl.h>
#include <linux/videodev2.h>

enum class MipiPort {
    Port0,
    Port1
};

enum class MipiMode {
    Mode0,
    Mode1
};

enum class V4L2Format {
    YUYV,
    NV12
};

class v4l2Device {
public:
    v4l2Device(const std::string& devname, int height, int width, int numBuffers, MipiPort mipiPort, MipiMode mipiMode, V4L2Format v4l2Format)
        : m_devname(devname), m_height(height), m_width(width), m_num_buffers(numBuffers), m_MipiPort(mipiPort), m_MipiMode(mipiMode), m_v4l2Format(v4l2Format), m_fd(-1) {}

    ~v4l2Device() {
        closeDevice();
    }

    bool openDevice() {
        m_fd = open(m_devname.c_str(), O_RDWR);
        if (m_fd == -1) {
            std::cerr << "Failed to open device: " << m_devname << std::endl;
            return false;
        }
        return true;
    }

    void closeDevice() {
        if (m_fd != -1) {
            close(m_fd);
            m_fd = -1;
        }
    }

    bool setVideoParameters() {
        struct v4l2_format fmt;
        memset(&fmt, 0, sizeof(fmt));
        fmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        fmt.fmt.pix.width = m_width;
        fmt.fmt.pix.height = m_height;
        fmt.fmt.pix.pixelformat = static_cast<uint32_t>(m_v4l2Format);
        fmt.fmt.pix.field = V4L2_FIELD_NONE;

        if (ioctl(m_fd, VIDIOC_S_FMT, &fmt) == -1) {
            std::cerr << "Failed to set video format" << std::endl;
            return false;
        }
        return true;
    }

    bool allocateBuffers() {
        struct v4l2_requestbuffers req;
        memset(&req, 0, sizeof(req));
        req.count = m_num_buffers;
        req.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        req.memory = V4L2_MEMORY_MMAP;

        if (ioctl(m_fd, VIDIOC_REQBUFS, &req) == -1) {
            std::cerr << "Failed to request buffers" << std::endl;
            return false;
        }

        for (unsigned int i = 0; i < req.count; ++i) {
            struct v4l2_buffer buf;
            memset(&buf, 0, sizeof(buf));
            buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
            buf.memory = V4L2_MEMORY_MMAP;
            buf.index = i;

            if (ioctl(m_fd, VIDIOC_QUERYBUF, &buf) == -1) {
                std::cerr << "Failed to query buffer" << std::endl;
                return false;
            }

            void* addr = mmap(NULL, buf.length, PROT_READ | PROT_WRITE, MAP_SHARED, m_fd, buf.m.offset);
            if (addr == MAP_FAILED) {
                std::cerr << "Failed to map buffer" << std::endl;
                return false;
            }

            // Store buffer information or use as needed
        }

        return true;
    }

    void startPollingThread() {
        m_pollingThread = std::thread(&v4l2Device::pollForFrames, this);
    }

private:
    void pollForFrames() {
        while (true) {
            struct v4l2_buffer buf;
            memset(&buf, 0, sizeof(buf));
            buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
            buf.memory = V4L2_MEMORY_MMAP;

            if (ioctl(m_fd, VIDIOC_DQBUF, &buf) == -1) {
                std::cerr << "Failed to dequeue buffer" << std::endl;
                continue;
            }

            // Process the frame data here
            processFrame(buf);

            if (ioctl(m_fd, VIDIOC_QBUF, &buf) == -1) {
                std::cerr << "Failed to queue buffer" << std::endl;
                continue;
            }
        }
    }

    void processFrame(const struct v4l2_buffer& buf) {
        // Placeholder for frame processing logic
        std::cout << "Processing frame with index: " << buf.index << std::endl;
    }

    std::string m_devname;
    int m_height;
    int m_width;
    int m_num_buffers;
    MipiPort m_MipiPort;
    MipiMode m_MipiMode;
    V4L2Format m_v4l2Format;
    int m_fd;
    std::thread m_pollingThread;
};
```

