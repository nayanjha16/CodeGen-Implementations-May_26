void ParseBinaryBuffer(const std::string& buf,
                       size_t len,
                       std::map<int32_t, OperatorSet>& opset_map) {
  // Parse the binary buffer to get the operator set.
  ::onnx::OperatorSetIdProto operator_set_id;
  if (!operator_set_id.ParseFromArray(buf.c_str(), len)) {
    throw std::runtime_error("Error parsing operator set id.");
