import unittest
from preferences import Profile, DichotomousPreferences
from rules_approval import ApprovalRule
from score_functions import ScoreFunction

class TestApprovalMultiwinner(unittest.TestCase):
    def test_createprofiles(self):
        # Create a Profile object with 3 candidates
        num_candidates = 3
        profile = Profile(num_candidates)
        
        # Add preferences to the profile using DichotomousPreferences
        preferences = DichotomousPreferences()
        preferences.add_preference([True, False, True])
        preferences.add_preference([False, True, False])
        preferences.add_preference([True, True, True])
        
        # Add the preferences to the profile
        profile.add_preferences(preferences)
        
        # Check for exceptions when adding invalid preferences
        with self.assertRaises(ValueError):
            preferences.add_preference([True, True, True, True])
        
        # Verify that the profile has unit weights after adding weighted preferences
        weighted_preferences = DichotomousPreferences()
        weighted_preferences.add_preference([0.5, 0.5, 0.5], weight=2)
        profile.add_preferences(weighted_preferences)
        self.assertEqual(profile.get_weights(), [1, 1, 1])

if __name__ == '__main__':
    unittest.main()
```

