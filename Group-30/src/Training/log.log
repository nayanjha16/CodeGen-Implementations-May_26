import unittest
from bs4 import BeautifulSoup
import requests

class UnitTestsDataMinerYellowPagesLithuania(unittest.TestCase):

    def test_extract_one_email(self):
        # Purpose: Extracts one email address from a single company's page on the Lithuanian Yellow Pages.
        
        url = 'https://www.yellowpages.lt/lt/vilnius/uzduotys'  # Example URL
        response = requests.get(url)
        
        if response.status_code == 200:
            soup = BeautifulSoup(response.content, 'html.parser')
            email_tag = soup.find('a', attrs={'itemprop': 'email'})
            
            if email_tag:
                email_address = email_tag.get_text()
                print(f"Extracted email: {email_address}")
            else:
                print("No email business")
        else:
            print(f"Failed to retrieve the webpage. Status code: {response.status_code}")

if __name__ == '__main__':
    unittest.main()
```

This code defines a unit test class `UnitTestsDataMinerYellowPagesLithuania` that inherits from `unittest.TestCase`. It includes a method `test_extract_one_email` which performs the described task of extracting an email address from a single company's page on the Lithuanian Yellow Pages. The method sends a GET request to the specified URL, parses the HTML content using BeautifulSoup, searches for an `<a>` tag with the attribute `itemprop="email"`, and extracts the email address if found.
