import os
import yaml
from jinja2 import Environment, FileSystemLoader

class JupyterSlides:
    def __init__(self, content_path='./content.yaml', table_contents=False):
        self.module_path = os.path.dirname(os.path.abspath(__file__))
        self.base_template_dir = os.path.join(self.module_path, 'templates')
        self.base_css_dir = os.path.join(self.module_path, 'css')
        self.base_js_dir = os.path.join(self.module_path, 'js')
        self.called_from_path = os.getcwd()
        self.source_path = os.path.join(self.called_from_path, 'src')
        self.template_dir = os.path.join(self.source_path, 'templates')
        self.css_dir = os.path.join(self.source_path, 'css')
        self.js_dir = os.path.join(self.source_path, 'js')
        self.content = self.parse_content(content_path)
        self.table_contents = table_contents
        self.slide_id = 0

    def parse_content(self, content_path):
        with open(content_path, 'r') as file:
            return yaml.safe_load(file)

    def render_template(self, template_name, context):
        env = Environment(loader=FileSystemLoader(self.template_dir))
        template = env.get_template(template_name)
        return template.render(context)

    def generate_slides(self):
        slides_html = []
        for slide in self.content['slides']:
            slide_context = {
                'slide': slide,
                'slide_id': self.slide_id
            }
            if self.table_contents:
                slide_context['table_of_contents'] = self.generate_table_of_contents(slide)
            slide_html = self.render_template('slide.html', slide_context)
            slides_html.append(slide_html)
            self.slide_id += 1
        return '\n'.join(slides_html)

    def generate_table_of_contents(self, slide):
        toc = '<ul>'
        for item in slide['content']:
            toc += f'<li>{item}</li>'
        toc += '</ul>'
        return toc

# Example usage:
if __name__ == "__main__":
    slides = JupyterSlides(table_contents=True)
    html_output = slides.generate_slides()
    print(html_output)
```

