        digits_.clear();
        exponent_.data.clear();
        is_positive_ = true;
    }

    // Method to return a debug-friendly string representation of the decimal
    std::string ToDebugString() const {
        std::string result = "Decimal{";
        if (is_positive_) {
            result += "+";
        } else {
            result += "-";
        }
        for (const auto& digit : digits_) {
            result += std::to_string(digit);
        }
        result += ", exponent=";
        for (const auto& byte : exponent_.data) {
            result += std::to_string(byte);
        }
        result += "}";
        return result;
    }
};

}  // namespace util
}  // namespace yb
