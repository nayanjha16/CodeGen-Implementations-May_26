class FlexLayoutView {
public:
    enum Orientation { kHorizontal, kVertical };
    enum Alignment { kStart, kCenter, kEnd, kStretch };

    FlexLayoutView() : layout_(std::make_unique<FlexLayout>()), orientation_(kHorizontal), 
                      main_axis_alignment_(kStart), cross_axis_alignment_(kStart) {}

    ~FlexLayoutView() = default;

    void SetOrientation(Orientation orientation) {
        if (orientation != orientation_) {
            orientation_ = orientation;
            layout_->SetOrientation(orientation_);
        }
    }

    Orientation GetOrientation() const {
        return orientation_;
    }

    void SetMainAxisAlignment(Alignment alignment) {
        if (alignment != main_axis_alignment_) {
            main_axis_alignment_ = alignment;
            layout_->SetMainAxisAlignment(alignment);
        }
    }

    Alignment GetMainAxisAlignment() const {
        return main_axis_alignment_;
    }

    void SetCrossAxisAlignment(Alignment alignment) {
        if (alignment != cross_axis_alignment_) {
            cross_axis_alignment_ = alignment;
            layout_->SetCrossAxisAlignment(alignment);
        }
    }

    Alignment GetCrossAxisAlignment() const {
        return cross_axis_alignment_;
    }

    void SetInteriorMargin(const gfx::Insets& margin) {
        if (margin != interior_margin_) {
            interior_margin_ = margin;
            layout_->set_interior_margin(margin);
        }
    }

    const gfx::Insets& GetInteriorMargin() const {
        return interior_margin_;
    }

private:
