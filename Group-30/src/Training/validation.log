#include <utils/String8.h>
#include <map>
#include <string>

namespace android {

class AudioParameter {
public:
    // Constructor
    AudioParameter(const android::String8& keyValuePairs);

    // Destructor
    ~AudioParameter();

    // Add a key-value pair
    void add(const std::string& key, const std::string& value);

    // Remove a key-value pair
    void remove(const std::string& key);

    // Retrieve a value by key
    std::string get(const std::string& key) const;

    // Convert the key-value pairs to a string representation
    android::String8 toString() const;

private:
    android::String8 mKeyValuePairs;
    std::map<std::string, std::string> mParameters;
};

// Implementation of constructor
AudioParameter::AudioParameter(const android::String8& keyValuePairs)
    : mKeyValuePairs(keyValuePairs) {
    parseKeyValuePairs();
}

// Implementation of destructor
AudioParameter::~AudioParameter() {
    // Clean up if necessary
}

// Implementation of add method
void AudioParameter::add(const std::string& key, const std::string& value) {
    mParameters[key] = value;
    updateKeyValuePairs();
}

// Implementation of remove method
void AudioParameter::remove(const std::string& key) {
    mParameters.erase(key);
    updateKeyValuePairs();
}

// Implementation of get method
std::string AudioParameter::get(const std::string& key) const {
    auto it = mParameters.find(key);
    if (it != mParameters.end()) {
        return it->second;
    }
    return "";
}

// Implementation of toString method
android::String8 AudioParameter::toString() const {
    return mKeyValuePairs;
}

// Helper method to parse key-value pairs from mKeyValuePairs
void AudioParameter::parseKeyValuePairs() {
    std::string str = mKeyValuePairs.string();
    size_t pos = 0;
    while ((pos = str.find(';')) != std::string::npos) {
        std::string pair = str.substr(0, pos);
        size_t eqPos = pair.find('=');
        if (eqPos != std::string::npos) {
            std::string key = pair.substr(0, eqPos);
            std::string value = pair.substr(eqPos + 1);
            mParameters[key] = value;
        }
        str.erase(0, pos + 1);
    }
    // Handle the last pair if there's no trailing ';'
    if (!str.empty()) {
        size_t eqPos = str.find('=');
        if (eqPos != std::string::npos) {
            std::string key = str.substr(0, eqPos);
            std::string value = str.substr(eqPos + 1);
            mParameters[key] = value;
        }
    }
}

// Helper method to update mKeyValuePairs from mParameters
void AudioParameter::updateKeyValuePairs() {
    mKeyValuePairs.clear();
    for (const auto& pair : mParameters) {
        if (!mKeyValuePairs.isEmpty()) {
            mKeyValuePairs.append(";");
        }
        mKeyValuePairs.append(pair.first).append("=").append(pair.second);
    }
}

}  // namespace android
