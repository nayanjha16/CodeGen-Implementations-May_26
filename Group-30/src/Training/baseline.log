```cpp
#include "ScriptMgr.h"
#include "Creature.h"
#include "InstanceScript.h"

class boss_selin_fireheartAI : public ScriptedAI {
public:
    boss_selin_fireheartAI(Creature* creature) : ScriptedAI(creature), m_pInstance(creature->GetInstanceScript()), m_bIsRegularMode(true) {
        if (m_pInstance) {
            m_pInstance->SetBossState(DATA_SELIN_FIREHEART, IN_PROGRESS);
        }
    }

    void Reset() override {
        _Reset();
        DrainLifeTimer = 10000; // 10 seconds
        DrainManaTimer = 15000; // 15 seconds
        FelExplosionTimer = 20000; // 20 seconds
        DrainCrystalTimer = 25000; // 25 seconds
        EmpowerTimer = 30000; // 30 seconds
        IsDraining = false;
        DrainingCrystal = 0;

        if (m_pInstance) {
            m_pInstance->DoRemoveAurasDueToSpellOnPlayers(SPELL_FEL_EXPLOSION);
        }
    }

    void EnterCombat(Unit* /*who*/) override {
        Talk(YELL_AGGRO);
        DoZoneInCombat(me);

        if (m_pInstance) {
            m_pInstance->SetBossState(DATA_SELIN_FIREHEART, IN_PROGRESS);
        }
    }

    void JustDied(Unit* /*killer*/) override {
        Talk(YELL_DEATH);
        if (m_pInstance) {
            m_pInstance->SetBossState(DATA_SELIN_FIREHEART, DONE);
        }
    }

    void UpdateAI(uint32 diff) override {
        if (!UpdateVictim())
            return;

        if (DrainLifeTimer <= diff) {
            DoCastVictim(SPELL_DRAIN_LIFE);
            DrainLifeTimer = 10000; // Reset timer
        } else {
            DrainLifeTimer -= diff;
        }

        if (DrainManaTimer <= diff) {
            DoCastVictim(SPELL_DRAIN_MANA);
            DrainManaTimer = 15000; // Reset timer
        } else {
            DrainManaTimer -= diff;
        }

        if (FelExplosionTimer <= diff) {
            DoCastAOE(SPELL_FEL_EXPLOSION);
            FelExplosionTimer = 20000; // Reset timer
        } else {
            FelExplosionTimer -= diff;
        }

        if (DrainCrystalTimer <= diff) {
            if (DrainingCrystal == 0) {
                std::vector<uint64> crystals = GetFelCrystals();
                if (!crystals.empty()) {
                    DrainingCrystal = crystals[urand(0, crystals.size() - 1)];
                }
            } else {
                Creature* crystal = Unit::GetCreature(*me, DrainingCrystal);
                if (crystal && crystal->isAlive()) {
                    DoCast(crystal, SPELL_DRAIN_CRYSTAL);
                } else {
                    DrainingCrystal = 0;
                }
            }
            DrainCrystalTimer = 25000; // Reset timer
        } else {
            DrainCrystalTimer -= diff;
        }

        if (EmpowerTimer <= diff) {
            DoCast(me, SPELL_EMPower);
            EmpowerTimer = 30000; // Reset timer
        } else {
            EmpowerTimer -= diff;
        }

        DoMeleeAttackIfReady();
    }

private:
    InstanceScript* m_pInstance;
    bool m_bIsRegularMode;
    uint32 DrainLifeTimer;
    uint32 DrainManaTimer;
    uint32 FelExplosionTimer;
    uint32 DrainCrystalTimer;
    uint32 EmpowerTimer;
    bool IsDraining;
    uint64 DrainingCrystal;

    std::vector<uint64> GetFelCrystals() {
        std::vector<uint64> crystals;
        Trinity::AnyAuraPredicate pred(AuraType::SPELL_AURA_MOD_STOLEN_STATS);
        Trinity::WorldObjectAuraCheck check(pred);
        Trinity::UnitAuraVisitor visitor(check);
        me->VisitNearbyWorldObjects(100.0f, visitor);

        for (auto& aura : visitor.GetAuras()) {
            if (aura->GetCasterGUID() == me->GetGUID()) {
                crystals.push_back(aura->GetTargetGUID());
            }
        }

        return crystals;
    }
};

void AddSC_boss_selin_fireheart() {
    new boss_selin_fireheartAI(npc_selin_fireheart);
}
```

### Notes:
- The `npc_selin_fireheart` should be defined elsewhere in your codebase as the entry ID for Selin Fireheart.
- The spells (`SPELL_DRAIN_LIFE`, `SPELL_DRAIN_MANA`, `SPELL_FEL_EXPLOSION`, `SPELL_DRAIN_CRYSTAL`, `SPELL_EMPower`) need to be defined in your spell database or added to the Mangos engine.
- The `DATA_SELIN_FIREHEART` and `YELL_AGGRO`, `YELL_DEATH` should also be defined appropriately in your instance script or other relevant files.
