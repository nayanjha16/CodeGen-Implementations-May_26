#include <iostream>
#include <string>

namespace ocgen {

class PropInfo {
public:
    // Constructor
    PropInfo(const std::string& name = "", const std::string& ret = "", bool readonly = false, bool writeonly = false)
        : name(name), ret(ret), readonly(readonly), writeonly(writeonly) {}

    // Copy constructor
    PropInfo(const PropInfo& other)
        : name(other.name), ret(other.ret), readonly(other.readonly), writeonly(other.writeonly) {}

    // Destructor
    ~PropInfo() {}

    // Assignment operator
    PropInfo& operator=(const PropInfo& other) {
        if (this != &other) {
            name = other.name;
            ret = other.ret;
            readonly = other.readonly;
            writeonly = other.writeonly;
        }
        return *this;
    }

    // Method to create a deep copy of the current object
    PropInfo* copy() const {
        return new PropInfo(*this);
    }

    // Getter for name
    std::string getName() const {
        return name;
    }

    // Setter for name
    void setName(const std::string& name) {
        this->name = name;
    }

    // Getter for return type
    std::string getRet() const {
        return ret;
    }

    // Setter for return type
    void setRet(const std::string& ret) {
        this->ret = ret;
    }

    // Getter for readonly status
    bool isReadOnly() const {
        return readonly;
    }

    // Setter for readonly status
    void setReadOnly(bool readonly) {
        this->readonly = readonly;
    }

    // Getter for writeonly status
    bool isWriteOnly() const {
        return writeonly;
    }

    // Setter for writeonly status
    void setWriteOnly(bool writeonly) {
        this->writeonly = writeonly;
    }

private:
    std::string name;   // Name of the property
    std::string ret;    // Return type of the property
    bool readonly;     // Indicates if the property is read-only
    bool writeonly;    // Indicates if the property is write-only
};

} // namespace ocgen

int main() {
    ocgen::PropInfo prop("example", "int", true, false);
    ocgen::PropInfo* copiedProp = prop.copy();

    std::cout << "Original Property Name: " << prop.getName() << std::endl;
    std::cout << "Copied Property Name: " << copiedProp->getName() << std::endl;

    delete copiedProp;
    return 0;
}
```

