#include <iostream>
#include <string>
#include <vector>
#include <ctime>

// Forward declarations
class FileDialog;

// Define tString as std::string for simplicity
using tString = std::string;

// Define tSystem namespace with tFileInfo struct
namespace tSystem {
    struct tFileInfo {
        tString name;
        bool isDirectory;
        time_t modTime;
        tString fileType;
        size_t fileSize;
    };
}

// ContentItem class definition
class ContentItem {
public:
    // Fields
    tString Name;
    bool IsDir;
    time_t ModTime;
    tString ModTimeString;
    tString FileType;
    tString FileTypeString;
    size_t FileSize;
    tString FileSizeString;
    bool Selected;

    // Constructor for creating a directory item
    ContentItem(const tString& dirName)
        : Name(dirName), IsDir(true), ModTime(0), ModTimeString(""), FileType("directory"), FileTypeString(""), FileSize(0), FileSizeString(""), Selected(false) {}

    // Constructor for creating a file item
    ContentItem(const tSystem::tFileInfo& fileInfo)
        : Name(fileInfo.name), IsDir(fileInfo.isDirectory), ModTime(fileInfo.modTime), ModTimeString(formatTime(fileInfo.modTime)), FileType(fileInfo.fileType), FileTypeString(formatFileType(fileInfo.fileType)), FileSize(fileInfo.fileSize), FileSizeString(formatFileSize(fileInfo.fileSize)), Selected(false) {}

private:
    // Helper function to format time
    static tString formatTime(time_t modTime) {
        char buffer[80];
        strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", localtime(&modTime));
        return buffer;
    }

    // Helper function to format file type
    static tString formatFileType(const tString& fileType) {
        return fileType;
    }

    // Helper function to format file size
    static tString formatFileSize(size_t fileSize) {
        if (fileSize >= 1024 * 1024 * 1024) {
            return std::to_string(fileSize / (1024 * 1024 * 1024)) + " GB";
        } else if (fileSize >= 1024 * 1024) {
            return std::to_string(fileSize / (1024 * 1024)) + " MB";
        } else if (fileSize >= 1024) {
            return std::to_string(fileSize / 1024) + " KB";
        } else {
            return std::to_string(fileSize) + " B";
        }
    }
};

// FileDialog class definition
class FileDialog {
public:
    // Methods
    void openFile() {
        // Implementation for opening a file
        std::cout << "Opening file..." << std::endl;
    }

    void saveFile() {
        // Implementation for saving a file
        std::cout << "Saving file..." << std::endl;
    }

    void browseDirectories() {
        // Implementation for browsing directories
        std::cout << "Browsing directories..." << std::endl;
    }

    void addBookmark(const tString& bookmark) {
        // Implementation for adding a bookmark
        std::cout << "Adding bookmark: " << bookmark << std::endl;
    }

    void removeBookmark(const tString& bookmark) {
        // Implementation for removing a bookmark
        std::cout << "Removing bookmark: " << bookmark << std::endl;
    }

    void selectItem(ContentItem* item) {
        // Implementation for selecting an item
        if (item) {
            item->Selected = true;
            std::cout << "Selected item: " << item->Name << std::endl;
        }
    }

private:
    // Fields
    std::vector<ContentItem> Items;
    std::vector<tString> Bookmarks;
};

int main() {
    // Example usage
    FileDialog fileDialog;
    tSystem::tFileInfo fileInfo = {"example.txt", false, time(nullptr), "text/plain", 1024};
    ContentItem fileItem(fileInfo);
    fileDialog.selectItem(&fileItem);

    fileDialog.openFile();
    fileDialog.saveFile();
    fileDialog.browseDirectories();
    fileDialog.addBookmark("home");
    fileDialog.removeBookmark("home");

    return 0;
}
```

