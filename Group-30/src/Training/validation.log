class Descriptor {
public:
    static constexpr int kSize = 128;
    std::array<uint8_t, kSize> data;

    // Constructor initializing the descriptor with default values
    Descriptor() {
        data.fill(0);
    }

    // Method to set a value at a specific index
    void setValue(int index, uint8_t value) {
        if (index >= 0 && index < kSize) {
            data[index] = value;
        }
    }

    // Method to get a value at a specific index
    uint8_t getValue(int index) const {
        if (index >= 0 && index < kSize) {
            return data[index];
        }
        return 0;
    }
};

