                pygame.quit()
                sys.exit()

def main():
    pygame.init()
    screen = pygame.display.set_mode((800, 600))
    clock = pygame.time.Clock()
    settings_manager = SettingsManager()

    while True:
        events = pygame.event.get()
        settings_manager.handle_events(events)
        settings_manager.update_settings()
