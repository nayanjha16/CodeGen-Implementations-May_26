```cpp
#include <iostream>
#include <functional>

namespace components {

// Forward declaration of Component
class Component;

// Reference type alias for Component
using Ref = std::shared_ptr<Component>;

// Enumerations
enum class TriggerOn {
    LOW,
    HIGH
};

// Callback type alias
using VoidCallback = std::function<void()>;

// Forward declaration of DigitalInput
class DigitalInput;

// Class representing a tactile button component
class TactileButton {
public:
    // Constructor
    TactileButton(Ref<Component> parent, DigitalInput input, TriggerOn trigger);

    // Method to set the callback for button press event
    void set_on_press(VoidCallback callback);

    // Method to set the callback for button release event
    void set_on_release(VoidCallback callback);

    // Method to update the button state based on digital input
    void update();

private:
    DigitalInput _input;          // Physical button input
    bool _pressed;                // Current state of the button
    VoidCallback _on_press;       // Callback for button press
    VoidCallback _on_release;     // Callback for button release
    TriggerOn _trigger;            // How the button triggers
};

// Implementation of TactileButton constructor
TactileButton::TactileButton(Ref<Component> parent, DigitalInput input, TriggerOn trigger)
    : _input(input), _pressed(false), _on_press(nullptr), _on_release(nullptr), _trigger(trigger) {}

// Implementation of set_on_press method
void TactileButton::set_on_press(VoidCallback callback) {
    _on_press = callback;
}

// Implementation of set_on_release method
void TactileButton::set_on_release(VoidCallback callback) {
    _on_release = callback;
}

// Implementation of update method
void TactileButton::update() {
    bool current_state = _input.read();
    if (_trigger == TriggerOn::LOW) {
        if (!current_state && _pressed) {
            _pressed = false;
            if (_on_release) {
                _on_release();
            }
        } else if (current_state && !_pressed) {
            _pressed = true;
            if (_on_press) {
                _on_press();
            }
        }
    } else if (_trigger == TriggerOn::HIGH) {
        if (current_state && !_pressed) {
            _pressed = true;
            if (_on_press) {
                _on_press();
            }
        } else if (!current_state && _pressed) {
            _pressed = false;
            if (_on_release) {
                _on_release();
            }
        }
    }
}

} // namespace components
```

### Explanation:
1. **Class Definition**: The `TactileButton` class is defined within the `components` namespace.
2. **Fields**: 
   - `_input`: A `DigitalInput` object representing the physical button input.
   - `_pressed`: A boolean indicating whether the button is currently pressed.
   - `_on_press`: A `VoidCallback` function pointer that gets called when the button is pressed.
   - `_on_release`: A `VoidCallback` function pointer that gets called when the button is released.
   - `_trigger`: An enumeration (`TriggerOn`) specifying how the button triggers (either on low or high state).
3. **Constructor**: Initializes the button with the provided parameters.
4. **Methods**:
   - `set_on_press`: Sets the callback for the button press event.
   - `set_on_release`: Sets the callback for the button release event.
   - `update`: Updates the button state based on the digital input and invokes the appropriate callbacks.

