```python
import numpy as np
from sklearn.base import BaseEstimator, ClassifierMixin

class PySVM(BaseEstimator, ClassifierMixin):
    def __init__(self, C=1.0, kernel='linear', max_iter=1000):
        self.C = C
        self.kernel = kernel
        self.max_iter = max_iter
        self.alpha = None
        self.b = None
        self.support_vectors_ = None
        self.support_indices_ = None

    def fit(self, X, y):
        n_samples, n_features = X.shape
        K = self._compute_kernel(X)
        P = np.outer(y, y) * K
        q = -np.ones(n_samples)
        G = np.vstack((np.eye(n_samples), -np.eye(n_samples)))
        h = np.hstack((self.C * np.ones(n_samples), np.zeros(n_samples)))
        A = y.reshape(1, -1).T
        b = 0.0

        alpha, _, _ = self._solve_qp(P, q, G, h, A, b)

        # Find support vectors
        sv_mask = alpha > 1e-5
        self.alpha = alpha[sv_mask]
        self.support_indices_ = np.where(sv_mask)[0]
        self.support_vectors_ = X[sv_mask]
        self.y_support_ = y[sv_mask]

        # Compute intercept
        self.b = np.mean(y_support_ - np.sum(alpha * y_support_ * K[support_indices_, :][:, support_indices_], axis=1))

        return self

    def predict(self, X):
        return np.sign(np.dot(self._compute_kernel(X, self.support_vectors_), self.alpha * self.y_support_) + self.b)

    def decision_function(self, X):
        return np.dot(self._compute_kernel(X, self.support_vectors_), self.alpha * self.y_support_) + self.b

    def _compute_kernel(self, X, Y=None):
        if Y is None:
            Y = X
        if self.kernel == 'linear':
            return np.dot(X, Y.T)
        elif self.kernel == 'poly':
            degree = 3
            return (np.dot(X, Y.T) + 1) ** degree
        elif self.kernel == 'rbf':
            gamma = 1.0 / X.shape[1]
            norm = np.linalg.norm(X[:, np.newaxis] - Y[np.newaxis, :], axis=2)
            return np.exp(-gamma * norm**2)
        else:
            raise ValueError("Unsupported kernel type")

    @staticmethod
    def _solve_qp(P, q, G, h, A, b):
        from scipy.optimize import minimize
        n = P.shape[0]
        bounds = [(0, None)] * n
        res = minimize(lambda x: 0.5 * np.dot(x, np.dot(P, x)) + np.dot(q, x),
                       np.zeros(n),
                       method='SLSQP',
                       bounds=bounds,
                       constraints={'type': 'eq', 'fun': lambda x: np.dot(A, x) - b},
                       options={'maxiter': 1000})
        return res.x, res.success, res.message
