class FullyConnectedLatentVariable:
    def __init__(self, input_size, output_size):
        """
        Initialize a fully connected (dense) layer for managing latent variables.

        Parameters:
        - input_size (int): The number of input features.
        - output_size (int): The number of output features.
        """
        self.input_size = input_size
        self.output_size = output_size
        self.weights = None
        self.bias = None

    def initialize_weights(self, initializer='random'):
        """
        Initialize the weights of the fully connected layer.

        Parameters:
        - initializer (str): The method of initialization ('random', 'zeros', etc.).
        """
        if initializer == 'random':
            import numpy as np
            self.weights = np.random.randn(self.input_size, self.output_size)
            self.bias = np.random.randn(self.output_size)
        elif initializer == 'zeros':
            self.weights = np.zeros((self.input_size, self.output_size))
            self.bias = np.zeros(self.output_size)

    def forward(self, inputs):
        """
        Compute the forward pass through the fully connected layer.

        Parameters:
        - inputs (np.ndarray): The input data.

        Returns:
        - np.ndarray: The output after applying the linear transformation.
        """
        return np.dot(inputs, self.weights) + self.bias


class ConvolutionalLatentVariable:
    def __init__(self, input_shape, kernel_size, num_filters):
        """
        Initialize a convolutional layer for managing latent variables.

        Parameters:
        - input_shape (tuple): The shape of the input tensor (height, width, channels).
        - kernel_size (tuple): The size of the convolutional kernel (height, width).
        - num_filters (int): The number of filters in the convolutional layer.
        """
        self.input_shape = input_shape
        self.kernel_size = kernel_size
        self.num_filters = num_filters
        self.filters = None
        self.biases = None

    def initialize_weights(self, initializer='random'):
        """
        Initialize the weights of the convolutional layer.

        Parameters:
        - initializer (str): The method of initialization ('random', 'zeros', etc.).
        """
        if initializer == 'random':
            import numpy as np
            self.filters = np.random.randn(*self.kernel_size, self.input_shape[-1], self.num_filters)
            self.biases = np.random.randn(self.num_filters)
        elif initializer == 'zeros':
            self.filters = np.zeros((*self.kernel_size, self.input_shape[-1], self.num_filters))
            self.biases = np.zeros(self.num_filters)

    def forward(self, inputs):
        """
        Compute the forward pass through the convolutional layer.

        Parameters:
        - inputs (np.ndarray): The input data.

        Returns:
        - np.ndarray: The output after applying the convolution operation.
        """
        import numpy as np
        batch_size, height, width, channels = inputs.shape
        filter_height, filter_width, _, num_filters = self.filters.shape
        output_height = height - filter_height + 1
        output_width = width - filter_width + 1
        output = np.zeros((batch_size, output_height, output_width, num_filters))

        for b in range(batch_size):
            for f in range(num_filters):
                for i in range(output_height):
                    for j in range(output_width):
                        output[b, i, j, f] = np.sum(
                            inputs[b, i:i+filter_height, j:j+filter_width, :] * self.filters[:, :, :, f]
                        ) + self.biases[f]

        return output
```

This code defines two classes, `FullyConnectedLatentVariable` and `ConvolutionalLatentVariable`, each with methods for initializing weights and performing a forward pass. The `FullyConnectedLatentVariable` class handles dense layers, while the `ConvolutionalLatentVariable` class manages convolutional layers. Both classes use NumPy for numerical operations.
