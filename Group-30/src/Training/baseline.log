```cpp
#include <Wire.h>
#include <Arduino.h>

// Define constants for the OLED display
const uint8_t OLED_WIDTH = 128;
const uint8_t OLED_HEIGHT = 64;

// Define constants for I2C communication
const uint8_t DEFAULT_I2C_ADDRESS = 0x3C;

// Define constants for font dimensions
const uint8_t FONT_WIDTH = 6;
const uint8_t FONT_HEIGHT = 8;

struct Font {
    const uint8_t* data; // Pointer to the font data
    uint8_t width;      // Width of each character in pixels
    uint8_t height;     // Height of each character in pixels
};

struct Cursor {
    uint8_t x;          // X-coordinate of the cursor
    uint8_t y;          // Y-coordinate of the cursor
};

class OLED12864 {
private:
    uint8_t _i2cAddress;       // I2C address of the OLED display
    bool _directDraw;          // Flag indicating whether direct drawing mode is enabled
    bool _enableBuffer;        // Flag indicating whether buffering is enabled
    uint8_t _buffer[OLED_WIDTH * OLED_HEIGHT / 8]; // Buffer used for storing display data when buffering is enabled
    bool _inverseMode;         // Flag indicating whether inverse mode is enabled
    Font _font;                // Structure containing font-related information
    Cursor _cursor;            // Structure representing the current cursor position on the display
    unsigned long _scrollDelay; // Delay between scroll steps

public:
    // Constructor
    OLED12864(uint8_t i2cAddress = DEFAULT_I2C_ADDRESS) : 
        _i2cAddress(i2cAddress), 
        _directDraw(false), 
        _enableBuffer(true), 
        _inverseMode(false), 
        _font{nullptr, FONT_WIDTH, FONT_HEIGHT}, 
        _cursor{0, 0}, 
        _scrollDelay(100) {}

    // Initialize the OLED display
    void init() {
        Wire.begin();
        clearDisplay();
        setCursor(0, 0);
    }

    // Clear the display
    void clearDisplay() {
        memset(_buffer, 0, sizeof(_buffer));
        if (!_directDraw) {
            updateDisplay();
        }
    }

    // Update the display with the contents of the buffer
    void updateDisplay() {
        Wire.beginTransmission(_i2cAddress);
        Wire.write(0x00); // Command mode
        Wire.endTransmission();

        Wire.beginTransmission(_i2cAddress);
        Wire.write(0x10 | (_cursor.x >> 3)); // Set column start address
        Wire.write(_cursor.y);               // Set page start address
        Wire.endTransmission();

        Wire.beginTransmission(_i2cAddress);
        Wire.write((uint8_t*)_buffer, sizeof(_buffer));
        Wire.endTransmission();
    }

    // Set the cursor position
    void setCursor(uint8_t x, uint8_t y) {
        _cursor.x = x % OLED_WIDTH;
        _cursor.y = y % OLED_HEIGHT;
    }

    // Print a string at the current cursor position
    void print(const char* str) {
        while (*str) {
            drawChar(_cursor.x, _cursor.y, *str, _inverseMode);
            str++;
            _cursor.x += _font.width;
            if (_cursor.x >= OLED_WIDTH) {
                _cursor.x = 0;
                _cursor.y += _font.height;
                if (_cursor.y >= OLED_HEIGHT) {
                    clearDisplay();
                    _cursor.y = 0;
                }
            }
        }
    }

    // Draw a single character at the specified position
    void drawChar(uint8_t x, uint8_t y, char ch, bool inverse) {
        uint8_t glyph = pgm_read_byte(&ch - ' ');
        for (int i = 0; i < _font.height; i++) {
            uint8_t line = pgm_read_byte(&glyph + i);
            if (inverse) {
                line = ~line;
            }
            for (int j = 0; j < _font.width; j++) {
                if (line & (1 << (7 - j))) {
                    setPixel(x + j, y + i, true);
                } else {
                    setPixel(x + j, y + i, false);
                }
            }
        }
    }

    // Set a pixel at the specified position
    void setPixel(uint8_t x, uint8_t y, bool value) {
        if (x >= OLED_WIDTH || y >= OLED_HEIGHT) return;
        uint8_t index = y / 8;
        uint8_t bit = 1 << (y % 8);
        if (value) {
            _buffer[index * OLED_WIDTH + x] |= bit;
        } else {
            _buffer[index * OLED_WIDTH + x] &= ~bit;
        }
        if (!_directDraw) {
            updateDisplay();
        }
    }

    // Enable or disable direct drawing mode
    void setDirectDraw(bool enable) {
        _directDraw = enable;
    }

    // Enable or disable buffering
    void setEnableBuffer(bool enable) {
        _enableBuffer = enable;
    }

    // Set the inverse mode
    void setInverseMode(bool enable) {
        _inverseMode = enable;
    }

    // Set the font
    voidsetFont(const Font& font) {
        _font = font;
    }

    // Scroll the display content
    void scrollDisplay(int lines) {
        for (int i = 0; i < OLED_HEIGHT - lines * _font.height; i++) {
            memcpy(_buffer + i * OLED_WIDTH / 8, _buffer + (i + lines * _font.height) * OLED_WIDTH / 8, OLED_WIDTH / 8);
        }
        memset(_buffer + (OLED_HEIGHT - lines * _font.height) * OLED_WIDTH / 8, 0, lines * _font.height * OLED_WIDTH / 8);
        updateDisplay();
    }

    // Set the scroll delay
    void setScrollDelay(unsigned long delay) {
        _scrollDelay = delay;
    }
};
```

This code defines the `OLED12864` class, which encapsulates the functionality required to interact with an OLED display using I2C communication. The class provides methods for initializing the display, clearing the display, updating the display, setting the cursor position, printing strings, drawing characters, setting pixels, enabling/disabling direct drawing mode, enabling/disabling buffering, setting inverse mode, setting the font, scrolling the display content, and setting the scroll delay.
