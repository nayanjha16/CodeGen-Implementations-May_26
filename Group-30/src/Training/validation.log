```cpp
#include <iostream>
#include <memory>
#include <string>
#include <thread>
#include <mutex>
#include <condition_variable>
#include <queue>

// Forward declarations
class Port;
class UdpClientPort;
class TcpClientPort;
class SerialPort;

enum class ConnectionType {
    UDP,
    TCP,
    SERIAL
};

struct mavlink_status_t {
    // Define the structure members as needed
};

class AdHocConnection {
public:
    virtual ~AdHocConnection() = default;
    virtual void connect(ConnectionType type, const std::string& address, int port) = 0;
    virtual void listen() = 0;
    virtual void sendMessage(const std::string& message) = 0;
    virtual void subscribe(std::function<void(const std::string&)> callback) = 0;
};

class AdHocConnectionImpl : public AdHocConnection {
private:
    bool closed;
    std::string name;
    mavlink_status_t mavlink_intermediate_status_;
    mavlink_status_t mavlink_status_;
    std::shared_ptr<AdHocConnection> con_;
    std::shared_ptr<Port> port;
    std::thread reader_thread;
    std::mutex queue_mutex;
    std::condition_variable cv;
    std::queue<std::string> packet_queue;
    std::vector<std::function<void(const std::string&)>> subscribers;

public:
    AdHocConnectionImpl(const std::string& name)
        : closed(false), name(name), con_(nullptr), port(nullptr) {}

    ~AdHocConnectionImpl() {
        close();
    }

    void connect(ConnectionType type, const std::string& address, int port) override {
        switch (type) {
            case ConnectionType::UDP:
                port = std::make_shared<UdpClientPort>(address, port);
                break;
            case ConnectionType::TCP:
                port = std::make_shared<TcpClientPort>(address, port);
                break;
            case ConnectionType::SERIAL:
                port = std::make_shared<SerialPort>(address, port);
                break;
        }
        if (port) {
            con_->setPort(port);
        }
    }

    void listen() override {
        reader_thread = std::thread(&AdHocConnectionImpl::readPackets, this);
    }

    void sendMessage(const std::string& message) override {
        if (!closed && port) {
            port->send(message);
        }
    }

    void subscribe(std::function<void(const std::string&)> callback) override {
        std::lock_guard<std::mutex> lock(queue_mutex);
        subscribers.push_back(callback);
    }

    void close() {
        closed = true;
        if (reader_thread.joinable()) {
            reader_thread.join();
        }
        if (port) {
            port->close();
        }
    }

private:
    void readPackets() {
        while (!closed) {
            std::string packet;
            if (port && port->receive(packet)) {
                {
                    std::lock_guard<std::mutex> lock(queue_mutex);
                    packet_queue.push(packet);
                }
                cv.notify_all();
            }
        }
    }

    void publishPacket(const std::string& packet) {
        std::lock_guard<std::mutex> lock(queue_mutex);
        for (auto& subscriber : subscribers) {
            subscriber(packet);
        }
    }
};
```

This code defines the `AdHocConnectionImpl` class, which inherits from `AdHocConnection`. It includes methods to connect to different types of ports, start listening, send messages, and manage subscriptions. The class uses multithreading to handle reading and publishing of packets asynchronously. The `Port`, `UdpClientPort`, `TcpClientPort`, and `SerialPort` classes are forward-declared, and you would need to implement them based on your specific requirements.
