# Copy to .env and adjust as needed:
#   cp .env.example .env

# HuggingFace model identifier (required)
MODEL_NAME=Salesforce/codegen-350M-multi
# MODEL_NAME=google-t5/t5-base
# MODEL_NAME=bigcode/starcoder2-3b

# LLM backend for semantic judge (and optional chat codegen): ollama | huggingface
# Default ollama preserves existing behavior when unset.
LLM_PROVIDER=ollama

# Local Ollama judge for semantic validation in detail CSVs and metrics
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_JUDGE_MODEL=qwen3:4b
OLLAMA_CODEGEN_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=120

# Hugging Face fallback when LLM_PROVIDER=huggingface (models are configurable)
HF_JUDGE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
HF_CODEGEN_MODEL=Qwen/Qwen2.5-Coder-0.5B-Instruct

# BERTScore evaluation model (required for metrics that use BERTScore)
BERTSCORE_MODEL_NAME=distilbert-base-uncased

# Optional: load a fine-tuned checkpoint from models/checkpoints/ instead of base model
# MODEL_CHECKPOINT=my-run-epoch-3

# Optional: load a LoRA adapter for a specific task (adapter dir under models/checkpoints/)
# MODEL_ADAPTER=text2sql
# MODEL_ADAPTER=sql2nosql
# MODEL_ADAPTER=nosql2doc
#
# Adapter layout (all fine-tuned weights saved here, base model stays in models/base/):
#   models/checkpoints/text2sql/    adapter_config.json + adapter_model.safetensors
#   models/checkpoints/sql2nosql/
#   models/checkpoints/nosql2doc/

# Local storage paths (relative to project root)
MODELS_BASE_DIR=models/base
MODELS_CHECKPOINTS_DIR=models/checkpoints
RESULTS_DIR=results

# TEND silver dataset on Hugging Face (training + evaluation)
TEND_DATASET_ID=care2achieve/tend
# Local JSONL cache (relative to project root); omit to use ~/.cache/codegen/tend
TEND_CACHE_DIR=data/cache/tend

# Frozen Spider gold validation set for baseline evaluation (50 examples)
SPIDER_GOLD_VALIDATION_PATH=data/spider_gold_validation.jsonl
