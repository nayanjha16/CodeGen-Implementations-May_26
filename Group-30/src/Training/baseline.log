import time
from trackball import TrackBall

class MouseSimulator:
    def __init__(self, trackball: TrackBall):
        self.trackball = trackball
        self.last_position = (0, 0)

    def update_mouse_position(self):
        button_state = self.trackball.read()
        dx, dy = 0, 0

        if button_state[0]:  # Up button
            dy -= 1
        if button_state[1]:  # Down button
            dy += 1
        if button_state[2]:  # Left button
            dx -= 1
        if button_state[3]:  # Right button
            dx += 1

        new_position = (self.last_position[0] + dx, self.last_position[1] + dy)
        self.move_mouse(new_position)
        self.last_position = new_position

    def move_mouse(self, position):
        x, y = position
        print(f"Moving mouse to ({x}, {y})")
        # Simulate mouse movement using xte command
        # os.system(f'xdotool mousemove_relative {dx} {dy}')

    def run(self):
        try:
            while True:
                self.update_mouse_position()
                time.sleep(0.1)
        except KeyboardInterrupt:
            print("Exiting program")

if __name__ == "__main__":
    trackball = TrackBall(interrupt_pin=18)  # Assuming interrupt pin is 18
    simulator = MouseSimulator(trackball)
    simulator.run()
```

