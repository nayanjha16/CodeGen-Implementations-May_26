#include <iostream>
#include <vector>
#include <cmath>
#include "catch.hpp"
#include "perceive/geometry/vector3.hpp"
#include "perceive/geometry/quaternion.hpp"

class EuclideanTransform {
public:
    Vector3 translation;
    Quaternion rotation;
    double scale;

    // Apply the transformation to a point X
    Vector3 apply(const Vector3& X) const {
        return rotation * (X * scale) + translation;
    }

    // Return the 4x4 transformation matrix
    Matrix4 make_transform_matrix() const {
        Matrix4 mat = Matrix4::identity();
        mat.block<3, 3>(0, 0) = rotation.to_rotation_matrix();
        mat.row(3).colwise() << translation, 1.0;
        mat.col(3).tail<3>() *= scale;
        return mat;
    }

    // Compose this transformation with another
    EuclideanTransform compose(const EuclideanTransform& other) const {
        EuclideanTransform result;
        result.translation = rotation * (other.translation * scale) + translation;
        result.rotation = rotation * other.rotation;
        result.scale = scale * other.scale;
        return result;
    }

    // Return the inverse transformation
    EuclideanTransform inverse() const {
        EuclideanTransform inv;
        inv.translation = -(rotation.inverse() * (translation / scale));
        inv.rotation = rotation.inverse();
        inv.scale = 1.0 / scale;
        return inv;
    }

    // Unpack the transformation parameters from an array
    void unpack(double* data) {
        translation.x = data[0];
        translation.y = data[1];
        translation.z = data[2];
        rotation.w = data[3];
        rotation.x = data[4];
        rotation.y = data[5];
        rotation.z = data[6];
        scale = data[7];
    }

    // Pack the transformation parameters into an array
    void pack(double* data) const {
        data[0] = translation.x;
        data[1] = translation.y;
        data[2] = translation.z;
        data[3] = rotation.w;
        data[4] = rotation.x;
        data[5] = rotation.y;
        data[6] = rotation.z;
        data[7] = scale;
    }
};

struct BinocularCameraInfo {
    // Placeholder for actual implementation
    std::string name;
    int width;
    int height;
    double focal_length;
    Vector3 principal_point;
    Vector3 skew;
    Matrix3 intrinsic_matrix;
    Matrix3 extrinsic_matrix;
};

TEST_CASE("Euclidean Transform Tests", "[euclidean]") {
    EuclideanTransform T1;
    T1.translation = {1.0, 2.0, 3.0};
    T1.rotation = Quaternion::from_euler_angles(0.1, 0.2, 0.3);
    T1.scale = 2.0;

    Vector3 p = {4.0, 5.0, 6.0};
    Vector3 transformed_p = T1.apply(p);

    REQUIRE(transformed_p.x == Approx(8.9466));
    REQUIRE(transformed_p.y == Approx(10.0877));
    REQUIRE(transformed_p.z == Approx(11.2288));

    EuclideanTransform T2 = T1.compose(T1);
    Vector3 transformed_p_composed = T2.apply(p);

    REQUIRE(transformed_p_composed.x == Approx(17.8932));
    REQUIRE(transformed_p_composed.y == Approx(20.1754));
    REQUIRE(transformed_p_composed.z == Approx(22.4476));

    EuclideanTransform T_inv = T1.inverse();
    Vector3 transformed_p_inv = T_inv.apply(transformed_p);

    REQUIRE(transformed_p_inv.x == Approx(p.x));
    REQUIRE(transformed_p_inv.y == Approx(p.y));
    REQUIRE(transformed_p_inv.z == Approx(p.z));
}

TEST_CASE("Binocular Camera Info Tests", "[binocular_camera]") {
    BinocularCameraInfo cam_info;
    cam_info.name = "TestCamera";
    cam_info.width = 1920;
    cam_info.height = 1080;
    cam_info.focal_length = 500.0;
    cam_info.principal_point = {cam_info.width / 2.0, cam_info.height / 2.0, 0.0};
    cam_info.skew = {0.0};
    cam_info.intrinsic_matrix = Matrix3::Identity() * cam_info.focal_length;
    cam_info.extrinsic_matrix = Matrix3::Identity();

    REQUIRE(cam_info.name == "TestCamera");
    REQUIRE(cam_info.width == 1920);
    REQUIRE(cam_info.height == 1080);
    REQUIRE(cam_info.focal_length == 500.0);
    REQUIRE(cam_info.principal_point.x == 960.0);
    REQUIRE(cam_info.principal_point.y == 540.0);
    REQUIRE(cam_info.skew.x == 0.0);
}
```

