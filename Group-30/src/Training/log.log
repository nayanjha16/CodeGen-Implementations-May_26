```python
import webapp2
from actingweb import ActingWeb
from config import Config
from trust import TrustManager
from auth import Auth

class rootHandler(webapp2.RequestHandler):
    def get(self, id=None):
        # Parse query parameters
        relationship = self.request.get('relationship')
        type = self.request.get('type')
        peerid = self.request.get('peerid')

        # Retrieve trust relationships
        trust_manager = TrustManager()
        relationships = trust_manager.get_trust_relationships(relationship, type, peerid)

        # Return JSON response
        self.response.headers['Content-Type'] = 'application/json'
        self.response.out.write(json.dumps(relationships))

    def post(self, id=None):
        # Expect JSON body containing details of the trust relationship
        data = json.loads(self.request.body)
        trust_details = {
            'subject': data.get('subject'),
            'object': data.get('object'),
            'type': data.get('type'),
            'details': data.get('details')
        }

        # Create reciprocal trust relationship
        trust_manager = TrustManager()
        trust_manager.create_reciprocal_trust(trust_details)

        # Return success response
        self.response.status = 201
        self.response.out.write(json.dumps({'message': 'Trust relationship created successfully'}))

class relationshipHandler(webapp2.RequestHandler):
    def get(self, id):
        # Retrieve specific trust relationship
        trust_manager = TrustManager()
        relationship = trust_manager.get_trust_relationship(id)

        # Return JSON response
        self.response.headers['Content-Type'] = 'application/json'
        self.response.out.write(json.dumps(relationship))

    def put(self, id):
        # Update specific trust relationship
        data = json.loads(self.request.body)
        updated_details = {
            'type': data.get('type', None),
            'details': data.get('details', None)
        }

        # Update trust relationship
        trust_manager = TrustManager()
        trust_manager.update_trust_relationship(id, updated_details)

        # Return success response
        self.response.status = 200
        self.response.out.write(json.dumps({'message': 'Trust relationship updated successfully'}))

    def delete(self, id):
        # Delete specific trust relationship
        trust_manager = TrustManager()
        trust_manager.delete_trust_relationship(id)

        # Return success response
        self.response.status = 204
        self.response.out.write(json.dumps({'message': 'Trust relationship deleted successfully'}))

# Define routes
app = webapp2.WSGIApplication([
    ('/trust', rootHandler),
    ('/trust/(.*)', relationshipHandler)
], debug=True)
```

This code defines two handlers, `rootHandler` and `relationshipHandler`, which handle GET, POST, PUT, and DELETE requests for managing trust relationships in a distributed system. The `rootHandler` handles requests to the `/trust` endpoint, while the `relationshipHandler` handles requests to the `/trust/<relationship>` endpoint. The `TrustManager` class is used to interact with the trust management logic, and the `Auth` class is used for authentication checks. The `Config` class is used to manage configuration settings.
