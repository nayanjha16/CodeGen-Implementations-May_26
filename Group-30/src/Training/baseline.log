import h5py
import numpy as np

class McD43C:
    def __init__(self, path, lon, lat, verb=1):
        self.verb = verb
        self.SDS = {
            'BRDF': 'BRDF',
            'Albedo': 'Albedo',
            # Add more SDS names as needed
        }
        self.Files = []
        self.nobs = len(lon)
        self.dx = np.zeros(self.nobs, dtype=int)
        self.dy = np.zeros(self.nobs, dtype=int)

        self.read_files(path, lon, lat)

    def read_files(self, path, lon, lat):
        for i in range(self.nobs):
            file_path = f"{path}/MODIS_{lon[i]}_{lat[i]}.hdf"
            self.Files.append(file_path)
            with h5py.File(file_path, 'r') as hdf_file:
                brdf_data = hdf_file[self.SDS['BRDF']][:]
                albedo_data = hdf_file[self.SDS['Albedo']][:]

                # Assuming lon and lat are within the valid range of the grid
                x_index = int((lon[i] + 180) / 0.05)
                y_index = int((90 - lat[i]) / 0.05)

                self.dx[i] = x_index
                self.dy[i] = y_index

                if self.verb > 0:
                    print(f"Read data for {file_path} at ({x_index}, {y_index})")

# Example usage:
if __name__ == "__main__":
    path = "path/to/modis/files"
    lon = [10, 20, 30]
    lat = [40, 50, 60]
    mc_d43c = McD43C(path, lon, lat, verb=1)
```

