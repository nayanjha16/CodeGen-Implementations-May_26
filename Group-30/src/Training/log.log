import nonebot
from nonebot import CommandSession
from nonebot.command import on_command
from nonebot.adapters import Message
from nonebot.params import ArgText
from baidu_translate import Translator

# Initialize the translator
translator = Translator()

# Define the command handler
translate_cmd = on_command("translate")

@translate_cmd.handle()
async def handle_first_receive(session: CommandSession):
    # Check if this is the first run
    session.state['is_first_run'] = True
    await session.pause("Please provide the text you want to translate.")

@translate_cmd.got('text', prompt="Please provide the text you want to translate.")
async def handle_text_received(session: CommandSession):
    text_to_translate = session.get('text')
    
    # Ask for source language if not already provided
    if 'source_lang' not in session.state:
        session.state['source_lang'] = await session.pause("Please specify the source language (e.g., en for English).")
    
    # Ask for target language if not already provided
    if 'target_lang' not in session.state:
        session.state['target_lang'] = await session.pause("Please specify the target language (e.g., zh for Chinese).")
    
    # Perform the translation
    translated_text = translator.translate(text_to_translate, src=session.state['source_lang'], tgt=session.state['target_lang'])
    
    # Send the translated text
    await session.finish(f"Translated Text: {translated_text}")

# Example usage of the CommandSession class
class ExampleCommandSession(CommandSession):
    state = {}
    current_arg_text = ""
    is_first_run = False
    
    async def get(self, field, prompt):
        if field not in self.state:
            self.state[field] = await self.pause(prompt)
        return self.state[field]
    
    async def pause(self, message):
        print(message)
    
    async def finish(self, message):
        print(message)

# Example usage of the ArgumentParser class
class ExampleArgumentParser:
    @staticmethod
    async def parse_args(args):
        parser = {
            "text": args[0],
            "source_lang": args[1],
            "target_lang": args[2]
        }
        return parser

# Example usage
if __name__ == "__main__":
    example_session = ExampleCommandSession()
    example_parser = ExampleArgumentParser()
    
    # Simulate user input
    user_input = ["Hello, world!", "en", "zh"]
    parsed_args = await example_parser.parse_args(user_input)
    
    # Set session state
    example_session.state = parsed_args
    
    # Handle the session
    await handle_text_received(example_session)
```

This code includes the `CommandSession` and `ArgumentParser` classes as described, along with an example usage of these classes. The `translate_cmd` function handles the translation logic using the Baidu Translation API. The `ExampleCommandSession` and `ExampleArgumentParser` classes demonstrate how these classes can be used in practice.
