    void processFile() {
        // Read file content into waitingForChunkingBuffer
        readFromFile(fileRecipe.filePath, waitingForChunkingBuffer);

        // Process chunks
        while (!waitingForChunkingBuffer.empty()) {
            auto chunk = extractChunk(waitingForChunkingBuffer);
            if (!chunk.empty()) {
                processChunk(chunk);
            } else {
                break;
            }
        }
    }

    void finalizeChunking() {
        // Finalize chunking process
        keyClientObj->submitJob("Finalizing chunking");
    }

private:
    void initializeLookups() {
        // Initialize powerLUT and removeLUT
        // This is a placeholder implementation
        powerLUT.resize(256);
        removeLUT.resize(256);
        for (size_t i = 0; i < 256; ++i) {
