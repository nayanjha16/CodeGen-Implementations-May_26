```cpp
#include "llvm/IR/Function.h"
#include "llvm/IR/Metadata.h"
#include "llvm/Pass.h"
#include <vector>
#include <algorithm>

namespace llvm {

class RSIsThreadablePass : public ModulePass {
public:
    static char ID;
    RSIsThreadablePass();

    bool runOnModule(Module &M) override;

private:
    std::vector<std::string> nonThreadableFns;

    void initializeNonThreadableFunctions();
};

char RSIsThreadablePass::ID = 0;

RSIsThreadablePass::RSIsThreadablePass() : ModulePass(ID) {
    initializeNonThreadableFunctions();
}

void RSIsThreadablePass::initializeNonThreadableFunctions() {
    nonThreadableFns = {"function1", "function2", "function3"}; // Replace with actual non-threadable function names
    std::sort(nonThreadableFns.begin(), nonThreadableFns.end());
}

bool RSIsThreadablePass::runOnModule(Module &M) {
    bool hasNonThreadableFn = false;

    for (auto &F : M.getFunctionList()) {
        if (std::binary_search(nonThreadableFns.begin(), nonThreadableFns.end(), F.getName().str())) {
            hasNonThreadableFn = true;
            break;
        }
    }

    if (hasNonThreadableFn) {
        MDNode *MD = MDNode::get(M.getContext(), ConstantAsMetadata::get(IntegerType::get(M.getContext(), 1), 0));
        M.setModuleFlag("rs_is_threadable", MD);
    }

    return hasNonThreadableFn;
}

} // namespace llvm

