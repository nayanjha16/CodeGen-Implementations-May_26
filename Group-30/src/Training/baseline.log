from datetime import datetime
from wyzeapy import Client, Device

class WyzeCameraMotion:
    def __init__(self, wyzeapi_client: Client, device: Device):
        self._client = wyzeapi_client
        self._device = device
        self._last_event = None
        self._on = False
        self._available = True

    @property
    def last_event(self) -> datetime:
        return self._last_event

    @property
    def on(self) -> bool:
        return self._on

    @property
    def available(self) -> bool:
        return self._available

    def update_status(self):
        # Simulate fetching status from the WyzeCam device
        current_time = datetime.now()
        if self._client.is_motion_detected(self._device.device_id):
            if not self._on:
                self._on = True
                self._last_event = current_time
        else:
            self._on = False

    def check_connectivity(self):
        # Simulate checking connectivity of the WyzeCam device
        self._available = self._client.is_device_connected(self._device.device_id)
```
