    std::shared_ptr<clan::Button> button3;
    std::shared_ptr<clan::Button> button4;

    void setupUI();
    void handleButtonClick(clan::Control* control);
};

App::App() {
    clan::SetupCore core;
    clan::SetupDisplay display;

    window = std::make_shared<clan::TopLevelWindow>("Simple GUI", clan::Size(800, 600));
    pRootView = std::make_shared<clan::View>(window->get_content());
    setupUI();

    window->sig_close().connect([this]() { clan::Application::quit(); });
    window->sig_key_down().connect(this, &App::handleButtonClick);

    window->show();
}

void App::run() {
    clan::Application::exec();
}

