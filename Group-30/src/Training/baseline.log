class WorkGround {
public:
    static void serialize(const WorkGround& obj, std::string& output);
    static void deserialize(std::stringstream& input, WorkGround*& output);
};

// Function Prototypes
void connectToService();
void disconnectFromService();
void sendOperation(Operation op, const std::string& data = "");
std::string receiveResponse();

