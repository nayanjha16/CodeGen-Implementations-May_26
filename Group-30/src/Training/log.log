const int &lvalue_noop_cast() {
    if (i == 0) {
        static const int value = 17;
        return value;
    } else if (i == 1) {
        static const int value = 17;
        return static_cast<const int&>(value);
    } else {
        static const int value = 17;
        return value;
    }
}

