    SurfaceFlux(MeshLib::Mesh const& boundary_mesh,
                 int bulk_property_number_of_components,
                 unsigned integration_order);

private:
    std::vector<std::unique_ptr<SurfaceFluxLocalAssembler>> _local_assemblers;
};

// Implementation of the constructor
SurfaceFlux::SurfaceFlux(MeshLib::Mesh const& boundary_mesh,
                          int bulk_property_number_of_components,
                          unsigned integration_order)
    : _local_assemblers(boundary_mesh.getNumberOfElements()) {
    // Create local assemblers for each element in the boundary mesh
    for (std::size_t i = 0; i < boundary_mesh.getNumberOfElements(); ++i) {
        _local_assemblers[i] = std::make_unique<SurfaceFluxLocalAssembler>(
            boundary_mesh.getElement(i), bulk_property_number_of_components, integration_order);
    }
}

}  // namespace ProcessLib
