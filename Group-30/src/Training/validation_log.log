using namespace mds;

namespace {

class ServerTest : public ::testing::Test {
public:
    ServerTest() : dbname_("test_mds") {}

    virtual void SetUp() {
        ASSERT_TRUE(mds_env_.CreateIfMissing(dbname_, true).ok());
        ASSERT_OK(mds_env_.NewWritableFile(dbname_ + "/MANIFEST-000001", &file_));
        ASSERT_OK(file_->Append("dummy"));

        ASSERT_OK(mdb_->Open(&mds_));
        ASSERT_OK(mds_->LoadMetadata());
        mdb_ = nullptr;
    }

    virtual void TearDown() {
        if (file_) delete file_;
        mds_env_.DeleteDir(dbname_);
    }

protected:
