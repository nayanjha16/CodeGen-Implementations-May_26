```python
import string

class Simplimental:
    def __init__(self, text="This is not a bad idea"):
        self.text = text.lower()
        self.dictionary = {
            'good': 1,
            'great': 2,
            'bad': -1,
            'terrible': -2,
            # Add more words and scores as needed
        }
        self.tokens = self._tokenize(text)

    def _tokenize(self, text):
        tokens = text.split()
        tokens = [word.strip(string.punctuation) for word in tokens]
        return tokens

    def calculate_sentiment_scores(self):
        positivity_score = sum(self.dictionary.get(token, 0) for token in self.tokens)
        negativity_score = sum(self.dictionary.get(token, 0) for token in self.tokens if self.dictionary.get(token, 0) < 0)
        return positivity_score, negativity_score

    def get_comparative_scores(self):
        total_words = len(self.tokens)
        positive_count = sum(1 for token in self.tokens if self.dictionary.get(token, 0) > 0)
        negative_count = sum(1 for token in self.tokens if self.dictionary.get(token, 0) < 0)
        positive_proportion = positive_count / total_words if total_words > 0 else 0
        negative_proportion = negative_count / total_words if total_words > 0 else 0
        return positive_proportion, negative_proportion

    def get_overall_sentiment(self):
        positivity_score, negativity_score = self.calculate_sentiment_scores()
        overall_sentiment = positivity_score - negativity_score
        return overall_sentiment
```

This code defines the `Simplimental` class with the required fields and methods. The `__init__` method initializes the class with the input text and sets up the dictionary of sentiment scores. The `_tokenize` method splits the text into individual words while removing punctuation. The `calculate_sentiment_scores` method computes the positivity and negativity scores based on the dictionary. The `get_comparative_scores` method calculates the proportions of positive and negative words. Finally, the `get_overall_sentiment` method computes the overall sentiment by subtracting the negativity score from the positivity score.
