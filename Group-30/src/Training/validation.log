#include <iostream>
#include <string>
#include <map>

// Define HTTP version enum
enum class http_version_t {
    HTTP_1_0,
    HTTP_1_1,
    HTTP_2_0
};

// Define HTTP headers map type
using http_headers_t = std::map<std::string, std::string>;

// Define the http_response_t struct
struct http_response_t {
    unsigned int code;          // HTTP status code
    std::string reason;         // Reason phrase corresponding to the status code
    http_version_t version;     // HTTP version used in the response
    http_headers_t headers;       // Collection of HTTP headers associated with the response
};

// Overload the insertion operator for http_response_t
std::ostream &operator<<(std::ostream &stream, const http_response_t &response) {
    switch (response.version) {
        case http_version_t::HTTP_1_0:
            stream << "HTTP/1.0 ";
            break;
        case http_version_t::HTTP_1_1:
            stream << "HTTP/1.1 ";
            break;
        case http_version_t::HTTP_2_0:
            stream << "HTTP/2.0 ";
            break;
    }
    stream << response.code << " " << response.reason << "\r\n";

    for (const auto &header : response.headers) {
        stream << header.first << ": " << header.second << "\r\n";
    }

    stream << "\r\n"; // End of headers marker
    return stream;
}

// Example usage
int main() {
    http_response_t response;
    response.code = 200;
    response.reason = "OK";
    response.version = http_version_t::HTTP_1_1;
    response.headers["Content-Type"] = "text/html";
    response.headers["Content-Length"] = "1234";

    std::cout << response << std::endl;

    return 0;
}
```

This code defines the `http_response_t` struct and overloads the insertion operator (`<<`) for `std::ostream` to print HTTP responses. The example usage demonstrates how to create and print an HTTP response object.
