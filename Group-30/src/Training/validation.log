#include <iostream>
#include <vector>
#include <cmath>

class Line {
public:
    Line(const std::vector<double>& data) : data_(data) {}

    double getValue(size_t index) const {
        if (index >= data_.size()) {
            throw std::out_of_range("Index out of range");
        }
        return data_[index];
    }

private:
    std::vector<double> data_;
};

class MovingAverage {
public:
    MovingAverage(Line& line, size_t period) : line_(line), period_(period) {}

    double calculate(size_t startIndex) const {
        double sum = 0;
        for (size_t i = 0; i < period_; ++i) {
            sum += line_.getValue(startIndex + i);
        }
        return sum / period_;
    }

private:
    Line& line_;
    size_t period_;
};

class MovingAveragesCrossing {
public:
    MovingAveragesCrossing(Line& smallerPeriodLine, Line& biggerPeriodLine, size_t crossingInterval)
        : smallerPeriodLine_(smallerPeriodLine),
          biggerPeriodLine_(biggerPeriodLine),
          crossingInterval_(crossingInterval) {}

    bool shouldBuy(size_t currentIndex) {
        if (currentIndex < crossingInterval_) {
            return false;
        }

        double smallerMA = smallerPeriodLine_.calculate(currentIndex - crossingInterval_);
        double biggerMA = biggerPeriodLine_.calculate(currentIndex - crossingInterval_);

        if (smallerMA > biggerMA && smallerMA <= biggerMA) {
            lastBuyCrossingPoint_ = currentIndex;
            crossingForBuySignal_ = true;
            return true;
        } else {
            crossingForBuySignal_ = false;
            return false;
        }
    }

    bool shouldSell(size_t currentIndex) {
        if (currentIndex < crossingInterval_) {
            return false;
        }

        double smallerMA = smallerPeriodLine_.calculate(currentIndex - crossingInterval_);
        double biggerMA = biggerPeriodLine_.calculate(currentIndex - crossingInterval_);

        if (smallerMA < biggerMA && smallerMA >= biggerMA) {
            lastSellCrossingPoint_ = currentIndex;
            crossingForSellSignal_ = true;
            return true;
        } else {
            crossingForSellSignal_ = false;
            return false;
        }
    }

    bool isDuplicateBuySignal() const {
        return crossingForBuySignal_ && currentIndex_ == lastBuyCrossingPoint_;
    }

    bool isDuplicateSellSignal() const {
        return crossingForSellSignal_ && currentIndex_ == lastSellCrossingPoint_;
    }

    void setCurrentIndex(size_t currentIndex) {
        currentIndex_ = currentIndex;
    }

private:
    Line& smallerPeriodLine_;
    Line& biggerPeriodLine_;
    size_t crossingInterval_;
    size_t lastBuyCrossingPoint_ = 0;
    size_t lastSellCrossingPoint_ = 0;
    bool crossingForBuySignal_ = false;
    bool crossingForSellSignal_ = false;
    size_t currentIndex_ = 0;
};
```

