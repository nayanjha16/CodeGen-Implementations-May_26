#include <skia/core/SkBitmap.h>
#include <skia/core/SkCanvas.h>
#include <skia/core/SkIRect.h>
#include <skia/core/SkPaint.h>
#include <skia/core/SkSurfaceProps.h>

class SkSurfaceProps {
public:
    enum class Orientation : int { kTopLeft = 0 };
    enum class Gamma : int { kLinear = 0 };

    Orientation fOrientation;
    Gamma fGamma;

    SkSurfaceProps(Orientation orientation, Gamma gamma)
        : fOrientation(orientation), fGamma(gamma) {}
};

class SkSpecialImage {
protected:
    SkSurfaceProps* fProps;
    SkIRect fSubset;
    int fUniqueID;

public:
    SkSpecialImage(SkSurfaceProps* props, SkIRect subset, int uniqueID)
        : fProps(props), fSubset(subset), fUniqueID(uniqueID) {}

    virtual ~SkSpecialImage() {
        delete fProps;
    }

    virtual void draw(SkCanvas* canvas, SkScalar x, SkScalar y, const SkPaint* paint) const = 0;
    virtual bool getROPixels(SkBitmap* bitmap) const = 0;
    virtual bool isTextureBacked() const = 0;

    SkIRect getSubset() const { return fSubset; }
    int getUniqueID() const { return fUniqueID; }
};

class RasterSpecialImage : public SkSpecialImage {
private:
    SkBitmap fBitmap;

public:
    RasterSpecialImage(const SkBitmap& bitmap, SkSurfaceProps* props, SkIRect subset, int uniqueID)
        : SkSpecialImage(props, subset, uniqueID), fBitmap(bitmap) {}

    void draw(SkCanvas* canvas, SkScalar x, SkScalar y, const SkPaint* paint) const override {
        canvas->drawBitmap(fBitmap, x, y, paint);
    }

    bool getROPixels(SkBitmap* bitmap) const override {
        *bitmap = fBitmap;
        return true;
    }

    bool isTextureBacked() const override {
        return false;
    }
};

class GpuSpecialImage : public SkSpecialImage {
private:
    GrTexture* fTexture;

public:
    GpuSpecialImage(GrTexture* texture, SkSurfaceProps* props, SkIRect subset, int uniqueID)
        : SkSpecialImage(props, subset, uniqueID), fTexture(texture) {}

    void draw(SkCanvas* canvas, SkScalar x, SkScalar y, const SkPaint* paint) const override {
        // Simulate drawing with GPU texture
        canvas->drawRect(fSubset.toRect(), *paint); // Placeholder for actual GPU drawing
    }

    bool getROPixels(SkBitmap* bitmap) const override {
        // Simulate retrieving pixels from GPU texture
        bitmap->allocPixels(fBitmap.info());
        memcpy(bitmap->getPixels(), fBitmap.getPixels(), fBitmap.rowBytes() * fBitmap.height());
        return true;
    }

    bool isTextureBacked() const override {
        return true;
    }
};
```

This code includes the `SkSpecialImage` abstract base class and two derived classes, `RasterSpecialImage` and `GpuSpecialImage`, each implementing the required methods for drawing, retrieving pixel data, and checking if they are GPU-backed. The `SkSurfaceProps` class is also included to manage surface properties.
