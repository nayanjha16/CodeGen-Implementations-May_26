```cpp
#include <iostream>
#include <vector>

// Forward declaration of PathState and DivvyCalc classes
class PathState;
class DivvyCalc;

class PathCursor {
public:
    // Constructor
    PathCursor(size_t nodeIndex, size_t nodeSize, PathState& pathState, DivvyCalc& divvyCalc)
        : nodeIndex_(nodeIndex), nodeSize_(nodeSize), pathState_(pathState), divvyCalc_(divvyCalc) {}

    // Method to get the current node
    Node& node() {
        return pathState_.nodes_[nodeIndex_];
    }

    // Method to get the previous node
    Node& previousNode() {
        if (nodeIndex_ > 0) {
            return pathState_.nodes_[nodeIndex_ - 1];
        }
        throw std::out_of_range("No previous node available");
    }

    // Method to reverse liquidity for the account
    void reverseLiquidityForAccount(double& saRevRedeem, double& saRevIssue, double& saRevDeliver) {
        while (nodeIndex_ < nodeSize_) {
            auto& currentNode = node();
            auto& prevNode = previousNode();

            // Calculate liquidity requirements based on current and previous node
            double liquidityRequired = divvyCalc_.calculateLiquidity(currentNode, prevNode);

            // Adjust liquidity requests
            saRevRedeem += liquidityRequired * 0.1; // Example adjustment factor
            saRevIssue -= liquidityRequired * 0.1;
            saRevDeliver += liquidityRequired * 0.1;

            // Move to the next node
            ++nodeIndex_;
        }
    }

private:
    size_t nodeIndex_;       // Current node index
    size_t nodeSize_;        // Total number of nodes in the path
    PathState& pathState_;   // Reference to the path state
    DivvyCalc& divvyCalc_;   // Reference to the liquidity calculation object
};

// Example usage
int main() {
    // Assuming PathState and DivvyCalc classes are defined elsewhere
    PathState pathState;
    DivvyCalc divvyCalc;

    PathCursor cursor(0, pathState.nodes_.size(), pathState, divvyCalc);
    double saRevRedeem = 0.0, saRevIssue = 0.0, saRevDeliver = 0.0;

    cursor.reverseLiquidityForAccount(saRevRedeem, saRevIssue, saRevDeliver);

    std::cout << "Adjusted Liquidity: Redeem=" << saRevRedeem << ", Issue=" << saRevIssue << ", Deliver=" << saRevDeliver << std::endl;

    return 0;
}
```

### Notes:
1. **Forward Declaration**: `PathState` and `DivvyCalc` classes are forward-declared because they are assumed to be defined elsewhere in the codebase.
2. **Error Handling**: The `previousNode` method includes basic error handling to ensure there is a previous node available.
3. **Adjustment Factor**: The example uses a simple adjustment factor (`* 0.1`) for demonstration purposes. In a real-world scenario, this would likely be more complex and depend on specific business rules.
4. **Example Usage**: A simple `main` function demonstrates how to use the `PathCursor` class.
