#include <iostream>
#include <fstream>
#include <vector>
#include "stb_image.h"
#include "stb_image_write.h"

struct Color {
    unsigned char r;
    unsigned char g;
    unsigned char b;
    unsigned char a;

    Color(unsigned char r = 0, unsigned char g = 0, unsigned char b = 0, unsigned char a = 255)
        : r(r), g(g), b(b), a(a) {}
};

class Stream {
public:
    virtual bool read(void* buffer, size_t size) = 0;
    virtual ~Stream() {}
};

class Image {
private:
    int width;
    int height;
    std::vector<Color> pixels;
    bool m_stbi_ownership;

public:
    // Constructor initializes a new Image object with default dimensions (0x0) and no pixel data
    Image()
        : width(0), height(0), pixels(), m_stbi_ownership(false) {}

    // Constructor initializes a new Image object by loading its contents from a given Stream
    Image(Stream& stream) {
        loadFromStream(stream);
    }

    // Constructor initializes a new Image object by loading its contents from a file
    Image(const char* file) {
        loadFromFile(file);
    }

    // Destructor
    ~Image() {
        if (m_stbi_ownership && pixels.size() > 0) {
            delete[] reinterpret_cast<unsigned char*>(pixels.data());
        }
    }

    // Getters
    int getWidth() const { return width; }
    int getHeight() const { return height; }
    const std::vector<Color>& getPixels() const { return pixels; }

    // Method to load image from a stream
    void loadFromStream(Stream& stream) {
        // Implementation details depend on how Stream is implemented
        // For example, you might need to read the stream into a buffer first
        // Then use stbi_load_from_memory or similar function to load the image
        // This is a placeholder implementation
        std::cout << "Loading image from stream..." << std::endl;
        // Assuming stream.read fills a buffer with image data
        // and we use stbi_load_from_memory to parse it
        // ...
    }

    // Method to load image from a file
    void loadFromFile(const char* file) {
        unsigned char* imageData = nullptr;
        int w, h, comp;
        imageData = stbi_load(file, &w, &h, &comp, 4); // Load image with alpha channel
        if (imageData) {
            width = w;
            height = h;
            pixels.resize(width * height);
            for (int i = 0; i < width * height; ++i) {
                pixels[i] = Color(imageData[i * 4], imageData[i * 4 + 1], imageData[i * 4 + 2], imageData[i * 4 + 3]);
            }
            stbi_image_free(imageData);
            m_stbi_ownership = true;
        } else {
            std::cerr << "Failed to load image: " << file << std::endl;
        }
    }

    // Method to save image to a file
    bool saveToFile(const char* file) const {
        if (pixels.empty()) {
            std::cerr << "No image data to save." << std::endl;
            return false;
        }
        unsigned char* imageData = new unsigned char[width * height * 4];
        for (size_t i = 0; i < pixels.size(); ++i) {
            imageData[i * 4] = pixels[i].r;
            imageData[i * 4 + 1] = pixels[i].g;
            imageData[i * 4 + 2] = pixels[i].b;
            imageData[i * 4 + 3] = pixels[i].a;
        }
        bool result = stbi_write_png(file, width, height, 4, imageData, width * 4) != 0;
        delete[] imageData;
        return result;
    }

    // Method to perform premultiplication on the image
    void premultiplyAlpha() {
        for (auto& pixel : pixels) {
            pixel.r = static_cast<unsigned char>(static_cast<int>(pixel.r) * pixel.a / 255);
            pixel.g = static_cast<unsigned char>(static_cast<int>(pixel.g) * pixel.a / 255);
            pixel.b = static_cast<unsigned char>(static_cast<int>(pixel.b) * pixel.a / 255);
        }
    }
};
```

