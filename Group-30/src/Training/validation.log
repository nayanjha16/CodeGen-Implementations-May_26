        super(AzureRMAvailabilitySetInfo, self).__init__(
            derived_arg_spec=self.module_args,
            supports_check_mode=True
        )

    def exec_module(self):
        client = self.get_client('ComputeManagementClient')

        if self.name:
            availability_set = client.availability_sets.get(self.resource_group, self.name)
            self.results['availability_sets'].append(availability_set.as_dict())
        else:
            availability_sets = client.availability_sets.list_by_resource_group(self.resource_group)
            for availability_set in availability_sets:
                if not self.tags or all(tag in availability_set.tags.items() for tag in self.tags.items()):
                    self.results['availability_sets'].append(availability_set.as_dict())

        return self.results

def main():
    AzureRMAvailabilitySetInfo()

if __name__ == '__main__':
    main()
```

