// Function to send a message to the service
bool sendMessageToService(HANDLE hPipe, const std::string& message) {
    DWORD bytesWritten;
    return WriteFile(hPipe, message.c_str(), message.size(), &bytesWritten, NULL);
}

// Function to receive a message from the service
bool receiveMessageFromService(HANDLE hPipe, std::string& message) {
    char buffer[BUFSIZE];
    DWORD bytesRead;
    if (!ReadFile(hPipe, buffer, BUFSIZE - 1, &bytesRead, NULL)) {
        return false;
    }
    buffer[bytesRead] = '\0';
    message = buffer;
    return true;
}

// Main function to demonstrate usage
int main() {
    HANDLE hPipe = CreateFile(
        "\\\\.\\pipe\\wgbgservice",   // Pipe name
        GENERIC_READ | GENERIC_WRITE, // Read/Write access
        0,                            // No sharing
        NULL,                         // Default security attributes
        OPEN_EXISTING,                // Open existing pipe
        0,                            // No flags or attributes
        NULL                          // Template file handle
    );

    if (hPipe == INVALID_HANDLE_VALUE) {
        std::cerr << "Could not open pipe" << std::endl;
        return 1;
    }

    // Example usage of WorkGround class
    WorkGround wg;
    std::string serializedWg;
    WorkGround::serialize(wg, serializedWg);

    // Send serialized WorkGround to the service
    if (!sendMessageToService(hPipe, serializedWg)) {
        std::cerr << "Failed to send message to service" << std::endl;
        CloseHandle(hPipe);
        return 1;
    }

    // Receive response from the service
    std::string response;
    if (!receiveMessageFromService(hPipe, response)) {
        std::cerr << "Failed to receive message from service" << std::endl;
        CloseHandle(hPipe);
        return 1;
    }

    // Deserialize the response back to a WorkGround object
    WorkGround* receivedWg = nullptr;
    std::stringstream ss(response);
    WorkGround::deserialize(ss, receivedWg);

    // Clean up
    delete receivedWg;
    CloseHandle(hPipe);

    return 0;
}
```

This code provides a basic structure for interacting with a Windows service using a named pipe. It includes the `WorkGround` class with serialization and deserialization methods, as well as functions to send and receive messages to/from the service. The `main` function demonstrates how to use these components.
