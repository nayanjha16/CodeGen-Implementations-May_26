#include <iostream>
#include <vector>
#include <cmath>

int main() {
    // Global variables
    int n;
    int log2n;
    int i;
    long long count = 0;

    // Read the number of elements from the standard input
    std::cin >> n;

    // Calculate the largest power of 2 less than or equal to n
    log2n = static_cast<int>(floor(log2(n)));

    // Declare a vector to store the input elements
    std::vector<long long> a(n);

    // Read the elements into the vector
    for (i = 0; i < n; ++i) {
        std::cin >> a[i];
        count += a[i]; // Update the cumulative sum
        std::cout << count << std::endl; // Output the current cumulative sum
    }

    return 0;
}
