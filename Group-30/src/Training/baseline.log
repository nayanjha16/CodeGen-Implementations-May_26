from pytorch_lightning.plugins.environments.cluster_environment import ClusterEnvironment

class SLURMEnvironment(ClusterEnvironment):
    def creates_processes_externally(self) -> bool:
        """
        Indicates whether the processes are created externally by the environment.
        
        :return: True
        """
        return True

    def detect(self) -> bool:
        """
        Detects if the current process was launched on a SLURM cluster.
        
        :return: True if the environment variable 'SLURM_NTASKS' is set, False otherwise
        """
        import os
        return 'SLURM_NTASKS' in os.environ

    def master_address(self) -> str:
        """
        Retrieves the main address for communication.
        
        :return: The value of the environment variable 'SLURM_NODEID'
        """
        import os
        return os.getenv('SLURM_NODEID', 'localhost')

    def master_port(self) -> int:
        """
        Retrieves the main port for communication.
        
        :return: The value of the environment variable 'SLURM_PORT', converted to an integer
        """
        import os
        return int(os.getenv('SLURM_PORT', '6000'))

    def world_size(self) -> int:
        """
        Retrieves the total number of processes across all nodes.
        
        :return: The value of the environment variable 'SLURM_NTASKS', converted to an integer
        """
        import os
        return int(os.getenv('SLURM_NTASKS', '1'))

    def global_rank(self) -> int:
        """
        Retrieves the global rank of the current process.
        
        :return: The value of the environment variable 'SLURM_PROCID', converted to an integer
        """
        import os
        return int(os.getenv('SLURM_PROCID', '0'))

    def local_rank(self) -> int:
        """
        Retrieves the local rank of the current process within its node.
        
        :return: The value of the environment variable 'SLURM_LOCALID', converted to an integer
        """
        import os
        return int(os.getenv('SLURM_LOCALID', '0'))

    def node_rank(self) -> int:
        """
        Retrieves the rank of the current node within the cluster.
        
        :return: The value of the environment variable 'SLURM_NODEID', converted to an integer
        """
        import os
        return int(os.getenv('SLURM_NODEID', '0'))
```

This code defines the `SLURMEnvironment` class, which inherits from `ClusterEnvironment`. It includes methods to check if the environment is a SLURM cluster, retrieve the master address and port, and get the world size, global rank, local rank, and node rank of the current process. The methods use environment variables specific to SLURM to obtain this information.
