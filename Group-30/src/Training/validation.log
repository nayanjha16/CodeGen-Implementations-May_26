# Global variable to store loaded models
loaded_models = {}

def load_model(model_id: int, nb_words: int, n_h_features: int) -> object:
    """
    Loads a pre-trained model based on its ID, number of words, and number of hidden features.
    
    Parameters:
        model_id (int): The unique identifier of the model.
        nb_words (int): The number of words in the vocabulary.
        n_h_features (int): The number of hidden features in the model.
        
    Returns:
        object: The loaded machine learning model.
    """
    if (model_id, nb_words, n_h_features) not in loaded_models:
        # Placeholder for actual model loading logic
        model = f"Model_{model_id}_{nb_words}_{n_h_features}"
        loaded_models[(model_id, nb_words, n_h_features)] = model
    return loaded_models[(model_id, nb_words, n_h_features)]

def predict_MSRP_test_data(n_models: int, test_data: List[Tuple[int, str]], output_file: str):
    """
    Predicts quality scores for test data using multiple models and outputs the results to a CSV file.
    
    Parameters:
        n_models (int): The number of models to use for prediction.
        test_data (List[Tuple[int, str]]): A list of tuples containing the test data, where each tuple consists of a model ID and a text string.
        output_file (str): The path to the output CSV file.
    """
    predictions = []
    
    for model_id, text in test_data:
        model = load_model(model_id, len(text.split()), 100)  # Assuming 100 hidden features for simplicity
        predicted_prob = model.predict_proba([text])[0][1]  # Assuming binary classification
        predictions.append((model_id, text, predicted_prob))
    
    # Average predictions if there are multiple models
    if n_models > 1:
        averaged_predictions = {}
        for model_id, text, prob in predictions:
            if (model_id, text) not in averaged_predictions:
                averaged_predictions[(model_id, text)] = [prob]
            else:
                averaged_predictions[(model_id, text)].append(prob)
        
        final_predictions = [(model_id, text, sum(probs) / len(probs)) for (model_id, text), probs in averaged_predictions.items()]
    else:
        final_predictions = predictions
    
    # Write predictions to CSV file
    with open(output_file, mode='w', newline='') as file:
        writer = csv.writer(file)
        writer.writerow(['ModelID', 'Text', 'PredictedProbability'])
        writer.writerows(final_predictions)

def predict_Quora_test_data(test_data: List[str], output_file: str):
