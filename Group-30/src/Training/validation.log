    label1 = std::make_shared<clan::LabelView>(pRootView, "Click Button 1");
    label2 = std::make_shared<clan::LabelView>(pRootView, "Click Button 2");
    label3 = std::make_shared<clan::LabelView>(pRootView, "Click Button 3");
    label4 = std::make_shared<clan::LabelView>(pRootView, "Click Button 4");

    button1 = std::make_shared<clan::Button>(pRootView, "Browse Folder");
    button2 = std::make_shared<clan::Button>(pRootView, "Open File");
    button3 = std::make_shared<clan::Button>(pRootView, "Save File");
    button4 = std::make_shared<clan::Button>(pRootView, "Toggle Sticky");

    button1->sig_clicked().connect(this, &App::handleButtonClick);
    button2->sig_clicked().connect(this, &App::handleButtonClick);
    button3->sig_clicked().connect(this, &App::handleButtonClick);
    button4->sig_clicked().connect(this, &App::handleButtonClick);
}

