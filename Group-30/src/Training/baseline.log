import sys
from PyQt4.QtGui import QApplication, QDialog, QLabel, QLineEdit, QPushButton, QVBoxLayout, QHBoxLayout, QIcon, QFont

class Ui_Dialog_add_subject(QDialog):
    def __init__(self):
        super().__init__()
        self.initUI()

    def initUI(self):
        # Layouts
        main_layout = QVBoxLayout()
        top_layout = QHBoxLayout()
        bottom_layout = QHBoxLayout()

        # Widgets
        self.lbl_subject_name = QLabel("SUBJECT NAME")
        self.label_add_subject = QLabel("ADD SUBJECT")
        self.label_add_subject.setFont(QFont("Arial", 12, QFont.Bold))
        self.lineEdit_subject_name = QLineEdit()
        self.label_year = QLabel("YEAR")
        self.label_semester = QLabel("SEMESTER")
        self.pushButton_save = QPushButton(QIcon("save_icon.png"), "SAVE")
        self.pushButton_cancel = QPushButton(QIcon("cancel_icon.png"), "CANCEL")

        # Adding widgets to layouts
        top_layout.addWidget(self.lbl_subject_name)
        top_layout.addWidget(self.lineEdit_subject_name)

        bottom_layout.addWidget(self.label_year)
        bottom_layout.addWidget(self.label_semester)
        bottom_layout.addWidget(self.pushButton_save)
        bottom_layout.addWidget(self.pushButton_cancel)

        main_layout.addLayout(top_layout)
        main_layout.addLayout(bottom_layout)

        self.setLayout(main_layout)
        self.setWindowTitle('Add Subject')
        self.setGeometry(300, 300, 300, 150)

if __name__ == '__main__':
    app = QApplication(sys.argv)
    ex = Ui_Dialog_add_subject()
    ex.show()
    sys.exit(app.exec_())
