from datetime import datetime
from typing import Optional

class Client:
    pass  # Placeholder for wyzeapy.Client

class Device:
    pass  # Placeholder for wyzeapy.Device

class WyzeCameraMotion:
    def __init__(self, wyzeapi_client: Client, device: Device):
        self._client = wyzeapi_client
        self._device = device
        self._last_event: Optional[datetime] = None
        self._on: bool = False
        self._available: bool = True

    @property
    def client(self) -> Client:
        return self._client

    @property
    def device(self) -> Device:
        return self._device

    @property
    def last_event(self) -> Optional[datetime]:
        return self._last_event

    @property
    def on(self) -> bool:
        return self._on

    @property
    def available(self) -> bool:
        return self._available

    def update_status(self):
        # Simulate fetching status from WyzeCam
        current_time = datetime.now()
        if self._client.is_motion_detected(self._device):
            self._last_event = current_time
            self._on = True
        else:
            self._on = False

    def check_connection(self):
        # Simulate checking connection to WyzeCam
        self._available = self._client.is_device_connected(self._device)

# Example usage
if __name__ == "__main__":
    wyzeapi_client = Client()  # Initialize your wyzeapy Client here
    device = Device()  # Initialize your wyzeapy Device here
    camera_motion = WyzeCameraMotion(wyzeapi_client, device)

    camera_motion.update_status()
    print(f"Last Event: {camera_motion.last_event}")
    print(f"On: {camera_motion.on}")
    print(f"Available: {camera_motion.available}")

    camera_motion.check_connection()
    print(f"Available after check: {camera_motion.available}")
```

