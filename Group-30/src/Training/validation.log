import numpy as np
from PIL import Image
import os

# Global variable
cls_to_clr_map = get_color()

def get_color():
    """
    Purpose: Returns a predefined list of RGB color codes representing different classes.

    Parameters: None

    Return Value: A NumPy array of shape (22, 3) where each row represents an RGB color code.
    """
    # Define a list of RGB color codes
    color_codes = [
        [0, 0, 0],      # Background
        [255, 0, 0],    # Class 1
        [0, 255, 0],    # Class 2
        [0, 0, 255],    # Class 3
        # Add more class color codes here up to class index 21
    ]
    
    # Convert the list into a NumPy array and return it
    return np.array(color_codes)

def encode_label(label):
    """
    Purpose: Encodes pixel values in a label image to corresponding class numbers. Assumes the input label image is in 3D format.

    Parameters:
    - label: A 3D NumPy array representing the label image.

    Return Value: A 2D NumPy array where each element is the class ID corresponding to the pixel value.
    """
    encoded_labels = np.zeros((label.shape[0], label.shape[1]), dtype=int)
    for i in range(cls_to_clr_map.shape[0]):
        mask = np.all(label == cls_to_clr_map[i], axis=-1)
        encoded_labels[mask] = i
    return encoded_labels

def process_dataset(image_dir, label_dir, output_train_file, output_val_file, train_ratio=0.8):
    """
    Purpose: Processes a dataset for semantic segmentation tasks by reading image files and corresponding label images,
             encoding the labels into numerical class IDs, and generating text files listing paths to these processed images and labels for training and validation sets.

    Parameters:
    - image_dir: Directory path containing the image files.
    - label_dir: Directory path containing the label images.
    - output_train_file: Path to the output file for training set paths.
    - output_val_file: Path to the output file for validation set paths.
    - train_ratio: Ratio of the dataset to be used for training (default is 0.8).

    Return Value: None
    """
    image_files = sorted([f for f in os.listdir(image_dir) if f.endswith('.png')])
    label_files = sorted([f for f in os.listdir(label_dir) if f.endswith('.png')])

    assert len(image_files) == len(label_files), "Number of image files and label files must match"

    num_images = len(image_files)
    num_train = int(num_images * train_ratio)
    num_val = num_images - num_train

    with open(output_train_file, 'w') as train_file, open(output_val_file, 'w') as val_file:
        for i in range(num_images):
            image_path = os.path.join(image_dir, image_files[i])
            label_path = os.path.join(label_dir, label_files[i])

            # Read the image and label
            image = Image.open(image_path).convert('RGB')
            label = Image.open(label_path).convert('RGB')

            # Encode the label
            encoded_label = encode_label(np.array(label))

            # Save the encoded label to a temporary file
            temp_label_path = f"temp_{i}.png"
            Image.fromarray(encoded_label.astype('uint8')).save(temp_label_path)

            if i < num_train:
                train_file.write(f"{image_path} {temp_label_path}\n")
            else:
                val_file.write(f"{image_path} {temp_label_path}\n")

            # Optionally remove the temporary label file after processing
            os.remove(temp_label_path)

# Example usage
if __name__ == "__main__":
    image_directory = 'path/to/images'
    label_directory = 'path/to/labels'
    train_output_file = 'train.txt'
    val_output_file = 'val.txt'

    process_dataset(image_directory, label_directory, train_output_file, val_output_file)
```

