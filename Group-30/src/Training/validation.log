#include "ofMain.h"

class ofApp : public ofBaseApp {
public:
    void setup();
    void update();
    void draw();
    void keyPressed(int key);
    void keyReleased(int key);
    void mouseMoved(int x, int y);
    void mouseDragged(int x, int y, int button);

private:
    ofImage img;
    ofMesh mesh;
};

void ofApp::setup() {
    // Initialize application settings
    ofSetWindowTitle("Point Cloud Image Visualization");
    ofSetWindowShape(800, 600);
    
    // Load the image from disk
    img.load("path/to/your/image.jpg");
    
    // Create the point cloud from the image
    mesh.setMode(OF_PRIMITIVE_POINTS);
    for (int y = 0; y < img.getHeight(); ++y) {
        for (int x = 0; x < img.getWidth(); ++x) {
            ofColor color = img.getColor(x, y);
            float brightness = color.getBrightness();
            float z = map(brightness, 0, 255, -100, 100); // Map brightness to depth
            
            mesh.addVertex(ofVec3f(x, y, z));
            mesh.addColor(color);
        }
    }
    
    // Set up the camera
    cam.setDistance(200);
}

void ofApp::update() {
    // Handle any updates needed during runtime
}

void ofApp::draw() {
    ofBackground(0);
    cam.begin();
    ofEnableDepthTest();
    
    mesh.drawVertices();
    
    ofDisableDepthTest();
    cam.end();
}

void ofApp::keyPressed(int key) {
    // Handle key press events
}

void ofApp::keyReleased(int key) {
    // Handle key release events
}

void ofApp::mouseMoved(int x, int y) {
    // Handle mouse move events
}

void ofApp::mouseDragged(int x, int y, int button) {
    // Handle mouse drag events
}
