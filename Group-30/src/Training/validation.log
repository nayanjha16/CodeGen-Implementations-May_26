from flask import Flask, render_template, redirect, url_for, request, session
from functools import wraps

class AuthDecorator:
    def __init__(self, app, excluded_resources_endpoints=()):
        self.app = app
        self.excluded_resources_endpoints = excluded_resources_endpoints
        self.add_auth_routes()

    def add_auth_routes(self):
        @self.app.route('/login', methods=['GET'])
        def login():
            if 'username' in session:
                return redirect(url_for('home'))
            return render_template('login.html')

        @self.app.route('/logout')
        def logout():
            session.pop('username', None)
            return redirect(url_for('home'))

        @self.app.before_request
        def auth():
            endpoint = request.endpoint
            if endpoint not in self.excluded_resources_endpoints:
                if 'username' not in session:
                    return redirect(url_for('login'))

    def login(self):
        # This method should be called manually when handling login logic outside of the route
        pass

    def logout(self):
        # This method should be called manually when handling logout logic outside of the route
        pass

    def auth(self):
        # This method should be called manually when handling authentication logic outside of the route
        pass

def add_routes(app, excluded_resources_endpoints=()):
    return AuthDecorator(app, excluded_resources_endpoints)

# Example usage:
