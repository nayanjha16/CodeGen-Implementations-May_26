#include <apr_pools.h>
#include <vector>
#include <string>

class AprAutoPool {
public:
    apr_pool_t* pool;

    AprAutoPool(apr_pool_t* parent = nullptr) : pool(nullptr) {
        apr_pool_create(&pool, parent);
    }

    ~AprAutoPool() {
        if (pool) {
            apr_pool_destroy(pool);
        }
    }

    void clear() {
        if (pool) {
            apr_pool_clear(pool);
        }
    }

    apr_pool_t* data() const {
