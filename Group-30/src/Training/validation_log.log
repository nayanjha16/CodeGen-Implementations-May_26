```python
import torch
from torch import nn
from transformers import BertConfig, BertTokenizer, BertModel

class ModalEmbeddings(nn.Module):
    def __init__(self, config, encoder):
        super(ModalEmbeddings, self).__init__()
        self.config = config
        self.encoder = encoder
        self.proj_embeddings = nn.Linear(config.hidden_size, config.embedding_dim)
        self.position_embeddings = nn.Embedding(config.max_position_embeddings, config.embedding_dim)
        self.token_type_embeddings = nn.Embedding(2, config.embedding_dim)
        self.word_embeddings = nn.Embedding(config.vocab_size, config.embedding_dim)
        self.LayerNorm = nn.LayerNorm(config.embedding_dim, eps=config.layer_norm_eps)
        self.dropout = nn.Dropout(config.hidden_dropout_prob)

    def forward(self, input_ids=None, position_ids=None, token_type_ids=None):
        if input_ids is None:
            input_ids = torch.zeros((input_ids.size(0), input_ids.size(1)), dtype=torch.long).to(input_ids.device)
        
        if position_ids is None:
            position_ids = torch.arange(input_ids.size(1), dtype=torch.long).unsqueeze(0).repeat(input_ids.size(0), 1).to(input_ids.device)
        
        if token_type_ids is None:
            token_type_ids = torch.zeros_like(input_ids).to(input_ids.device)
        
        embedded_input = self.word_embeddings(input_ids) + self.position_embeddings(position_ids) + self.token_type_embeddings(token_type_ids)
        projected_input = self.proj_embeddings(embedded_input)
        normalized_input = self.LayerNorm(projected_input)
        output = self.dropout(normalized_input)
        return output

class MMBTModel(nn.Module):
    def __init__(self, config):
        super(MMBTModel, self).__init__()
        self.config = config
        self.image_encoder = BertModel.from_pretrained('bert-base-uncased')
        self.text_encoder = BertModel.from_pretrained('bert-base-uncased')
        self.modal_embeddings = ModalEmbeddings(config, self.text_encoder)
        self.classifier = nn.Linear(config.embedding_dim * 2, config.num_labels)

    def forward(self, image_features, text_ids, text_mask):
        image_output = self.image_encoder(image_features)
        text_output = self.modal_embeddings(text_ids, text_mask)
        combined_output = torch.cat([image_output[0], text_output], dim=-1)
        logits = self.classifier(combined_output)
        return logits

# Example usage
config = BertConfig()
model = MMBTModel(config)
image_features = torch.randn(1, 197, 768)  # Example image features (batch_size, num_patches, hidden_size)
text_ids = torch.randint(0, config.vocab_size, (1, 128))  # Example text IDs (batch_size, max_seq_length)
text_mask = torch.ones_like(text_ids)  # Example text mask (batch_size, max_seq_length)

logits = model(image_features, text_ids, text_mask)
print(logits.shape)  # Should be (1, num_labels)
```

This code defines the `ModalEmbeddings` and `MMBTModel` classes as described in the natural language documentation. The `ModalEmbeddings` class handles projecting modal embeddings into the main transformer's embedding space, while the `MMBTModel` class combines information from both image and text using transformers and outputs logits for classification.
