import argparse
import imageio
import numpy as np
from cffi import FFI

# Global Variables
RESOLUTIONS = {
    "1080p": (1920, 1080),
    "720p": (1280, 720),
    "480p": (854, 480)
}

# External C++ routines via FFI
ffi = FFI()
lib = ffi.dlopen("mandelbrot_routines.so")

# Define the C function signature
ffi.cdef("""
    void mandelbrot_set(double* out, int width, int height, double x_min, double x_max, double y_min, double y_max);
""")

class VideoRenderer:
    def __init__(self, resolution="1080p", fps=30):
        self.resolution = RESOLUTIONS.get(resolution, (1920, 1080))
        self.fps = fps
        self.width, self.height = self.resolution

    def render(self, output_file):
        frames = []
        for i in range(100):  # Example loop for generating frames
            rgb_channels = [np.zeros((self.height, self.width), dtype=np.uint8) for _ in range(3)]
            lib.mandelbrot_set(rgb_channels[0].ctypes.data_as(ffi.POINTER(ffi.c_double)), self.width, self.height, -2.0, 1.0, -1.5, 1.5)
            frame = make_video_frame(rgb_channels)
            frames.append(frame)
        
        writer = imageio.get_writer(output_file, fps=self.fps)
        for frame in frames:
            writer.append_data(frame)
        writer.close()

def make_video_frame(rgb, indexing='ij', dither=1.0/256.0):
    if dither != 0.0:
        for channel in rgb:
            noise = np.random.rand(*channel.shape) * dither
            channel += noise
    
    if indexing == 'ij':
        return np.transpose(np.array(rgb), (1, 2, 0)).astype(np.uint8)
    elif indexing == 'xy':
        return np.array(rgb).astype(np.uint8)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Render a video using the Mandelbrot set algorithm.")
    parser.add_argument("-o", "--output", type=str, required=True, help="Output video file")
    parser.add_argument("-r", "--resolution", type=str, default="1080p", choices=["1080p", "720p", "480p"], help="Video resolution")
    parser.add_argument("-f", "--fps", type=int, default=30, help="Frame rate")
    
    args = parser.parse_args()
    renderer = VideoRenderer(args.resolution, args.fps)
    renderer.render(args.output)
```

This code includes the necessary imports, global variables, and functions as described in the documentation. The `VideoRenderer` class handles the rendering process, while the `make_video_frame` function creates video frames from RGB channels. The script also includes command-line argument parsing using `argparse`.
