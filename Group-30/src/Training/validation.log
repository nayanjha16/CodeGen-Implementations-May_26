    def load_and_decode_tfrecords(self, record_files):
        """Loads and decodes TensorFlow records."""
        raw_dataset = tf.data.TFRecordDataset(record_files)
        parsed_dataset = raw_dataset.map(self._parse_example)
        return parsed_dataset

    def _parse_example(self, example_proto):
        """Parses a single example from the TFRecord."""
        feature_description = {
            'audio': tf.io.FixedLenFeature([], tf.string),
            'label': tf.io.FixedLenFeature([], tf.int64),
            'confidence': tf.io.FixedLenFeature([], tf.float32)
        }
        example = tf.io.parse_single_example(example_proto, feature_description)
        audio = tf.audio.decode_wav(example['audio'], desired_channels=1)
        label = example['label']
        confidence = example['confidence']
        return audio, label, confidence

    def filter_classes(self, data, confidence_threshold, class_restrictions=None):
        """Filters classes based on confidence levels and restrictions."""
        filtered_data = data[data['confidence'] >= confidence_threshold]
        if class_restrictions:
            filtered_data = filtered_data[filtered_data['label'].isin(class_restrictions)]
        return filtered_data

    def filter_samples(self, data, max_duration, min_duration):
        """Filters samples to ensure they belong to only one class and have the correct duration."""
        valid_indices = []
        for idx, row in data.iterrows():
            audio = tf.audio.decode_wav(row['audio'], desired_channels=1)
            duration = audio.shape[0] / 16000  # Assuming sample rate is 16kHz
            if len(set(data.loc[data['label'] == row['label'], 'audio'])) == 1 and min_duration <= duration <= max_duration:
                valid_indices.append(idx)
        return data.iloc[valid_indices]

    def split_data(self, data, test_size=0.2, random_state=42):
        """Splits the filtered data into training and testing sets."""
        train_data, test_data = train_test_split(data, test_size=test_size, random_state=random_state)
        return train_data, test_data

    def save_processed_data(self, data):
        """Saves the processed data in a pickle file."""
        with open(self.target_path, 'wb') as f:
            pickle.dump(data, f)

def main():
    data_dir = 'path/to/data'
    download_dir = 'path/to/download'
    fpath_conf_data = 'path/to/confidence_data.csv'
    fpath_label_inds = 'path/to/label_indices.csv'
    fpath_ontology = 'path/to/ontology.json'
    target_path = 'path/to/save/processed_data.pkl'
    n_classes = 10

    processor = AudioSetProcessor(data_dir, download_dir, fpath_conf_data, fpath_label_inds, fpath_ontology, target_path, n_classes)
    
    # Load and decode TFRecords
    record_files = [os.path.join(data_dir, f) for f in os.listdir(data_dir) if f.endswith('.tfrecord')]
    data = processor.load_and_decode_tfrecords(record_files).as_numpy_iterator()
    
    # Filter classes
    confidence_threshold = 0.8
    class_restrictions = [0, 1, 2]  # Example class restrictions
    data = processor.filter_classes(pd.DataFrame(list(data)), confidence_threshold, class_restrictions)
    
    # Filter samples
    max_duration = 10  # seconds
    min_duration = 5   # seconds
    data = processor.filter_samples(data, max_duration, min_duration)
    
    # Split data
    train_data, test_data = processor.split_data(data)
    
    # Save processed data
    processor.save_processed_data(train_data)
    processor.save_processed_data(test_data, 'test')

if __name__ == "__main__":
    main()
```

This code defines an `AudioSetProcessor` class that encapsulates the functionality described in the documentation. It includes methods for loading and decoding TensorFlow records, filtering classes and samples, splitting the data, and saving the processed data. The `main` function demonstrates how to use this class to process the AudioSet dataset.
