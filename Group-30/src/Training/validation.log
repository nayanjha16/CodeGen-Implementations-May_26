#include <SDL.h>
#include <iostream>

// Global Variables
const int WINDOW_WIDTH = 800;
const int WINDOW_HEIGHT = 600;
SDL_Window* g_main_window = nullptr;
SDL_Renderer* g_main_renderer = nullptr;

// Namespace for Colors
namespace Colors {
    const SDL_Color BLACK = {0, 0, 0, 255};
}

// Function Prototypes
bool Init();
void ClearScreen(SDL_Renderer* renderer);
void HandleEvents();

int main(int argc, char* args[]) {
    if (!Init()) {
        std::cerr << "Failed to initialize SDL!" << std::endl;
        return 1;
    }

    bool running = true;
    while (running) {
        HandleEvents();
        ClearScreen(g_main_renderer);
        SDL_RenderPresent(g_main_renderer);
    }

    // Clean up
    SDL_DestroyRenderer(g_main_renderer);
    SDL_DestroyWindow(g_main_window);
    SDL_Quit();

    return 0;
}

bool Init() {
    if (SDL_Init(SDL_INIT_VIDEO) != 0) {
        std::cerr << "SDL could not initialize! SDL_Error: " << SDL_GetError() << std::endl;
        return false;
    }

    g_main_window = SDL_CreateWindow("SDL Window", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
                                     WINDOW_WIDTH, WINDOW_HEIGHT, SDL_WINDOW_SHOWN);
    if (g_main_window == nullptr) {
        std::cerr << "Window could not be created! SDL_Error: " << SDL_GetError() << std::endl;
        SDL_Quit();
        return false;
    }

    g_main_renderer = SDL_CreateRenderer(g_main_window, -1, SDL_RENDERER_ACCELERATED);
    if (g_main_renderer == nullptr) {
        std::cerr << "Renderer could not be created! SDL_Error: " << SDL_GetError() << std::endl;
        SDL_DestroyWindow(g_main_window);
        SDL_Quit();
        return false;
    }

    return true;
}

void ClearScreen(SDL_Renderer* renderer) {
    SDL_SetRenderDrawColor(renderer, Colors::BLACK.r, Colors::BLACK.g, Colors::BLACK.b, Colors::BLACK.a);
    SDL_RenderClear(renderer);
}

void HandleEvents() {
    SDL_Event e;
    while (SDL_PollEvent(&e)) {
        switch (e.type) {
            case SDL_QUIT:
                g_main_window = nullptr;
                break;
            case SDL_KEYDOWN:
                if (e.key.keysym.sym == SDLK_ESCAPE) {
                    g_main_window = nullptr;
                }
                break;
        }
    }
}
```

