```python
import os
import time
from google.cloud import monitoring_v3
from gflags import DEFINE_string, FLAGS

class NginxAccessTailer:
    def __init__(self, log_file_path, project_id):
        self.log_file_path = log_file_path
        self.project_id = project_id
        self.client = monitoring_v3.MetricServiceClient()

    def read_log_file(self):
        if not os.path.exists(self.log_file_path):
            raise FileNotFoundError(f"Log file not found at {self.log_file_path}")

        with open(self.log_file_path, 'r') as file:
            while True:
                line = file.readline()
                if not line:
                    time.sleep(1)
                    continue
                yield line.strip()

    def send_metric_to_gcp(self, metric_name, value):
        name = f"projects/{self.project_id}/metricDescriptors/{metric_name}"
        point = {
            "interval": {"end_time": time.time()},
            "value": {"double_value": value}
        }
        time_series = {
            "name": name,
            "points": [point],
            "resource": {"type": "global"}
        }
        self.client.create_time_series(name, [time_series])

def main():
    DEFINE_string('log_file_path', None, 'Path to the Nginx access log file')
    DEFINE_string('project_id', None, 'Google Cloud project ID')

    FLAGS(sys.argv)

    if not FLAGS.log_file_path or not FLAGS.project_id:
        print("Both log_file_path and project_id must be provided")
        sys.exit(1)

    tailer = NginxAccessTailer(FLAGS.log_file_path, FLAGS.project_id)

    for log_entry in tailer.read_log_file():
        # Example: Count the number of requests per minute
        tailer.send_metric_to_gcp('nginx_requests_per_minute', 1)

if __name__ == '__main__':
    main()
```

This code defines the `NginxAccessTailer` class with methods to read log files and send metrics to Google Cloud Monitoring. The `main` function sets up command-line arguments using `gflags` and initializes the `NginxAccessTailer` with the provided log file path and project ID. The example usage in `send_metric_to_gcp` demonstrates how to count the number of requests per minute, which can be adapted based on specific requirements.
