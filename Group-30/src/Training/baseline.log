import os
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.neighbors import kneighbors_graph
from utils.data import load_csv_data, filter_by_attribute, get_cases_chronologically

# Global Variables
BASE_PATH = 'path/to/covid19/dataset'
NUM_COLORS = len(plt.cm.tab10.colors)
NUM_STYLES = len(['-', '--', '-.', ':'])

def find_most_similar_country(country_name, k=5):
    """
    Finds the k countries with the most similar COVID-19 case trajectory to the given country.
    
    Parameters:
    - country_name: str, the name of the country to compare against.
    - k: int, the number of most similar countries to return.
    
    Returns:
    - List[str], the names of the k most similar countries.
    """
    # Load data
    df = load_csv_data(os.path.join(BASE_PATH, 'cases.csv'))
    
    # Filter data by country
    country_df = filter_by_attribute(df, 'country', country_name)
    
    if country_df.empty:
        raise ValueError(f"Country '{country_name}' not found in the dataset.")
    
    # Get cases chronologically
    country_cases = get_cases_chronologically(country_df)
    
    # Compute similarity graph
    similarity_matrix = compute_similarity_matrix(df)
    similarity_scores = similarity_matrix.loc[country_name].sort_values(ascending=False)
    
    # Find k most similar countries
    most_similar_countries = similarity_scores.index[1:k+1].tolist()
    
    return most_similar_countries

def plot_trajectories(countries):
    """
    Plots the COVID-19 case trajectories for the given list of countries.
    
    Parameters:
    - countries: List[str], the names of the countries to plot.
    """
    # Load data
    df = load_csv_data(os.path.join(BASE_PATH, 'cases.csv'))
    
    # Plot each country's trajectory
    fig, ax = plt.subplots(figsize=(12, 8))
    for i, country in enumerate(countries):
        country_df = filter_by_attribute(df, 'country', country)
        cases = get_cases_chronologically(country_df)
        ax.plot(cases, label=country, color=plt.cm.tab10(i % NUM_COLORS), linestyle=plt.cm.Set1(i % NUM_STYLES))
    
    ax.set_xlabel('Time')
    ax.set_ylabel('Number of Cases')
    ax.set_title('COVID-19 Case Trajectories')
    ax.legend()
    plt.show()

def compute_similarity_matrix(df):
    """
    Computes the similarity matrix between countries based on their case trajectories.
    
    Parameters:
    - df: DataFrame, the DataFrame containing the COVID-19 case data.
    
    Returns:
    - DataFrame, the similarity matrix.
    """
    # Get cases chronologically for each country
    cases_dict = {country: get_cases_chronologically(filter_by_attribute(df, 'country', country)) for country in df['country'].unique()}
    
    # Compute similarity scores
    similarity_matrix = pd.DataFrame(index=cases_dict.keys(), columns=cases_dict.keys())
    for country1, cases1 in cases_dict.items():
        for country2, cases2 in cases_dict.items():
            similarity_score = cosine_similarity(cases1.values.reshape(1, -1), cases2.values.reshape(1, -1))[0][0]
            similarity_matrix.at[country1, country2] = similarity_score
    
    return similarity_matrix

def cosine_similarity(a, b):
    """
    Computes the cosine similarity between two vectors.
    
    Parameters:
    - a: ndarray, the first vector.
    - b: ndarray, the second vector.
    
    Returns:
    - float, the cosine similarity score.
    """
    dot_product = np.dot(a, b)
    norm_a = np.linalg.norm(a)
    norm_b = np.linalg.norm(b)
    return dot_product / (norm_a * norm_b)

# Example usage
if __name__ == "__main__":
    target_country = 'United States'
    similar_countries = find_most_similar_country(target_country, k=5)
    print(f"Most similar countries to {target_country}: {similar_countries}")
    plot_trajectories(similar_countries + [target_country])
```

This code includes the necessary functions and global variables to load data, compute similarities, and plot trajectories. The `find_most_similar_country` function finds the k most similar countries to a given country, while the `plot_trajectories` function plots their case trajectories. The `compute_similarity_matrix` function computes the similarity matrix between countries based on their case trajectories. The `cosine_similarity` function calculates the cosine similarity between two vectors.
