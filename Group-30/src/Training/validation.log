```python
import tensorflow as tf
from tensorflow.keras.layers import Conv2D, BatchNormalization, Activation, Add, GlobalAveragePooling2D, GlobalMaxPooling2D, Concatenate, Dense

class ChannelAttention(tf.keras.layers.Layer):
    def __init__(self, filters, reduction_ratio=16):
        super(ChannelAttention, self).__init__()
        self.avg = GlobalAveragePooling2D()
        self.max = GlobalMaxPooling2D()
        self.conv1 = Conv2D(filters // reduction_ratio, kernel_size=1, use_bias=False)
        self.relu = Activation('relu')
        self.conv2 = Conv2D(filters, kernel_size=1, use_bias=False)

    def call(self, x):
        avg_out = self.conv2(self.relu(self.conv1(self.avg(x))))
        max_out = self.conv2(self.relu(self.conv1(self.max(x))))
        out = Add()([avg_out, max_out])
        return tf.nn.sigmoid(out) * x

class SpatialAttention(tf.keras.layers.Layer):
    def __init__(self, kernel_size=7):
        super(SpatialAttention, self).__init__()
        self.conv1 = Conv2D(1, kernel_size=kernel_size, padding='same', use_bias=False)
        self.sigmoid = Activation('sigmoid')

    def call(self, x):
        avg_out = tf.reduce_mean(x, axis=-1, keepdims=True)
        max_out = tf.reduce_max(x, axis=-1, keepdims=True)
        out = Concatenate(axis=-1)([avg_out, max_out])
        out = self.conv1(out)
        return self.sigmoid(out) * x

# Example usage of the classes
if __name__ == "__main__":
    inputs = tf.random.normal((1, 32, 32, 64))
    
    # Test ChannelAttention
    channel_attention_layer = ChannelAttention(64)
    output_channel_attention = channel_attention_layer(inputs)
    print("Output shape after ChannelAttention:", output_channel_attention.shape)
    
    # Test SpatialAttention
    spatial_attention_layer = SpatialAttention()
    output_spatial_attention = spatial_attention_layer(inputs)
    print("Output shape after SpatialAttention:", output_spatial_attention.shape)
```

This code defines two classes, `ChannelAttention` and `SpatialAttention`, each implementing specific attention mechanisms for neural networks. The `ChannelAttention` class focuses on channel-wise importance, while the `SpatialAttention` class focuses on spatial importance within feature maps. Both classes inherit from `tf.keras.layers.Layer` and include methods to apply the attention mechanisms to input tensors. The example usage at the bottom demonstrates how to create instances of these classes and apply them to random input tensors to verify their functionality.
