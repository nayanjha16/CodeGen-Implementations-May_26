```python
import numpy as np
from sklearn.base import BaseEstimator, ClassifierMixin

class PySVM(BaseEstimator, ClassifierMixin):
    def __init__(self, C=1.0, kernel='linear', max_iter=1000):
        self.C = C
        self.kernel = kernel
        self.max_iter = max_iter
        self.alpha = None
        self.b = None
        self.support_vectors_ = None
        self.support_indices_ = None

    def fit(self, X, y):
        n_samples, n_features = X.shape
        K = np.zeros((n_samples, n_samples))
        
        if self.kernel == 'linear':
            K = np.dot(X, X.T)
        elif self.kernel == 'rbf':
            gamma = 1.0 / (2 * np.var(X))
            for i in range(n_samples):
                for j in range(n_samples):
                    K[i, j] = np.exp(-gamma * np.linalg.norm(X[i] - X[j]) ** 2)
        else:
            raise ValueError("Unsupported kernel type")

        P = np.outer(y, y) * K
        q = -np.ones(n_samples)
        G = np.vstack((-np.eye(n_samples), np.eye(n_samples)))
        h = np.hstack((np.zeros(n_samples), np.full(n_samples, self.C)))
        A = y.reshape(1, -1).T
        b = np.array([0])

        alpha = np.linalg.solve(np.block([[P, A.T], [A, 0]]), np.block([-q, b]))
        self.alpha = alpha[:n_samples]
        self.b = b[0]

        support_indices = np.where(alpha > 1e-8)[0]
        self.support_vectors_ = X[support_indices]
        self.support_indices_ = support_indices

        return self

    def predict(self, X):
        n_samples = X.shape[0]
        predictions = np.zeros(n_samples)

        for i in range(n_samples):
            prediction = self.b
            for j in range(len(self.support_indices_)):
                prediction += self.alpha[self.support_indices_[j]] * self.y[self.support_indices_[j]] * self.kernel_function(X[i], self.support_vectors_[j])
            predictions[i] = np.sign(prediction)

        return predictions

    def kernel_function(self, x1, x2):
        if self.kernel == 'linear':
            return np.dot(x1, x2)
        elif self.kernel == 'rbf':
            gamma = 1.0 / (2 * np.var(self.support_vectors_))
            return np.exp(-gamma * np.linalg.norm(x1 - x2) ** 2)
        else:
            raise ValueError("Unsupported kernel type")
```

This code defines a `PySVM` class that implements a Support Vector Machine using the Sequential Minimal Optimization (SMO) algorithm. The class inherits from `BaseEstimator` and `ClassifierMixin` from `sklearn.base`, making it compatible with scikit-learn's ecosystem. The `fit` method trains the model, and the `predict` method makes predictions using the trained model. The `kernel_function` method computes the kernel value between two samples based on the specified kernel type.
