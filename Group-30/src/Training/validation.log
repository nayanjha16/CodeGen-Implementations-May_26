	VertexArray* VertexArray::Create()
	{
		switch (Renderer::GetAPI())
		{
			case RendererAPI::None: FLICK_CORE_ASSERT(false, "RendererAPI::None"); return nullptr;
			case RendererAPI::OpenGL: return new OpenGL_VertexArray();
		}

		FLICK_CORE_ASSERT(false, "Unknown RendererAPI!");
		return nullptr;
	}
	
	
