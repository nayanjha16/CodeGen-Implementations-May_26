```python
import numpy as np
from sklearn.base import BaseEstimator, ClassifierMixin
from sklearn.utils.validation import check_X_y, check_array, check_is_fitted

class PySVM(BaseEstimator, ClassifierMixin):
    """
    A simple and efficient implementation of Support Vector Machine (SVM) using the Sequential Minimal Optimization (SMO) algorithm.
    
    Parameters:
    - C: float, default=1.0
        Regularization parameter. The strength of the regularization is inversely proportional to C. Must be strictly positive.
    - kernel: str, default='linear'
        Specifies the kernel type to be used in the algorithm. Options are 'linear', 'poly', 'rbf', 'sigmoid'.
    - degree: int, default=3
        Degree of the polynomial kernel function ('poly'). Ignored by all other kernels.
    - gamma: {'scale', 'auto'} or float, default='scale'
        Kernel coefficient for 'rbf', 'poly' and 'sigmoid'. If 'scale' is chosen then it uses 1 / (n_features * X.var()) as value of gamma if X is given as input to fit method.
    - tol: float, default=1e-4
        Tolerance for stopping criterion.
    - max_iter: int, default=-1
        Maximum number of iterations taken for the solvers to converge.
    """

    def __init__(self, C=1.0, kernel='linear', degree=3, gamma='scale', tol=1e-4, max_iter=-1):
        self.C = C
        self.kernel = kernel
        self.degree = degree
        self.gamma = gamma
        self.tol = tol
        self.max_iter = max_iter
        self.support_vectors_ = None
        self.dual_coef_ = None
        self.intercept_ = None

    def _compute_kernel(self, X, Y=None):
        """Compute the kernel matrix."""
        if Y is None:
            Y = X
        if self.kernel == 'linear':
            return np.dot(X, Y.T)
        elif self.kernel == 'poly':
            return (np.dot(X, Y.T) + 1) ** self.degree
        elif self.kernel == 'rbf':
            gamma = 1 / (X.shape[1] * np.var(X)) if self.gamma == 'scale' else self.gamma
            return np.exp(-gamma * np.sum((X[:, np.newaxis] - Y[np.newaxis, :]) ** 2, axis=2))
        elif self.kernel == 'sigmoid':
            gamma = 1 / (X.shape[1] * np.var(X)) if self.gamma == 'scale' else self.gamma
            coef0 = 0
            return np.tanh(gamma * np.dot(X, Y.T) + coef0)
        else:
            raise ValueError(f"Kernel '{self.kernel}' not supported")

    def fit(self, X, y):
        """Fit the SVM model according to the given training data."""
        X, y = check_X_y(X, y, accept_sparse=False)
        n_samples, n_features = X.shape

        # Initialize alpha parameters
        alpha = np.zeros(n_samples)

        # Compute the kernel matrix
        K = self._compute_kernel(X)

        # Set up the quadratic programming problem
        P = np.outer(y, y) * K
        q = -np.ones(n_samples)
        G = np.vstack((-np.eye(n_samples), np.eye(n_samples)))
        h = np.hstack((np.zeros(n_samples), np.full(n_samples, self.C)))
        A = y.reshape(1, -1).T
        b = 0

        # Solve the quadratic programming problem
        from scipy.optimize import minimize
        res = minimize(lambda alpha: 0.5 * np.dot(alpha, np.dot(P, alpha)) + np.dot(q, alpha),
                      alpha,
                      method='SLSQP',
                      bounds=[(0, self.C)] * n_samples,
                      constraints={'type': 'eq', 'fun': lambda alpha: np.dot(A, alpha) - b})

        alpha = res.x

        # Find support vectors
        sv_indices = np.where(alpha > 1e-8)[0]
        self.support_vectors_ = X[sv_indices]
        self.dual_coef_ = np.dot(y[sv_indices], alpha[sv_indices])
        self.intercept_ = b - np.sum(self.dual_coef_ * y[sv_indices] * np.sum(K[sv_indices][:, sv_indices], axis=1))

        return self

    def predict(self, X):
        """Perform classification on samples in X."""
        check_is_fitted(self, ['support_vectors_', 'dual_coef_', 'intercept_'])
        X = check_array(X, accept_sparse=False)
        n_samples, n_features = X.shape

        K = self._compute_kernel(self.support_vectors_, X)
        decision_function = np.dot(self.dual_coef_, K) + self.intercept_
        return np.sign(decision_function)
