import numpy as np
from pandas.api.types import CategoricalDtype
from pandas.core.indexes.numeric import NumericIndex
from pandas.core.indexes.base import Index
from pandas.core.dtypes.common import is_integer_dtype
from pandas.errors import InvalidIndexError

class RangeIndex(NumericIndex):
    _typ = "rangeindex"
    _engine_type = None  # This should be set appropriately based on the actual implementation
    _dtype_validation_metadata = {'kind': 'i'}  # Ensures the data type is a signed integer
    _can_hold_na = False
    _range = None

    def __init__(self, start=0, stop=None, step=1, dtype=None, copy=False):
        if stop is None:
            raise ValueError("stop must be specified")
        self._range = range(start, stop, step)
        super().__init__(np.array(list(self._range), dtype=dtype), copy=copy)

    @property
    def start(self):
        return next(iter(self._range))

    @property
    def stop(self):
        return self._range.stop

    @property
    def step(self):
        return self._range.step

    def contains(self, key):
        try:
            return key in self._range
        except TypeError:
            return False

    def __add__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start + other, self.stop + other, self.step)
        else:
            raise TypeError("Unsupported operand type(s) for +: '{}' and '{}'".format(type(self).__name__, type(other).__name__))

    def __sub__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start - other, self.stop - other, self.step)
        else:
            raise TypeError("Unsupported operand type(s) for -: '{}' and '{}'".format(type(self).__name__, type(other).__name__))

    def __mul__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start * other, self.stop * other, self.step)
        else:
            raise TypeError("Unsupported operand type(s) for *: '{}' and '{}'".format(type(self).__name__, type(other).__name__))

    def __truediv__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start // other, self.stop // other, self.step)
        else:
            raise TypeError("Unsupported operand type(s) for /: '{}' and '{}'".format(type(self).__name__, type(other).__name__))

    def __floordiv__(self, other):
        return self.__truediv__(other)

    def __mod__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start % other, self.stop % other, self.step)
        else:
            raise TypeError("Unsupported operand type(s) for %: '{}' and '{}'".format(type(self).__name__, type(other).__name__))

    def __getitem__(self, key):
        if isinstance(key, slice):
            start = key.start or self.start
            stop = key.stop or self.stop
            step = key.step or self.step
            return RangeIndex(start, stop, step)
        elif isinstance(key, int):
            return next(x for i, x in enumerate(self._range) if i == key)
        else:
            raise TypeError("Unsupported index type: {}".format(type(key).__name__))

    def __len__(self):
        return len(self._range)

    def __eq__(self, other):
        if not isinstance(other, RangeIndex):
            return False
        return self._range == other._range

    def __ne__(self, other):
        return not self == other

    def __lt__(self, other):
        if not isinstance(other, RangeIndex):
            return NotImplemented
        return self._range < other._range

    def __le__(self, other):
        if not isinstance(other, RangeIndex):
            return NotImplemented
        return self._range <= other._range

    def __gt__(self, other):
        if not isinstance(other, RangeIndex):
            return NotImplemented
        return self._range > other._range

    def __ge__(self, other):
        if not isinstance(other, RangeIndex):
            return NotImplemented
        return self._range >= other._range

    def __hash__(self):
        return hash(self._range)

    def __repr__(self):
        return f"{self.__class__.__name__}({self.start}, {self.stop}, {self.step})"
