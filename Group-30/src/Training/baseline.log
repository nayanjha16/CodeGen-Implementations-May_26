```cpp
#include <iostream>

// Class representing a node in the binary search tree
class Node {
public:
    int data;         // Integer value stored at this node
    Node *left;       // Pointer to the left child node
    Node *right;      // Pointer to the right child node

    // Constructor to initialize a new node with the given integer value
    Node(int d) : data(d), left(NULL), right(NULL) {}
};

// Class containing methods to manipulate the binary search tree
class Solution {
public:
    // Insert a new node with the specified integer value into the BST
    Node* insert(Node* root, int data) {
        if (root == NULL) {
            return new Node(data);
        } else {
            if (data <= root->data) {
                root->left = insert(root->left, data);
            } else {
                root->right = insert(root->right, data);
            }
            return root;
        }
    }

    // Pre-order traversal method to print the elements of the BST
    void preOrder(Node* root) {
        if (root != NULL) {
            std::cout << root->data << " ";
            preOrder(root->left);
            preOrder(root->right);
        }
    }
};

int main() {
    Solution sol;
    Node* root = NULL;

    // Example usage: Inserting values into the BST
    root = sol.insert(root, 10);
    sol.insert(root, 5);
    sol.insert(root, 15);
    sol.insert(root, 3);
    sol.insert(root, 7);
    sol.insert(root, 12);
    sol.insert(root, 18);

    // Traversing the BST in pre-order
    std::cout << "Pre-order traversal of the BST: ";
    sol.preOrder(root);
    std::cout << std::endl;

    return 0;
}
```

This code defines a `Node` class for the binary search tree nodes and a `Solution` class that contains methods to insert nodes and perform a pre-order traversal. The `main` function demonstrates how to use these classes to create a BST and traverse it.
