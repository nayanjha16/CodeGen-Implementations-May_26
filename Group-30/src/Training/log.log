enum class PageBlockType {
    BLOCK_CONTINUEUS,
    BLOCK_REFERENCE
};

class PageBlock {
public:
    PageBlockType m_type;
    int m_start = -1;
    int m_end = -1;
    int m_reference = -1;
    int m_size = 0;

    bool isValid() const {
        return (m_type == PageBlockType::BLOCK_CONTINUEUS && m_start >= 0 && m_end >= 0) ||
               (m_type == PageBlockType::BLOCK_REFERENCE && m_reference >= 0 && m_size > 0);
    }

    operator bool() const {
        return isValid();
    }

    int getStart() const {
        return m_start;
    }

    int getEnd() const {
        return m_end;
    }
};
