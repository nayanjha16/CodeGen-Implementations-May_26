REPOCODER_PROJECT_ROOT=/data
REPOCODER_ADAPTER_NAME=RepoCoderStudio_FastCorrected_LoRA_v1_0
REPOCODER_ENABLE_RAG=true
REPOCODER_AUTO_DOWNLOAD_PUBLIC_REPOS=true
REPOCODER_ALLOW_MOCK_EMBEDDINGS=false
REPOCODER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REPOCODER_ENABLE_HYBRID_RETRIEVAL=true
REPOCODER_DENSE_SCORE_WEIGHT=0.75
REPOCODER_LEXICAL_SCORE_WEIGHT=0.25
# Enabled for the notebook's real third ablation arm. Set blank explicitly
# only for a latency-sensitive deployment that should use hybrid ranking alone.
REPOCODER_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
REPOCODER_RERANKER_WEIGHT=0.35
REPOCODER_RAG_MIN_TOP_SCORE=0.28
REPOCODER_RAG_MIN_SCORE_MARGIN=0.015
REPOCODER_RAG_ALLOW_AMBIGUOUS_MULTI_SOURCE=true
REPOCODER_PROFILE=development
REPOCODER_ENABLE_ONLINE_REINDEX=false
REPOCODER_ALLOWED_REPO_ROOT=/data/repos
REPOCODER_MAX_INPUT_CHARS=100000
REPOCODER_MAX_CONCURRENT_GENERATIONS=1
REPOCODER_LOG_RETRIEVAL_QUERIES=false
# REPOCODER_API_KEY=set-for-non-public-generation-endpoints
# REPOCODER_ADMIN_TOKEN=set-only-if-online-reindex-is-enabled
