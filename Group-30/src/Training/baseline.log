#include <iostream>
#include <string>

class Point {
private:
    int x; // The x-coordinate of the point
    int y; // The y-coordinate of the point

public:
    // Method to set the position of the point
    Point& setPos(int px, int py) {
        x = px;
        y = py;
        return *this;
    }

    // Getter for the x-coordinate
    int getX() const {
        return x;
    }

    // Setter for the x-coordinate
    void setX(int px) {
        x = px;
    }

    // Getter for the y-coordinate
    int getY() const {
        return y;
    }

    // Setter for the y-coordinate
    void setY(int py) {
        y = py;
    }
};

int main() {
    Point p;
    p.setPos(10, 20);
    std::cout << "Point is at (" << p.getX() << ", " << p.getY() << ")" << std::endl;

    p.setX(30);
    p.setY(40);
    std::cout << "Updated point is at (" << p.getX() << ", " << p.getY() << ")" << std::endl;

    return 0;
}
```

