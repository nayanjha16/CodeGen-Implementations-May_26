# Program 1: Checking Armstrong Numbers

def is_armstrong_number(n):
    # Calculate the digits
    i = n // 100
    j = (n // 10) % 10
    k = n % 10
    
    # Check if the number is an Armstrong number
    return n == i**3 + j**3 + k**3

def check_armstrong_numbers():
    # Loop through numbers from 400 to 500
    for n in range(400, 501):
        if is_armstrong_number(n):
            print(n)

# Run the function to check Armstrong numbers
