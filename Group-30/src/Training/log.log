#include "ScriptMgr.h"
#include "Creature.h"
#include "CreatureAI.h"
#include "GameObject.h"
#include "Map.h"
#include "Player.h"
#include "SpellInfo.h"

class boss_selin_fireheartAI : public ScriptedAI {
public:
    explicit boss_selin_fireheartAI(Creature* creature) : ScriptedAI(creature), m_pInstance(nullptr), m_bIsRegularMode(true) {
        InitializeTimers();
    }

    void InitializeTimers() {
        DrainLifeTimer = 10000; // 10 seconds
        DrainManaTimer = 15000; // 15 seconds
        FelExplosionTimer = 20000; // 20 seconds
        DrainCrystalTimer = 25000; // 25 seconds
        EmpowerTimer = 30000; // 30 seconds
        IsDraining = false;
        DrainingCrystal = ObjectGuid::Empty;
    }

    void Reset() override {
        InitializeTimers();
        me->RemoveAurasDueToSpell(SPELL_DRAIN_LIFE);
        me->RemoveAurasDueToSpell(SPELL_DRAIN_MANA);
        me->RemoveAurasDueToSpell(SPELL_FEL_EXPLOSION);
        me->RemoveAurasDueToSpell(SPELL_DRAIN_CRYSTAL);
        me->RemoveAurasDueToSpell(SPELL_EMPOWER);

        if (m_pInstance)
            m_pInstance->SetBossState(DATA_SELIN_FIREHEART, NOT_STARTED);
    }

    void EnterCombat(Unit* who) override {
        ScriptedAI::EnterCombat(who);
        if (m_pInstance)
            m_pInstance->SetBossState(DATA_SELIN_FIREHEART, IN_PROGRESS);
    }

    void UpdateAI(uint32 diff) override {
        if (!UpdateVictim())
            return;

        if (DrainLifeTimer <= diff) {
            DoCast(me->getVictim(), SPELL_DRAIN_LIFE);
            DrainLifeTimer = 10000; // Reset timer
        } else {
            DrainLifeTimer -= diff;
        }

        if (DrainManaTimer <= diff) {
            DoCast(me->getVictim(), SPELL_DRAIN_MANA);
            DrainManaTimer = 15000; // Reset timer
        } else {
            DrainManaTimer -= diff;
        }

        if (FelExplosionTimer <= diff) {
            DoCastAOE(SPELL_FEL_EXPLOSION);
            FelExplosionTimer = 20000; // Reset timer
        } else {
            FelExplosionTimer -= diff;
        }

        if (DrainCrystalTimer <= diff && !IsDraining) {
            SelectRandomCrystal();
            if (DrainingCrystal != ObjectGuid::Empty) {
                DoCast(DrainingCrystal, SPELL_DRAIN_CRYSTAL);
                IsDraining = true;
                DrainCrystalTimer = 25000; // Reset timer
            }
        } else if (IsDraining) {
            DrainCrystalTimer -= diff;
            if (DrainCrystalTimer <= diff) {
                IsDraining = false;
                DrainingCrystal = ObjectGuid::Empty;
            }
        }

        if (EmpowerTimer <= diff) {
            DoCast(me, SPELL_EMPower);
            EmpowerTimer = 30000; // Reset timer
        } else {
            EmpowerTimer -= diff;
        }

        DoMeleeAttackIfReady();
    }

private:
    InstanceScript* m_pInstance;
    bool m_bIsRegularMode;
    std::list<ObjectGuid> Crystals;
    uint32 DrainLifeTimer;
    uint32 DrainManaTimer;
    uint32 FelExplosionTimer;
    uint32 DrainCrystalTimer;
    uint32 EmpowerTimer;
    bool IsDraining;
    ObjectGuid DrainingCrystal;

    void SelectRandomCrystal() {
        if (Crystals.empty())
            return;

        auto it = Crystals.begin();
        std::advance(it, rand() % Crystals.size());
        DrainingCrystal = *it;
    }
};

void AddSC_boss_selin_fireheart() {
    new boss_selin_fireheartAI(npc_selin_fireheart);
}
```

