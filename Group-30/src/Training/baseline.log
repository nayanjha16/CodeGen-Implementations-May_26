    size_t getNumAssetBalances() const { return numAssetBalances; }
    size_t getNumVestingBalances() const { return numVestingBalances; }
    size_t getNumCanceledAsks() const { return numCanceledAsks; }
    size_t getNumCanceledBids() const { return numCanceledBids; }
    size_t getNumCanceledShorts() const { return numCanceledShorts; }
    size_t getNumAccountNames() const { return numAccountNames; }
    size_t getNumWitnesses() const { return numWitnesses; }
    size_t getNumWorkers() const { return numWorkers; }
