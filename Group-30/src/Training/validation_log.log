    @patch('subprocess.run')
    def test_upload_gallery(self, subprocess_run):
        """Tests the upload_gallery method of the AWS uploader to ensure it correctly uploads files to an S3 bucket."""
        temp_dir = TempDirectory()
        try:
            uploader = get_uploader('aws')
            files_to_upload = [temp_dir.getpath(f'test_file_{i}.jpg') for i in range(3)]
            for file_path in files_to_upload:
