#ifndef CLI_ARGS_HPP
#define CLI_ARGS_HPP

#include <string>

struct cli_args {
    // Network and Routing Options
    std::string net;  // Network file name
    int units;        // Number of units
    bool gd;          // Generic Dijkstra search algorithm flag
    bool bf;          // Brute force search algorithm flag
    bool ee;          // Edge exclusion search algorithm flag

    // Traffic Options
    double mcat;       // Mean client arrival time
    double ol;         // Offered load
    double mht;        // Mean holding time
    double mnu;        // Mean number of units

    // Simulation Options
    int sim_time;     // Simulation time
    int seed;         // Random seed
};

// Function to parse command-line arguments into cli_args structure
cli_args parse_cli_args(int argc, char* argv[]) {
    cli_args args;
    // Default values
    args.net = "default_network.txt";
    args.units = 10;
    args.gd = false;
    args.bf = false;
    args.ee = false;
    args.mcat = 0.0;
    args.ol = 0.0;
    args.mht = 0.0;
    args.mnu = 0.0;
    args.sim_time = 1000;
    args.seed = 42;

    for (int i = 1; i < argc; ++i) {
        if (std::string(argv[i]) == "--network") {
            if (i + 1 < argc) {
                args.net = argv[++i];
            }
        } else if (std::string(argv[i]) == "--units") {
            if (i + 1 < argc) {
                args.units = std::stoi(argv[++i]);
            }
        } else if (std::string(argv[i]) == "--gd") {
            args.gd = true;
        } else if (std::string(argv[i]) == "--bf") {
            args.bf = true;
        } else if (std::string(argv[i]) == "--ee") {
            args.ee = true;
        } else if (std::string(argv[i]) == "--mcat") {
            if (i + 1 < argc) {
                args.mcat = std::stod(argv[++i]);
            }
        } else if (std::string(argv[i]) == "--ol") {
            if (i + 1 < argc) {
                args.ol = std::stod(argv[++i]);
            }
        } else if (std::string(argv[i]) == "--mht") {
            if (i + 1 < argc) {
                args.mht = std::stod(argv[++i]);
            }
        } else if (std::string(argv[i]) == "--mnu") {
            if (i + 1 < argc) {
                args.mnu = std::stod(argv[++i]);
            }
        } else if (std::string(argv[i]) == "--sim-time") {
            if (i + 1 < argc) {
                args.sim_time = std::stoi(argv[++i]);
            }
        } else if (std::string(argv[i]) == "--seed") {
            if (i + 1 < argc) {
                args.seed = std::stoi(argv[++i]);
            }
        }
    }

    return args;
}

#endif // CLI_ARGS_HPP
```

This code defines a `cli_args` struct to store command-line arguments and a `parse_cli_args` function to parse these arguments from the command line. The function sets default values and updates them based on the provided command-line options.
