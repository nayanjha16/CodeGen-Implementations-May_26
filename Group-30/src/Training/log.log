```cpp
#include <memory>
#include <string>

namespace Http {
    namespace RateLimit {

        enum class State {
            Waiting,
            Calling,
            Responded,
            Complete
        };

        class StreamDecoderFilterCallbacks {
            // Mock implementation for demonstration purposes
        public:
            virtual void sendLocalReply(uint32_t status, const std::string& body) = 0;
        };

        class RateLimitClient {
            // Mock implementation for demonstration purposes
        public:
            virtual bool checkRateLimit(const std::string& key, uint32_t limit, uint32_t interval) = 0;
        };

        class FilterConfig {
            // Mock implementation for demonstration purposes
        public:
            virtual uint32_t getRateLimit() const = 0;
            virtual uint32_t getInterval() const = 0;
        };

        class ThreadLocalCluster {
            // Mock implementation for demonstration purposes
        public:
            virtual std::string getName() const = 0;
        };

        class Filter {
        private:
            StreamDecoderFilterCallbacks* callbacks_;
            RateLimitClient* client_;
            FilterConfig* config_;
            ThreadLocalCluster* cluster_;
            State state_;
            bool initiating_call_;

        public:
            Filter(StreamDecoderFilterCallbacks* callbacks, RateLimitClient* client, FilterConfig* config, ThreadLocalCluster* cluster)
                : callbacks_(callbacks), client_(client), config_(config), cluster_(cluster), state_(State::Waiting), initiating_call_(false) {}

            void onNewRequest() {
                if (state_ == State::Waiting) {
                    state_ = State::Calling;
                    initiateRateLimitCheck();
                }
            }

        private:
            void initiateRateLimitCheck() {
                if (!initiating_call_) {
                    initiating_call_ = true;
                    auto key = cluster_->getName();
                    auto limit = config_->getRateLimit();
                    auto interval = config_->getInterval();

                    if (!client_->checkRateLimit(key, limit, interval)) {
                        handleRateLimitExceeded();
                    } else {
                        handleRateLimitPassed();
                    }
                }
            }

            void handleRateLimitExceeded() {
                callbacks_->sendLocalReply(429, "Too Many Requests");
                state_ = State::Responded;
            }

            void handleRateLimitPassed() {
                // Proceed with the request
                state_ = State::Complete;
            }
        };
    }
}
```

This code defines the `Filter` class within the `Http::RateLimit` namespace, which implements the rate-limiting functionality for HTTP requests. The class uses mock implementations for dependencies such as `StreamDecoderFilterCallbacks`, `RateLimitClient`, `FilterConfig`, and `ThreadLocalCluster`. The `onNewRequest` method handles incoming requests, initiates a rate-limiting check, and responds appropriately based on the result.
