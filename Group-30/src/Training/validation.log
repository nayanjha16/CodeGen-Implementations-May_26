```python
import usocket
import ujson

class Response:
    def __init__(self, sock):
        self.sock = sock
        self.status_code = None
        self.headers = {}
        self.body = b''

    @property
    def content(self):
        return self.body

    @property
    def text(self):
        return self.body.decode('utf-8')

    def close(self):
        self.sock.close()

    def json(self):
        return ujson.loads(self.text)

def delete(url, **kwargs):
    return _request('DELETE', url, **kwargs)

def _request(method, url, **kwargs):
    # Parse URL components
    parts = url.split('/')
    host = parts[2]
    path = '/' + '/'.join(parts[3:])
    
    # Create socket
    s = usocket.socket(usocket.AF_INET, usocket.SOCK_STREAM)
    s.connect((host, 80))
    
    # Build request
    headers = {
        'Host': host,
        'Connection': 'close'
    }
    headers.update(kwargs.get('headers', {}))
    
    query_params = kwargs.get('params')
    if query_params:
        query_string = '&'.join([f'{k}={v}' for k, v in query_params.items()])
        path += '?' + query_string
    
    request = f'{method} {path} HTTP/1.1\r\n'
    request += '\r\n'.join([f'{k}: {v}' for k, v in headers.items()]) + '\r\n\r\n'
    
    # Send request
    s.sendall(request.encode('utf-8'))
    
    # Receive response
    response = s.recv(4096).decode('utf-8')
    s.close()
    
    # Parse response
    lines = response.split('\r\n')
    status_line = lines[0]
    headers_lines = lines[1:-2]
    body = '\r\n'.join(lines[-2:])
    
    status_parts = status_line.split()
    response_obj = Response(s)
    response_obj.status_code = int(status_parts[1])
    
    for line in headers_lines:
        key, value = line.split(': ', 1)
        response_obj.headers[key] = value
    
    response_obj.body = body.encode('utf-8')
    
    return response_obj
```

This code defines the `Response` class and the `delete` function as per the provided documentation. The `_request` function is a helper function used internally by both `get`, `post`, `put`, and `delete` to handle the actual HTTP request and response processing.
