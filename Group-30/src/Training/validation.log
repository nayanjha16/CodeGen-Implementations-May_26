```python
import http.server
import socketserver
import json
import xml.etree.ElementTree as ET
from threading import Lock

class PlexHttpHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        self.config = kwargs.pop('config')
        self.hdhr_station_scan = False
        self.rmg_station_scans = []
        self.local_locast = None
        self.location = {}
        super().__init__(*args, directory=self.config['webroot'], **kwargs)

    def do_GET(self):
        if self.path == '/lineup.xml':
            response = self.generate_lineup_xml()
        elif self.path == '/metadata.json':
            response = self.generate_metadata_json()
        else:
            response = super().do_GET()

        self.send_response(200)
        self.send_header('Content-type', 'application/xml' if self.path == '/lineup.xml' else 'application/json')
        self.end_headers()
        self.wfile.write(response.encode())

    def do_POST(self):
        content_length = int(self.headers['Content-Length'])
        post_data = self.rfile.read(content_length)
        data = json.loads(post_data.decode())

        if data.get('action') == 'start_scan':
            self.start_station_scan()
        elif data.get('action') == 'abort_scan':
            self.abort_station_scan()

        self.send_response(200)
        self.send_header('Content-type', 'application/json')
        self.end_headers()
        self.wfile.write(json.dumps({'status': 'success'}).encode())

    def do_DELETE(self):
        if self.path.startswith('/stop_scan/'):
            sid = self.path.split('/')[-1]
            self.stop_station_scan(sid)

        self.send_response(200)
        self.send_header('Content-type', 'application/json')
        self.end_headers()
        self.wfile.write(json.dumps({'status': 'success'}).encode())

    def do_tuning(self, sid):
        # Placeholder for tuning logic
        pass

    def generate_lineup_xml(self):
        root = ET.Element("Lineup")
        for station in self.config['stations']:
            channel = ET.SubElement(root, "Channel", id=station['id'], number=station['number'])
            display_name = ET.SubElement(channel, "DisplayName")
            display_name.text = station['name']
        return ET.tostring(root, encoding='unicode')

    def generate_metadata_json(self):
        return json.dumps(self.config['stations'])

    def start_station_scan(self):
        self.hdhr_station_scan = True
        # Placeholder for actual scan logic

    def abort_station_scan(self):
        self.hdhr_station_scan = False
        # Placeholder for actual abort logic

    def stop_station_scan(self, sid):
        if sid in self.rmg_station_scans:
            self.rmg_station_scans.remove(sid)
            # Placeholder for actual stop logic

if __name__ == '__main__':
    PORT = 8080
    Handler = PlexHttpHandler
    Handler.config = {
        'webroot': 'path/to/webroot',
        'stations': [
            {'id': '1', 'number': '1', 'name': 'Station 1'},
            {'id': '2', 'number': '2', 'name': 'Station 2'}
        ]
    }

    with socketserver.TCPServer(("", PORT), Handler) as httpd:
        print(f"Serving at port {PORT}")
        httpd.serve_forever()
```

This code defines a `PlexHttpHandler` class that inherits from `http.server.SimpleHTTPRequestHandler`. It handles GET, POST, and DELETE requests to provide XML and JSON responses for lineup information and metadata. The class also includes methods for starting and stopping station scans. The server is set up to run on port 8080 and serves files from a specified webroot directory.
