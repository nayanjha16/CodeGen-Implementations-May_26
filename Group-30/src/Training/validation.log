```python
from vanilla import Window, Slider, Button, Group
import mojo.roboFont as roboFont

class slideGlyphsDialog:
    def __init__(self):
        self.font = roboFont.getCurrentFont()
        self.font_name = self.font.info.familyName
        
        self._moveX = 0
        self._moveY = 0
        self._xMax = 100
        self._xMin = -100
        self._yMax = 100
        self._yMin = -100
        
        self.w = Window((200, 150), "Slide Glyphs")
        
        group = Group((10, 10, -10, -10))
        group.xSlider = Slider((10, 10, -10, 22), minvalue=self._xMin, maxvalue=self._xMax, value=0, callback=self.updateMoveX)
        group.ySlider = Slider((10, 40, -10, 22), minvalue=self._yMin, maxvalue=self._yMax, value=0, callback=self.updateMoveY)
        group.resetButton = Button((10, 70, -10, 22), title="Reset", callback=self.resetPosition)
        
        self.w.open()
    
    def updateMoveX(self, sender):
        self._moveX = sender.value
        self.applyTransformations()
    
    def updateMoveY(self, sender):
        self._moveY = sender.value
        self.applyTransformations()
    
    def resetPosition(self, sender):
        self._moveX = 0
        self._moveY = 0
        self.w.xSlider.set(0)
        self.w.ySlider.set(0)
        self.applyTransformations()
    
    def applyTransformations(self):
        if not self.font.selection:
            return
        
        for glyph in self.font.selection:
            glyph.transform([1, 0, 0, 1, self._moveX, self._moveY])

# Example usage
dialog = slideGlyphsDialog()
```

