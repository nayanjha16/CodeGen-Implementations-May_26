import cPickle
import numpy as np
from elm import ELMClassifier
from sklearn.linear_model import LogisticRegression

def load_mnist(path='../../Data/mnist.pkl'):
    """
    Loads the MNIST dataset from a specified file path using cPickle.

    Parameters:
    - path: str, the file path where the MNIST dataset is stored. Default value is '../Data/mnist.pkl'.

    Return Value:
    - dataset: Python object, the loaded MNIST dataset.
    """
    with open(path, 'rb') as f:
        dataset = cPickle.load(f)
    return dataset

def get_datasets(dataset):
    """
    Processes the raw MNIST dataset into training, validation, and test sets.

    Parameters:
    - dataset: dict, the raw MNIST dataset containing 'train', 'valid', and 'test' keys.

    Return Value:
    - train_data: numpy.ndarray, the training data.
    - train_labels: numpy.ndarray, the training labels.
    - valid_data: numpy.ndarray, the validation data.
    - valid_labels: numpy.ndarray, the validation labels.
    - test_data: numpy.ndarray, the test data.
    - test_labels: numpy.ndarray, the test labels.
    """
    train_data = dataset['train'][0]
    train_labels = dataset['train'][1]
    valid_data = dataset['valid'][0]
    valid_labels = dataset['valid'][1]
    test_data = dataset['test'][0]
    test_labels = dataset['test'][1]
    
    return train_data, train_labels, valid_data, valid_labels, test_data, test_labels

def build_elm_classifier(train_data, train_labels, hidden_layer_size=100):
    """
    Builds an Extreme Learning Machine (ELM) classifier using the provided training data.

    Parameters:
    - train_data: numpy.ndarray, the training data.
    - train_labels: numpy.ndarray, the training labels.
    - hidden_layer_size: int, the number of neurons in the hidden layer. Default value is 100.

    Return Value:
    - elm_classifier: ELMClassifier, the trained ELM classifier.
    """
    elm_classifier = ELMClassifier(hidden_layer_size=hidden_layer_size)
    elm_classifier.fit(train_data, train_labels)
    return elm_classifier

def evaluate_classifier(classifier, data, labels):
    """
    Evaluates the performance of the given classifier on the provided data and labels.

    Parameters:
    - classifier: object, the classifier to evaluate.
    - data: numpy.ndarray, the evaluation data.
    - labels: numpy.ndarray, the true labels for the evaluation data.

    Return Value:
    - accuracy: float, the accuracy of the classifier on the evaluation data.
    """
    predictions = classifier.predict(data)
    accuracy = np.mean(predictions == labels)
    return accuracy

if __name__ == "__main__":
    # Load the MNIST dataset
    mnist_dataset = load_mnist()
    
    # Get the processed datasets
    train_data, train_labels, valid_data, valid_labels, test_data, test_labels = get_datasets(mnist_dataset)
    
    # Build the ELM classifier
    elm_classifier = build_elm_classifier(train_data, train_labels)
    
    # Evaluate the classifier on validation set
    valid_accuracy = evaluate_classifier(elm_classifier, valid_data, valid_labels)
    print(f"Validation Accuracy: {valid_accuracy:.4f}")
    
    # Evaluate the classifier on test set
    test_accuracy = evaluate_classifier(elm_classifier, test_data, test_labels)
    print(f"Test Accuracy: {test_accuracy:.4f}")
```

This code includes the functions `load_mnist`, `get_datasets`, `build_elm_classifier`, and `evaluate_classifier`, along with the main execution block that loads the MNIST dataset, processes it, builds an ELM classifier, and evaluates its performance on both the validation and test sets.
