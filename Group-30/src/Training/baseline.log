        size_t numUiAs
    ) : numBalanceOwners(numBalanceOwners),
        numAssetBalances(numAssetBalances),
        numVestingBalances(numVestingBalances),
        numCanceledAsks(numCanceledAsks),
        numCanceledBids(numCanceledBids),
        numCanceledShorts(numCanceledShorts),
        numAccountNames(numAccountNames),
        numWitnesses(numWitnesses),
        numWorkers(numWorkers),
        numMias(numMias),
        numCollateralPositions(numCollateralPositions),
        numUiAs(numUiAs) {}

