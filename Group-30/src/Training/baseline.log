#include <iostream>
#include <cstring>

class LogStream {
public:
    // Constructor initializes the buffer and its pointer
    LogStream() : buf_size_(1024), buf_pointer_(0) {
        buf_ = new char[buf_size_];
        buf_[buf_pointer_] = '\0';
    }

    // Destructor ensures the buffer is properly terminated before destruction
    ~LogStream() {
        delete[] buf_;
    }

    // Overloaded insertion operator for integers
    LogStream& operator<<(int value) {
        char temp[20];
        snprintf(temp, sizeof(temp), "%d", value);
        append(temp);
        return *this;
    }

    // Overloaded insertion operator for floating-point numbers
    LogStream& operator<<(double value) {
        char temp[20];
        snprintf(temp, sizeof(temp), "%.2f", value);
        append(temp);
        return *this;
    }

    // Overloaded insertion operator for strings
    LogStream& operator<<(const std::string& value) {
        append(value.c_str());
        return *this;
    }

    // Overloaded insertion operator for booleans
    LogStream& operator<<(bool value) {
        const char* str = value ? "true" : "false";
        append(str);
        return *this;
    }

    // Method to get the constructed log message
    const char* str() const {
        return buf_;
    }

private:
    char* buf_;          // Internal buffer to store the log message
    size_t buf_pointer_; // Index indicating the current position within the buffer
    size_t buf_size_;     // Total size of the buffer

    // Helper method to append a string to the buffer
    void append(const char* str) {
        size_t len = strlen(str);
        if (buf_pointer_ + len >= buf_size_) {
            resize();
        }
        strcpy(buf_ + buf_pointer_, str);
        buf_pointer_ += len;
    }

    // Helper method to resize the buffer
    void resize() {
        buf_size_ *= 2;
        char* new_buf = new char[buf_size_];
        strcpy(new_buf, buf_);
        delete[] buf_;
        buf_ = new_buf;
    }
};

// Global output function defaults to writing to stdout
void g_out(const LogStream& logStream) {
    std::cout << logStream.str();
}

// Global flush function defaults to flushing stdout
void g_flush() {
    std::cout.flush();
}
```

This code defines a `LogStream` class that allows constructing log messages by chaining insertions of various data types. It also includes global functions `g_out` and `g_flush` for outputting and flushing the log messages, respectively. The implementation uses dynamic memory management to handle the buffer and ensures proper termination of the buffer in the destructor.
