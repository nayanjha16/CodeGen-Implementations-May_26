```python
# Global variables
summary = 0
i = 0

# Main function to calculate the sum of the first five non-negative integers
def calculate_sum():
    global summary, i
    
    # Step 1: Initialize variables
    summary = 0
    i = 0
    
    # Step 2: Enter the while loop
    while i < 5:
        # Step 3: Inside the loop
        summary += i  # Add the current value of i to summary
        print(f"Current sum: {summary}")  # Print the updated value of summary
        i += 1  # Increment i by 1
        
    # Step 4: Loop completes
    print("Loop completed.")

# Call the main function
calculate_sum()
```

