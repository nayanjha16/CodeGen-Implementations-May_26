```cpp
#include <array>
#include <cmath>
#include <iostream>

namespace Math {

template <size_t N, typename T>
class Vector {
public:
    // Constructor that initializes the vector from an array
    constexpr Vector(const std::array<T, N>& data)
        : data_(data) {}

    // Method to calculate the magnitude of the vector
    T length(std::function<T(T)> sqrt_function = std::sqrt) const {
        T sum = 0;
        for (const auto& elem : data_) {
            sum += elem * elem;
        }
        return sqrt_function(sum);
    }

    // Accessor for the underlying data
    const std::array<T, N>& data() const {
        return data_;
    }

private:
    std::array<T, N> data_;
};

// Specialization for 2D vectors
using Vector2 = Vector<2, double>;

// Specialization for 3D vectors
using Vector3 = Vector<3, double>;

// Specialization for 4D vectors
using Vector4 = Vector<4, double>;

// Utility function to output a vector as a string
template <size_t N, typename T>
std::ostream& operator<<(std::ostream& os, const Vector<N, T>& vec) {
    os << "(";
    for (size_t i = 0; i < N; ++i) {
        if (i > 0) os << ", ";
        os << vec.data()[i];
    }
    os << ")";
    return os;
}

// Linear interpolation between two vectors
template <size_t N, typename T>
Vector<N, T> lerp(const Vector<N, T>& v1, const Vector<N, T>& v2, T t) {
    Vector<N, T> result;
    for (size_t i = 0; i < N; ++i) {
        result.data()[i] = v1.data()[i] + t * (v2.data()[i] - v1.data()[i]);
    }
    return result;
}

} // namespace Math
```

This code defines a generic `Vector` template class along with specializations for 2D, 3D, and 4D vectors. It includes methods for calculating the vector's magnitude, accessing the underlying data, and overloading the stream insertion operator for easy printing. Additionally, a linear interpolation function is provided.
