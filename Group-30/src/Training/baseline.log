// Helper Functions
void connectToService() {
    if (!isConnected) {
        hPipe = CreateFile(
            "\\\\.\\pipe\\wgbgservice",
            GENERIC_READ | GENERIC_WRITE,
            0,
            NULL,
            OPEN_EXISTING,
            FILE_ATTRIBUTE_NORMAL,
            NULL);

        if (hPipe == INVALID_HANDLE_VALUE) {
            std::cerr << "Failed to connect to service" << std::endl;
            return;
        }
        isConnected = true;
    }
}

void disconnectFromService() {
    if (isConnected) {
        CloseHandle(hPipe);
        isConnected = false;
    }
}

void sendOperation(Operation op, const std::string& data) {
    if (!isConnected) {
        std::cerr << "Not connected to service" << std::endl;
        return;
    }

    char buffer[BUFSIZE];
    DWORD bytesWritten;

    switch (op) {
        case STORE_WG:
            sprintf(buffer, "%d:%s", STORE_WG, data.c_str());
            break;
        case SEND_ID:
            sprintf(buffer, "%d:%s", SEND_ID, data.c_str());
            break;
        case RETRIEVE_WG:
            sprintf(buffer, "%d:%s", RETRIEVE_WG, data.c_str());
            break;
        case DELETE_WG:
            sprintf(buffer, "%d:%s", DELETE_WG, data.c_str());
            break;
        case TERMINATE_SERVICE:
            sprintf(buffer, "%d", TERMINATE_SERVICE);
            break;
        default:
            std::cerr << "Unknown operation" << std::endl;
            return;
    }

    WriteFile(hPipe, buffer, strlen(buffer), &bytesWritten, NULL);
}

std::string receiveResponse() {
    if (!isConnected) {
        std::cerr << "Not connected to service" << std::endl;
        return "";
    }

    char buffer[BUFSIZE];
    DWORD bytesRead;

    ReadFile(hPipe, buffer, BUFSIZE - 1, &bytesRead, NULL);
    buffer[bytesRead] = '\0';

    return std::string(buffer);
}

// Main Function
int main() {
    connectToService();

    // Example usage
    WorkGround wg;
    std::string serializedWg;
    WorkGround::serialize(wg, serializedWg);
    sendOperation(STORE_WG, serializedWg);
    std::cout << "Response: " << receiveResponse() << std::endl;

    disconnectFromService();
    return 0;
}
```

