from mpi4py import MPI

def test_1():
    worker_shape = [2, 2]
    world = MPI.COMM_WORLD
    num_workers = worker_shape[0] * worker_shape[1]
    comm = world.Split(color=world.Get_rank() // worker_shape[1], key=world.Get_rank())
    
    if comm.Get_rank() == 0:
        x = torch.arange(8).reshape(worker_shape)
    else:
        x = None
    
    e = torch.tensor([0, 1, 2, 3, 4, 5, 6, 7])
    
    y = comm.gather(x, root=0)
    
    if comm.Get_rank() == 0:
        assert torch.equal(torch.cat(y), e)

