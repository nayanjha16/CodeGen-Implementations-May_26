#include <boost/qvm/all.hpp>
#include <iostream>

// Define the wrap class template
template <typename T>
class wrap {
public:
    // Field
    T t;

    // Constructors
    wrap() : t(T()) {}
    explicit wrap(T t) : t(t) {}
};

// Overload the multiplication operator for wrap<T> and S
template <typename S, typename T>
wrap<typename boost::qvm::scalar_of<S>::type> operator*(S s, const wrap<T>& w) {
    return wrap<typename boost::qvm::scalar_of<S>::type>(s * w.t);
}

// Overload the addition operator for wrap<T>
template <typename T>
wrap<T> operator+(const wrap<T>& w1, const wrap<T>& w2) {
    return wrap<T>(w1.t + w2.t);
}

int main() {
    // Create a wrap object with a scalar value
    wrap<double> angle(M_PI);

    // Define a vector to rotate
    boost::qvm::vec<double, 3> v = {1.0, 0.0, 0.0};

    // Rotate the vector around the z-axis by π radians
    boost::qvm::rotate(v, angle.t, boost::qvm::vec<double, 3>{0.0, 0.0, 1.0});

    // Print the rotated vector
    std::cout << "Rotated Vector: (" 
              << v[0] << ", " << v[1] << ", " << v[2] << ")" << std::endl;

    return 0;
}
```

This code defines a `wrap` class template that wraps a scalar value and provides constructors for initialization. It also overloads the multiplication and addition operators for the `wrap` class. The `main` function demonstrates rotating a vector around the z-axis by π radians using the Boost QVM library and prints the result.
