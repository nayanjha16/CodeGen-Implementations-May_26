#include <iostream>
#include <string>
#include <vector>
#include <nlohmann/json.hpp>

namespace mo {
    namespace sys {
        namespace combat {

            class Health_comp {
            public:
                // Constructor
                Health_comp() : _auto_heal_max(0), _auto_heal(0), _max_hp(100), _current_hp(100) {}

                // Load state from JSON
                void load_from_json(const nlohmann::json& json_data) {
                    if (json_data.contains("auto_heal_max")) _auto_heal_max = json_data["auto_heal_max"];
                    if (json_data.contains("auto_heal")) _auto_heal = json_data["auto_heal"];
                    if (json_data.contains("max_hp")) _max_hp = json_data["max_hp"];
                    if (json_data.contains("current_hp")) _current_hp = json_data["current_hp"];
                    if (json_data.contains("physical_resistance")) _physical_resistence = json_data["physical_resistance"];
                    if (json_data.contains("resistances")) _resistences = json_data["resistances"];
                    if (json_data.contains("vulnerabilities")) _vulnerabilities = json_data["vulnerabilities"];
                    if (json_data.contains("death_effect")) _death_effect = json_data["death_effect"];
                }

                // Save state to JSON
                nlohmann::json save_to_json() const {
                    nlohmann::json json_data;
                    json_data["auto_heal_max"] = _auto_heal_max;
                    json_data["auto_heal"] = _auto_heal;
                    json_data["max_hp"] = _max_hp;
                    json_data["current_hp"] = _current_hp;
                    json_data["physical_resistance"] = _physical_resistence;
                    json_data["resistances"] = _resistences;
                    json_data["vulnerabilities"] = _vulnerabilities;
                    json_data["death_effect"] = _death_effect;
                    return json_data;
                }

                // Apply damage based on element type
                void apply_damage(int damage, const std::string& element_type) {
                    int effective_damage = damage;
                    if (_resistences.find(element_type) != _resistences.end()) {
                        effective_damage /= 2; // Reduce damage by half for resistant elements
                    } else if (_vulnerabilities.find(element_type) != _vulnerabilities.end()) {
                        effective_damage *= 2; // Increase damage by double for vulnerable elements
                    }
                    _current_hp -= effective_damage;
                    if (_current_hp <= 0) {
                        _current_hp = 0;
                        trigger_death_effect();
                    }
                }

                // Get current health
                int get_current_health() const { return _current_hp; }

                // Set current health
                void set_current_health(int hp) { _current_hp = hp; }

                // Get maximum health
                int get_max_health() const { return _max_hp; }

                // Set maximum health
                void set_max_health(int max_hp) { _max_hp = max_hp; }

                // Get auto heal rate
                int get_auto_heal_rate() const { return _auto_heal; }

                // Set auto heal rate
                void set_auto_heal_rate(int auto_heal) { _auto_heal = auto_heal; }

                // Get physical resistance
                int get_physical_resistance() const { return _physical_resistence; }

                // Set physical resistance
                void set_physical_resistance(int resistance) { _physical_resistence = resistance; }

                // Get resistances
                const std::vector<std::string>& get_resistances() const { return _resistences; }

                // Add resistance
                void add_resistance(const std::string& element) { _resistences.push_back(element); }

                // Remove resistance
                void remove_resistance(const std::string& element) {
                    _resistences.erase(std::remove(_resistences.begin(), _resistences.end(), element), _resistences.end());
                }

                // Get vulnerabilities
                const std::vector<std::string>& get_vulnerabilities() const { return _vulnerabilities; }

                // Add vulnerability
                void add_vulnerability(const std::string& element) { _vulnerabilities.push_back(element); }

                // Remove vulnerability
                void remove_vulnerability(const std::string& element) {
                    _vulnerabilities.erase(std::remove(_vulnerabilities.begin(), _vulnerabilities.end(), element), _vulnerabilities.end());
                }

                // Get death effect
                const std::string& get_death_effect() const { return _death_effect; }

                // Set death effect
                void set_death_effect(const std::string& effect) { _death_effect = effect; }

            private:
                int _auto_heal_max;
                int _auto_heal;
                int _max_hp;
                int _current_hp;
                int _physical_resistence;
                std::vector<std::string> _resistences;
                std::vector<std::string> _vulnerabilities;
                std::string _death_effect;

                // Trigger death effect
                void trigger_death_effect() {
                    // Implementation of death effect
                    std::cout << "Death effect triggered: " << _death_effect << std::endl;
                }
            };

        } // namespace combat
    } // namespace sys
} // namespace mo
```

