 * 
 * This file implements a simple config wrapper around some json stuff.
 */

#include <fstream>
#include "ConfigWrapper.hpp"

namespace server {
    
void ConfigWrapper::init(std::string path) {
    std::ifstream i(path);
    i >> config_;
    i.close();
}

std::string ConfigWrapper::getValue(std::string key) {
    if (!config_.contains(key)) {
        return "";
    }
    return config_[key].get<std::string>();
}
