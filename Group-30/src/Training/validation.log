#include <opencv2/opencv.hpp>
#include <iostream>

using namespace cv;
using namespace std;

class GCApplication {
public:
    enum { NOT_SET = 0, IN_PROCESS = 1, SET = 2 };
    static const int radius = 2;
    static const int thickness = -1;
    const string* winName;
    const Mat* image;
    Mat mask;
    Rect rect;
    int state;
    Point prevPt;

    GCApplication(const string& windowName, const Mat& img) 
        : winName(&windowName), image(&img), state(NOT_SET) {}

    void run() {
        namedWindow(*winName);
        setMouseCallback(*winName, mouseHandler, this);

        while (true) {
            imshow(*winName, *image);
            char key = waitKey(0);
            if (key == 's') {
                saveSegmentedResult();
                break;
            }
        }

        destroyAllWindows();
    }

private:
    void mouseHandler(int event, int x, int y, int flags, void* userdata) {
        GCApplication* app = static_cast<GCApplication*>(userdata);
        switch (event) {
            case EVENT_LBUTTONDOWN:
                if (app->state == NOT_SET) {
                    app->rect.x = x;
                    app->rect.y = y;
                    app->state = IN_PROCESS;
                } else if (app->state == IN_PROCESS) {
                    app->rect.width = x - app->rect.x;
                    app->rect.height = y - app->rect.y;
                    app->state = SET;
                    applyGrabCut();
                }
                break;
            case EVENT_MOUSEMOVE:
                if (app->state == IN_PROCESS) {
                    app->rect.width = x - app->rect.x;
                    app->rect.height = y - app->rect.y;
                    drawRectangle(app->mask, app->rect, Scalar::all(2));
                    imshow(*(app->winName), *(app->image));
                }
                break;
        }
    }

    void applyGrabCut() {
        Mat bgModel, fgModel;
        grabCut(*(this->image), this->mask, this->rect, bgModel, fgModel, 5, GC_INIT_WITH_RECT);
        updateMask();
    }

    void updateMask() {
        for (int i = 0; i < this->mask.rows; ++i) {
            for (int j = 0; j < this->mask.cols; ++j) {
                uchar val = this->mask.at<uchar>(i, j);
                if (val == 0 || val == 2) {
                    this->mask.at<uchar>(i, j) = 0;
                } else {
                    this->mask.at<uchar>(i, j) = 255;
                }
            }
        }
    }

    void saveSegmentedResult() {
        Mat foreground;
        bitwise_and(*(this->image), *(this->image), foreground, this->mask);
        imwrite("segmented_result.png", foreground);
        cout << "Segmented result saved as segmented_result.png" << endl;
    }

    void drawRectangle(Mat& mat, Rect rect, Scalar color) {
        rectangle(mat, rect.tl(), rect.br(), color, thickness);
    }
};

int main() {
    string windowName = "GrabCut Segmentation";
    Mat image = imread("input.jpg");
    if (image.empty()) {
        cerr << "Error: Could not open or find the image." << endl;
        return -1;
    }

    GCApplication app(windowName, image);
    app.run();

    return 0;
}
```

This code defines a `GCApplication` class that encapsulates the functionality of a simple interactive GrabCut segmentation tool using OpenCV. The class handles user interactions, applies the GrabCut algorithm, and saves the segmented result. The `main` function initializes the application with an input image and runs it.
