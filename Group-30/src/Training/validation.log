#include <mpi.h>
#include <iostream>

// Global variables
int _my_rank;
int _num_workers;

// Function declarations
int slave_all_sum(int my_copy);

int main(int argc, char** argv) {
    // Initialize MPI
    MPI_Init(&argc, &argv);

    // Get the rank of the current process
    MPI_Comm_rank(MPI_COMM_WORLD, &_my_rank);

    // Get the total number of processes
    MPI_Comm_size(MPI_COMM_WORLD, &_num_workers);

    // Example usage of slave_all_sum
    if (_my_rank == 0) {
        std::cout << "Master process" << std::endl;
    } else {
        int my_data = _my_rank * 10; // Example data for each worker
        int result = slave_all_sum(my_data);
        std::cout << "Worker " << _my_rank << " received sum: " << result << std::endl;
    }

    // Finalize MPI
    MPI_Finalize();
    return 0;
}

// Function definitions
int slave_all_sum(int my_copy) {
    int global_sum;
    // Perform reduction operation to sum up all values
    MPI_Reduce(&my_copy, &global_sum, 1, MPI_INT, MPI_SUM, 0, MPI_COMM_WORLD);
    return global_sum;
}
