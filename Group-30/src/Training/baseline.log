#include <iostream>
#include <vector>
#include <opencv2/opencv.hpp>

struct Point2f {
    float x;
    float y;
};

class RotatedRect {
public:
    cv::RotatedRect rect;

    RotatedRect(const cv::RotatedRect& r) : rect(r) {}

    void draw(cv::Mat& img, const cv::Scalar& color = cv::Scalar(0, 255, 0), int thickness = 2) const {
        cv::ellipse(img, rect, color, thickness);
    }
};

struct LED_Stick {
    Point2f start;
    Point2f end;
    float length;
    float angle;
    cv::Vec3b color;

    LED_Stick(Point2f s, Point2f e, float l, float a, cv::Vec3b c)
        : start(s), end(e), length(l), angle(a), color(c) {}
};

class armor {
private:
    LED_Stick* stick1;
    LED_Stick* stick2;
    cv::RotatedRect boundingBox;

public:
    armor(LED_Stick* s1, LED_Stick* s2) : stick1(s1), stick2(s2) {
        calculateBoundingBox();
    }

    void drawRectangle(cv::Mat& img, const cv::Scalar& color = cv::Scalar(0, 255, 0), int thickness = 2) const {
        boundingBox.draw(img, color, thickness);
    }

    void drawSpots(cv::Mat& img, const cv::Scalar& color = cv::Scalar(0, 255, 0), int radius = 5) const {
        cv::circle(img, stick1->start, radius, color, -1);
        cv::circle(img, stick1->end, radius, color, -1);
        cv::circle(img, stick2->start, radius, color, -1);
        cv::circle(img, stick2->end, radius, color, -1);
    }

    double calculateAverageIntensity(const cv::Mat& img) const {
        cv::Mat roi = img(boundingBox.boundingRect());
        cv::Scalar mean = cv::mean(roi);
        return mean[0];
    }

    bool matchLEDSticks() const {
        // Simple heuristic to check if the sticks are parallel and close enough
        float angleDiff = std::abs(stick1->angle - stick2->angle);
        return angleDiff < 10 && std::abs(stick1->length - stick2->length) < 10;
    }

private:
    void calculateBoundingBox() {
        std::vector<cv::Point> points = {stick1->start, stick1->end, stick2->start, stick2->end};
        boundingBox = cv::minAreaRect(points);
    }
};

class ArmorDetector {
private:
    cv::VideoCapture cap;
    cv::Mat frame;
    cv::Mat processedFrame;

public:
    ArmorDetector(const std::string& videoPath) : cap(videoPath) {
        if (!cap.isOpened()) {
            throw std::runtime_error("Could not open video file");
        }
    }

    ~ArmorDetector() {
        cap.release();
    }

    cv::Mat getROI() {
        // Placeholder for ROI calculation logic
        return frame(Rect(100, 100, 300, 300));
    }

    std::vector<armor*> detectArmor() {
        std::vector<armor*> armors;
        while (true) {
            cap >> frame;
            if (frame.empty()) break;

            processedFrame = frame.clone();
            // Placeholder for feature extraction and object detection logic
            // ...

            // Example: Detecting two LED sticks
            LED_Stick* stick1 = new LED_Stick(Point2f(100, 100), Point2f(200, 200), 100, 45, cv::Vec3b(255, 0, 0));
            LED_Stick* stick2 = new LED_Stick(Point2f(150, 150), Point2f(250, 250), 100, 45, cv::Vec3b(0, 255, 0));

            if (stick1->matchLEDSticks()) {
                armors.push_back(new armor(stick1, stick2));
            } else {
                delete stick1;
                delete stick2;
            }
        }
        return armors;
    }

    void adjustBrightness(int value) {
        brightAdjust(processedFrame, value);
    }

    static void brightAdjust(cv::Mat& img, int value) {
        img.convertTo(img, -1, 1, value);
        img = cv::max(0, cv::min(img, 255));
    }
};

int main() {
    try {
        ArmorDetector detector("path_to_video.mp4");
        detector.adjustBrightness(50);

        while (true) {
            cv::Mat roi = detector.getROI();
            std::vector<armor*> armors = detector.detectArmor();

            for (auto& armor : armors) {
                armor->drawRectangle(roi);
                armor->drawSpots(roi);
            }

            cv::imshow("Detected Armor", roi);
            if (cv::waitKey(30) >= 0) break;
        }
    } catch (const std::exception& e) {
        std::cerr << "Error: " << e.what() << std::endl;
    }

    return 0;
}
