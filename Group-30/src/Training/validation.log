```python
import json
import logging
import numpy as np
import torch
from snorkel.data import Dataset, Example, Field, LabelField, TextField
from transformers import PreTrainedTokenizer

# Global Variables
TASK_NAME = "WSC"

# Standalone Functions
def get_char_index(text, span_text, span_index):
    """
    Calculates the character indices of a given span within a text.
    
    Args:
        text (str): The original text.
        span_text (str): The span text to find within the original text.
        span_index (int): The starting index of the span in the original text.
        
    Returns:
        tuple: A tuple containing the start and end character indices of the span.
    """
    if span_text in text[span_index:]:
        return span_index + text[span_index:].index(span_text), span_index + text[span_index:].index(span_text) + len(span_text)
    else:
        # Handle case where span is not found exactly
        return None, None

def parse(jsonl_path, tokenizer, max_data_samples=None, max_sequence_length=512):
    """
    Reads data from a JSONL file, processes it, and returns a MultitaskDataset object.
    
    Args:
        jsonl_path (str): Path to the JSONL file.
        tokenizer (PreTrainedTokenizer): Tokenizer to use for tokenization.
        max_data_samples (int, optional): Maximum number of data samples to process. Defaults to None.
        max_sequence_length (int, optional): Maximum sequence length for tokenized inputs. Defaults to 512.
        
    Returns:
        MultitaskDataset: Processed dataset ready for machine learning model.
    """
    dataset = Dataset()
    with open(jsonl_path, 'r') as f:
        for line in f:
            data = json.loads(line)
            if max_data_samples is not None and len(dataset) >= max_data_samples:
                break
            
            sentence = data['sentence']
            span_start = data['start']
            span_end = data['end']
            label = data['label']
            
            tokens = tokenizer.tokenize(sentence)
            if len(tokens) > max_sequence_length - 2:
                tokens = tokens[:max_sequence_length - 2]
            
            input_ids = tokenizer.convert_tokens_to_ids(['[CLS]'] + tokens + ['[SEP]'])
            attention_mask = [1] * len(input_ids)
            token_type_ids = [0] * len(input_ids)
            
            char_start, char_end = get_char_index(sentence, tokens[1:-1], span_start)
            if char_start is not None and char_end is not None:
                char_span = (char_start, char_end)
            else:
                char_span = None
            
            example = Example(
                id=len(dataset),
                sentence=TextField(tokens),
                input_ids=LabelField(value=input_ids, dtype=torch.long),
                attention_mask=LabelField(value=attention_mask, dtype=torch.long),
                token_type_ids=LabelField(value=token_type_ids, dtype=torch.long),
                char_span=LabelField(value=char_span, dtype=torch.int64),
                label=LabelField(value=label, dtype=torch.long)
            )
            dataset.add_example(example)
    
    return dataset
```

This code defines the global variable `TASK_NAME`, two standalone functions `get_char_index` and `parse`, and a simple implementation of a dataset parsing function that reads from a JSONL file, tokenizes sentences using a provided tokenizer, and constructs a dataset suitable for machine learning models.
