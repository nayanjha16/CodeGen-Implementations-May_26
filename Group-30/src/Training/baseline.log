```python
import argparse
from torchvision import datasets, transforms
from torch.utils.data import DataLoader
import torch.nn.functional as F
import torch

class ImageNetInference:
    def __init__(self, model_path, data_dir):
        self.model = self.load_model(model_path)
        self.transform = transforms.Compose([
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
        ])
        self.dataset = datasets.ImageFolder(root=data_dir, transform=self.transform)
        self.dataloader = DataLoader(self.dataset, batch_size=32, shuffle=False)

    @staticmethod
    def load_model(model_path):
        # Load a pre-trained model (e.g., ResNet)
        model = torch.hub.load('pytorch/vision:v0.10.0', 'resnet50', pretrained=True)
        model.eval()
        return model

    def evaluate(self):
        correct_top1 = 0
        correct_top5 = 0
        total_samples = len(self.dataset)

        with torch.no_grad():
            for inputs, labels in self.dataloader:
                outputs = self.model(inputs)
                _, predicted = outputs.max(1)
                top5_prob, top5_pred = F.softmax(outputs, dim=1).topk(5, dim=1)

                correct_top1 += (predicted == labels).sum().item()
                correct_top5 += (top5_pred == labels.unsqueeze(1)).sum().item()

        top1_accuracy = correct_top1 / total_samples
        top5_accuracy = correct_top5 / total_samples

        print(f'Top-1 Accuracy: {top1_accuracy:.4f}')
        print(f'Top-5 Accuracy: {top5_accuracy:.4f}')

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description='ImageNet Inference Script')
    parser.add_argument('--model-path', type=str, required=True, help='Path to the pre-trained model')
    parser.add_argument('--data-dir', type=str, required=True, help='Directory containing the ImageNet dataset')

    args = parser.parse_args()

    inference = ImageNetInference(args.model_path, args.data_dir)
    inference.evaluate()
```

### Explanation:

1. **`argparse.ArgumentParser`**:
   - Used to parse command-line arguments (`--model-path` and `--data-dir`).

2. **`torchvision.datasets.ImageFolder`**:
   - Loads images from a directory structure where each subdirectory represents a class.
   - Applies transformations to the images.

3. **`torch.utils.data.DataLoader`**:
   - Provides an iterable over the dataset, enabling efficient batching, shuffling, and parallel data loading.

4. **`ImageNetInference` Class**:
   - Initializes the model, transformation pipeline, dataset, and dataloader.
   - Contains a method `load_model` to load a pre-trained model.
   - Contains a method `evaluate` to compute top-1 and top-5 accuracy metrics on the dataset.

5. **Main Execution Block**:
   - Parses command-line arguments.
   - Creates an instance of `ImageNetInference`.
   - Calls the `evaluate` method to run the inference and print the accuracy metrics.
