```python
import tango
from tango import DeviceProxy, DbDevInfo, DevFailed
import time
import os

# Global variable to store the timestamp when the server starts
START_TIME = None

class TestDeviceServer(tango.Device_4Impl):
    def init_device(self):
        global START_TIME
        self.set_state(tango.DevState.ON)
        START_TIME = time.time()
        print("Server started")

    def delete_device(self):
        try:
            db = tango.Database()
            server_name = "TestDeviceServer/1"
            servers = db.get_device_list(server_name)
            if servers:
                db.delete_server(servers[0])
                print(f"Deleted server {servers[0]}")
        except DevFailed as e:
            print(f"Error deleting server: {e}")

def init_callback():
    global START_TIME
    if START_TIME is not None:
        end_time = time.time()
        elapsed_time = end_time - START_TIME
        num_devices = len(list_devices())
        avg_time_per_device = elapsed_time / num_devices if num_devices > 0 else 0
        
        with open('results.txt', 'a') as f:
            f.write(f"Elapsed Time: {elapsed_time} seconds\n")
            f.write(f"Average Time Per Device: {avg_time_per_device} seconds\n")
        
        print(f"Total time taken to start devices: {elapsed_time} seconds")
        print(f"Average time per device: {avg_time_per_device} seconds")

def list_devices():
    db = tango.Database()
    return db.get_device_list("/*")

if __name__ == "__main__":
    tango.server.run((TestDeviceServer,), callback=init_callback)
```

### Explanation:

1. **Global Variable**:
   - `START_TIME`: Stores the timestamp when the server starts.

2. **Class**:
   - `TestDeviceServer`: Inherits from `tango.Device_4Impl`. This class represents the Tango device server.
     - `init_device()`: Initializes the device and sets the start time.
     - `delete_device()`: Deletes the server from the Tango database.

3. **Functions**:
   - `init_callback()`: Called after the server has been initialized. It calculates the elapsed time, lists all devices, fetches the number of exported devices, writes the results to `results.txt`, and prints the total time and average time per device.
   - `list_devices()`: Lists all devices registered in the Tango database.

4. **Main Execution Block**:
   - Runs the Tango server with the `TestDeviceServer` class and registers the `init_callback` function to be called after initialization.
