#include <iostream>
#include <vector>
#include <unordered_map>
#include <fstream>

struct Marker {
    int position;
    char kmer[3]; // Assuming k = 3 for simplicity
};

struct Read {
    std::string sequence;
    int baseCount;
};

struct AlignmentData {
    int readId1;
    int readId2;
    double similarity;
};

class AlignmentCandidates {
public:
    void addCandidate(int readId1, int readId2, double similarity) {
        candidates.push_back({readId1, readId2, similarity});
    }

    const std::vector<AlignmentData>& getCandidates() const {
        return candidates;
    }

private:
    std::vector<AlignmentData> candidates;
};

class MinHash {
public:
    MinHash(int numHashes) : numHashes(numHashes) {}

    void compute(const std::vector<std::string>& reads) {
        for (size_t i = 0; i < reads.size(); ++i) {
            const auto& read = reads[i];
            for (size_t j = 0; j <= read.length() - 3; ++j) { // Assuming k = 3
                std::string kmer = read.substr(j, 3);
                hashValues[kmer].insert(i);
            }
        }
    }

    std::unordered_map<std::string, std::unordered_set<int>> getHashValues() const {
        return hashValues;
    }

private:
    int numHashes;
    std::unordered_map<std::string, std::unordered_set<int>> hashValues;
};

class Assembler {
public:
    Assembler(int numMarkers, int k) : numMarkers(numMarkers), k(k) {}

    void setupReads(const std::vector<Read>& reads) {
        this->reads = reads;
        extractKmers();
    }

    void runMinHash() {
        minHash.compute(reads);
    }

    void writeOverlappingReads(const std::string& filename) {
        std::ofstream outFile(filename);
        if (!outFile.is_open()) {
            std::cerr << "Failed to open file: " << filename << std::endl;
            return;
        }

        auto hashValues = minHash.getHashValues();
        for (const auto& [kmer, ids] : hashValues) {
            if (ids.size() > 1) {
                for (auto it = ids.begin(); it != ids.end(); ++it) {
                    int id1 = *it;
                    for (auto it2 = std::next(it); it2 != ids.end(); ++it2) {
                        int id2 = *it2;
                        double similarity = calculateSimilarity(id1, id2);
                        alignmentCandidates.addCandidate(id1, id2, similarity);
                        outFile << id1 << "," << id2 << "," << similarity << std::endl;
                    }
                }
            }
        }
    }

    const AlignmentCandidates& getAlignmentCandidates() const {
        return alignmentCandidates;
    }

private:
    void extractKmers() {
        for (const auto& read : reads) {
            for (size_t j = 0; j <= read.sequence.length() - k; ++j) {
                std::string kmer = read.sequence.substr(j, k);
                markers.push_back({static_cast<int>(j), kmer[0], kmer[1], kmer[2]});
            }
        }
    }

    double calculateSimilarity(int id1, int id2) {
        // Placeholder for similarity calculation logic
        return 0.8; // Example value
    }

    int numMarkers;
    int k;
    std::vector<Marker> markers;
    std::vector<Read> reads;
    MinHash minHash;
    AlignmentCandidates alignmentCandidates;
};
