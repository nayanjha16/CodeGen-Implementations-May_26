class Solution:
    def finalPrices(self, prices):
        """
        :type prices: List[int]
        :rtype: List[int]
        """
        n = len(prices)
        result = [0] * n
        
        for i in range(n - 1):
            for j in range(i + 1, n):
                if prices[j] <= prices[i]:
                    result[i] = prices[i] - prices[j]
                    break
            else:
                result[i] = prices[i]
        
        result[n - 1] = prices[n - 1]
        
        return result
```

