```python
import os
from configparser import ConfigParser, NoSectionError, NoOptionError

# Global variables
HASH_PATH_SUFFIX = ''
HASH_PATH_PREFIX = ''

# Read configuration from /etc/swift/swift.conf
_hash_conf = ConfigParser()
if _hash_conf.read('/etc/swift/swift.conf'):
    try:
        HASH_PATH_SUFFIX = _hash_conf.get('swift-hash', 'swift_hash_path_suffix')
    except (NoSectionError, NoOptionError):
        pass
    try:
        HASH_PATH_PREFIX = _hash_conf.get('swift-hash', 'swift_hash_path_prefix')
    except (NoSectionError, NoOptionError):
        pass

def validate_configuration():
    """
    Validates if both swift_hash_path_suffix and swift_hash_path_prefix are configured in /etc/swift/swift.conf.
    Exits the program with an error message if either is missing.
    """
    if not HASH_PATH_SUFFIX or not HASH_PATH_PREFIX:
        raise ValueError("Both swift_hash_path_suffix and swift_hash_path_prefix must be configured in /etc/swift/swift.conf")

def hash_path(path: str) -> str:
    """
    Hashes a given path using SHA-256 and appends the HASH_PATH_PREFIX and HASH_PATH_SUFFIX.
    
    :param path: The original path to hash
    :return: The hashed path with prefix and suffix
    """
    import hashlib
    hasher = hashlib.sha256()
    hasher.update(path.encode())
    hashed_path = hasher.hexdigest()
    return f"{HASH_PATH_PREFIX}{hashed_path}{HASH_PATH_SUFFIX}"

def normalize_timestamp(timestamp: str) -> str:
    """
    Normalizes a timestamp to a standardized format.
    
    :param timestamp: The timestamp to normalize
    :return: The normalized timestamp
    """
    from datetime import datetime
    dt_object = datetime.strptime(timestamp, '%Y-%m-%d %H:%M:%S')
    return dt_object.strftime('%Y%m%d%H%M%S')

def generate_storage_directory(account: str, container: str, object_name: str) -> str:
    """
    Generates a storage directory based on account, container, and object name.
    
    :param account: The account name
    :param container: The container name
    :param object_name: The object name
    :return: The generated storage directory
    """
    return f"/{account}/{container}/{object_name}"

def audit_location(directory: str) -> bool:
    """
    Audits a location within a storage device to check its existence and accessibility.
    
    :param directory: The directory to audit
    :return: True if the directory exists and is accessible, False otherwise
    """
    return os.path.exists(directory) and os.access(directory, os.R_OK | os.W_OK)

# Example usage
if __name__ == "__main__":
    validate_configuration()
    path_to_hash = "/example/path"
    print(f"Hashed Path: {hash_path(path_to_hash)}")
    
    timestamp = "2023-10-05 12:34:56"
    print(f"Normalized Timestamp: {normalize_timestamp(timestamp)}")
    
    storage_dir = generate_storage_directory("user1", "container1", "object1.txt")
    print(f"Storage Directory: {storage_dir}")
    
    print(f"Audit Result: {audit_location(storage_dir)}")
```
