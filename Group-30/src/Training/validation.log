class Animal:
    def __init__(self, name: str):
        self.name = name
        self.order = None

    def set_order(self, order: int):
        self.order = order

    def peek_order(self) -> int:
        return self.order

    def __str__(self) -> str:
        return self.name


class Node:
    def __init__(self, data: Animal):
        self.data = data
        self.next = None


class AnimalQueue:
    def __init__(self):
        self.dog_queue = []
        self.cat_queue = []
        self.order = 0

    def enqueue(self, animal: Animal):
        animal.set_order(self.order)
        self.order += 1
        if isinstance(animal, Dog):
            self.dog_queue.append((animal, animal.peek_order()))
        elif isinstance(animal, Cat):
            self.cat_queue.append((animal, animal.peek_order()))

    def dequeue_any(self) -> Animal:
        if not self.dog_queue and not self.cat_queue:
            raise Exception("No animals in the queue")
        dog = self.dog_queue[0][1] if self.dog_queue else float('inf')
        cat = self.cat_queue[0][1] if self.cat_queue else float('inf')
        if dog < cat:
            return self.dequeue_dog()
        else:
            return self.dequeue_cat()

    def dequeue_dog(self) -> Animal:
        if not self.dog_queue:
            raise Exception("No dogs in the queue")
        return self.dog_queue.pop(0)[0]

    def dequeue_cat(self) -> Animal:
        if not self.cat_queue:
            raise Exception("No cats in the queue")
        return self.cat_queue.pop(0)[0]


class Dog(Animal):
    pass


class Cat(Animal):
    pass
```

This code defines the required classes and methods to implement the animal queue system as described. The `Animal` class serves as a base class for both `Dog` and `Cat`, while the `Node` class represents nodes in the linked list. The `AnimalQueue` class manages the queues for dogs and cats, ensuring that animals are served in the correct order according to their type and the order they were added.
