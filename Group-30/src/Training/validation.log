import unittest
import anyio
from hbmqtt.mqtt.subscribe import SubscribePacket

class SubscribePacketTest(unittest.TestCase):
    async def test_from_stream(self):
        # Define a byte string representing an MQTT subscribe packet
        data = b'\x82\x0a\x00\x01\x00\x0cmy/topic\x00\x01'

        # Call the from_stream method and capture the result
        packet = await SubscribePacket.from_stream(data)

        # Verify that the packet was parsed correctly
        self.assertEqual(packet.packet_id, 1)
        self.assertEqual(len(packet.topics), 1)
        self.assertEqual(packet.topics[0].topic_filter, 'my/topic')
        self.assertEqual(packet.topics[0].qos, 1)

if __name__ == '__main__':
    unittest.main()
```

