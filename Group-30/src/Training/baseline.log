```cpp
#include <gtest/gtest.h>
#include "base_test.h" // Assuming BaseTest is defined here

// Define StackTestArg struct
struct StackTestArg {
    uint8_t initial_stack_pointer;
    uint8_t expected_stack_pointer;
    uint8_t accumulator_value;
    uint8_t expected_accumulator_value;
};

// Define StackTest class
class StackTest : public BaseTest, public ::testing::WithParamInterface<StackTestArg> {
protected:
    RegisterState expected_regs;
    CPU cpu;
    size_t expected_code_length;

    void SetUp() override {
        BaseTest::SetUp();
        auto arg = GetParam();
        cpu.registers.sp = arg.initial_stack_pointer;
        cpu.resetRegisters();
        expected_regs = cpu.getRegisters();
        expected_code_length = 1; // Assuming single-byte instructions for simplicity
    }
};

// Test cases for PHA (Push Accumulator)
TEST_P(StackTest, PHATest) {
    auto arg = GetParam();
    cpu.registers.a = arg.accumulator_value;
    cpu.executeInstruction(0x48); // PHA opcode

    EXPECT_EQ(cpu.registers.sp, arg.expected_stack_pointer);
    EXPECT_EQ(cpu.memory[cpu.registers.sp], arg.accumulator_value);
}

// Test cases for PLA (Pull Accumulator)
TEST_P(StackTest, PLATest) {
    auto arg = GetParam();
    cpu.memory[cpu.registers.sp] = arg.accumulator_value;
    cpu.registers.sp++;
    cpu.executeInstruction(0x68); // PLA opcode

    EXPECT_EQ(cpu.registers.sp, arg.expected_stack_pointer);
    EXPECT_EQ(cpu.registers.a, arg.expected_accumulator_value);
}

// Test cases for PHP (Push Processor Status)
TEST_P(StackTest, PHTest) {
    auto arg = GetParam();
    cpu.setProcessorStatus(arg.processor_status);
    cpu.executeInstruction(0x08); // PHP opcode

    EXPECT_EQ(cpu.registers.sp, arg.expected_stack_pointer);
    EXPECT_EQ(cpu.memory[cpu.registers.sp], arg.processor_status);
}

// Test cases for PLP (Pull Processor Status)
TEST_P(StackTest, PLPTest) {
    auto arg = GetParam();
    cpu.memory[cpu.registers.sp] = arg.processor_status;
    cpu.registers.sp++;
    cpu.executeInstruction(0x28); // PLP opcode

    EXPECT_EQ(cpu.registers.sp, arg.expected_stack_pointer);
    EXPECT_EQ(cpu.getProcessorStatus(), arg.expected_processor_status);
}

// Instantiate and run the tests with specific parameters
INSTANTIATE_TEST_SUITE_P(
    StackOperations,
    StackTest,
    ::testing::Values(
        StackTestArg{0xFD, 0xFC, 0x10, 0x10},
        StackTestArg{0xFE, 0xFD, 0x20, 0x20}
    )
);
```

