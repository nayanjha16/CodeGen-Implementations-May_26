class SetSeedSupervisor : public SupervisorVertexIf<ASM_CODELETS_ENABLED> {
private:
    Input<std::vector<uint32_t>, ONE_PTR, 8> seed;
    const uint32_t seedModifierUser;

public:
    SetSeedSupervisor(uint32_t userSeedModifier)
        : seedModifierUser(userSeedModifier) {}

    void process() override {
        std::vector<uint32_t> seedValues = seed.get();
        if (!seedValues.empty()) {
            uint32_t combinedSeed = combineSeeds(seedValues, seedModifierUser);
            // Set the random number generator seed here
            // Example: std::srand(combinedSeed);
        }
    }

private:
    uint32_t combineSeeds(const std::vector<uint32_t>& seeds, uint32_t modifier) {
        uint32_t combinedSeed = 0;
        for (uint32_t seed : seeds) {
            combinedSeed ^= seed;
        }
        combinedSeed ^= modifier;
        return combinedSeed;
    }
};

} // namespace poprand
