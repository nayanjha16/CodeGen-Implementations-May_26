```python
class Foo:
    """Base class without specific functionality."""
    pass

class Bar(Foo):
    """Class that inherits from Foo and demonstrates correct usage of super()."""
    
    def __init__(self):
        super(Bar, self).__init__()

class Baz(Foo):
    """Class that inherits from Foo and demonstrates calling super() with arguments."""
    
    def __init__(self, value):
        super(Baz, self).__init__()
        self.value = value

class Qux(Foo):
    """Class that inherits from Foo and demonstrates calling super() in a method."""
    
    def some_method(self):
        super(Qux, self).some_method()

class NotSuperCall(Foo):
    """Class that inherits from Foo but does not call super(). This is incorrect."""
    
    def __init__(self):
        # Missing super().__init__() call
        pass

class InvalidSuperCall(Foo):
