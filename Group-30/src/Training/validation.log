import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns

# Global Variables
COLORS = ["blue", "green", "red", "purple", "orange"]
SPECIES = {
    "sp1": "Species 1",
    "sp2": "Species 2",
    "sp3": "Species 3"
}
FONTSIZE_TITLE = 16
FONTSIZE_LABEL = 14
MAX_LINES = 10
MIN_FRACTION = 0.05
THRESHOLD_FRAC = 0.1
MAX_SIGLVL = 0.95
COLORBAR_MIN = 0.0
COLORBAR_MAX = 1.0

class MutationLinePlot:
    def __init__(self, data, species_id):
        """
        Initialize the MutationLinePlot with mutation data and species identifier.
        
        Parameters:
        - data (DataFrame): DataFrame containing mutation data.
        - species_id (str): Identifier for the species.
        """
        self.data = data
        self.species_id = species_id
        self.filtered_data = None

    def filter_mutations(self):
        """
        Filter mutations based on minimum fraction and threshold fraction.
        """
        # Filter out mutations below the minimum fraction
        filtered_data = self.data[self.data['fraction'] >= MIN_FRACTION]
        
        # Further filter based on threshold fraction
        filtered_data = filtered_data[filtered_data['fraction'] <= THRESHOLD_FRAC]
        
        self.filtered_data = filtered_data

    def plot_mutation_frequency(self):
        """
        Plot the frequency of mutations over time.
        """
        if self.filtered_data is None:
            raise ValueError("Mutations need to be filtered first.")
        
        plt.figure(figsize=(10, 6))
        sns.lineplot(data=self.filtered_data, x='time', y='frequency', hue='mutation', palette=COLORS)
        plt.title(f"Mutation Frequency Over Time for {SPECIES[self.species_id]}", fontsize=FONTSIZE_TITLE)
        plt.xlabel('Time', fontsize=FONTSIZE_LABEL)
        plt.ylabel('Frequency', fontsize=FONTSIZE_LABEL)
        plt.legend(title='Mutation')
        plt.show()

    def plot_co_occurrence(self):
        """
        Plot the co-occurrence of mutations.
        """
        if self.filtered_data is None:
            raise ValueError("Mutations need to be filtered first.")
        
        co_occurrence_matrix = self.filtered_data.pivot_table(index='mutation', columns='co_mutation', aggfunc='size', fill_value=0)
        plt.figure(figsize=(10, 8))
        sns.heatmap(co_occurrence_matrix, annot=True, cmap="YlGnBu")
        plt.title(f"Co-Occurrence Matrix for Mutations in {SPECIES[self.species_id]}", fontsize=FONTSIZE_TITLE)
        plt.xlabel('Co-Mutation', fontsize=FONTSIZE_LABEL)
        plt.ylabel('Mutation', fontsize=FONTSIZE_LABEL)
        plt.show()

    def plot_significance_level(self):
        """
        Plot the significance level of mutations.
        """
        if self.filtered_data is None:
            raise ValueError("Mutations need to be filtered first.")
        
        plt.figure(figsize=(10, 6))
        sns.scatterplot(data=self.filtered_data, x='time', y='significance_level', hue='mutation', palette=COLORS)
        plt.title(f"Significance Level of Mutations Over Time for {SPECIES[self.species_id]}", fontsize=FONTSIZE_TITLE)
        plt.xlabel('Time', fontsize=FONTSIZE_LABEL)
        plt.ylabel('Significance Level', fontsize=FONTSIZE_LABEL)
        plt.legend(title='Mutation')
        plt.ylim(COLORBAR_MIN, COLORBAR_MAX)
        plt.show()
