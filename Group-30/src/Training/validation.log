import re

class Simplimental:
    def __init__(self, text="This is not a bad idea"):
        self.text = text
        self.dictionary = {
            'good': 1,
            'bad': -1,
            'great': 2,
            'terrible': -2,
            # Add more words and scores as needed
        }
        self.tokens = self._preprocess_text(text)

    def _preprocess_text(self, text):
        # Remove punctuation and convert to lowercase
        tokens = re.findall(r'\b\w+\b', text.lower())
        return tokens

    def calculate_sentiment_scores(self):
        positivity_score = 0
        negativity_score = 0
        
        for token in self.tokens:
            if token in self.dictionary:
                score = self.dictionary[token]
                if score > 0:
                    positivity_score += score
                elif score < 0:
                    negativity_score += abs(score)
        
        return positivity_score, negativity_score

    def get_overall_sentiment(self):
        positivity_score, negativity_score = self.calculate_sentiment_scores()
        overall_sentiment = positivity_score - negativity_score
        return overall_sentiment

    def get_comparative_scores(self):
        total_words = len(self.tokens)
        positive_words = sum(1 for word in self.tokens if word in self.dictionary and self.dictionary[word] > 0)
        negative_words = sum(1 for word in self.tokens if word in self.dictionary and self.dictionary[word] < 0)
        
        positive_proportion = positive_words / total_words if total_words > 0 else 0
        negative_proportion = negative_words / total_words if total_words > 0 else 0
        
        return positive_proportion, negative_proportion

# Example usage:
simplimental = Simplimental("This is a great day! However, there are some terrible things happening.")
print("Overall Sentiment:", simplimental.get_overall_sentiment())
print("Comparative Scores (Positive, Negative):", simplimental.get_comparative_scores())
```

This code defines the `Simplimental` class with the specified fields and methods. The `__init__` method initializes the class with the provided text and sets up the dictionary of sentiment scores. The `_preprocess_text` method processes the input text to extract individual words. The `calculate_sentiment_scores` method computes the positivity and negativity scores based on the dictionary. The `get_overall_sentiment` method returns the overall sentiment score, and the `get_comparative_scores` method returns the proportions of positive and negative words.
