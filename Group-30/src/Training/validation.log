#include <QWidget>
#include <QPainter>
#include <QLabel>
#include <QMouseEvent>

class Chess {
public:
    int type; // 0 for empty, 1 for black piece, 2 for white piece
    Chess(int t = 0) : type(t) {}
};

class PlayScene : public QWidget {
    Q_OBJECT

public:
    PlayScene(QWidget *parent = nullptr);
    ~PlayScene();

protected:
    void paintEvent(QPaintEvent *event) override;
    void mousePressEvent(QMouseEvent *event) override;

private:
    Chess **map;
    int sta[15][15]; // Assuming a 15x15 board
    int scoreBlack, scoreWhite;
    QLabel *blackLabel, *whiteLabel;
    QString modIndex;

    void drawBoard(QPainter &painter);
    void drawPieces(QPainter &painter);
    void updateScore();
    bool isValidMove(int x, int y);
    void makeMove(int x, int y, int player);
    void reverseOpponentPiece(int x, int y);
};

PlayScene::PlayScene(QWidget *parent)
    : QWidget(parent), map(new Chess*[15]), scoreBlack(0), scoreWhite(0) {
    for (int i = 0; i < 15; ++i) {
        map[i] = new Chess*[15];
        for (int j = 0; j < 15; ++j) {
            map[i][j] = new Chess();
        }
    }

    blackLabel = new QLabel("Black: 0", this);
    whiteLabel = new QLabel("White: 0", this);

    setFixedSize(600, 600);
}

PlayScene::~PlayScene() {
    for (int i = 0; i < 15; ++i) {
        for (int j = 0; j < 15; ++j) {
            delete map[i][j];
        }
        delete[] map[i];
    }
    delete[] map;
    delete blackLabel;
    delete whiteLabel;
}

void PlayScene::paintEvent(QPaintEvent *event) {
    QPainter painter(this);
    drawBoard(painter);
    drawPieces(painter);
}

void PlayScene::mousePressEvent(QMouseEvent *event) {
    if (isValidMove(event->x(), event->y())) {
        makeMove(event->x(), event->y(), 1); // Assuming player 1 is always black
        updateScore();
        repaint();
    }
}

void PlayScene::drawBoard(QPainter &painter) {
    painter.setPen(Qt::black);
    for (int i = 0; i <= 15; ++i) {
        painter.drawLine(i * 40, 0, i * 40, 600);
        painter.drawLine(0, i * 40, 600, i * 40);
    }
}

void PlayScene::drawPieces(QPainter &painter) {
    for (int i = 0; i < 15; ++i) {
        for (int j = 0; j < 15; ++j) {
            if (map[i][j]->type == 1) {
                painter.setBrush(Qt::black);
                painter.drawEllipse(i * 40 + 10, j * 40 + 10, 20, 20);
            } else if (map[i][j]->type == 2) {
                painter.setBrush(Qt::white);
                painter.drawEllipse(i * 40 + 10, j * 40 + 10, 20, 20);
            }
        }
    }
}

void PlayScene::updateScore() {
    scoreBlack = 0;
    scoreWhite = 0;
    for (int i = 0; i < 15; ++i) {
        for (int j = 0; j < 15; ++j) {
            if (map[i][j]->type == 1) {
                scoreBlack++;
            } else if (map[i][j]->type == 2) {
                scoreWhite++;
            }
        }
    }
    blackLabel->setText(QString("Black: %1").arg(scoreBlack));
    whiteLabel->setText(QString("White: %1").arg(scoreWhite));
}

bool PlayScene::isValidMove(int x, int y) {
    int gridX = x / 40;
    int gridY = y / 40;
    return gridX >= 0 && gridX < 15 && gridY >= 0 && gridY < 15 && map[gridX][gridY]->type == 0;
}

void PlayScene::makeMove(int x, int y, int player) {
    int gridX = x / 40;
    int gridY = y / 40;
    map[gridX][gridY]->type = player;
    reverseOpponentPiece(gridX, gridY);
}

void PlayScene::reverseOpponentPiece(int x, int y) {
    // Placeholder for logic to reverse opponent's pieces
}
```

