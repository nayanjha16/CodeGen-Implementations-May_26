Status ImportGraphDefToMlir(const FunctionLibraryDefinition& flib_def,
                           const DebugInfo& debug_info,
                           const SignatureDef& signature_def,
                           const std::vector<std::pair<string, Tensor>>& inputs,
                           const std::vector<std::pair<string, Tensor>>& outputs,
                           mlir::ModuleOp module) {
    std::vector<std::pair<string, Tensor>> sorted_outputs = outputs;
    llvm::sort(sorted_outputs, [](const auto& lhs, const auto& rhs) {
        return lhs.first.size() < rhs.first || lhs.first > rhs.first;
    });

    GraphImportConfig specs;
    specs.prune_unused_nodes = true;
    specs.graph_as_function = true;
    specs.inputs = ParseInputArrays(inputs);
    specs.outputs = ParseInputArrays(sorted_outputs);
    specs.control_outputs = ParseInputArrays(signature_def.control_inputs());

    std::unordered_map<std::string, std::string> tf_name_to_mlir_name;
    NameUniquifier function_name_uniquifier(flib_def);

    GraphDefImporter importer(flib_def, debug_info, specs, module, &tf_name_to_mlir_name,
                              &function_name_uniquifier);

    TF_RETURN_IF_ERROR(importer.PrepareConvert(graphdef));

    auto fn_names = graphdef.library().function_names();
    for (const auto& fn_name : fn_names) {
        TF_RETURN_IF_ERROR(importer.ConvertLibFunction(fn_name));
    }

    return Status::OK();
}

std::vector<string> ParseInputArrays(const std::vector<std::pair<string, Tensor>>& input_pairs) {
    std::vector<string> result;
    for (const auto& pair : input_pairs) {
        result.push_back(pair.first);
    }
    return result;
}
