import numpy as np
from pandas.api.types import CategoricalDtype
from pandas.core.indexes.numeric import NumericIndex
from pandas.core.indexes.base import Index
from pandas.core.dtypes.common import is_integer_dtype

class RangeIndex(NumericIndex):
    _typ = "rangeindex"
    _engine_type = None  # This should be set appropriately based on the actual implementation
    _dtype_validation_metadata = {'kind': 'i'}  # Ensure it is a signed integer
    _can_hold_na = False
    
    def __init__(self, start=0, stop=None, step=1, name=None):
        if stop is None:
            stop = start
            start = 0
        
        self._range = range(start, stop, step)
        super().__init__(np.array(list(self._range), dtype=np.int64), name=name)
    
    @property
    def start(self):
        return next(iter(self._range))
    
    @property
    def stop(self):
        return next(reversed(self._range))
    
    @property
    def step(self):
        return list(self._range)[1] - list(self._range)[0]
    
    def contains(self, key):
        return key in self._range
    
    def __add__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start + other, self.stop + other, self.step)
        elif isinstance(other, RangeIndex):
            if self.step != other.step or self.start % self.step != other.start % self.step:
                raise ValueError("Cannot add non-matching RangeIndexes")
            return RangeIndex(min(self.start, other.start), max(self.stop, other.stop), self.step)
        else:
            return NotImplemented
    
    def __sub__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start - other, self.stop - other, self.step)
        elif isinstance(other, RangeIndex):
            if self.step != other.step or self.start % self.step != other.start % self.step:
                raise ValueError("Cannot subtract non-matching RangeIndexes")
            return RangeIndex(max(self.start, other.start), min(self.stop, other.stop), self.step)
        else:
            return NotImplemented
    
    def __mul__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start * other, self.stop * other, self.step * other)
        else:
            return NotImplemented
    
    def __truediv__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start // other, self.stop // other, self.step // other)
        else:
            return NotImplemented
    
    def __contains__(self, item):
        return self.contains(item)
    
    def __getitem__(self, key):
        if isinstance(key, slice):
            start = key.start if key.start is not None else self.start
            stop = key.stop if key.stop is not None else self.stop
            step = key.step if key.step is not None else self.step
            return RangeIndex(start, stop, step)
        else:
            return self._range[key]
    
    def __len__(self):
        return len(self._range)
    
    def __repr__(self):
        return f"RangeIndex({self.start}, {self.stop}, {self.step})"
