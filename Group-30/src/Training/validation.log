import tensorflow as tf
from typing import Tuple, Dict
from py_utils import Config, NestedMap

class CarLayersTest(tf.test.TestCase):
    def _testNestedOutShape(self, p: Config, input_shape: Tuple[int], expected_shape: NestedMap):
        # Set up the TensorFlow graph
        with self.session() as sess:
            # Create a placeholder for the input tensor
            input_tensor = tf.placeholder(tf.float32, shape=input_shape)
            
            # Instantiate the SamplingAndGroupingLayer
            layer = SamplingAndGroupingLayer(p)
            
            # Get the output tensor from the layer
            output_tensor = layer(input_tensor)
            
            # Run the session to get the actual output shape
            actual_shape = sess.run(output_tensor).shape
            
            # Check if the actual shape matches the expected shape
            self.assertEqual(actual_shape, expected_shape)

class SamplingAndGroupingLayer(tf.keras.layers.Layer):
    def __init__(self, p: Config):
        super(SamplingAndGroupingLayer, self).__init__()
        self.p = p
    
    def call(self, inputs: tf.Tensor) -> tf.Tensor:
        batch_size, num_points, feature_dim = inputs.shape.as_list()
        
        # Sample points
        sampled_indices = tf.random.uniform([batch_size, self.p.num_samples], maxval=num_points, dtype=tf.int32)
        sampled_points = tf.gather(inputs, sampled_indices, axis=1)
        
        # Group points by spatial proximity (simplified example)
        grouped_points = tf.reshape(sampled_points, [batch_size, self.p.num_samples, self.p.group_size, feature_dim])
        
        return grouped_points

# Example usage
if __name__ == '__main__':
    tf.test.main()
```

