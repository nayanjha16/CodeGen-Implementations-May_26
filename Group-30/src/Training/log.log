    std::string bin_file_name;
    std::vector<int> receptive_field_list;
    std::vector<int> receptive_field_stride;
    ncnn::Net net;

    // Helper method to load the neural network model
    void loadModel() const;

    // Helper method to perform inference on the input image
    void infer(const cv::Mat& input_image, std::vector<std::vector<float>>& outputs) const;

    // Helper method to post-process the inference results
    void postProcess(const std::vector<std::vector<float>>& outputs, std::vector<cv::Rect>& bounding_boxes) const;
};

// Constructor implementation
LFFD::LFFD(int num_output_scales, int num_thread, const std::string& param_file_name, const std::string& bin_file_name)
    : num_output_scales(num_output_scales), num_thread(num_thread), param_file_name(param_file_name), bin_file_name(bin_file_name) {
    loadModel();
}

// Destructor implementation
LFFD::~LFFD() {
    // Clean up resources if necessary
}

// Method to detect faces in an image
void LFFD::detectFaces(const cv::Mat& input_image, std::vector<cv::Rect>& bounding_boxes) const {
    std::vector<std::vector<float>> outputs;
    infer(input_image, outputs);
    postProcess(outputs, bounding_boxes);
}

// Helper method to load the neural network model
void LFFD::loadModel() const {
    net.load_param(param_file_name.c_str());
    net.load_model(bin_file_name.c_str());
}

// Helper method to perform inference on the input image
void LFFD::infer(const cv::Mat& input_image, std::vector<std::vector<float>>& outputs) const {
    ncnn::Extractor ex = net.create_extractor();
    ex.set_num_threads(num_thread);

    ncnn::Mat in = ncnn::Mat::from_pixels_resize(input_image.data, ncnn::Mat::PIXEL_BGR, input_image.cols, input_image.rows, 320, 240);
    ex.input("input", in);

    for (int i = 0; i < num_output_scales; ++i) {
        std::vector<float> output;
        ex.extract(std::to_string(i + 1).c_str(), output);
        outputs.push_back(output);
    }
}

// Helper method to post-process the inference results
void LFFD::postProcess(const std::vector<std::vector<float>>& outputs, std::vector<cv::Rect>& bounding_boxes) const {
    for (const auto& output : outputs) {
        for (size_t j = 0; j < output.size(); j += 5) {
            float confidence = output[j + 4];
            if (confidence > 0.5) {
                int x1 = static_cast<int>(output[j] * input_image.cols);
                int y1 = static_cast<int>(output[j + 1] * input_image.rows);
                int x2 = static_cast<int>(output[j + 2] * input_image.cols);
                int y2 = static_cast<int>(output[j + 3] * input_image.rows);
                bounding_boxes.emplace_back(x1, y1, x2 - x1, y2 - y1);
            }
        }
    }
}
```

This code snippet defines the `LFFD` class, which includes methods for initializing the model, performing inference, and post-processing the results to detect faces in images. The class uses the ncnn library for neural network operations.
