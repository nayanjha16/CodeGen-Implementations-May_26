```cpp
#include <SFML/Graphics.hpp>
#include <vector>
#include <array>

// Define the shape of each tetromino
enum class Figure {
    I,
    Z,
    S,
    T,
    L,
    J,
    O
};

// Define the possible directions for tetromino movement
enum class Direction {
    Left,
    Right,
    Down,
    Rotate
};

class Block {
public:
    Block(Figure figure, sf::Vector2i position);
    void draw(sf::RenderWindow& window);
    // Other necessary methods for block manipulation

private:
    Figure figure;
    sf::Vector2i position;
    std::vector<sf::RectangleShape> shapes;
};

class Map {
public:
    Map();
    bool canPlace(const Block& block) const;
    void placeBlock(const Block& block);
    void clearLines();
    // Other necessary methods for map manipulation

private:
    std::vector<std::vector<bool>> grid;
    int width;
    int height;
};

class Engine {
public:
    Engine();
    void run(sf::RenderWindow& window);
    void handleEvents(sf::Event& event);
    void update(float deltaTime);
    void render(sf::RenderWindow& window);

private:
    static constexpr std::array<Figure, 7> figures = {Figure::I, Figure::Z, Figure::S, Figure::T, Figure::L, Figure::J, Figure::O};
    float time;
    int delay;
    bool game;
    Direction direction;
    int score;
    bool rotate;

    Block currentBlock;
    Map map;
    sf::Clock clock;
    sf::SoundBuffer soundBuffer;
    sf::Sound sound;
};

Engine::Engine()
    : time(0.0f), delay(500), game(true), direction(Direction::Down), score(0), rotate(false),
      currentBlock(figures[0], sf::Vector2i(4, 0)), map(), clock(), soundBuffer(), sound() {
    // Load sound buffer if needed
}

void Engine::run(sf::RenderWindow& window) {
    while (window.isOpen()) {
        sf::Event event;
        while (window.pollEvent(event)) {
            handleEvents(event);
        }

        float deltaTime = clock.getElapsedTime().asMilliseconds();
        clock.restart();

        update(deltaTime / 1000.0f); // Convert milliseconds to seconds
        render(window);
    }
}

void Engine::handleEvents(sf::Event& event) {
    if (event.type == sf::Event::KeyPressed) {
        switch (event.key.code) {
            case sf::Keyboard::Left:
                direction = Direction::Left;
                break;
            case sf::Keyboard::Right:
                direction = Direction::Right;
                break;
            case sf::Keyboard::Down:
                direction = Direction::Down;
                break;
            case sf::Keyboard::Up:
                rotate = true;
                break;
            case sf::Keyboard::Escape:
                game = false;
                break;
            default:
                break;
        }
    }
}

void Engine::update(float deltaTime) {
    time += deltaTime;
    if (time >= delay) {
        time -= delay;
        move(direction);
    }

    if (rotate) {
        rotateBlock();
        rotate = false;
    }

    checkCollision();
}

void Engine::render(sf::RenderWindow& window) {
    window.clear();
    map.draw(window);
    currentBlock.draw(window);
    window.display();
}

void Engine::move(Direction dir) {
    switch (dir) {
        case Direction::Left:
            currentBlock.move(-1, 0);
            break;
        case Direction::Right:
            currentBlock.move(1, 0);
            break;
        case Direction::Down:
            currentBlock.move(0, 1);
            break;
        default:
            break;
    }
}

void Engine::rotateBlock() {
    currentBlock.rotate();
}

void Engine::checkCollision() {
    if (!map.canPlace(currentBlock)) {
        map.placeBlock(currentBlock);
        currentBlock = Block(figures[0], sf::Vector2i(4, 0));
        map.clearLines();
        score++;
    }
}

int main() {
    sf::RenderWindow window(sf::VideoMode(800, 600), "Tetris");
    Engine engine;

    while (engine.game) {
        engine.run(window);
    }

    return 0;
}
```

This code provides a basic implementation of a Tetris-like game using the SFML library. The `Engine` class manages the game loop, event handling, and game state. The `Block` and `Map` classes handle the individual blocks and the game board, respectively. The `main` function initializes the SFML window and runs the game loop.
