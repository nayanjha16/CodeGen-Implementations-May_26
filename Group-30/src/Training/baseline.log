import json
from typing import List, Dict

class PreprocessGenerator:
    def __init__(self, path_fast_text_model_l2i_i2l: str):
        """
        Initializes the PreprocessGenerator object. If a pre-existing mapping file exists,
        it loads this mapping into l2i_i2l.
        
        :param path_fast_text_model_l2i_i2l: Path to the JSON file containing label-to-index and index-to-label mappings.
        """
        self.l2i_i2l = {}
        if path_fast_text_model_l2i_i2l.exists():
            with open(path_fast_text_model_l2i_i2l, 'r') as file:
                self.l2i_i2l = json.load(file)

    def prereocess_idx(self, pred: List[int]) -> List[str]:
        """
        Converts prediction indices back to labels and sorts them based on their probabilities.
        
        :param pred: A list of predicted indices.
        :return: A sorted list of labels.
        """
        # Assuming pred contains tuples (index, probability)
        indexed_labels = [(self.l2i_i2l[str(index)], prob) for index, prob in pred]
        sorted_labels = sorted(indexed_labels, key=lambda x: x[1], reverse=True)
        return [label for label, _ in sorted_labels]

# Example usage:
