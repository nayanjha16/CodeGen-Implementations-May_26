```python
import boto3
import hashlib
import os
import urllib.request

# Global Variables
s3bucket_name = 'your-s3-bucket-name'
license_key = 'your-license-key'
s3key_prefix = 'GeoLite2/'

def download_file(filename):
    """Downloads the specified GeoIP database file from MaxMind and saves it locally."""
    url = f'https://geolite.maxmind.com/download/geoip/database/{filename}.tar.gz?license_key={license_key}'
    local_filename = filename + '.tar.gz'
    urllib.request.urlretrieve(url, local_filename)
    return local_filename

def put_to_s3(filename):
    """Uploads the downloaded GeoIP database file to the specified S3 bucket after verifying its integrity."""
    s3_client = boto3.client('s3')
    local_filename = filename + '.tar.gz'
    
    # Verify integrity using SHA-256 checksum
    with open(local_filename, 'rb') as f:
        sha256_hash = hashlib.sha256(f.read()).hexdigest()
    
    # Download expected checksum from MaxMind
    checksum_url = f'https://geolite.maxmind.com/download/geoip/database/{filename}.sha256'
    with urllib.request.urlopen(checksum_url) as response:
        expected_checksum = response.read().decode().strip().split()[0]
    
    if sha256_hash != expected_checksum:
        raise ValueError("Checksum verification failed")
    
    # Upload file to S3
    s3_client.upload_file(local_filename, s3bucket_name, s3key_prefix + local_filename)

def send(event, context, responseStatus, responseData, physicalResourceId=None, noEcho=False):
    """Sends a response back to CloudFormation indicating the success or failure of the operation."""
    responseUrl = event['ResponseURL']
    
    print(responseUrl)
    
    responseBody = {}
    responseBody['Status'] = responseStatus
    responseBody['Reason'] = 'See the details in CloudWatch Log Stream: ' + context.log_stream_name
    responseBody['PhysicalResourceId'] = physicalResourceId or context.log_stream_name
    responseBody['StackId'] = event['StackId']
    responseBody['RequestId'] = event['RequestId']
    responseBody['LogicalResourceId'] = event['LogicalResourceId']
    responseBody['Data'] = responseData
    
    json_response_body = json.dumps(responseBody)
    
    headers = {
        'content-type': '',
        'content-length': str(len(json_response_body))
    }
    
    try:
        response = requests.put(responseUrl,
                               data=json_response_body,
                               headers=headers)
        print("Status code:", response.status_code)
        print("Status text:", response.reason)
    except Exception as e:
        print("Send response failed: " + str(e))

def lambda_handler(event, context):
    """The main entry point for the Lambda function"""
    responseData = {}
    
    try:
        if event['RequestType'] == 'Create':
            filename = 'GeoLite2-City'  # Example filename, can be dynamic based on event
            download_file(filename)
            put_to_s3(filename)
            responseData['Message'] = 'GeoIP database uploaded successfully'
        elif event['RequestType'] == 'Update':
            filename = 'GeoLite2-City'  # Example filename, can be dynamic based on event
            download_file(filename)
            put_to_s3(filename)
            responseData['Message'] = 'GeoIP database updated successfully'
        elif event['RequestType'] == 'Delete':
            responseData['Message'] = 'No action needed for delete request'
        
        send(event, context, 'SUCCESS', responseData)
    except Exception as e:
        responseData['Error'] = str(e)
        send(event, context, 'FAILED', responseData)
```

This code includes the global variables, standalone functions, and the main `lambda_handler` function as described in the documentation. It handles both `Create` and `Update` events by downloading and uploading GeoIP databases to an S3 bucket, and sends appropriate responses back to CloudFormation.
