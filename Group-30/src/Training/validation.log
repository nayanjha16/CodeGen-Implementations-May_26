from kivy.uix.popup import Popup
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.listview import ListView, ListItemButton
from kivy.properties import NumericProperty, ReferenceListProperty, ObjectProperty

class MultiSelectPopUp(Popup):
    pHint_x = NumericProperty(0.8)
    pHint_y = NumericProperty(0.6)
    pHint = ReferenceListProperty(pHint_x, pHint_y)

    def __init__(self, title, option_list, option_init=None, callback=None, multiselect=True, **kwargs):
        super(MultiSelectPopUp, self).__init__(**kwargs)
        self.title = title
        self.option_list = option_list
        self.callback = callback
        self.multiselect = multiselect
        
        if option_init is None:
            option_init = [False] * len(option_list)
        
        layout = BoxLayout(orientation='vertical')
        self.list_view = ListView(adapter=ListAdapter(data=[{'text': item} for item in option_list]))
        layout.add_widget(self.list_view)
        
        button_layout = BoxLayout(size_hint=(1, 0.1))
        ok_button = Button(text='OK', size_hint=(0.5, 1))
        cancel_button = Button(text='Cancel', size_hint=(0.5, 1))
        
        ok_button.bind(on_press=self.on_ok)
        cancel_button.bind(on_press=self.dismiss)
        
        button_layout.add_widget(ok_button)
        button_layout.add_widget(cancel_button)
        layout.add_widget(button_layout)
        
        self.content = layout
    
    def on_ok(self, instance):
        selected_indices = [i for i, item in enumerate(self.list_view.adapter.data) if item['selected']]
        selected_items = [self.option_list[i] for i in selected_indices]
        if self.callback:
            self.callback(selected_items)
        self.dismiss()

class ListAdapter(object):
    def __init__(self, data):
        self._data = data
    
    def get_view(self, index):
        view = ListItemButton(text=self._data[index]['text'])
        view.bind(on_release=lambda x: setattr(x, 'selected', not getattr(x, 'selected', False)))
        return view
    
    def get_length(self):
        return len(self._data)
```

This code defines a `MultiSelectPopUp` class that extends `Popup` from Kivy. It includes a list view with selectable items and buttons to confirm or cancel the selection. The selected items are passed back to the caller via a callback function when the OK button is pressed.
