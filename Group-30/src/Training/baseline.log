    // Add student to the course
    mathCourse.addStudent(student1);

    // Display students in the course
    mathCourse.displayStudents();

    // Remove student from the course
    mathCourse.removeStudent("John Doe");

    // Display students in the course after removal
    mathCourse.displayStudents();

    return 0;
}
