#include <windows.h>
#include <winternl.h>
#include <string>

// Forward declaration of UNICODE_STRING structure
typedef struct _UNICODE_STRING {
    USHORT Length;
    USHORT MaximumLength;
    PWSTR Buffer;
} UNICODE_STRING, *PUNICODE_STRING;

// Global variable for exceptions
extern "C" LONG exceptions;

class ScopedEnterCriticalSection {
public:
    // Constructor that enters the critical section
    explicit ScopedEnterCriticalSection(CRITICAL_SECTION* critsec)
        : critsec_(critsec) {
        EnterCriticalSection(critsec_);
    }

    // Destructor that leaves the critical section when the object goes out of scope
    ~ScopedEnterCriticalSection() {
        LeaveCriticalSection(critsec_);
    }

private:
    CRITICAL_SECTION* critsec_;
};

std::wstring FromUnicodeString(const UNICODE_STRING& str) {
    if (str.Buffer == nullptr || str.Length == 0) {
        return std::wstring();
    }
    return std::wstring(str.Buffer, str.Length / sizeof(wchar_t));
}
```

