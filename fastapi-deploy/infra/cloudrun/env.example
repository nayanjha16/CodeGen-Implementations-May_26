# Copy this file to deploy.env (same folder) and fill in GCP_PROJECT_ID.
# deploy.env is gitignored - never commit project id, URL, or secrets.
# Works on Windows, macOS, and Linux (read by deploy.py). No shell needed.

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south2        # Hyderabad

SERVICE_NAME=codegen-api
AR_REPO=codegen-api
IMAGE_TAG=latest

# Cloud Run sizing (350M model + PyTorch needs ample RAM on CPU)
CLOUD_RUN_MEMORY=8Gi
CLOUD_RUN_CPU=2
CLOUD_RUN_TIMEOUT=900
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_MAX_INSTANCES=1

# Hugging Face org for public adapters
HF_ORG=codegenstudio

# Set after first deploy (deploy.py prints it)
# CLOUD_RUN_SERVICE_URL=https://***.asia-south2.run.app
