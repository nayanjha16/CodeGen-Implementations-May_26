assistant
```python
class Point:
    def __init__(self, x, y):
        self.x = x
        self.y = y

    def __add__(self, q):
        return Point(self.x + q.x, self.y + q.y)

class RiskMap:
    def __init__(self, levels, factor=1):
        self._factor = factor
        self._levels = [[(level + (i // len(levels)) % 9 + (j // len(levels[0])) % 9 - 1) % 9 + 1 for j, level in enumerate(row)] for i, row in enumerate(levels)]
        self._nrows = len(self._levels)
        self._ncols = len(self._levels[0])

    def get_risk_level(self, point):
        if not (0 <= point.x < self._ncols * self._factor and 0 <= point.y < self._nrows * self._factor):
            raise ValueError("Point out of bounds")
        return self._levels[point.y // self._factor][point.x // self._factor]

    def find_lowest_risk_path(self):
        nrows = self._nrows * self._factor
        ncols = self._ncols * self._factor
        dp = [[float('inf')] * ncols for _ in range(nrows)]
        dp[0][0] = 0

        directions = [Point(0, 1), Point(1, 0)]

        queue = [(0, 0)]
        while queue:
            current_x, current_y = queue.pop(0)
            current_risk = dp[current_y][current_x]

            for direction in directions:
                next_point = current_point + direction
                next_x, next_y = next_point.x, next_point.y
                if 0 <= next_x < ncols and 0 <= next_y < nrows:
                    next_risk = current_risk + self.get_risk_level(next_point)
                    if next_risk < dp[next_y][next_x]:
                        dp[next_y][next_x] = next_risk
                        queue.append((next_x, next_y))

        return dp[nrows - 1][ncols - 1]
```

This code defines the `Point` and `RiskMap` classes as specified in the documentation. The `RiskMap` class includes methods to calculate the risk level at a given point and to find the lowest risk path through the grid. The `find_lowest_risk_path` method uses dynamic programming to efficiently compute the solution.
