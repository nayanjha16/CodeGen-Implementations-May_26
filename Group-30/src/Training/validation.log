```python
import time
import json
from robolink import Robolink, ItemTypes

# Global Variables and Standalone Functions

AxesOptimSettings = {
    "active": True,
    "algorithm_type": "Gradient Descent",
    "iteration_limit": 1000,
    "tolerance": 0.001,
    "absolute_joint_references": [0, 0, 0],
    "weights": [1.0, 1.0, 1.0],
    "relative_motion_settings": {"speed_factor": 0.8}
}

ToUpdate = {}

def pause(seconds):
    """
    Pauses the execution of the script for a specified duration.

    Parameters:
    - seconds (float): Number of seconds to pause execution.

    Returns:
    - None
    """
    time.sleep(seconds)

# Classes and Structs

class Robolink:
    def __init__(self):
        self.robot = None

    def get_item(self, name, itemtype=ItemTypes.Robot):
        if itemtype == ItemTypes.Robot:
            self.robot = name
            return self.robot
        else:
            raise ValueError("Unsupported item type")

    def set_value(self, key, value):
        global ToUpdate
        ToUpdate[key] = value

    def get_value(self, key):
        global ToUpdate
        return ToUpdate.get(key, AxesOptimSettings.get(key))

    def save_json(self, filename):
        global ToUpdate
        data = {**AxesOptimSettings, **ToUpdate}
        with open(filename, 'w') as file:
            json.dump(data, file, indent=4)

    def load_json(self, filename):
        global ToUpdate
        with open(filename, 'r') as file:
            data = json.load(file)
            ToUpdate.update(data)

# Functions and Methods

def main():
    rl = Robolink()
    robot_name = input("Enter the name of the robot arm: ")
    rl.get_item(robot_name)

    print("Current axes optimization settings:")
    for key, value in AxesOptimSettings.items():
        print(f"{key}: {value}")

    while True:
        update_key = input("Enter the setting to update (or 'exit' to finish): ")
        if update_key.lower() == 'exit':
            break
        new_value = input(f"Enter the new value for {update_key}: ")
        try:
            new_value = float(new_value) if new_value.replace('.', '', 1).isdigit() else new_value
            rl.set_value(update_key, new_value)
        except ValueError:
            print("Invalid input. Please enter a valid value.")

    rl.save_json('axes_optimization.json')
    print("Updated settings saved to 'axes_optimization.json'")

if __name__ == "__main__":
    main()
```

This Python script demonstrates how to interact with the RoboDK API to read and modify the axes optimization settings of a robot arm. It includes a `Robolink` class that provides access to the RoboDK API functionalities, a `main` function that interacts with the user to update and save the axes optimization settings, and global variables to manage the settings and updates.
