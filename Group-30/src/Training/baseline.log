#include <string>
#include <iostream>

// Forward declarations
class ProcessLaunchCommandOptions;
class CommandInterpreter;

// Class representing the base command object for process operations
class CommandObjectParsed {
public:
    virtual ~CommandObjectParsed() = default;
    virtual bool Execute(CommandInterpreter &interpreter) = 0;
};

// Class for handling the 'process launch' command
class CommandObjectProcessLaunch : public CommandObjectParsed {
public:
    CommandObjectProcessLaunch(CommandInterpreter &interpreter)
        : m_interpreter(interpreter), m_options(new ProcessLaunchCommandOptions()) {}

    ~CommandObjectProcessLaunch() override {
        delete m_options;
    }

    bool Execute(CommandInterpreter &interpreter) override {
        // Implementation of process launch logic
        std::cout << "Launching process..." << std::endl;
        return true;
    }

private:
    CommandInterpreter &m_interpreter;
    ProcessLaunchCommandOptions *m_options;
};

// Class for handling the 'process attach' command
class CommandObjectProcessAttach : public CommandObjectParsed {
public:
    CommandObjectProcessAttach(CommandInterpreter &interpreter)
        : m_interpreter(interpreter) {}

    bool Execute(CommandInterpreter &interpreter) override {
        // Implementation of process attach logic
        std::cout << "Attaching to process..." << std::endl;
        return true;
    }

private:
    CommandInterpreter &m_interpreter;
};

// Class for handling the 'process detach' command
class CommandObjectProcessDetach : public CommandObjectParsed {
public:
    CommandObjectProcessDetach(CommandInterpreter &interpreter)
        : m_interpreter(interpreter) {}

    bool Execute(CommandInterpreter &interpreter) override {
        // Implementation of process detach logic
        std::cout << "Detaching from process..." << std::endl;
        return true;
    }

private:
    CommandInterpreter &m_interpreter;
};

// Class for handling the 'process signal' command
class CommandObjectProcessSignal : public CommandObjectParsed {
public:
    CommandObjectProcessSignal(CommandInterpreter &interpreter)
        : m_interpreter(interpreter) {}

    bool Execute(CommandInterpreter &interpreter) override {
        // Implementation of process signal logic
        std::cout << "Sending signal to process..." << std::endl;
        return true;
    }

private:
    CommandInterpreter &m_interpreter;
};
