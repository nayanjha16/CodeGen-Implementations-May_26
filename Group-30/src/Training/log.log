import re
from setuptools import setup

# Global variable to hold the version number
__version__ = None

def _read_version():
    global __version__
    with open('facebookbot/__about__.py', 'r') as about_file:
        match = re.search(r'__version__\s*=\s*[\'"]([^\'"]+)[\'"]', about_file.read())
        if match:
            __version__ = match.group(1)

def _requirements():
    """Reads the list of dependencies from the requirements.txt file."""
    with open('requirements.txt', 'r') as requirements_file:
        return [line.strip() for line in requirements_file.readlines()]

def setup_package():
    """Configures and sets up the package using the setuptools library."""
    _read_version()
    
    setup(
        name="fbsdk",
        version=__version__,
        packages=["facebookbot"],
        install_requires=_requirements(),
        author="Your Name",
        author_email="your.email@example.com",
        description="A Facebook Messaging API SDK",
        long_description=open("README.md").read(),
        long_description_content_type="text/markdown",
        url="https://github.com/yourusername/fbsdk",
        classifiers=[
            "Programming Language :: Python :: 3",
            "License :: OSI Approved :: MIT License",
            "Operating System :: OS Independent",
        ],
        python_requires='>=3.6',
    )

if __name__ == "__main__":
    setup_package()
```

