    MkldnnQuantizerConfig() : default_scale_algo_(ScaleAlgo::kNone) {}

    // Method to set a specific scaling algorithm for a given operation and connection
    void SetRule(const std::string& op_type, const std::string& conn_name, ScaleAlgo algo) {
        rules_[op_type][conn_name] = algo;
    }

    // Method to get the scaling algorithm for a given operation and connection
    ScaleAlgo GetRule(const std::string& op_type, const std::string& conn_name) const {
        auto it_op = rules_.find(op_type);
        if (it_op != rules_.end()) {
            auto it_conn = it_op->second.find(conn_name);
            if (it_conn != it_op->second.end()) {
                return it_conn->second;
            }
        }
        return default_scale_algo_;
    }

private:
    // Nested map to store the scaling rules
    std::map<std::string, std::map<std::string, ScaleAlgo>> rules_;

    // Default scaling algorithm
    ScaleAlgo default_scale_algo_;
};

}  // namespace paddle
```

This code defines the `MkldnnQuantizerConfig` class within the `paddle` namespace, including its constructor, `SetRule` method, and `GetRule` method. The `rules_` member variable is a nested map that stores the scaling algorithms for different operation types and connections, while `default_scale_algo_` provides a fallback value when no specific rule is found.
