        public:
            VkBuffer getHandle() const;
            // Other Vulkan object methods
        };

        class VulkanStagingBuffer {
        private:
            std::shared_ptr<VulkanObjectManager> m_objectManager;
            uint64_t m_sizeInBytes;
            VulkanObject m_object;
            uint64_t m_offsetAlignment;
            uint64_t m_sizeAlignment;
            void* m_pointer;
            uint64_t m_offset;
            std::vector<StagingData> m_reservations;

        public:
            VulkanStagingBuffer(std::shared_ptr<VulkanObjectManager> objectManager, uint64_t sizeInBytes, uint64_t offsetAlignment = 256, uint64_t sizeAlignment = 256);

            void reserveSpace(uint64_t size, uint64_t alignment);
            void flush();
            void reset();

            uint64_t getSizeInBytes() const { return m_sizeInBytes; }
            uint64_t getOffset() const { return m_offset; }
            void* getPointer() const { return m_pointer; }

        private:
            void allocateBuffer();
            void deallocateBuffer();
        };

        VulkanStagingBuffer::VulkanStagingBuffer(std::shared_ptr<VulkanObjectManager> objectManager, uint64_t sizeInBytes, uint64_t offsetAlignment, uint64_t sizeAlignment)
            : m_objectManager(objectManager), m_sizeInBytes(sizeInBytes), m_offsetAlignment(offsetAlignment), m_sizeAlignment(sizeAlignment) {
            allocateBuffer();
        }

        void VulkanStagingBuffer::allocateBuffer() {
            m_objectManager->createBuffer(m_sizeInBytes, VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
            m_object = VulkanObject();
            m_pointer = m_object.getHandle();
            m_offset = 0;
        }

        void VulkanStagingBuffer::deallocateBuffer() {
            m_objectManager->destroyBuffer(m_object.getHandle());
        }

        void VulkanStagingBuffer::reserveSpace(uint64_t size, uint64_t alignment) {
            uint64_t alignedSize = (size + alignment - 1) & ~(alignment - 1);
            if (m_offset + alignedSize > m_sizeInBytes) {
                throw std::runtime_error("Not enough space in staging buffer");
            }
            m_reservations.push_back({m_offset, alignedSize});
            m_offset += alignedSize;
        }

        void VulkanStagingBuffer::flush() {
            // Flush the buffer to the GPU
            // Implementation details depend on Vulkan API usage
        }

        void VulkanStagingBuffer::reset() {
            m_offset = 0;
            m_reservations.clear();
        }

    } // namespace vulkan
} // namespace dp
