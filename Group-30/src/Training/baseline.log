```python
import paramiko

def read_devices_file(file_path):
    with open(file_path, 'r') as f:
        return [line.strip().split() for line in f.readlines()]

def read_commands_file(file_path):
    with open(file_path, 'r') as f:
        return [line.strip() for line in f.readlines()]

def connect_to_device(addr, user, pwd):
    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    client.connect(addr, username=user, password=pwd)
    return client.invoke_shell()

def send_commands(device_access, commands):
    output = []
    for command in commands:
        device_access.send(command + '\n')
        while True:
            if device_access.recv_ready():
                output.append(device_access.recv(1024).decode('utf-8'))
            else:
                break
    return ''.join(output)

def write_output_to_file(ip_address, output):
    with open(f'{ip_address}.txt', 'w') as f:
        f.write(output)

def main():
    devices = read_devices_file('devices.txt')
    commands = read_commands_file('commands.txt')

    for data in devices:
        addr, user, pwd = data
        device_access = connect_to_device(addr, user, pwd)
        output = send_commands(device_access, commands)
        write_output_to_file(addr, output)
        device_access.close()

if __name__ == "__main__":
    main()
```

### Explanation:

1. **read_devices_file**: Reads the `devices.txt` file and returns a list of lists, where each sublist contains the IP address, username, and password for a device.
2. **read_commands_file**: Reads the `commands.txt` file and returns a list of commands to be sent to each device.
3. **connect_to_device**: Establishes an SSH connection to a device using the provided IP address, username, and password, and returns a channel object for sending commands.
4. **send_commands**: Sends a list of commands to the device via the provided channel and captures the output.
5. **write_output_to_file**: Writes the captured output to a file named after the device's IP address.
6. **main**: Orchestrates the process by reading device and command files, connecting to each device, sending commands, capturing output, and writing it to files.
