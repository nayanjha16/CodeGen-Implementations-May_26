#include <vector>
#include <cmath>

namespace tg {

template <typename ScalarT>
struct pos2 {
    ScalarT x;
    ScalarT y;

    pos2(ScalarT x = 0, ScalarT y = 0) : x(x), y(y) {}
};

template <typename ScalarT>
class segment {
public:
    pos2<ScalarT> pos0;
    pos2<ScalarT> pos1;

    segment(pos2<ScalarT> pos0, pos2<ScalarT> pos1) : pos0(pos0), pos1(pos1) {}

    std::vector<pos2<int>> rasterize() const {
        std::vector<pos2<int>> points;
        int x0 = static_cast<int>(std::round(pos0.x));
        int y0 = static_cast<int>(std::round(pos0.y));
        int x1 = static_cast<int>(std::round(pos1.x));
        int y1 = static_cast<int>(std::round(pos1.y));

        int dx = abs(x1 - x0);
        int dy = abs(y1 - y0);
        int sx = (x0 < x1) ? 1 : -1;
        int sy = (y0 < y1) ? 1 : -1;
        int err = dx - dy;

        while (true) {
            points.emplace_back(x0, y0);
            if ((x0 == x1) && (y0 == y1)) break;
            int e2 = 2 * err;
            if (e2 > -dy) { err -= dy; x0 += sx; }
            if (e2 < dx) { err += dx; y0 += sy; }
        }

        return points;
    }

    std::vector<pos2<int>> rasterize_with_distances() const {
        std::vector<pos2<int>> points;
        int x0 = static_cast<int>(std::round(pos0.x));
        int y0 = static_cast<int>(std::round(pos0.y));
        int x1 = static_cast<int>(std::round(pos1.x));
        int y1 = static_cast<int>(std::round(pos1.y));

        int dx = abs(x1 - x0);
        int dy = abs(y1 - y0);
        int sx = (x0 < x1) ? 1 : -1;
        int sy = (y0 < y1) ? 1 : -1;
        int err = dx - dy;

        while (true) {
            points.emplace_back(x0, y0);
            if ((x0 == x1) && (y0 == y1)) break;
            int e2 = 2 * err;
            if (e2 > -dy) { err -= dy; x0 += sx; }
            if (e2 < dx) { err += dx; y0 += sy; }
        }

        return points;
    }
};

template <typename ScalarT>
class triangle {
public:
    pos2<ScalarT> pos0;
    pos2<ScalarT> pos1;
    pos2<ScalarT> pos2;

    triangle(pos2<ScalarT> pos0, pos2<ScalarT> pos1, pos2<ScalarT> pos2)
        : pos0(pos0), pos1(pos1), pos2(pos2) {}

    std::vector<pos2<int>> rasterize() const {
        // Implement rasterization logic here
        return {};
    }

    std::vector<pos2<int>> rasterize_with_barycentric_coords() const {
        // Implement rasterization with barycentric coordinates logic here
        return {};
    }
};

class aabb {
public:
    pos2<int> min;
    pos2<int> max;

    aabb(pos2<int> min, pos2<int> max) : min(min), max(max) {}

    bool contains(const pos2<int>& point) const {
        return (point.x >= min.x && point.x <= max.x &&
                point.y >= min.y && point.y <= max.y);
    }
};

} // namespace tg
