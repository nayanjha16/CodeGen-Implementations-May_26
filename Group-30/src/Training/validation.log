```cpp
#include <vector>
#include <array>
#include <algorithm>

class InteractionElement {
public:
    std::array<unsigned short, 4> r;
    std::array<unsigned short, 4> nu;
    double w;
    std::vector<unsigned short> partners_id;

    // Constructor
    InteractionElement(std::array<unsigned short, 4> r, std::array<unsigned short, 4> nu, double w)
        : r(r), nu(nu), w(w) {}

    // Equality operator
    bool operator==(const InteractionElement& other) const {
        return r == other.r && nu == other.nu;
    }
};

class InteractionVertices {
private:
    std::vector<InteractionElement> elements;

public:
    // Constructor to initialize from a list of InteractionElements
    InteractionVertices(const std::vector<InteractionElement>& initial_elements)
        : elements(initial_elements) {}

    // Method to insert a new InteractionElement
    void insert(const InteractionElement& element) {
        elements.push_back(element);
    }

    // Method to sample an InteractionElement based on its weight
    InteractionElement sample() const {
        if (elements.empty()) {
            throw std::runtime_error("No elements to sample");
        }

        double total_weight = 0.0;
        for (const auto& elem : elements) {
            total_weight += elem.w;
        }

        double random_value = static_cast<double>(rand()) / RAND_MAX * total_weight;
        double cumulative_weight = 0.0;

        for (const auto& elem : elements) {
            cumulative_weight += elem.w;
            if (random_value <= cumulative_weight) {
                return elem;
            }
        }

        // Fallback, should never reach here if total_weight is not zero
        throw std::runtime_error("Failed to sample an element");
    }
};
```

This code defines the `InteractionElement` and `InteractionVertices` classes as specified in the documentation. The `InteractionElement` class represents a single matrix element of the Hamiltonian with its properties, and the `InteractionVertices` class manages a collection of these elements, providing methods to insert new elements and sample them based on their weights.
