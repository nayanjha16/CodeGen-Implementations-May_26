#include <iostream>
#include <vector>
#include <string>

// Forward declaration of HloComputation to avoid circular dependency
class HloComputation;

// Enumerations for opcode
enum class Opcode {
    ADD,
    MULTIPLY,
    DATA_MOVEMENT,
    CONTROL_FLOW,
    // Add other opcodes as needed
};

// Class representing the shape of the output
class Shape {
public:
    Shape(int dimensions) : dimensions_(dimensions) {}
    int getDimensions() const { return dimensions_; }
private:
    int dimensions_;
};

// Class representing an operand to the instruction
class HloOperand {
public:
    HloOperand(const std::string& name) : name_(name) {}
    std::string getName() const { return name_; }
private:
    std::string name_;
};

// Class representing an instruction in the HLO computation graph
class HloInstruction {
public:
    HloInstruction(int unique_id, Opcode opcode, const Shape& shape, const std::string& name)
        : unique_id_(unique_id), opcode_(opcode), shape_(shape), name_(name) {}

    int getUniqueId() const { return unique_id_; }
    Opcode getOpcode() const { return opcode_; }
    const Shape& getShape() const { return shape_; }
    const std::string& getName() const { return name_; }

    void addParameter(HloOperand* parameter) {
        parameters_.push_back(parameter);
    }

    void addControlSuccessor(HloInstruction* successor) {
        control_successors_.push_back(successor);
    }

    void addControlPredecessor(HloInstruction* predecessor) {
        control_predecessors_.push_back(predecessor);
    }

    const std::vector<HloOperand*>& getParameters() const { return parameters_; }
    const std::vector<HloInstruction*>& getControlSuccessors() const { return control_successors_; }
    const std::vector<HloInstruction*>& getControlPredecessors() const { return control_predecessors_; }

private:
    int unique_id_;
    Opcode opcode_;
    Shape shape_;
    std::string name_;
    std::vector<HloOperand*> parameters_;
    std::vector<HloInstruction*> control_successors_;
    std::vector<HloInstruction*> control_predecessors_;
};

// Example usage
int main() {
    // Create some operands
    HloOperand param1("param1");
    HloOperand param2("param2");

    // Create a shape
    Shape result_shape(2);

    // Create an instruction
    HloInstruction instruction(1, Opcode::ADD, result_shape, "add_instruction");

    // Add parameters to the instruction
    instruction.addParameter(&param1);
    instruction.addParameter(&param2);

    // Print instruction details
    std::cout << "Instruction ID: " << instruction.getUniqueId() << std::endl;
    std::cout << "Opcode: " << static_cast<int>(instruction.getOpcode()) << std::endl;
    std::cout << "Name: " << instruction.getName() << std::endl;
    std::cout << "Shape Dimensions: " << instruction.getShape().getDimensions() << std::endl;

    return 0;
}
```

