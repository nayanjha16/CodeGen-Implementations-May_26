# Google Cloud Run (HTTPS included via *.run.app)
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY hf_deploy ./hf_deploy
COPY manifest.yaml .
COPY entrypoint.sh /entrypoint.sh
# Windows checkouts often use CRLF; that breaks shebang with "no such file or directory".
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

ENV HF_DEPLOY_ADAPTER_SOURCE=hub
ENV HF_ORG=care2achieve
ENV HF_DEPLOY_EAGER_LOAD=true
ENV HF_DEPLOY_DEVICE=cpu
ENV PYTHONPATH=/app
ENV PORT=8080

EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
