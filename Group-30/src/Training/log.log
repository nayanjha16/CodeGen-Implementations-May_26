#include <ngraph/opsets/opset.hpp>
#include <mkl-dnn/mkl_dnn.h>

namespace ngraph {
    namespace op {

        // Forward declaration of the Rnn struct
        struct Rnn;

        // Builder class responsible for building and registering custom operations
        class Builder {
        public:
            // Template specialization for the Rnn operation
            static void BUILDER_DECL(ngraph::op::Rnn);
        };

        // Rnn struct representing the RNN operation
        struct Rnn : public ngraph::op::Op {
            Rnn(const std::shared_ptr<ngraph::Node>& X,
                 const std::shared_ptr<ngraph::Node>& H,
                 const std::shared_ptr<ngraph::Node>& W,
                 const std::shared_ptr<ngraph::Node>& B,
                 const std::shared_ptr<ngraph::Node>& A,
                 const std::shared_ptr<ngraph::Node>& P);

            virtual std::shared_ptr<Node> clone_with_new_inputs(const OutputVector& new_args) const override;
            virtual bool visit_attributes(AttributeVisitor& visitor) override;

            // Input ports
            static constexpr NodeTypeInfo type_info{"Rnn", 0};
            const NodeTypeInfo& get_type_info() const override { return type_info; }

            // Parameters
            std::shared_ptr<ngraph::Node> m_X;
            std::shared_ptr<ngraph::Node> m_H;
            std::shared_ptr<ngraph::Node> m_W;
            std::shared_ptr<ngraph::Node> m_B;
            std::shared_ptr<ngraph::Node> m_A;
            std::shared_ptr<ngraph::Node> m_P;
        };

        // Implementation of the BUILDER_DECL for the Rnn operation
        void Builder::BUILDER_DECL(ngraph::op::Rnn) {
            auto rnn = std::make_shared<Rnn>(X, H, W, B, A, P);
            register_custom_op("Rnn", [](const OutputVector& args) -> std::shared_ptr<Node> {
                return std::make_shared<Rnn>(args[0], args[1], args[2], args[3], args[4], args[5]);
            });
        }

        // Constructor implementation for the Rnn struct
        Rnn::Rnn(const std::shared_ptr<ngraph::Node>& X,
                 const std::shared_ptr<ngraph::Node>& H,
                 const std::shared_ptr<ngraph::Node>& W,
                 const std::shared_ptr<ngraph::Node>& B,
                 const std::shared_ptr<ngraph::Node>& A,
                 const std::shared_ptr<ngraph::Node>& P)
            : Op({X, H, W, B, A, P}), m_X(X), m_H(H), m_W(W), m_B(B), m_A(A), m_P(P) {}

        // Clone implementation for the Rnn struct
        std::shared_ptr<Node> Rnn::clone_with_new_inputs(const OutputVector& new_args) const {
            return std::make_shared<Rnn>(new_args[0], new_args[1], new_args[2], new_args[3], new_args[4], new_args[5]);
        }

        // Visit attributes implementation for the Rnn struct
        bool Rnn::visit_attributes(AttributeVisitor& visitor) {
            return true;
        }
    } // namespace op
} // namespace ngraph
```

