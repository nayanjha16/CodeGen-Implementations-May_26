    void setValue(const std::string& key, Node* value) {
        _map[key] = value;
    }

    // Method to get a value by key
    Node* getValue(const std::string& key) const {
        auto it = _map.find(key);
        if (it != _map.end()) {
            return it->second;
        }
        return nullptr;
    }

    // Method to remove a key-value pair
    void removeValue(const std::string& key) {
        _map.erase(key);
    }

    // Getter for the underlying plist node
    plist_t getPlistNode() const override {
        return _node;
    }
};
```

