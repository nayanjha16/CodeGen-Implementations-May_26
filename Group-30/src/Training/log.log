import pandas as pd
import matplotlib.pyplot as plt
import os

def group_by_category(df):
    """
    Groups crimes by category and creates a pie chart showing the percentage of crimes in each category.

    Parameters:
    - df (pd.DataFrame): A Pandas DataFrame containing the crime data.

    Algorithm:
    1. Groups the data by the 'CATEGORY' column.
    2. Counts the number of crimes in each category.
    3. Creates a pie chart using Matplotlib, labeling each slice with the category name and its percentage of total crimes.
    4. Sets the title of the chart to "Crimes Percentage Grouped By Category".
    5. Removes the legend from the chart.
    6. Saves the chart as a PNG image named "category.png" in the "../charts" directory.
    """
    # Ensure the output directory exists
    output_dir = '../charts'
    if not os.path.exists(output_dir):
        os.makedirs(output_dir)

    # Group data by category and count occurrences
    category_counts = df['CATEGORY'].value_counts()

    # Create pie chart
    fig, ax = plt.subplots()
    ax.pie(category_counts, labels=category_counts.index, autopct='%1.1f%%', startangle=90)
    ax.axis('equal')  # Equal aspect ratio ensures that pie is drawn as a circle.
    ax.set_title("Crimes Percentage Grouped By Category")
    ax.legend_.remove()  # Remove the legend

    # Save the chart as a PNG image
    chart_path = os.path.join(output_dir, 'category.png')
    plt.savefig(chart_path)
    plt.close(fig)

def group_by_time_of_day(df):
    """
    Groups crimes by time of day and creates a bar graph showing the number of crimes per hour.

    Parameters:
    - df (pd.DataFrame): A Pandas DataFrame containing the crime data.

    Algorithm:
    1. Extracts the hour part from the 'DATETIME' column.
    2. Groups the data by the extracted hour.
    3. Counts the number of crimes in each hour.
    4. Creates a bar graph using Matplotlib, plotting the number of crimes against the hour.
    5. Sets the title of the chart to "Number of Crimes Per Hour".
    6. Saves the chart as a PNG image named "time_of_day.png" in the "../charts" directory.
    """
    # Ensure the output directory exists
    output_dir = '../charts'
    if not os.path.exists(output_dir):
        os.makedirs(output_dir)

    # Extract hour from datetime
    df['HOUR'] = df['DATETIME'].dt.hour

    # Group data by hour and count occurrences
    hour_counts = df['HOUR'].value_counts().sort_index()

    # Create bar graph
    fig, ax = plt.subplots()
    ax.bar(hour_counts.index, hour_counts.values)
    ax.set_xlabel('Hour of Day')
    ax.set_ylabel('Number of Crimes')
    ax.set_title("Number of Crimes Per Hour")

    # Save the chart as a PNG image
    chart_path = os.path.join(output_dir, 'time_of_day.png')
    plt.savefig(chart_path)
    plt.close(fig)

# Example usage
if __name__ == "__main__":
    # Load data from CSV
    df = pd.read_csv('crimes.csv')

    # Process data
    group_by_category(df)
    group_by_time_of_day(df)
