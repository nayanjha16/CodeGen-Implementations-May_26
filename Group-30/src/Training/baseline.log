#include <vector>
#include <optional>

enum class PageBlockType {
    BLOCK_CONTINUEUS,
    BLOCK_REFERENCE
};

class PageBlock {
private:
    PageBlockType m_type;
    std::optional<int> m_start;
    std::optional<int> m_end;
    std::optional<int> m_reference;
    std::optional<int> m_size;

public:
    PageBlock(PageBlockType type, int start, int end)
        : m_type(type), m_start(start), m_end(end) {}

    PageBlock(PageBlockType type, int reference, int size)
        : m_type(type), m_reference(reference), m_size(size) {}

    bool isValid() const {
        return (m_type == PageBlockType::BLOCK_CONTINUEUS && m_start.has_value() && m_end.has_value()) ||
               (m_type == PageBlockType::BLOCK_REFERENCE && m_reference.has_value() && m_size.has_value());
    }

    operator bool() const {
        return isValid();
    }

    int getStart() const {
        if (!m_start.has_value()) {
            throw std::runtime_error("Invalid PageBlock: Start not set");
        }
        return *m_start;
    }

    int getEnd() const {
        if (!m_end.has_value()) {
            throw std::runtime_error("Invalid PageBlock: End not set");
        }
        return *m_end;
    }

    int getReference() const {
        if (!m_reference.has_value()) {
            throw std::runtime_error("Invalid PageBlock: Reference not set");
        }
        return *m_reference;
    }

    int getSize() const {
        if (!m_size.has_value()) {
            throw std::runtime_error("Invalid PageBlock: Size not set");
        }
        return *m_size;
    }
};
```

