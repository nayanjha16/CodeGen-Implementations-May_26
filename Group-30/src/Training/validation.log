from dataclasses import dataclass, field
from typing import List

@dataclass
class Car:
    id: int
    speed: int

@dataclass
class Bridge:
    capacity: int = 5
    length: int = 10
    cars: List[Car] = field(default_factory=list)

    def add_car(self, car: Car):
        if len(self.cars) < self.capacity:
            self.cars.append(car)
        else:
            raise ValueError("Bridge is at capacity")

    def remove_car(self, car_id: int):
        self.cars = [car for car in self.cars if car.id != car_id]

    def move_cars(self):
        for car in self.cars:
            car.speed -= 1
            if car.speed <= 0:
                self.remove_car(car.id)

    def check_for_collapses(self):
        # Placeholder for collapse logic
        pass

# Example usage
if __name__ == "__main__":
    bridge = Bridge()
    car1 = Car(id=1, speed=bridge.length)
    car2 = Car(id=2, speed=bridge.length - 1)

    bridge.add_car(car1)
    bridge.add_car(car2)

    while bridge.cars:
        bridge.move_cars()
        print(f"Cars on bridge: {[car.id for car in bridge.cars]}")
```

This code defines two classes: `Car` and `Bridge`. The `Car` class has an `id` and a `speed`, while the `Bridge` class manages a list of cars, allowing them to be added, removed, moved, and checked for collapses. The example usage demonstrates adding cars to the bridge and moving them until they have crossed.
