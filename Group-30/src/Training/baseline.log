        public:
            VulkanStagingBuffer(std::shared_ptr<VulkanObjectManager> objectManager, VkDeviceSize sizeInBytes)
                : m_objectManager(objectManager), m_sizeInBytes(sizeInBytes), m_offset(0) {
                // Initialize Vulkan buffer here
                VkBufferCreateInfo createInfo = {};
                createInfo.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
                createInfo.size = sizeInBytes;
                createInfo.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
                createInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;

                if (vkCreateBuffer(m_objectManager->getDevice(), &createInfo, nullptr, &m_object.getBuffer()) != VK_SUCCESS) {
                    throw std::runtime_error("Failed to create Vulkan buffer");
                }

                // Allocate memory for the buffer
                VkMemoryRequirements memReqs;
                vkGetBufferMemoryRequirements(m_objectManager->getDevice(), m_object.getBuffer(), &memReqs);

                VkMemoryAllocateInfo allocInfo = {};
                allocInfo.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
                allocInfo.allocationSize = memReqs.size;
                allocInfo.memoryTypeIndex = findMemoryType(memReqs.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);

                if (vkAllocateMemory(m_objectManager->getDevice(), &allocInfo, nullptr, &m_object.getMemory()) != VK_SUCCESS) {
                    throw std::runtime_error("Failed to allocate Vulkan buffer memory");
                }

                // Bind buffer memory
                vkBindBufferMemory(m_objectManager->getDevice(), m_object.getBuffer(), m_object.getMemory(), 0);
            }

            ~VulkanStagingBuffer() {
                vkDestroyBuffer(m_objectManager->getDevice(), m_object.getBuffer(), nullptr);
                vkFreeMemory(m_objectManager->getDevice(), m_object.getMemory(), nullptr);
            }

            void reserve(VkDeviceSize size, VkDeviceSize alignment) {
                VkDeviceSize alignedOffset = alignUp(m_offset, alignment);
                VkDeviceSize alignedSize = alignUp(size, alignment);

                if (alignedOffset + alignedSize > m_sizeInBytes) {
                    throw std::out_of_range("Not enough space in staging buffer");
                }

                m_reservations.push_back({alignedOffset, alignedSize, nullptr});
                m_offset = alignedOffset + alignedSize;
            }

            void flush(const StagingData& reservation, const void* data) {
                if (reservation.offset + reservation.size > m_sizeInBytes) {
