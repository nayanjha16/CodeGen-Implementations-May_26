class GpuTestExpectations:
    def __init__(self):
        self.expectations = {}

    def add_expectation(self, test_name, platform=None, driver=None, bug_id=None, status='PASS'):
        if test_name not in self.expectations:
            self.expectations[test_name] = []
        self.expectations[test_name].append({
            'platform': platform,
            'driver': driver,
            'bug_id': bug_id,
            'status': status
        })

class PixelExpectations(GpuTestExpectations):
    def __init__(self):
        super().__init__()

    def set_expectations(self):
        # Example expectations
        self.add_expectation('test_gpu_blur', platform='Windows', driver='NVIDIA', bug_id=12345, status='FAIL')
        self.add_expectation('test_gpu_shader', platform='Linux', driver='AMD', bug_id=67890, status='SKIP')
        self.add_expectation('test_gpu_render', platform='macOS', driver='Intel', bug_id=None, status='PASS')

# Usage example
if __name__ == "__main__":
    pixel_expectations = PixelExpectations()
    pixel_expectations.set_expectations()
    print(pixel_expectations.expectations)
```

