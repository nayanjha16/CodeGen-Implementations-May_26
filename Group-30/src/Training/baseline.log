    std::string modTimeString;
    std::string fileType;
    std::string fileTypeString;
    off_t fileSize;
    std::string fileSizeString;
    bool selected;

    // Constructors
    ContentItem(const std::string& dirName) : name(dirName), isDir(true), modTime(0), modTimeString(""), fileType(""), fileTypeString(""), fileSize(0), fileSizeString(""), selected(false) {}

    ContentItem(const tSystem::tFileInfo& fileInfo)
        : name(fileInfo.name),
          isDir(fileInfo.isDirectory),
          modTime(fileInfo.modTime),
          modTimeString(formatTime(fileInfo.modTime)),
          fileType(fileInfo.fileType),
          fileTypeString(formatFileType(fileInfo.fileType)),
          fileSize(fileInfo.fileSize),
          fileSizeString(formatFileSize(fileInfo.fileSize)),
          selected(false) {}

private:
    // Helper methods
    static std::string formatTime(time_t time) {
        char buffer[80];
        strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", localtime(&time));
        return std::string(buffer);
    }

    static std::string formatFileType(const std::string& fileType) {
        return "[" + fileType + "]";
    }

    static std::string formatFileSize(off_t fileSize) {
        if (fileSize >= 1024 * 1024 * 1024) {
            return std::to_string(fileSize / (1024 * 1024 * 1024)) + " GB";
        } else if (fileSize >= 1024 * 1024) {
            return std::to_string(fileSize / (1024 * 1024)) + " MB";
        } else if (fileSize >= 1024) {
            return std::to_string(fileSize / 1024) + " KB";
        } else {
            return std::to_string(fileSize) + " B";
        }
    }
};

