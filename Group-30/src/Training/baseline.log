```cpp
#include "ScriptMgr.h"
#include "Creature.h"
#include "InstanceScript.h"

class boss_selin_fireheartAI : public ScriptedAI
{
public:
    boss_selin_fireheartAI(Creature* creature) : ScriptedAI(creature), m_pInstance(creature->GetInstanceScript()), m_bIsRegularMode(true)
    {
        if (m_pInstance)
            m_pInstance->SetBossState(DATA_SELIN_FIREHEART, NOT_STARTED);
    }

    void Reset() override
    {
        _Reset();
        m_bIsRegularMode = true;
        DrainLifeTimer = 10000; // 10 seconds
        DrainManaTimer = 15000; // 15 seconds
        FelExplosionTimer = 20000; // 20 seconds
        DrainCrystalTimer = 25000; // 25 seconds
        EmpowerTimer = 30000; // 30 seconds
        IsDraining = false;
        DrainingCrystal = ObjectGuid::Empty;

        if (m_pInstance)
            m_pInstance->SetBossState(DATA_SELIN_FIREHEART, IN_PROGRESS);

        me->RemoveAurasDueToSpell(SPELL_DRAIN_LIFE);
        me->RemoveAurasDueToSpell(SPELL_DRAIN_MANA);
        me->RemoveAurasDueToSpell(SPELL_FEL_EXPLOSION);
    }

    void EnterCombat(Unit* who) override
    {
        _EnterCombat(who);
        DoZoneInCombat(me);
        events.ScheduleEvent(EVENT_DRAIN_LIFE, DrainLifeTimer);
        events.ScheduleEvent(EVENT_DRAIN_MANA, DrainManaTimer);
        events.ScheduleEvent(EVENT_FEL_EXPLOSION, FelExplosionTimer);
        events.ScheduleEvent(EVENT_DRAIN_CRYSTAL, DrainCrystalTimer);
        events.ScheduleEvent(EVENT_EMPLOYER, EmpowerTimer);
    }

    void UpdateAI(uint32 diff) override
    {
        if (!UpdateVictim())
            return;

        events.Update(diff);

        while (uint32 eventId = events.ExecuteEvent())
        {
            switch (eventId)
            {
                case EVENT_DRAIN_LIFE:
                    DoCastVictim(SPELL_DRAIN_LIFE);
                    events.ScheduleEvent(EVENT_DRAIN_LIFE, DrainLifeTimer);
                    break;
                case EVENT_DRAIN_MANA:
                    DoCastVictim(SPELL_DRAIN_MANA);
                    events.ScheduleEvent(EVENT_DRAIN_MANA, DrainManaTimer);
                    break;
                case EVENT_FEL_EXPLOSION:
                    DoCastAOE(SPELL_FEL_EXPLOSION);
                    events.ScheduleEvent(EVENT_FEL_EXPLOSION, FelExplosionTimer);
                    break;
                case EVENT_DRAIN_CRYSTAL:
                    if (DrainingCrystal.IsEmpty())
                        DrainCrystal = SelectRandomCrystal();
                    if (!DrainingCrystal.IsEmpty())
                    {
                        Creature* crystal = Unit::GetCreature(*me, DrainingCrystal);
                        if (crystal && crystal->isAlive())
                        {
                            DoCast(crystal, SPELL_DRAIN_CRYSTAL);
                            IsDraining = true;
                        }
                        else
                        {
                            DrainingCrystal = ObjectGuid::Empty;
                        }
                    }
                    events.ScheduleEvent(EVENT_DRAIN_CRYSTAL, DrainCrystalTimer);
                    break;
                case EVENT_EMPLOYER:
                    DoCast(me, SPELL_EMPLOYER);
                    events.ScheduleEvent(EVENT_EMPLOYER, EmpowerTimer);
                    break;
            }
        }

        DoMeleeAttackIfReady();
    }

private:
    InstanceScript* m_pInstance;
    bool m_bIsRegularMode;
    std::vector<ObjectGuid> Crystals;
    uint32 DrainLifeTimer;
    uint32 DrainManaTimer;
    uint32 FelExplosionTimer;
    uint32 DrainCrystalTimer;
    uint32 EmpowerTimer;
    bool IsDraining;
    ObjectGuid DrainingCrystal;

    ObjectGuid SelectRandomCrystal()
    {
        if (Crystals.empty())
            return ObjectGuid::Empty;

        return Crystals[urand(0, Crystals.size() - 1)];
    }
};

void AddSC_boss_selin_fireheart()
{
    new boss_selin_fireheartAI(npc_selin_fireheart);
}
```

