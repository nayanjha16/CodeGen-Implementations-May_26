```cpp
#include <Wire.h>
#include <Arduino.h>

struct Font {
    const uint8_t* data;
    uint8_t width;
    uint8_t height;
};

struct Cursor {
    uint8_t x;
    uint8_t y;
};

class OLED12864 {
private:
    uint8_t _i2cAddress;
    bool _directDraw;
    bool _enableBuffer;
    uint8_t _buffer[1024]; // Assuming 128x64 pixels
    bool _inverseMode;
    Font _font;
    Cursor _cursor;
    unsigned long _scrollDelay;

public:
    OLED12864(uint8_t i2cAddress) : _i2cAddress(i2cAddress), _directDraw(false), _enableBuffer(true), _inverseMode(false), _scrollDelay(100) {}

    void begin() {
        Wire.begin();
        clearDisplay();
    }

    void setDirectDraw(bool enable) {
        _directDraw = enable;
    }

    void setEnableBuffer(bool enable) {
        _enableBuffer = enable;
    }

    void setInverseMode(bool enable) {
        _inverseMode = enable;
    }

    void setFont(const Font& font) {
        _font = font;
    }

    void setCursor(uint8_t x, uint8_t y) {
        _cursor.x = x;
        _cursor.y = y;
    }

    void setScrollDelay(unsigned long delay) {
        _scrollDelay = delay;
    }

    void clearDisplay() {
        if (_enableBuffer) {
            memset(_buffer, 0, sizeof(_buffer));
        }
        sendBufferToDisplay();
    }

    void print(const char* text) {
        for (const char* p = text; *p != '\0'; ++p) {
            drawChar(_cursor.x, _cursor.y, *p);
            _cursor.x += _font.width;
            if (_cursor.x >= 128) {
                newLine();
            }
        }
    }

    void print(int number) {
        char buffer[12];
        sprintf(buffer, "%d", number);
        print(buffer);
    }

    void newLine() {
        _cursor.x = 0;
        _cursor.y += _font.height;
        if (_cursor.y >= 64) {
            scrollDisplay();
        }
    }

    void scrollDisplay() {
        memmove(_buffer, &_buffer[_font.height * 128], 1024 - _font.height * 128);
        memset(&_buffer[1024 - _font.height * 128], 0, _font.height * 128);
        sendBufferToDisplay();
        delay(_scrollDelay);
    }

private:
    void drawChar(uint8_t x, uint8_t y, char ch) {
        uint8_t asciiCode = static_cast<uint8_t>(ch);
        uint8_t byteWidth = (_font.width + 7) / 8;
        for (uint8_t row = 0; row < _font.height; ++row) {
            uint8_t byteIndex = asciiCode * byteWidth + row / 8;
            uint8_t bitIndex = row % 8;
            uint8_t pixelData = pgm_read_byte(&(_font.data[byteIndex]));
            if (pixelData & (1 << (7 - bitIndex))) {
                if (_inverseMode) {
                    _buffer[y * 128 + x] &= ~(1 << (7 - (y % 8)));
                } else {
                    _buffer[y * 128 + x] |= (1 << (7 - (y % 8)));
                }
            } else {
                if (_inverseMode) {
                    _buffer[y * 128 + x] |= (1 << (7 - (y % 8)));
                } else {
                    _buffer[y * 128 + x] &= ~(1 << (7 - (y % 8)));
                }
            }
        }
    }

    void sendBufferToDisplay() {
        Wire.beginTransmission(_i2cAddress);
        Wire.write(0x40); // Data command
        for (int i = 0; i < 1024; ++i) {
            Wire.write(_buffer[i]);
        }
        Wire.endTransmission();
    }
};
```

This code defines the `OLED12864` class with methods to control an OLED display using I2C communication. It includes functionalities for setting display properties, printing text and numbers, handling cursor positions, and managing font and buffer settings. The class uses a buffer to store display data when buffering is enabled and supports inverse mode for displaying inverted colors.
