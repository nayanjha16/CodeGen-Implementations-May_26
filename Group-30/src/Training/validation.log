    }

    void processChunk(const std::vector<char>& chunk) {
        // Process the chunk using cryptographic hash
        std::string hash = cryptoObj.generateHash(std::string(chunk.begin(), chunk.end()));
        keyClientObj->submitJob(hash);
    }
};

