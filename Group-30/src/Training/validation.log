```cpp
#include <iostream>
#include <sys/sysinfo.h>

class SystemResource {
public:
    // Constructor
    SystemResource();

    // Getters
    uint64_t getTotalVirtualMemory() const;
    uint64_t getTotalPhysicalMemory() const;
    uint64_t getVirtualMemoryUsed() const;
    uint64_t getPhysicalMemoryUsed() const;

private:
    uint64_t totalVirtualMem;
    uint64_t totalPhysMem;
    uint64_t virtualMemUsed;
    uint64_t physMemUsed;
    struct sysinfo memInfo;
};

// Constructor implementation
SystemResource::SystemResource() {
    if (sysinfo(&memInfo) != 0) {
        throw std::runtime_error("Failed to retrieve system info");
    }
    totalVirtualMem = static_cast<uint64_t>(memInfo.totalram * memInfo.mem_unit);
    totalPhysMem = static_cast<uint64_t>(memInfo.totalram * memInfo.mem_unit);
    virtualMemUsed = static_cast<uint64_t>((memInfo.totalram - memInfo.freeram) * memInfo.mem_unit);
    physMemUsed = static_cast<uint64_t>((memInfo.totalram - memInfo.freeram) * memInfo.mem_unit);
}

// Getter implementations
uint64_t SystemResource::getTotalVirtualMemory() const {
    return totalVirtualMem;
}

uint64_t SystemResource::getTotalPhysicalMemory() const {
    return totalPhysMem;
}

uint64_t SystemResource::getVirtualMemoryUsed() const {
    return virtualMemUsed;
}

uint64_t SystemResource::getPhysicalMemoryUsed() const {
    return physMemUsed;
}

int main() {
    try {
        SystemResource resource;
        std::cout << "Total Virtual Memory: " << resource.getTotalVirtualMemory() << " bytes" << std::endl;
        std::cout << "Total Physical Memory: " << resource.getTotalPhysicalMemory() << " bytes" << std::endl;
        std::cout << "Virtual Memory Used: " << resource.getVirtualMemoryUsed() << " bytes" << std::endl;
        std::cout << "Physical Memory Used: " << resource.getPhysicalMemoryUsed() << " bytes" << std::endl;
    } catch (const std::exception& e) {
        std::cerr << "Error: " << e.what() << std::endl;
        return 1;
    }
    return 0;
}
```

This code defines a `SystemResource` class that encapsulates the functionality to manage and report on system memory usage. It uses the `sysinfo` function from the `<sys/sysinfo.h>` header to gather system information and calculates the total and used virtual and physical memory. The `main` function demonstrates how to use the `SystemResource` class to retrieve and print memory usage statistics.
