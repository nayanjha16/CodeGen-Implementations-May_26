from typing import Dict, Set
from opencivicdata.models import Bill

class BaseImporter:
    def __init__(self, jurisdiction_id):
        self.jurisdiction_id = jurisdiction_id

class BillImporter(BaseImporter):
    _type = 'bill'
    model_class = Bill
    related_models: Dict[str, Tuple[str, Dict]] = {
        'organization': ('organization_id', {}),
        'person': ('sponsor_id', {}),
        'session': ('session_id', {})
    }
    preserve_order: Set[str] = {'order'}

    def __init__(self, jurisdiction_id, org_importer, person_importer):
        super().__init__(jurisdiction_id)
        self.org_importer = org_importer
        self.person_importer = person_importer

    def import_data(self, data):
        # Assuming data is a list of dictionaries representing bills
        for item in data:
            bill = self.model_class(
                jurisdiction=self.jurisdiction_id,
                identifier=item['identifier'],
                title=item['title'],
                sponsor=self.person_importer.get_person(item['sponsor']),
                organization=self.org_importer.get_organization(item['organization']),
                session=self.session_importer.get_session(item['session']),
                **item
            )
            bill.save()

    def get_related_model_instance(self, model_name, id):
        if model_name == 'organization':
            return self.org_importer.get_organization(id)
        elif model_name == 'person':
            return self.person_importer.get_person(id)
        elif model_name == 'session':
            return self.session_importer.get_session(id)
        else:
            raise ValueError(f"Unsupported model: {model_name}")
```

