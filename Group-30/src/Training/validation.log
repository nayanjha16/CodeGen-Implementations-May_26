#include <iostream>
#include <string>

namespace ghoul {
    namespace opengl {
        namespace debug {

            // Enumerates different sources of OpenGL debug messages
            enum class Source {
                Core,
                Extensions,
                ThirdParty,
                Application,
                Other,
                DontCare
            };

            // Enumerates different types of OpenGL debug messages
            enum class Type {
                Error,
                DeprecatedBehavior,
                UndefinedBehavior,
                PerformanceWarning,
                PortabilityWarning,
                ShaderCompilerWarning,
                Other,
                DontCare
            };

            // Class to manage the setup and configuration of OpenGL's debug output
            class DebugManager {
            public:
                DebugManager();
                ~DebugManager();

                void enableDebugOutput();
                void disableDebugOutput();
                void setCallbackFunction(void (*callback)(Source, Type, const std::string&));

            private:
                static void defaultCallback(Source source, Type type, const std::string& message);
                void (*_callbackFunction)(Source, Type, const std::string*);
            };

            // Constructor for DebugManager
            DebugManager::DebugManager() : _callbackFunction(&defaultCallback) {}

            // Destructor for DebugManager
            DebugManager::~DebugManager() {}

