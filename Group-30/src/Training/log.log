from typing import List, Tuple
import numpy as np

class Point:
    def __init__(self, x: float, y: float, z: float):
        self.x = x
        self.y = y
        self.z = z

class Spectrum:
    def __init__(self, r: float, g: float, b: float):
        self.r = r
        self.g = g
        self.b = b

class CatmullRomCurve:
    def __init__(self):
        self.points: List[Point] = []
        self.sizes: List[float] = []
        self.cols: List[Spectrum] = []
        self.uvs: List[Tuple[float, float]] = []

    def add_point(self, point: Point, size: float, col: Spectrum, uv: Tuple[float, float]):
        self.points.append(point)
        self.sizes.append(size)
        self.cols.append(col)
        self.uvs.append(uv)

    def evaluate(self, t: float) -> Point:
        if len(self.points) < 4:
            raise ValueError("At least 4 points are required for evaluation")

        # Convert lists to numpy arrays for easier manipulation
        points_array = np.array([p.__dict__ for p in self.points])
        sizes_array = np.array(self.sizes)
        cols_array = np.array([[c.r, c.g, c.b] for c in self.cols])
        uvs_array = np.array(self.uvs)

        # Perform Catmull-Rom interpolation
        t_clamped = max(0, min(t, 1))
        t_cubed = t_clamped ** 3
        t_squared = t_clamped ** 2

        a0 = -t_cubed + 2 * t_squared - t_clamped
        a1 = 3 * t_cubed - 5 * t_squared + 2
        a2 = -3 * t_cubed + 4 * t_squared + t_clamped
        a3 = t_cubed - t_squared

        result_x = a0 * points_array[0]['x'] + a1 * points_array[1]['x'] + a2 * points_array[2]['x'] + a3 * points_array[3]['x']
        result_y = a0 * points_array[0]['y'] + a1 * points_array[1]['y'] + a2 * points_array[2]['y'] + a3 * points_array[3]['y']
        result_z = a0 * points_array[0]['z'] + a1 * points_array[1]['z'] + a2 * points_array[2]['z'] + a3 * points_array[3]['z']

        return Point(result_x, result_y, result_z)

    def adaptive_tessellation(self, num_segments: int) -> List[Point]:
