#include <iostream>
#include <vector>
#include <opencv2/opencv.hpp>

// Structure representing a 2D point with floating-point coordinates
struct Point2f {
    float x;
    float y;

    Point2f(float x = 0.0f, float y = 0.0f) : x(x), y(y) {}
};

// Class representing a rotated rectangle
class RotatedRect {
public:
    cv::RotatedRect rect;

    RotatedRect(const cv::RotatedRect& r) : rect(r) {}

    // Method to draw the rectangle on an image
    void draw(cv::Mat& img, const cv::Scalar& color = cv::Scalar(0, 255, 0), int thickness = 2) const {
        cv::ellipse(img, rect, color, thickness);
    }
};

// Struct representing a single LED stick
struct LED_Stick {
    Point2f start;
    Point2f end;
    float length;
    float angle;

    LED_Stick(Point2f start, Point2f end) : start(start), end(end) {
        length = std::sqrt((end.x - start.x) * (end.x - start.x) + (end.y - start.y) * (end.y - start.y));
        angle = std::atan2(end.y - start.y, end.x - start.x);
    }

    // Method to calculate the midpoint of the LED stick
    Point2f midpoint() const {
        return Point2f((start.x + end.x) / 2.0f, (start.y + end.y) / 2.0f);
    }
