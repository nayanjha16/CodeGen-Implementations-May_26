// Define the arith_uint256 type for handling large numbers
class arith_uint256 {
public:
    uint64_t data[4];

    arith_uint256 operator~() const {
        return arith_uint256{~data[0], ~data[1], ~data[2], ~data[3]};
    }

    arith_uint256 operator>>(int shift) const {
        arith_uint256 result;
        if (shift >= 64) {
            result.data[0] = result.data[1] = result.data[2] = result.data[3] = 0;
            result.data[shift / 64] = data[shift % 64];
        } else {
            result.data[0] = data[0] >> shift;
            result.data[1] = ((data[0] << (64 - shift)) | (data[1] >> shift));
            result.data[2] = ((data[1] << (64 - shift)) | (data[2] >> shift));
            result.data[3] = ((data[2] << (64 - shift)) | (data[3] >> shift));
        }
        return result;
    }
};

