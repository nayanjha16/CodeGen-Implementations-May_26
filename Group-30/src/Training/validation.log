```python
import os
import re
from typing import Callable, Any, List, Tuple, Set

# Internal variables for path manipulation
_sep = os.sep
_path_re = re.compile(r'[\\/]+')

# Decorators to convert function output to list or tuple
def to_list(func: Callable) -> Callable:
    def wrapper(*args, **kwargs) -> List[Any]:
        return list(func(*args, **kwargs))
    return wrapper

def to_tuple(func: Callable) -> Callable:
    def wrapper(*args, **kwargs) -> Tuple[Any]:
        return tuple(func(*args, **kwargs))
    return wrapper

# Function to convert a two-dimensional array to a one-dimensional set
def unite(array: List[List[Any]]) -> Set[Any]:
    return set(item for sublist in array for item in sublist)

# Custom exception class for uncaught attribute errors
class UncaughtAttributeError(Exception):
    pass
```
