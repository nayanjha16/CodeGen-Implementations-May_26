class FullyConnectedLatentVariable:
    def __init__(self, input_size, output_size):
        """
        Initialize a FullyConnectedLatentVariable instance.

        Parameters:
        - input_size (int): The number of input features.
        - output_size (int): The number of output features.
        """
        self.input_size = input_size
        self.output_size = output_size
        self.weights = None
        self.bias = None

    def initialize_weights(self, initializer='random'):
        """
        Initialize weights using the specified initializer.

        Parameters:
        - initializer (str): The type of initializer ('random' or 'zeros').
        """
        if initializer == 'random':
            import numpy as np
            self.weights = np.random.randn(self.input_size, self.output_size)
        elif initializer == 'zeros':
            self.weights = np.zeros((self.input_size, self.output_size))

    def initialize_bias(self, value=0.0):
        """
        Initialize bias with the specified value.

        Parameters:
        - value (float): The initial value for the bias.
        """
        self.bias = np.full(self.output_size, value)

    def forward(self, inputs):
        """
        Compute the forward pass through the fully connected layer.

        Parameters:
        - inputs (np.ndarray): Input data of shape (batch_size, input_size).

        Returns:
        - np.ndarray: Output data of shape (batch_size, output_size).
        """
        return np.dot(inputs, self.weights) + self.bias


class ConvolutionalLatentVariable:
    def __init__(self, input_shape, kernel_size, filters, stride=1, padding=0):
        """
        Initialize a ConvolutionalLatentVariable instance.

        Parameters:
        - input_shape (tuple): The shape of the input tensor (height, width, channels).
        - kernel_size (int): The size of the convolutional kernel.
        - filters (int): The number of filters (output channels).
        - stride (int): The stride of the convolution operation.
        - padding (int): The amount of zero-padding added to both sides of the input.
        """
        self.input_shape = input_shape
        self.kernel_size = kernel_size
        self.filters = filters
        self.stride = stride
        self.padding = padding
        self.weights = None
        self.bias = None

    def initialize_weights(self, initializer='random'):
        """
        Initialize weights using the specified initializer.

        Parameters:
        - initializer (str): The type of initializer ('random' or 'zeros').
        """
        if initializer == 'random':
            import numpy as np
            self.weights = np.random.randn(self.filters, self.kernel_size, self.kernel_size, self.input_shape[2])
        elif initializer == 'zeros':
            self.weights = np.zeros((self.filters, self.kernel_size, self.kernel_size, self.input_shape[2]))

    def initialize_bias(self, value=0.0):
        """
        Initialize bias with the specified value.

        Parameters:
        - value (float): The initial value for the bias.
        """
        self.bias = np.full(self.filters, value)

    def forward(self, inputs):
        """
        Compute the forward pass through the convolutional layer.

        Parameters:
        - inputs (np.ndarray): Input data of shape (batch_size, height, width, channels).

        Returns:
        - np.ndarray: Output data of shape (batch_size, new_height, new_width, filters).
        """
        batch_size, height, width, channels = inputs.shape
        new_height = (height + 2 * self.padding - self.kernel_size) // self.stride + 1
        new_width = (width + 2 * self.padding - self.kernel_size) // self.stride + 1

        padded_inputs = np.pad(inputs, ((0, 0), (self.padding, self.padding), (self.padding, self.padding), (0, 0)), mode='constant')
        outputs = np.zeros((batch_size, new_height, new_width, self.filters))

        for b in range(batch_size):
            for f in range(self.filters):
                for i in range(new_height):
                    for j in range(new_width):
                        start_i = i * self.stride
                        start_j = j * self.stride
                        end_i = start_i + self.kernel_size
                        end_j = start_j + self.kernel_size
                        outputs[b, i, j, f] = np.sum(padded_inputs[b, start_i:end_i, start_j:end_j, :] * self.weights[f]) + self.bias[f]

        return outputs
```

This code defines two classes, `FullyConnectedLatentVariable` and `ConvolutionalLatentVariable`, each with methods to initialize weights, biases, and perform forward passes through their respective layers. The classes use NumPy for numerical operations and include padding and stride parameters for convolutional layers.
