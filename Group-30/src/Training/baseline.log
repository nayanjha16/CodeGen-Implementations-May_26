```python
import numpy as np
import tensorflow as tf
import tensorflow_probability as tfp

tfd = tfp.distributions

class ArrayMatcher:
    def __init__(self, expected):
        self.expected = expected

    def __eq__(self, actual):
        return np.allclose(self.expected, actual, equal_nan=True)

class LatentVariableLayer(tf.keras.layers.Layer):
    def __init__(self, encoder, prior, **kwargs):
        super(LatentVariableLayer, self).__init__(**kwargs)
        self._encoder = encoder
        self._prior = prior

    def call(self, inputs):
        # Encode inputs to get posterior distribution
        posterior = self._encoder(inputs)
        
        # Compute KL divergence between prior and posterior
        kl_divergence = self.compute_kl_divergence(posterior, self._prior)
        
        # Sample from the posterior distribution
        samples = posterior.sample()
        
        return samples, kl_divergence

    def compute_kl_divergence(self, posterior, prior):
        return tf.reduce_mean(tfd.kl_divergence(posterior, prior))

# Example usage
if __name__ == "__main__":
    # Define a simple encoder model
    encoder_model = tf.keras.Sequential([
        tf.keras.layers.Dense(10, activation='relu'),
        tf.keras.layers.Dense(2, activation=None)
    ])

    # Define prior distribution
    prior_distribution = tfd.Normal(loc=0., scale=1.)

    # Create an instance of LatentVariableLayer
    latent_layer = LatentVariableLayer(encoder_model, prior_distribution)

    # Sample from the latent layer
    inputs = tf.random.normal([10, 5])
    samples, kl_divergence = latent_layer(inputs)

    print("Samples:", samples.numpy())
    print("KL Divergence:", kl_divergence.numpy())
```

This code defines the `ArrayMatcher` class for comparing NumPy arrays with tolerance and the `LatentVariableLayer` class for handling latent variables in a neural network, including computing KL divergences and sampling from posterior distributions. The example usage demonstrates how to use these classes together.
