                vkMapMemory(m_objectManager->getDevice(), m_object.getMemory(), reservation.offset, reservation.size, 0, &gpuPointer);
                memcpy(gpuPointer, data, reservation.size);
                vkUnmapMemory(m_objectManager->getDevice(), m_object.getMemory());
            }

            void reset() {
