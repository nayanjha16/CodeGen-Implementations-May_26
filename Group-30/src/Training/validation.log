from kivy.app import App
from kivy.uix.popup import Popup
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.checkbox import CheckBox
from kivy.properties import NumericProperty, ListProperty, ReferenceListProperty

class MultiSelectPopUp(Popup):
    pHint_x = NumericProperty(0.8)
    pHint_y = NumericProperty(0.6)
    pHint = ReferenceListProperty(pHint_x, pHint_y)

    def __init__(self, title, option_list, option_init=None, callback=None, multiselect=True, **kwargs):
        super(MultiSelectPopUp, self).__init__(**kwargs)
        self.title = title
        self.option_list = option_list
        self.callback = callback
        self.multiselect = multiselect
        
        if option_init is None:
            option_init = [False] * len(option_list)
        
        layout = BoxLayout(orientation='vertical')
        self.content = layout
        
        for i, option in enumerate(option_list):
            checkbox = CheckBox(active=option_init[i])
            label = Label(text=option)
            box = BoxLayout(orientation='horizontal', spacing=10)
            box.add_widget(checkbox)
            box.add_widget(label)
            layout.add_widget(box)
        
        button_layout = BoxLayout(orientation='horizontal', spacing=10)
        cancel_button = Button(text='Cancel')
        cancel_button.bind(on_press=self.dismiss)
        ok_button = Button(text='OK')
        ok_button.bind(on_press=lambda instance: self.on_ok())
        button_layout.add_widget(cancel_button)
        button_layout.add_widget(ok_button)
        layout.add_widget(button_layout)
    
    def on_ok(self):
        selected_options = []
        for i, checkbox in enumerate(self.content.children[:-1]):
            if checkbox.active:
                selected_options.append(self.option_list[i])
        if self.callback:
            self.callback(selected_options)
        self.dismiss()

class MyApp(App):
    def build(self):
        def handle_selection(options):
            print(f"Selected options: {options}")
        
        popup = MultiSelectPopUp(
            title="Select Options",
            option_list=["Option 1", "Option 2", "Option 3"],
            option_init=[True, False, True],
            callback=handle_selection,
            multiselect=True
        )
        popup.open()
        return popup

if __name__ == '__main__':
    MyApp().run()
```

This code defines a `MultiSelectPopUp` class that extends `Popup` from Kivy and provides a multi-select dialog. It also includes a simple Kivy application (`MyApp`) that demonstrates how to use the `MultiSelectPopUp`. The `MultiSelectPopUp` allows users to select multiple options from a list and passes the selected options back to the caller via a callback function.
