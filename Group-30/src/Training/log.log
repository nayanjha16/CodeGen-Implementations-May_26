```python
import pandas as pd
import os

# Global Variables
me_list = []
close_list = []
mom_list = []

def read_and_process_data(market_cap_dir, close_price_dir):
    """
    Reads and processes market cap and closing price data from specified directories.
    
    Parameters:
    - market_cap_dir: Directory path containing Excel files with market cap data.
    - close_price_dir: Directory path containing text files with closing price data.
    """
    global me_list, close_list
    
    # Read market cap data
    for file_name in os.listdir(market_cap_dir):
        if file_name.endswith('.xlsx'):
            file_path = os.path.join(market_cap_dir, file_name)
            df = pd.read_excel(file_path)
            me_list.append(df)
    
    # Read closing price data
    for file_name in os.listdir(close_price_dir):
        if file_name.endswith('.txt'):
            file_path = os.path.join(close_price_dir, file_name)
            df = pd.read_csv(file_path, sep='\t')
            close_list.append(df)

def merge_and_calculate_mom():
    """
    Merges the processed market cap and closing price data and calculates the MOM ratios.
    """
    global mom_list
    
    # Merge dataframes
    merged_df = pd.concat(me_list).reset_index(drop=True)
    for df in close_list:
        merged_df = pd.merge(merged_df, df, on='date', how='left')
    
    # Calculate past-year returns
    merged_df['past_year_return'] = merged_df.groupby('ticker')['close'].pct_change(periods=252)
    
    # Split data into market segments
    merged_df['market_segment'] = pd.cut(merged_df['market_cap'], bins=[0, 1e9, 1e12, float('inf')], labels=['Small Cap', 'Mid Cap', 'Large Cap'])
    
    # Calculate MOM ratio
    mom_ratio = merged_df.groupby(['ticker', 'market_segment'])['past_year_return'].mean().reset_index()
    mom_ratio.rename(columns={'past_year_return': 'mom_ratio'}, inplace=True)
    
    mom_list.append(mom_ratio)

# Example usage
if __name__ == "__main__":
    market_cap_directory = 'path/to/market_cap_files'
    close_price_directory = 'path/to/close_price_files'
    
    read_and_process_data(market_cap_directory, close_price_directory)
    merge_and_calculate_mom()
    
    print(mom_list)
```

This code defines two standalone functions: `read_and_process_data` and `merge_and_calculate_mom`. The `read_and_process_data` function reads market cap and closing price data from specified directories and stores them in global lists. The `merge_and_calculate_mom` function merges the processed data, calculates past-year returns, splits the data into market segments, and computes the MOM ratio for each segment. The results are stored in a global list `mom_list`.
