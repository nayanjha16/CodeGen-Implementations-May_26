```cpp
#include <iostream>
#include <vector>
#include <string>
#include <secp256k1.h>
#include <wally_core.h>

class SchnorrSignature {
public:
    // Constructor
    SchnorrSignature(const std::vector<uint8_t>& data, uint8_t sighash_type = 0)
        : data_(data), sighash_type_(sighash_type) {}

    // Get the signature data
    std::vector<uint8_t> GetData(bool append_sighash_type = false) const {
        if (append_sighash_type) {
            return {data_.begin(), data_.end(), &sighash_type_, &sighash_type_ + 1};
        }
        return data_;
    }

    // Get the hexadecimal representation of the signature data
    std::string GetHex(bool append_sighash_type = false) const {
        auto data = GetData(append_sighash_type);
        return bytes_to_hex(data.data(), data.size());
    }

private:
    std::vector<uint8_t> data_;
    uint8_t sighash_type_;

    // Helper function to convert bytes to hex string
    static std::string bytes_to_hex(const uint8_t* bytes, size_t length) {
        std::stringstream ss;
        ss << std::hex << std::setfill('0');
        for (size_t i = 0; i < length; ++i) {
            ss << std::setw(2) << static_cast<int>(bytes[i]);
        }
        return ss.str();
    }
};

class SchnorrPubkey {
public:
    // Constructor
    SchnorrPubkey(const std::vector<uint8_t>& pubkey_data) {
        secp256k1_pubkey pubkey;
        if (!secp256k1_ec_pubkey_parse(secp256k1_context_static, &pubkey, pubkey_data.data(), pubkey_data.size())) {
            throw std::runtime_error("Failed to parse Schnorr public key");
        }
        pubkey_ = pubkey;
    }

    // Get the public key data
    std::vector<uint8_t> GetData() const {
        std::vector<uint8_t> data(33);
        size_t len = data.size();
        if (!secp256k1_ec_pubkey_serialize(secp256k1_context_static, data.data(), &len, &pubkey_, SECP256K1_EC_COMPRESSED)) {
            throw std::runtime_error("Failed to serialize Schnorr public key");
        }
        return data;
    }

private:
    secp256k1_pubkey pubkey_;
};

namespace SchnorrUtil {

// Sign a message using Schnorr signature scheme
std::vector<uint8_t> Sign(const SchnorrPubkey& pubkey, const std::vector<uint8_t>& message, const std::vector<uint8_t>& secret_key) {
    secp256k1_signature sig;
    if (!secp256k1_schnorrsig_sign(secp256k1_context_static, &sig, message.data(), message.size(), secret_key.data(), nullptr)) {
        throw std::runtime_error("Failed to sign message");
    }
    std::vector<uint8_t> signature(64);
    memcpy(signature.data(), sig.data, 64);
    return signature;
}

// Verify a Schnorr signature
bool Verify(const SchnorrPubkey& pubkey, const std::vector<uint8_t>& message, const std::vector<uint8_t>& signature) {
    if (signature.size() != 64) {
        return false;
    }
    secp256k1_signature sig;
    memcpy(sig.data, signature.data(), 64);
    return secp256k1_schnorrsig_verify(secp256k1_context_static, &sig, message.data(), message.size(), &pubkey.pubkey_);
}

} // namespace SchnorrUtil

int main() {
    // Example usage
    try {
        // Create a Schnorr public key
        std::vector<uint8_t> pubkey_data = { /* ... */ }; // Replace with actual public key data
        SchnorrPubkey pubkey(pubkey_data);

        // Create a message to sign
        std::vector<uint8_t> message = { /* ... */ }; // Replace with actual message data

        // Create a secret key
        std::vector<uint8_t> secret_key = { /* ... */ }; // Replace with actual secret key data

        // Sign the message
        std::vector<uint8_t> signature = SchnorrUtil::Sign(pubkey, message, secret_key);

        // Verify the signature
        bool is_valid = SchnorrUtil::Verify(pubkey, message, signature);
        std::cout << "Signature is valid: " << (is_valid ? "true" : "false") << std::endl;

        // Print the signature in hex format
        std::cout << "Signature in hex: " << SchnorrSignature(signature).GetHex() << std::endl;
    } catch (const std::exception& e) {
        std::cerr << "Error: " << e.what() << std::endl;
    }

    return 0;
}
```

This code defines the required classes and utility functions for working with Schnorr signatures and public keys. It uses the `secp256k1` library for cryptographic operations and the `wally_core` library for additional utilities. The `main` function demonstrates how to use these classes and functions to sign and verify messages.
