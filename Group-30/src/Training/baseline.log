```cpp
#include <array>
#include <cmath>
#include <functional>
#include <iostream>

template <size_t N, typename T>
class Vector {
public:
    // Constructor that initializes the vector from an array
    constexpr Vector(const std::array<T, N>& data);

    // Method to calculate the magnitude of the vector
    T length(std::function<T(T)> sqrt_function = std::sqrt) const;

    // Accessor for individual elements
    T& operator[](size_t index);
    const T& operator[](size_t index) const;

private:
    std::array<T, N> data_;
};

// Implementation of the constructor
template <size_t N, typename T>
constexpr Vector<N, T>::Vector(const std::array<T, N>& data)
    : data_(data) {}

// Implementation of the length method
template <size_t N, typename T>
T Vector<N, T>::length(std::function<T(T)> sqrt_function) const {
    T sum = 0;
    for (const auto& elem : data_) {
        sum += elem * elem;
    }
    return sqrt_function(sum);
}

// Implementation of the subscript operator for accessing elements
template <size_t N, typename T>
T& Vector<N, T>::operator[](size_t index) {
    return data_[index];
}

template <size_t N, typename T>
const T& Vector<N, T>::operator[](size_t index) const {
    return data_[index];
}

// Specialized class for 2D vectors
template <typename T>
class Vector2 : public Vector<2, T> {
public:
    using Vector<2, T>::Vector;

    // Constructors for convenience
    constexpr Vector2(T x, T y);
    constexpr Vector2(const std::array<T, 2>& data);
};

// Implementation of the 2D vector constructors
template <typename T>
constexpr Vector2<T>::Vector2(T x, T y)
    : Vector<2, T>({x, y}) {}

template <typename T>
constexpr Vector2<T>::Vector2(const std::array<T, 2>& data)
    : Vector<2, T>(data) {}

// Specialized class for 3D vectors
template <typename T>
class Vector3 : public Vector<3, T> {
public:
    using Vector<3, T>::Vector;

    // Constructors for convenience
    constexpr Vector3(T x, T y, T z);
    constexpr Vector3(const std::array<T, 3>& data);
};

// Implementation of the 3D vector constructors
template <typename T>
constexpr Vector3<T>::Vector3(T x, T y, T z)
    : Vector<3, T>({x, y, z}) {}

template <typename T>
constexpr Vector3<T>::Vector3(const std::array<T, 3>& data)
    : Vector<3, T>(data) {}

// Specialized class for 4D vectors
template <typename T>
class Vector4 : public Vector<4, T> {
public:
    using Vector<4, T>::Vector;

    // Constructors for convenience
    constexpr Vector4(T x, T y, T z, T w);
    constexpr Vector4(const std::array<T, 4>& data);
};

// Implementation of the 4D vector constructors
template <typename T>
constexpr Vector4<T>::Vector4(T x, T y, T z, T w)
    : Vector<4, T>({x, y, z, w}) {}

template <typename T>
constexpr Vector4<T>::Vector4(const std::array<T, 4>& data)
    : Vector<4, T>(data) {}

// Utility function to output a vector as a string
template <size_t N, typename T>
std::ostream& operator<<(std::ostream& os, const Vector<N, T>& vec) {
    os << "(";
    for (size_t i = 0; i < N; ++i) {
        if (i > 0) os << ", ";
        os << vec[i];
    }
    os << ")";
    return os;
}

// Linear interpolation between two vectors
template <size_t N, typename T>
Vector<N, T> lerp(const Vector<N, T>& v1, const Vector<N, T>& v2, T t) {
    Vector<N, T> result;
    for (size_t i = 0; i < N; ++i) {
        result[i] = v1[i] + t * (v2[i] - v1[i]);
    }
    return result;
}
```

This code defines a generic `Vector` class template along with specialized versions for 2D, 3D, and 4D vectors. It includes methods for constructing vectors, calculating their magnitudes, and accessing individual elements. Additionally, it provides utility functions for outputting vectors as strings and performing linear interpolation.
