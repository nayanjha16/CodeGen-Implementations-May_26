#ifdef _WIN32
#include <io.h>
#include <direct.h>
#endif

#define OF_MAX_PATH_LEN 1024

class OFDirent {
public:
    OFDirent(const char *path);
    ~OFDirent();
    bool read(std::string &entry);

private:
    char m_path[OF_MAX_PATH_LEN];
    void* m_dir;
    int m_first;
#ifdef _WIN32
    struct _finddata_t m_data;
#endif
};

OFDirent::OFDirent(const char *path) : m_dir(nullptr), m_first(1) {
    strncpy(m_path, path, OF_MAX_PATH_LEN - 1);
    m_path[OF_MAX_PATH_LEN - 1] = '\0';
}

OFDirent::~OFDirent() {
    if (m_dir) {
        close();
    }
}

bool OFDirent::read(std::string &entry) {
    if (!m_dir) {
        return false;
    }

#ifdef _WIN32
    if (m_first) {
        std::string searchPath = std::string(m_path) + "\\*";
        m_dir = _findfirst(searchPath.c_str(), &m_data);
        m_first = 0;
    } else {
        if (_findnext(static_cast<intptr_t>(m_dir), &m_data) == -1) {
            _findclose(static_cast<intptr_t>(m_dir));
            m_dir = nullptr;
            return false;
        }
    }
    entry = m_data.name;
#else
    struct dirent *dirEntry;
    while ((dirEntry = readdir(static_cast<DIR*>(m_dir))) != nullptr) {
        entry = dirEntry->d_name;
        return true;
    }
    closedir(static_cast<DIR*>(m_dir));
    m_dir = nullptr;
    return false;
#endif

    return true;
}

int main() {
    OFDirent dir(".");

    std::string entry;
    while (dir.read(entry)) {
        std::cout << entry << std::endl;
    }

    return 0;
}
```

This code defines the `OFDirent` class, which can be used to iterate through the contents of a directory on both Windows and POSIX-compliant systems. The class uses platform-specific APIs (`_findfirst`, `_findnext` on Windows and `readdir` on POSIX) to achieve this. The `main` function demonstrates how to use the `OFDirent` class to list the contents of the current directory.
