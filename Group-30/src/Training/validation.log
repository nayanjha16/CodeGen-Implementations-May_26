import os
import json
from datetime import datetime

# Global Variables
LOG_FILE_LOC = None
PRODUCTION_BOOL = True

def configure_logging(module, production_mode=True, path=None):
    """
    Purpose: Configures the log file with a standard logging format.

    Parameters:
    - module (str): The name of the module being logged.
    - production_mode (bool, optional): Whether or not the output should be written to the production environment. Default is True.
    - path (str, optional): Where to write the log if user-supplied path; default is the working directory.

    Returns:
    - None
    """
    global LOG_FILE_LOC, PRODUCTION_BOOL
    
    # Determine the log file location based on production_mode
    if production_mode:
        LOG_FILE_LOC = os.path.join(path or os.getcwd(), f"{module}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log")
    else:
        LOG_FILE_LOC = os.path.join(path or os.getcwd(), "development.log")
    
    # Set the production boolean flag
    PRODUCTION_BOOL = production_mode

# Example usage
if __name__ == "__main__":
    configure_logging("example_module", production_mode=False)
    print(f"Log file location: {LOG_FILE_LOC}")
```

This code snippet includes the `configure_logging` function as described in the documentation. It sets up the log file location based on whether it's in production mode or not and handles both user-provided paths and default paths. The global variables `LOG_FILE_LOC` and `PRODUCTION_BOOL` are used to store the current log file location and the production mode status, respectively.
