```python
import requests

# Global variable to store the list of French words
words_list = []

def fetch_words_from_github():
    """
    Fetches a list of French words from a GitHub repository.
    
    Returns:
        list: A list of strings representing French words.
    """
    url = "https://raw.githubusercontent.com/dwyl/french-words/master/french-words.txt"
    response = requests.get(url)
    if response.status_code == 200:
        words_list.extend(response.text.splitlines())
    else:
        raise Exception(f"Failed to fetch words. Status code: {response.status_code}")

def filter_short_words(min_length=5):
    """
    Filters out words shorter than a specified length from the global words_list.
    
    Parameters:
        min_length (int): The minimum length of words to include in the filtered list.
        
    Returns:
        list: A list of strings representing French words longer than or equal to min_length.
    """
    return [word for word in words_list if len(word) >= min_length]

def save_filtered_words(file_path=None):
    """
    Saves the filtered list of words to a specified file path.
    
    Parameters:
        file_path (str, optional): The path where the filtered words will be saved.
                                   If not provided, defaults to 'words.txt' in the current directory.
    """
    if file_path is None:
        file_path = 'words.txt'
    
    with open(file_path, 'w') as file:
        for word in filter_short_words():
            file.write(word + '\n')

# Example usage
if __name__ == "__main__":
    fetch_words_from_github()
    save_filtered_words()
```

This code includes the necessary functions to fetch words from a GitHub repository, filter them based on length, and save the filtered list to a file. The example usage at the bottom demonstrates how to call these functions.
