void threadRead(boost::shared_ptr<Port> port, boost::weak_ptr<AdHocConnectionImpl> con)
{
    try {
        while (true) {
            // This will block until there are any bytes available.
            char buffer[65536];
            int len = port->read(buffer, sizeof(buffer));

            if (!len) {
                break;
            }

