#include <vector>
#include <iostream>

// Class representing an Average Pooling operation
class AveragePool {
public:
    // Constructor with parameters
    AveragePool(int filterHeight, int filterWidth, int strideH, int strideW)
        : filterHeight(filterHeight), filterWidth(filterWidth), strideH(strideH), strideW(strideW) {}

    // Method to perform the pooling operation
    std::vector<std::vector<double>> pool(const std::vector<std::vector<double>>& input) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int outputHeight = (inputHeight - filterHeight + strideH) / strideH;
        int outputWidth = (inputWidth - filterWidth + strideW) / strideW;

        std::vector<std::vector<double>> output(outputHeight, std::vector<double>(outputWidth));

        for (int i = 0; i < outputHeight; ++i) {
            for (int j = 0; j < outputWidth; ++j) {
                double sum = 0.0;
                for (int k = 0; k < filterHeight; ++k) {
                    for (int l = 0; l < filterWidth; ++l) {
                        sum += input[i * strideH + k][j * strideW + l];
                    }
                }
                output[i][j] = sum / (filterHeight * filterWidth);
            }
        }

        return output;
    }

private:
    int filterHeight;
    int filterWidth;
    int strideH;
    int strideW;
};

// Class representing a Convolution operation
class Convolution {
public:
    // Constructor with parameters
    Convolution(const std::vector<std::vector<double>>& weights, const std::vector<std::vector<double>>& biases)
        : weights(weights), biases(biases) {}

    // Method to perform the convolution operation
    std::vector<std::vector<double>> convolve(const std::vector<std::vector<double>>& input) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int kernelHeight = weights.size();
        int kernelWidth = weights[0].size();

        std::vector<std::vector<double>> output(inputHeight - kernelHeight + 1, std::vector<double>(inputWidth - kernelWidth + 1));

        for (int i = 0; i < output.size(); ++i) {
            for (int j = 0; j < output[0].size(); ++j) {
                double sum = 0.0;
                for (int k = 0; k < kernelHeight; ++k) {
                    for (int l = 0; l < kernelWidth; ++l) {
                        sum += input[i + k][j + l] * weights[k][l];
                    }
                }
                output[i][j] = sum + biases[i][j];
            }
        }

        return output;
    }

private:
    std::vector<std::vector<double>> weights;
    std::vector<std::vector<double>> biases;
};

// Class representing a Depthwise Convolution operation
class DepthwiseConvolution {
public:
    // Constructor with parameters
    DepthwiseConvolution(const std::vector<std::vector<double>>& weights, const std::vector<std::vector<double>>& biases)
        : weights(weights), biases(biases) {}

    // Method to perform the depthwise convolution operation
    std::vector<std::vector<double>> depthwiseConvolve(const std::vector<std::vector<double>>& input) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int kernelHeight = weights.size();
        int kernelWidth = weights[0].size();

        std::vector<std::vector<double>> output(inputHeight - kernelHeight + 1, std::vector<double>(inputWidth - kernelWidth + 1));

        for (int i = 0; i < output.size(); ++i) {
            for (int j = 0; j < output[0].size(); ++j) {
                double sum = 0.0;
                for (int k = 0; k < kernelHeight; ++k) {
                    for (int l = 0; l < kernelWidth; ++l) {
                        sum += input[i + k][j + l] * weights[k][l];
                    }
                }
                output[i][j] = sum + biases[i][j];
            }
        }

        return output;
    }

private:
    std::vector<std::vector<double>> weights;
    std::vector<std::vector<double>> biases;
};

// Class representing an Add operation
class Add {
public:
    // Method to perform element-wise addition
    std::vector<std::vector<double>> add(const std::vector<std::vector<double>>& a, const std::vector<std::vector<double>>& b) {
        int height = a.size();
        int width = a[0].size();

        std::vector<std::vector<double>> result(height, std::vector<double>(width));

        for (int i = 0; i < height; ++i) {
            for (int j = 0; j < width; ++j) {
                result[i][j] = a[i][j] + b[i][j];
            }
        }

        return result;
    }
};

// Class representing a SpaceToBatchND operation
class SpaceToBatchND {
public:
    // Method to convert spatial dimensions to batch dimensions
    std::vector<std::vector<double>> spaceToBatchND(const std::vector<std::vector<double>>& input, const std::vector<int>& blockShape, const std::vector<int>& pads) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int batchSize = 1;
        for (int pad : pads) {
            batchSize *= (pad + 1);
        }

        std::vector<std::vector<double>> output(batchSize, std::vector<double>(inputHeight * blockShape[0], inputWidth * blockShape[1]));

        for (int i = 0; i < batchSize; ++i) {
            for (int j = 0; j < inputHeight; ++j) {
                for (int k = 0; k < inputWidth; ++k) {
                    output[i][(j * blockShape[0]) + (k * blockShape[1])] = input[j][k];
                }
            }
        }

        return output;
    }
};

// Class representing a BatchToSpaceND operation
class BatchToSpaceND {
public:
    // Method to convert batch dimensions back to spatial dimensions
    std::vector<std::vector<double>> batchToSpaceND(const std::vector<std::vector<double>>& input, const std::vector<int>& blockShape, const std::vector<int>& crops) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int batchSize = inputHeight / (blockShape[0] * blockShape[1]);

        std::vector<std::vector<double>> output(batchSize, std::vector<double>((inputHeight - crops[0] - crops[2]) / blockShape[0], (inputWidth - crops[1] - crops[3]) / blockShape[1]));

        for (int i = 0; i < batchSize; ++i) {
            for (int j = 0; j < output.size(); ++j) {
                for (int k = 0; k < output[0].size(); ++k) {
                    output[i][j][k] = input[(j * blockShape[0]) + crops[0]][(k * blockShape[1]) + crops[1]];
                }
            }
        }

        return output;
    }
};

// Class representing a Concatenation operation
class Concatenation {
public:
    // Method to concatenate tensors along a specified dimension
    std::vector<std::vector<double>> concatenate(const std::vector<std::vector<double>>& a, const std::vector<std::vector<double>>& b, int axis) {
        if (axis == 0) {
            std::vector<std::vector<double>> result(a.size() + b.size(), std::vector<double>(a[0].size()));
            for (int i = 0; i < a.size(); ++i) {
                result[i] = a[i];
            }
            for (int i = 0; i < b.size(); ++i) {
                result[a.size() + i] = b[i];
            }
            return result;
        } else if (axis == 1) {
            std::vector<std::vector<double>> result(a.size());
            for (int i = 0; i < a.size(); ++i) {
                result[i].resize(a[i].size() + b[i].size());
                for (int j = 0; j < a[i].size(); ++j) {
                    result[i][j] = a[i][j];
                }
                for (int j = 0; j < b[i].size(); ++j) {
                    result[i][a[i].size() + j] = b[i][j];
                }
            }
            return result;
        }
        throw std::invalid_argument("Invalid axis");
    }
};

// Class representing a Fully Connected layer
class FullyConnected {
public:
    // Constructor with parameters
    FullyConnected(const std::vector<std::vector<double>>& weights, const std::vector<std::vector<double>>& biases)
        : weights(weights), biases(biases) {}

    // Method to implement fully connected layers
    std::vector<double> fullyConnect(const std::vector<double>& input) {
        int inputSize = input.size();
        int outputSize = biases.size();

        std::vector<double> output(outputSize);

        for (int i = 0; i < outputSize; ++i) {
            double sum = 0.0;
            for (int j = 0; j < inputSize; ++j) {
                sum += input[j] * weights[i][j];
            }
            output[i] = sum + biases[i];
        }

        return output;
    }

private:
    std::vector<std::vector<double>> weights;
    std::vector<std::vector<double>> biases;
};

// Class representing a Gather operation
class Gather {
public:
    // Method to gather slices from a tensor according to indices
    std::vector<std::vector<double>> gather(const std::vector<std::vector<double>>& input, const std::vector<int>& indices) {
        std::vector<std::vector<double>> output(indices.size());

        for (int i = 0; i < indices.size(); ++i) {
            output[i] = input[indices[i]];
        }

        return output;
    }
};

// Class representing an L2 Normalization operation
class L2Normalization {
public:
    // Method to apply L2 normalization
    std::vector<std::vector<double>> normalize(const std::vector<std::vector<double>>& input) {
        int height = input.size();
        int width = input[0].size();

        std::vector<std::vector<double>> output(height, std::vector<double>(width));

        for (int i = 0; i < height; ++i) {
            double norm = 0.0;
            for (int j = 0; j < width; ++j) {
                norm += input[i][j] * input[i][j];
            }
            norm = std::sqrt(norm);
            for (int j = 0; j < width; ++j) {
                output[i][j] = input[i][j] / norm;
            }
        }

        return output;
    }
};

// Class representing an L2 Pooling operation
class L2Pool {
public:
    // Method to perform L2 pooling
    std::vector<std::vector<double>> pool(const std::vector<std::vector<double>>& input) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int filterHeight = 2;
        int filterWidth = 2;
        int strideH = 2;
        int strideW = 2;

        int outputHeight = (inputHeight - filterHeight + strideH) / strideH;
        int outputWidth = (inputWidth - filterWidth + strideW) / strideW;

        std::vector<std::vector<double>> output(outputHeight, std::vector<double>(outputWidth));

        for (int i = 0; i < outputHeight; ++i) {
            for (int j = 0; j < outputWidth; ++j) {
                double sum = 0.0;
                for (int k = 0; k < filterHeight; ++k) {
                    for (int l = 0; l < filterWidth; ++l) {
                        sum += input[i * strideH + k][j * strideW + l] * input[i * strideH + k][j * strideW + l];
                    }
                }
                output[i][j] = std::sqrt(sum);
            }
        }

        return output;
    }
};

// Class representing a Local Response Normalization operation
class LocalResponseNormalization {
public:
    // Method to apply local response normalization
    std::vector<std::vector<double>> normalize(const std::vector<std::vector<double>>& input) {
        int height = input.size();
        int width = input[0].size();
        int radius = 2;
        double alpha = 0.0001;
        double beta = 0.75;

        std::vector<std::vector<double>> output(height, std::vector<double>(width));

        for (int i = 0; i < height; ++i) {
            for (int j = 0; j < width; ++j) {
                double sum = 0.0;
                for (int k = std::max(0, j - radius); k <= std::min(width - 1, j + radius); ++k) {
                    sum += input[i][k] * input[i][k];
                }
                output[i][j] = input[i][j] * (alpha / (sum + beta)) + input[i][j];
            }
        }

        return output;
    }
