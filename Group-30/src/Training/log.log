import string

class Base64Decoder:
    def __init__(self):
        # Create a mapping from Base64 characters to their indices
        self.base64_map = {c: i for i, c in enumerate(string.ascii_uppercase + string.ascii_lowercase + string.digits + '+/')}
        self.padding_char = '='

    def decode(self, encoded_data):
        """
        Decodes a Base64-encoded string or bytes object back to its original binary form.

        Parameters:
        - encoded_data (str or bytes): The Base64-encoded data to be decoded.

        Returns:
        - bytes: The original binary data.
        """
        if isinstance(encoded_data, str):
            encoded_data = encoded_data.encode('utf-8')

        decoded_bytes = bytearray()
        i = 0
        while i < len(encoded_data):
            segment = encoded_data[i:i+4]
            num_chars = len(segment)
            if num_chars == 4:
                decoded_bytes.extend(self._decode_4_bytes(segment))
            elif num_chars == 3:
                decoded_bytes.extend(self._decode_3_bytes(segment))
            elif num_chars == 2:
                decoded_bytes.extend(self._decode_2_bytes(segment))
            elif num_chars == 1:
                decoded_bytes.extend(self._decode_1_byte(segment))
            i += 4

        return bytes(decoded_bytes)

    def _decode_4_bytes(self, segment):
        """
        Decodes a 4-byte segment of Base64 data.

        Parameters:
        - segment (bytes): A 4-byte segment of Base64 data.

        Returns:
        - bytes: The decoded 3-byte segment.
        """
        idx1 = self.base64_map[segment[0]]
        idx2 = self.base64_map[segment[1]]
        idx3 = self.base64_map[segment[2]]
        idx4 = self.base64_map[segment[3]]

        b1 = (idx1 << 2) | (idx2 >> 4)
        b2 = ((idx2 & 0xf) << 4) | (idx3 >> 2)
        b3 = ((idx3 & 0x3) << 6) | idx4

        return bytes([b1, b2, b3])

    def _decode_3_bytes(self, segment):
        """
        Decodes a 3-byte segment of Base64 data.

        Parameters:
        - segment (bytes): A 3-byte segment of Base64 data.

        Returns:
        - bytes: The decoded 2-byte segment.
        """
        idx1 = self.base64_map[segment[0]]
        idx2 = self.base64_map[segment[1]]
        idx3 = self.base64_map[segment[2]]

        b1 = (idx1 << 2) | (idx2 >> 4)
        b2 = ((idx2 & 0xf) << 4) | (idx3 >> 2)

        return bytes([b1, b2])

    def _decode_2_bytes(self, segment):
        """
        Decodes a 2-byte segment of Base64 data.

        Parameters:
        - segment (bytes): A 2-byte segment of Base64 data.

        Returns:
        - bytes: The decoded 1-byte segment.
        """
        idx1 = self.base64_map[segment[0]]
        idx2 = self.base64_map[segment[1]]

        b1 = (idx1 << 2) | (idx2 >> 4)

        return bytes([b1])

    def _decode_1_byte(self, segment):
        """
        Decodes a 1-byte segment of Base64 data.

        Parameters:
        - segment (bytes): A 1-byte segment of Base64 data.

        Returns:
        - bytes: The decoded 0-byte segment (empty).
        """
        idx1 = self.base64_map[segment[0]]

        return bytes([])
```

This Python code implements a Base64 decoder that can handle both string and bytes inputs. It uses a dictionary to map Base64 characters to their corresponding indices and decodes the input data in chunks of four bytes at a time. The `_decode_4_bytes`, `_decode_3_bytes`, `_decode_2_bytes`, and `_decode_1_byte` methods handle the decoding of each segment according to the Base64 encoding scheme.
