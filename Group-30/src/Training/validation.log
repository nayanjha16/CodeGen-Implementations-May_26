```cpp
#include <cuda_runtime.h>
#include <iostream>

template <typename IntType>
struct device_sequence_space {
    IntType* sequences;
    unsigned int capacity;
    unsigned int size;
    unsigned int seq_count;
    unsigned int seq_width;

    __host__ __device__
    void _resize_space_impl(IntType* sspace, unsigned int cols, unsigned int rows) {
        // Check if the current capacity is sufficient
        if (cols * rows > capacity) {
            // Delete the existing sequences
            cudaFree(sspace);
            
            // Allocate new memory
            cudaMalloc((void**)&sspace, cols * rows * sizeof(IntType));
            
            // Update the space metadata
            capacity = cols * rows;
        }
        
        sequences = sspace;
        seq_width = cols;
        size = rows * cols;
    }

    __host__ __device__
    void _resize_space(ColumnSpaceType* aspace, unsigned int seq_count) {
        // Resize the space using the private implementation
        _resize_space_impl(aspace->sequences, aspace->seq_width, seq_count);
        
        // Update the sequence count
        aspace->seq_count = seq_count;
    }
};

int main() {
    // Example usage
    device_sequence_space<int> seqSpace;
    ColumnSpaceType colSpace;
    
    // Initialize column space with some values
    colSpace.sequences = nullptr;
    colSpace.capacity = 0;
    colSpace.size = 0;
    colSpace.seq_count = 0;
    colSpace.seq_width = 0;
    
    // Resize the sequence space
    seqSpace._resize_space(&colSpace, 10);
    
    std::cout << "Resized sequence space with " << colSpace.seq_count << " sequences." << std::endl;
    
    return 0;
}
```

Note: The `ColumnSpaceType` is assumed to be defined elsewhere in your codebase or provided by the context. The example usage in the `main` function demonstrates how to initialize and use the `device_sequence_space` struct.
