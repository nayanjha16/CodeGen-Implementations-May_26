#include <windows.h>

namespace JCS_GUI {

class JCS_TreeNode {
public:
    // Constructor
    JCS_TreeNode() : m_node(nullptr) {}

    // Destructor
    ~JCS_TreeNode() {
        if (m_node != nullptr) {
            TreeView_DeleteItem(GetParentWindow(), m_node);
        }
    }

    // Method to create a root node
    HTREEITEM CreateRootNode(HWND hWndTree, LPCTSTR lpszText) {
        m_node = TreeView_InsertItem(hWndTree, TVI_ROOT, TVI_LAST, lpszText, lpszText, 0, 0, 0, 0);
        return m_node;
    }

    // Method to create a child node
    HTREEITEM CreateChildNode(HTREEITEM hParentNode, LPCTSTR lpszText) {
        m_node = TreeView_InsertItem(GetParentWindow(), hParentNode, TVI_LAST, lpszText, lpszText, 0, 0, 0, 0);
        return m_node;
    }

    // Method to get the handle of the node
    HTREEITEM GetNodeHandle() const {
        return m_node;
    }

private:
    HTREEITEM m_node;

    // Helper function to get the parent window handle from the tree view handle
    HWND GetParentWindow() const {
        return TreeView_GetParent(m_node);
    }
};

} // namespace JCS_GUI
```

