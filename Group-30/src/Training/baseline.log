#include <iostream>
#include <string>
#include <thread>
#include <mutex>
#include <condition_variable>
#include <fcntl.h>
#include <unistd.h>
#include <sys/ioctl.h>
#include <linux/videodev2.h>

enum class MipiPort {
    PortA,
    PortB,
    // Add more ports as needed
};

enum class MipiMode {
    Mode0,
    Mode1,
    // Add more modes as needed
};

enum class V4L2Format {
    YUYV,
    NV12,
    // Add more formats as needed
};

class v4l2Device {
public:
    v4l2Device(const std::string& devname, int height, int width, int numBuffers, MipiPort mipiPort, MipiMode mipiMode, V4L2Format v4l2Format)
        : m_devname(devname), m_height(height), m_width(width), m_num_buffers(numBuffers), m_MipiPort(mipiPort), m_MipiMode(mipiMode), m_v4l2Format(v4l2Format), m_fd(-1) {}

    ~v4l2Device() {
        closeDevice();
    }

    bool openDevice() {
        m_fd = open(m_devname.c_str(), O_RDWR);
        if (m_fd == -1) {
            perror("Failed to open V4L2 device");
            return false;
        }
        return true;
    }

    void closeDevice() {
        if (m_fd != -1) {
            close(m_fd);
            m_fd = -1;
        }
    }

    bool setVideoParameters() {
        struct v4l2_format fmt;
        memset(&fmt, 0, sizeof(fmt));
        fmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        fmt.fmt.pix.width = m_width;
        fmt.fmt.pix.height = m_height;
        fmt.fmt.pix.pixelformat = static_cast<uint32_t>(m_v4l2Format);
        fmt.fmt.pix.field = V4L2_FIELD_NONE;

        if (ioctl(m_fd, VIDIOC_S_FMT, &fmt) == -1) {
            perror("Failed to set video format");
            return false;
        }
        return true;
    }

    bool requestBuffers() {
        struct v4l2_requestbuffers req;
        memset(&req, 0, sizeof(req));
        req.count = m_num_buffers;
        req.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        req.memory = V4L2_MEMORY_MMAP;

        if (ioctl(m_fd, VIDIOC_REQBUFS, &req) == -1) {
            perror("Failed to request buffers");
            return false;
        }
        return true;
    }

    bool queryBuffer(int index, struct v4l2_buffer& buffer) {
        memset(&buffer, 0, sizeof(buffer));
        buffer.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        buffer.memory = V4L2_MEMORY_MMAP;
        buffer.index = index;

        if (ioctl(m_fd, VIDIOC_QUERYBUF, &buffer) == -1) {
            perror("Failed to query buffer");
            return false;
        }
        return true;
    }

    bool mapBuffer(struct v4l2_buffer& buffer, void*& addr) {
        addr = mmap(NULL, buffer.length, PROT_READ | PROT_WRITE, MAP_SHARED, m_fd, buffer.m.offset);
        if (addr == MAP_FAILED) {
            perror("Failed to map buffer");
            return false;
        }
        return true;
    }

    bool queueBuffer(struct v4l2_buffer& buffer) {
        if (ioctl(m_fd, VIDIOC_QBUF, &buffer) == -1) {
            perror("Failed to queue buffer");
            return false;
        }
        return true;
    }

    bool dequeueBuffer(struct v4l2_buffer& buffer) {
        if (ioctl(m_fd, VIDIOC_DQBUF, &buffer) == -1) {
            perror("Failed to dequeue buffer");
            return false;
        }
        return true;
    }

    void startCapture() {
        enum v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        if (ioctl(m_fd, VIDIOC_STREAMON, &type) == -1) {
            perror("Failed to start capture");
        }
    }

    void stopCapture() {
        enum v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        if (ioctl(m_fd, VIDIOC_STREAMOFF, &type) == -1) {
            perror("Failed to stop capture");
        }
    }

private:
    std::string m_devname;
    int m_height;
    int m_width;
    int m_num_buffers;
    MipiPort m_MipiPort;
    MipiMode m_MipiMode;
    V4L2Format m_v4l2Format;
    int m_fd;
};
```

This code defines a `v4l2Device` class that encapsulates the functionality for interacting with a V4L2 device. It includes methods for opening and closing the device, setting video parameters, requesting and mapping buffers, queuing and dequeuing buffers, starting and stopping capture. The class uses standard V4L2 ioctls to interact with the device.
