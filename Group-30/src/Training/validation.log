#ifndef TESTMESSAGE_H
#define TESTMESSAGE_H

#include <iostream>
#include <string>

struct TestMessage {
    uint32_t m_MessageSize;
    uint16_t m_p1Size;
    uint16_t m_p2Size;
    std::string m_p1;
    std::string m_p2;

    // Constructor
    TestMessage(uint32_t messageSize = 0, uint16_t p1Size = 0, uint16_t p2Size = 0, const std::string& p1 = "", const std::string& p2 = "")
        : m_MessageSize(messageSize), m_p1Size(p1Size), m_p2Size(p2Size), m_p1(p1), m_p2(p2) {}

    // Serialize the message to a buffer
    void serialize(char* buffer) const {
        memcpy(buffer, &m_MessageSize, sizeof(m_MessageSize));
        memcpy(buffer + sizeof(m_MessageSize), &m_p1Size, sizeof(m_p1Size));
        memcpy(buffer + sizeof(m_MessageSize) + sizeof(m_p1Size), &m_p2Size, sizeof(m_p2Size));
        memcpy(buffer + sizeof(m_MessageSize) + sizeof(m_p1Size) + sizeof(m_p2Size), m_p1.c_str(), m_p1Size);
        memcpy(buffer + sizeof(m_MessageSize) + sizeof(m_p1Size) + sizeof(m_p2Size) + m_p1Size, m_p2.c_str(), m_p2Size);
    }

    // Deserialize the message from a buffer
    void deserialize(const char* buffer) {
        memcpy(&m_MessageSize, buffer, sizeof(m_MessageSize));
        memcpy(&m_p1Size, buffer + sizeof(m_MessageSize), sizeof(m_p1Size));
        memcpy(&m_p2Size, buffer + sizeof(m_MessageSize) + sizeof(m_p1Size), sizeof(m_p2Size));
        m_p1.assign(buffer + sizeof(m_MessageSize) + sizeof(m_p1Size) + sizeof(m_p2Size), m_p1Size);
        m_p2.assign(buffer + sizeof(m_MessageSize) + sizeof(m_p1Size) + sizeof(m_p2Size) + m_p1Size, m_p2Size);
    }
};

#endif // TESTMESSAGE_H
```

