```python
from django.db.models.signals import pre_syncdb
from django.dispatch import receiver
import logging

# Global Variables
PRE_SYNCDB_ARGS = []
SYNCDB_DATABASE = 'default'
SYNCDB_VERBOSITY = 1
SYNCDB_INTERACTIVE = False

# Logger configuration
logger = logging.getLogger(__name__)

class PreSyncdbReceiver:
    """
    This class serves as a signal receiver for the `pre_syncdb` signal.
    It counts the number of times the signal is received and stores the arguments passed to it.
    """

    def __init__(self):
        self.call_counter = 0

    @receiver(pre_syncdb)
    def handle_pre_syncdb(self, sender, **kwargs):
        """
        Signal handler for the `pre_syncdb` signal.
        
        Parameters:
        - sender: The model class that triggered the signal.
        - **kwargs: Additional keyword arguments passed to the signal.
        """
        self.call_counter += 1
        PRE_SYNCDB_ARGS.append((sender, kwargs))
        logger.info(f"pre_syncdb signal received {self.call_counter} time(s)")

def run_tests():
    """
    Function to simulate running tests and ensuring the pre_syncdb signal is called exactly once.
    """
    # Simulate database synchronization
    pre_syncdb.send(None, using=SYNCDB_DATABASE, verbosity=SYNCDB_VERBOSITY, interactive=SYNCDB_INTERACTIVE)

    # Check if the pre_syncdb signal was called exactly once
    assert len(PRE_SYNCDB_ARGS) == 1, "The pre_syncdb signal was not called exactly once"
    print("All tests passed successfully.")

if __name__ == "__main__":
    run_tests()
```

This code defines a `PreSyncdbReceiver` class that listens for the `pre_syncdb` signal and counts the number of times it is received. It also includes a `run_tests` function to simulate running tests and ensure that the `pre_syncdb` signal is called exactly once. The global variables and standalone functions are included as per the requirements.
