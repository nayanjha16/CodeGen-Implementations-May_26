class Transformer:
    def __init__(self):
        self.transformations = []

    def transform(self, program):
        for _, fun in sorted(self.transformations, key=lambda x: x['priority']):
            program = fun(program)
        return program

def add_transformer(fun, priority):
    Dagoba.T.append({'priority': priority, 'fun': fun})

# Global variable to store transformations
Dagoba = type('Dagoba', (), {'T': []})
