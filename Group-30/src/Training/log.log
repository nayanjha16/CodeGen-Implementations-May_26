        GENERIC_READ | GENERIC_WRITE,
        0,
        NULL,
        OPEN_EXISTING,
        FILE_ATTRIBUTE_NORMAL,
        NULL);

    if (hPipe == INVALID_HANDLE_VALUE) {
        throw std::runtime_error("Failed to connect to service");
    }
}

void disconnectFromService() {
    CloseHandle(hPipe);
}

void sendOperation(int operationCode, const WorkGround* wg) {
    char buffer[BUFSIZE];
    ZeroMemory(buffer, BUFSIZE);

    // Pack the operation code into the buffer
    memcpy(buffer, &operationCode, sizeof(operationCode));

    if (wg != nullptr) {
        std::string serializedData;
        WorkGround::serialize(*wg, serializedData);
        memcpy(buffer + sizeof(operationCode), serializedData.c_str(), serializedData.size());
    }

    DWORD bytesWritten;
    WriteFile(hPipe, buffer, BUFSIZE, &bytesWritten, NULL);
}

std::string receiveResponse() {
    char buffer[BUFSIZE];
    ZeroMemory(buffer, BUFSIZE);

    DWORD bytesRead;
    ReadFile(hPipe, buffer, BUFSIZE, &bytesRead, NULL);

    return std::string(buffer, bytesRead);
}

int main() {
    try {
        connectToService();

        // Example usage
        WorkGround wg;
        sendOperation(STORE_WG, &wg);
        std::string response = receiveResponse();
        std::cout << "Response: " << response << std::endl;

        disconnectFromService();
    } catch (const std::exception& e) {
        std::cerr << "Error: " << e.what() << std::endl;
        return 1;
    }

    return 0;
}
```

This code provides a basic structure for interacting with a Windows service using named pipes. It includes the necessary constants, classes, and functions as described in the documentation. The `WorkGround` class has placeholder implementations for serialization and deserialization, which should be replaced with actual logic based on the specific requirements of your application.
