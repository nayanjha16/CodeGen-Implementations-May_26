```python
import torch
import torch.nn as nn
from minkowskiengine import SparseConvNetBase, MinkowskiBatchNorm, MinkowskiConvolution, MinkowskiTransposedConvolution

class BasicBlock(nn.Module):
    def __init__(self, in_channels, out_channels, kernel_size=3, stride=1, dilation=1):
        super(BasicBlock, self).__init__()
        self.conv1 = MinkowskiConvolution(in_channels, out_channels, kernel_size, stride=stride, dilation=dilation)
        self.bn1 = MinkowskiBatchNorm(out_channels)
        self.relu = nn.ReLU()
        self.conv2 = MinkowskiConvolution(out_channels, out_channels, kernel_size, stride=1, dilation=dilation)
        self.bn2 = MinkowskiBatchNorm(out_channels)

    def forward(self, x):
        identity = x
        out = self.conv1(x)
        out = self.bn1(out)
        out = self.relu(out)
        out = self.conv2(out)
        out = self.bn2(out)
        out += identity
        out = self.relu(out)
        return out

class Bottleneck(nn.Module):
    expansion = 4

    def __init__(self, in_channels, out_channels, kernel_size=3, stride=1, dilation=1):
        super(Bottleneck, self).__init__()
        self.conv1 = MinkowskiConvolution(in_channels, out_channels, kernel_size=1, stride=1, dilation=1)
        self.bn1 = MinkowskiBatchNorm(out_channels)
        self.conv2 = MinkowskiConvolution(out_channels, out_channels, kernel_size, stride=stride, dilation=dilation)
        self.bn2 = MinkowskiBatchNorm(out_channels)
        self.conv3 = MinkowskiConvolution(out_channels, out_channels * self.expansion, kernel_size=1, stride=1, dilation=1)
        self.bn3 = MinkowskiBatchNorm(out_channels * self.expansion)
        self.relu = nn.ReLU()

    def forward(self, x):
        identity = x
        out = self.conv1(x)
        out = self.bn1(out)
        out = self.relu(out)
        out = self.conv2(out)
        out = self.bn2(out)
        out = self.relu(out)
        out = self.conv3(out)
        out = self.bn3(out)
        out += identity
        out = self.relu(out)
        return out

class MinkUNetBase(SparseConvNetBase):
    def __init__(self, BLOCK, PLANES, DILATIONS, LAYERS, INIT_DIM, OUT_TENSOR_STRIDE):
        super(MinkUNetBase, self).__init__()
        self.BLOCK = BLOCK
        self.PLANES = PLANES
        self.DILATIONS = DILATIONS
        self.LAYERS = LAYERS
        self.INIT_DIM = INIT_DIM
        self.OUT_TENSOR_STRIDE = OUT_TENSOR_STRIDE
        
        # Define the encoder part
        self.encoder = []
        current_dim = INIT_DIM
        for i, num_layers in enumerate(LAYERS):
            for _ in range(num_layers):
                if BLOCK == BasicBlock:
                    block = BasicBlock(current_dim, PLANES[i])
                elif BLOCK == Bottleneck:
                    block = Bottleneck(current_dim, PLANES[i])
                else:
                    raise ValueError("Unsupported block type")
                self.encoder.append(block)
                current_dim = PLANES[i]
            if i < len(LAYERS) - 1:
                self.encoder.append(MinkowskiMaxPooling(kernel_size=2, stride=2))
        
        self.encoder = nn.Sequential(*self.encoder)
        
        # Define the decoder part
        self.decoder = []
        for i in range(len(LAYERS) - 2, -1, -1):
            for _ in range(LAYERS[i]):
                if BLOCK == BasicBlock:
                    block = BasicBlock(current_dim, PLANES[i])
                elif BLOCK == Bottleneck:
                    block = Bottleneck(current_dim, PLANES[i])
                else:
                    raise ValueError("Unsupported block type")
                self.decoder.append(block)
                current_dim = PLANES[i]
            if i > 0:
                self.decoder.append(MinkowskiUnpooling(kernel_size=2, stride=2))
                current_dim *= 2
        
        self.decoder = nn.Sequential(*self.decoder)
        
        # Final convolution to match the output tensor stride
        self.final_conv = MinkowskiConvolution(current_dim, PLANES[0], kernel_size=3, stride=1, dilation=DILATIONS[-1])
        self.out_bn = MinkowskiBatchNorm(PLANES[0])

    def forward(self, x):
        encoded_features = []
        for layer in self.encoder:
            if isinstance(layer, MinkowskiMaxPooling):
                encoded_features.append(x)
            x = layer(x)
        for layer in self.decoder:
            if isinstance(layer, MinkowskiUnpooling):
                x = x + encoded_features.pop()
            x = layer(x)
        x = self.final_conv(x)
        x = self.out_bn(x)
        return x

def save_model(model, path):
    torch.save(model.state_dict(), path)

def load_model(model, path):
    model.load_state_dict(torch.load(path))
    model.eval()
```

This code defines the `MinkUNetBase` class along with helper classes like `BasicBlock`, `Bottleneck`, and utility functions `save_model` and `load_model`. The `MinkUNetBase` class implements a UNet-like architecture using the MinkowskiEngine library, supporting both `BasicBlock` and `Bottleneck` types. The `save_model` and `load_model` functions allow for saving and loading the model's state dictionary.
