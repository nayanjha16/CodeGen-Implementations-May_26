```python
import ast

class Extension:
    pass

class Pipeline(Extension):
    def __init__(self, pipeline_visitor: 'PipelineVisitor'):
        self.pipeline_visitor = pipeline_visitor

class PipelineVisitor(ast.NodeTransformer):
    def __init__(self, activation: dict):
        self.activation = activation

    def visit_BinOp(self, node: ast.BinOp) -> ast.AST:
        if isinstance(node.op, ast.BitOr):
            # Create a new Call node with the function as the first argument
            call_node = ast.Call(
                func=node.right,
                args=[node.left],
                keywords=[]
            )
            return call_node
        return self.generic_visit(node)
```

