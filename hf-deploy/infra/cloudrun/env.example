# Copy to env.sh, fill in, then: source env.sh && ./deploy.sh
# On Windows PowerShell, use env.example.ps1 instead (copy to env.ps1, then: . .\env.ps1)
# env.sh is gitignored — never commit project id, URL, or secrets.

export GCP_PROJECT_ID="your-gcp-project-id"
export GCP_REGION="asia-south2"  # Hyderabad
export SERVICE_NAME="codegen-api"
export AR_REPO="hf-deploy"

# Set after first deploy (deploy.sh can update this for you)
export CLOUD_RUN_SERVICE_URL="https://***.asia-south2.run.app"

# Cloud Run sizing (350M model + PyTorch needs ample RAM on CPU)
export CLOUD_RUN_MEMORY="8Gi"
export CLOUD_RUN_CPU="2"
export CLOUD_RUN_TIMEOUT="900"
export CLOUD_RUN_MIN_INSTANCES="0"
export CLOUD_RUN_MAX_INSTANCES="1"

# Hugging Face (public adapters — token usually not required)
export HF_ORG="care2achieve"

# Optional: VERBOSE=1 for gcloud debug output during deploy
# export VERBOSE=1
