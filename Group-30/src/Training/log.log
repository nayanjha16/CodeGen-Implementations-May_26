#include <Arduino.h>
#include <AccelStepper.h>

// Define the pins for the stepper motors
const int X_DIR_PIN = 2;
const int X_STEP_PIN = 3;
const int Y_DIR_PIN = 4;
const int Y_STEP_PIN = 5;
const int Z_DIR_PIN = 6;
const int Z_STEP_PIN = 7;

// Define the number of steps per revolution for each stepper motor
const int STEPS_PER_REVOLUTION_X = 200;
const int STEPS_PER_REVOLUTION_Y = 200;
const int STEPS_PER_REVOLUTION_Z = 200;

// Create instances of AccelStepper for each axis
AccelStepper stepperX(AccelStepper::DRIVER, X_DIR_PIN, X_STEP_PIN);
AccelStepper stepperY(AccelStepper::DRIVER, Y_DIR_PIN, Y_STEP_PIN);
AccelStepper stepperZ(AccelStepper::DRIVER, Z_DIR_PIN, Z_STEP_PIN);

void setup() {
  // Initialize serial communication at 9600 baud rate
  Serial.begin(9600);

  // Set the maximum speed and acceleration for each stepper motor
  stepperX.setMaxSpeed(1000);
  stepperX.setAcceleration(500);
  stepperY.setMaxSpeed(1000);
  stepperY.setAcceleration(500);
  stepperZ.setMaxSpeed(1000);
  stepperZ.setAcceleration(500);
}

void loop() {
  if (Serial.available() > 0) {
    char command = Serial.read();

    switch (command) {
      case 'X':
        moveStepper(&stepperX, Serial.parseInt());
        break;
      case 'Y':
        moveStepper(&stepperY, Serial.parseInt());
        break;
      case 'Z':
        moveStepper(&stepperZ, Serial.parseInt());
        break;
      case 'P':
        printPositions();
        break;
      case 'R':
        resetPositions();
        break;
    }
  }
}

void moveStepper(AccelStepper* stepper, int steps) {
  stepper->move(steps);
  while (stepper->distanceToGo() != 0) {
    stepper->run();
  }
}

void printPositions() {
  Serial.print("X: ");
  Serial.println(stepperX.currentPosition());
  Serial.print("Y: ");
  Serial.println(stepperY.currentPosition());
  Serial.print("Z: ");
  Serial.println(stepperZ.currentPosition());
}

void resetPositions() {
  stepperX.setCurrentPosition(0);
  stepperY.setCurrentPosition(0);
  stepperZ.setCurrentPosition(0);
}
```

This code defines a simple Arduino sketch that controls three stepper motors using the `AccelStepper` library. It listens for serial commands to move the steppers along the X, Y, and Z axes, prints their current positions, or resets their positions to zero.
