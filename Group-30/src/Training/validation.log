```python
import unittest
import socket

_server = ('localhost', 11211)
_dead_retry = 30
_socket_timeout = 3
_max_receive_size = 4096

class MockConnection:
    def __init__(self, server=_server, dead_retry=_dead_retry, socket_timeout=_socket_timeout):
        self.server = server
        self.dead_retry = dead_retry
        self.socket_timeout = socket_timeout
        self.sock = None

    def connect(self):
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.sock.settimeout(self.socket_timeout)
        try:
            self.sock.connect(self.server)
        except socket.error as e:
            print(f"Failed to connect to {self.server}: {e}")
            return False
        return True

    def disconnect(self):
        if self.sock:
            self.sock.close()
            self.sock = None

    def set_value(self, key, value):
        if not self.sock:
            return False
        try:
            self.sock.sendall(f"SET {key} 0 0 {len(value)}\r\n{value}\r\n".encode())
            response = self.sock.recv(_max_receive_size).decode().strip()
            if response == "STORED":
                return True
        except socket.error as e:
            print(f"Error setting value for {key}: {e}")
        return False

    def get_value(self, key):
        if not self.sock:
            return None
        try:
            self.sock.sendall(f"GET {key}\r\n".encode())
            response = self.sock.recv(_max_receive_size).decode().strip()
            if response.startswith("VALUE"):
                _, _, value = response.split()
                return value
            elif response == "END":
                return None
        except socket.error as e:
            print(f"Error getting value for {key}: {e}")
        return None

class TestMemcachedClient(unittest.TestCase):
    def setUp(self):
        self.connection = MockConnection()

    def tearDown(self):
        self.connection.disconnect()

    def test_connect_and_disconnect(self):
        self.assertTrue(self.connection.connect())
        self.connection.disconnect()
        self.assertIsNone(self.connection.sock)

    def test_set_and_get_value(self):
        key = "test_key"
        value = "test_value"
        self.assertTrue(self.connection.set_value(key, value))
        retrieved_value = self.connection.get_value(key)
        self.assertEqual(retrieved_value, value)

if __name__ == '__main__':
    unittest.main()
```

This code includes the `MockConnection` class with methods to connect, disconnect, set, and get values, as well as a test class `TestMemcachedClient` using the `unittest` framework to validate these operations.
