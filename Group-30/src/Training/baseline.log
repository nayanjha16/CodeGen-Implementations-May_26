class Transformer:
    def __init__(self):
        self.T = []

    def transform(self, program):
        for transformer in sorted(self.T, key=lambda x: x['priority']):
            program = transformer['fun'](program)
        return program

def add_transformer(fun, priority):
    global Dagoba
    if not hasattr(Dagoba, 'T'):
        Dagoba.T = []
    Dagoba.T.append({'priority': priority, 'fun': fun})

# Example usage
if __name__ == "__main__":
    # Define some sample transformations
    def add_one(x):
        return x + 1

    def multiply_by_two(x):
        return x * 2

    # Add transformations with different priorities
    add_transformer(add_one, priority=1)
    add_transformer(multiply_by_two, priority=0)

    # Create an instance of Transformer
    transformer_system = Transformer()

    # Apply transformations to a program
    result = transformer_system.transform(5)
    print(result)  # Output should be 12 (5 + 1) * 2
```

