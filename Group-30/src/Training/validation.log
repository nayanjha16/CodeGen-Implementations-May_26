int veg::argc = 0;
char** veg::argv = nullptr;

void suppressOutput(bool suppress) {
    if (suppress) {
        std::cout.rdbuf(nullptr);
        std::cerr.rdbuf(nullptr);
    } else {
        std::cout.rdbuf(std::cout.rdbuf());
        std::cerr.rdbuf(std::cerr.rdbuf());
    }
}

int main(int argc, char** argv) {
    veg::argc = argc;
    veg::argv = argv;

    // Check if the last two arguments are "--suppress-output"
    bool suppress = false;
    if (argc >= 3 && strcmp(argv[argc - 2], "--suppress-output") == 0) {
        suppress = true;
    }

    suppressOutput(suppress);

    // Run doctest
    return doctest::Context().run();
}
