class TransformWhileSampling:
    def __init__(self, transform):
        """
        Initializes a new instance of the TransformWhileSampling class.

        Parameters:
        - transform: A callable object representing the transformation to be applied to the input sample.
        """
        self.transform = transform

    def __call__(self, sample):
        """
        Applies the transformation to the input sample twice and returns both results.

        Parameters:
        - sample: The input sample to which the transformation will be applied.

        Returns:
        - A tuple containing the two transformed samples.
        """
        first_transformed_sample = self.transform(sample)
        second_transformed_sample = self.transform(first_transformed_sample)
        return first_transformed_sample, second_transformed_sample
