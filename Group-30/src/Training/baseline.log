```

```cpp
#include "CLI_ARGS_HPP"
#include <iostream>
#include <vector>
#include <sstream>
#include <algorithm>

void parse_cli_args(int argc, char* argv[], cli_args& args) {
    std::vector<std::string> tokens;
    for (int i = 1; i < argc; ++i) {
        tokens.push_back(std::string(argv[i]));
    }

    auto find_option = [&](const std::string& option, double& value) {
        auto it = std::find(tokens.begin(), tokens.end(), option);
        if (it != tokens.end() && it + 1 != tokens.end()) {
            value = std::stod(*(it + 1));
            tokens.erase(it, it + 2);
        }
    };

    auto find_flag = [&](const std::string& option, bool& flag) {
        auto it = std::find(tokens.begin(), tokens.end(), option);
        if (it != tokens.end()) {
            flag = true;
            tokens.erase(it);
        } else {
            flag = false;
        }
    };

    find_option("--net", args.net);
    find_option("--units", args.units);
    find_flag("--gd", args.gd);
    find_flag("--bf", args.bf);
    find_flag("--ee", args.ee);
    find_option("--mcat", args.mcat);
    find_option("--ol", args.ol);
    find_option("--mht", args.mht);
    find_option("--mnu", args.mnu);
    find_flag("--verbose", args.verbose);
    find_option("--seed", args.seed);

    if (!tokens.empty()) {
        std::cerr << "Unknown options: ";
        for (const auto& token : tokens) {
            std::cerr << token << " ";
        }
        std::cerr << std::endl;
    }
}
