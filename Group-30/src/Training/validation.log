```python
import CommonServerPython as demisto
from typing import Dict, List, Optional
import re
import requests

# Constants
VENDOR = 'Have I Been Pwned? V2'
MAX_RETRY_ALLOWED = 3
API_KEY = demisto.getParam('apikey')
USE_SSL = demisto.getParam('use_ssl', True)
BASE_URL = 'https://haveibeenpwned.com/api/v2' if USE_SSL else 'http://haveibeenpwned.com/api/v2'
HEADERS = {
    'User-Agent': 'Demisto Integration',
    'Api-Key': API_KEY
}

class HaveIBeenPwnedClient:
    def __init__(self, base_url: str, headers: Dict[str, str]):
        self.base_url = base_url
        self.headers = headers

    def _make_request(self, endpoint: str, params: Optional[Dict[str, str]] = None) -> Dict:
        url = f"{self.base_url}/{endpoint}"
        response = requests.get(url, headers=self.headers, params=params, verify=USE_SSL)
        response.raise_for_status()
        return response.json()

    def test_module(self):
        try:
            self._make_request('breach/example@example.com')
            demisto.results('ok')
        except Exception as e:
            demisto.error(f'Test failed: {e}')
            raise

    def get_breaches_by_email(self, email: str) -> List[Dict]:
        return self._make_request(f'email-breaches/{email}')

    def get_pwned_passwords_count(self, password: str) -> int:
        # Note: This endpoint requires sending the password as part of the query string, which is not secure.
        # It's recommended to use this endpoint only for testing purposes.
        return len(self._make_request('breach/passwords', {'password': password}))

    def get_breaches_by_domain(self, domain: str) -> List[Dict]:
        return self._make_request(f'domain-breaches/{domain}')

    def get_breached_usernames(self, username: str) -> List[Dict]:
        return self._make_request(f'usernames/{username}')

def main():
    command = demisto.command()
