#include <hpx/hpx.hpp>
#include <hpx/applier/apply.hpp>
#include <hpx/runtime_local/thread_pool_base.hpp>
#include <hpx/runtime_local/thread_helpers.hpp>

namespace hpx { namespace applier { namespace detail {

    // Template struct responsible for scheduling actions
    template <typename Action, bool DirectExecute>
    struct apply_helper;

    // Specialization for direct execution
    template <typename Action>
    struct apply_helper<Action, true> {
        static void call(Action&& action) {
            // Directly execute the action
            std::forward<Action>(action)();
        }
    };

    // Specialization for indirect execution
    template <typename Action>
    struct apply_helper<Action, false> {
        static void call(Action&& action) {
            // Create a thread initialization data object
            hpx::threads::thread_init_data tid(std::forward<Action>(action));

            // Set up the continuation (if needed)
            // For simplicity, we assume no continuation is required here

            // Schedule the thread using the appropriate strategy
            hpx::threads::thread_id_type tid = hpx::threads::schedule_thread(tid);
        }
    };

}}} // namespace hpx::applier::detail
