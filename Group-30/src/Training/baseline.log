#include <iostream>
#include <string>
#include <cstring>
#include <dirent.h> // For POSIX systems
#ifdef _WIN32
#include <io.h>
#include <direct.h>
#include <sys/types.h>
#include <sys/stat.h>
#endif

#define OF_MAX_PATH_LEN 1024

class OFDirent {
public:
    OFDirent(const char *path);
    ~OFDirent();
    bool read(std::string &entry);

private:
    char m_path[OF_MAX_PATH_LEN];
    void* m_dir;
    int m_first;
#ifdef _WIN32
    struct _finddata_t m_data;
#endif
};

OFDirent::OFDirent(const char *path) : m_dir(nullptr), m_first(1) {
    strncpy(m_path, path, OF_MAX_PATH_LEN - 1);
    m_path[OF_MAX_PATH_LEN - 1] = '\0';
}

OFDirent::~OFDirent() {
    if (m_dir != nullptr) {
        close();
    }
}

bool OFDirent::read(std::string &entry) {
#ifdef _WIN32
    if (m_first) {
        std::string searchPath = std::string(m_path) + "\\*";
        m_dir = _findfirst(searchPath.c_str(), &m_data);
        m_first = 0;
    } else {
        if (_findnext(reinterpret_cast<long*>(&m_dir), &m_data) == -1) {
            return false;
        }
    }

    if ((m_data.attrib & _A_SUBDIR) == 0) {
        entry = m_data.name;
        return true;
    }
#else
    if (m_dir == nullptr) {
        m_dir = opendir(m_path);
        if (m_dir == nullptr) {
            return false;
        }
    }

    struct dirent *ent;
    while ((ent = readdir(static_cast<DIR*>(m_dir))) != nullptr) {
        if (strcmp(ent->d_name, ".") != 0 && strcmp(ent->d_name, "..") != 0) {
            entry = ent->d_name;
            return true;
        }
    }

    closedir(static_cast<DIR*>(m_dir));
    m_dir = nullptr;
#endif

    return false;
}
```

