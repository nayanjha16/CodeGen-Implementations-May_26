import pytest
from dagster import DagsterInstance, DagsterInstanceMigrationRequired
from dagster.core.storage.runs import RunStorage
from dagster.core.storage.events import EventLogStorage
from dagster.utils.test import restore_directory

def test_0_6_4():
    # Set up a test directory
    test_dir = restore_directory()

    # Create a DagsterInstance from the test directory
    instance = DagsterInstance.from_config_value({"storage": {"filesystem": {}}}, test_dir)

    # Retrieve all runs from the instance
    runs = instance.get_runs()

    # Attempt to retrieve logs for each run, which should raise a DagsterInstanceMigrationRequired exception
    for run in runs:
        with pytest.raises(DagsterInstanceMigrationRequired):
            instance.get_run_logs(run.run_id)
