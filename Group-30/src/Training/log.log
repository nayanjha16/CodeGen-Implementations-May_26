import time

def p3():
    """This function represents the deepest level of the process hierarchy. It waits for 30 nanoseconds before exiting."""
    print(f"{time.time()} entering p3")
    time.sleep(30e-9)  # Wait for 30 nanoseconds
    print(f"{time.time()} exiting p3")

def p2():
    """This function spawns p3 and waits for 20 nanoseconds before exiting."""
    print(f"{time.time()} entering p2")
    sc_spawn(p3)
    time.sleep(20e-9)  # Wait for 20 nanoseconds
    print(f"{time.time()} exiting p2")

def p1():
    """This function spawns p2 and waits for 10 nanoseconds before exiting."""
    print(f"{time.time()} entering p1")
    sc_spawn(p2)
    time.sleep(10e-9)  # Wait for 10 nanoseconds
    print(f"{time.time()} exiting p1")

def p0():
    """This function spawns p1 and waits for 5 nanoseconds before exiting."""
    print(f"{time.time()} entering p0")
    sc_spawn(p1)
    time.sleep(5e-9)  # Wait for 5 nanoseconds
    print(f"{time.time()} exiting p0")

# Simulate the main entry point
if __name__ == "__main__":
    p0()
```

