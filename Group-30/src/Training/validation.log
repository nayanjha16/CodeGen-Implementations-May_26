#include <iostream>
#include <cstddef>

namespace details {

    template<typename T>
    std::ostream& printVector(std::ostream& stream, const T* data, size_t count) {
        if (count == 0) {
            return stream << "<>";
        }
        
        stream << "<";
        for (size_t i = 0; i < count - 1; ++i) {
            stream << data[i] << ", ";
        }
        stream << data[count - 1];
        stream << ">";
        
        return stream;
    }

} // namespace details
