# Global variables
__version__ = "1.0.0"
release_notes = {
    "1.0.0": "Initial release with basic functionality.",
    "1.1.0": "Added support for new features."
}
release_banner = """
==================================
RLBot Release Information
==================================
"""

def get_current_release_notes():
    """
    Retrieves the release notes for the current version of the RLBot project.
    
    Parameters:
    None
    
    Returns:
    str: A string containing the release notes for the current version, or an empty string if the version is not found in the `release_notes` dictionary.
    """
    if __version__ in release_notes:
        return release_notes[__version__]
    else:
        return ""

def print_release_info():
    """
    Prints the release banner and the release notes for the current version of the RLBot project.
    
    Parameters:
    None
    
    Returns:
    None
    """
    print(release_banner)
    notes = get_current_release_notes()
    if notes:
        print("Release Notes:")
        print(notes)
    else:
        print("No release notes available for the current version.")

if __name__ == "__main__":
    print_release_info()
