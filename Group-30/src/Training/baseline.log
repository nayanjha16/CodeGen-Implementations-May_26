import torch
from torch import nn
from transformers import BertConfig, BertTokenizer, BertModel

class ModalEmbeddings(nn.Module):
    def __init__(self, config):
        super(ModalEmbeddings, self).__init__()
        self.config = config
        self.encoder = BertEncoder(config)
        self.proj_embeddings = nn.Linear(config.hidden_size, config.hidden_size)
        self.position_embeddings = nn.Embedding(config.max_position_embeddings, config.hidden_size)
        self.token_type_embeddings = nn.Embedding(2, config.hidden_size)
        self.word_embeddings = nn.Embedding(config.vocab_size, config.hidden_size)
        self.LayerNorm = nn.LayerNorm(config.hidden_size, eps=config.layer_norm_eps)
        self.dropout = nn.Dropout(config.hidden_dropout_prob)

    def forward(self, input_ids=None, position_ids=None, token_type_ids=None, inputs_embeds=None):
        if input_ids is not None:
            seq_length = input_ids.size(1)
            position_ids = torch.arange(seq_length, dtype=torch.long, device=input_ids.device).unsqueeze(0).expand_as(input_ids)
        
        if token_type_ids is None:
            token_type_ids = torch.zeros_like(input_ids)

        if inputs_embeds is None:
            inputs_embeds = self.word_embeddings(input_ids) + self.position_embeddings(position_ids) + self.token_type_embeddings(token_type_ids)

        projected_embeddings = self.proj_embeddings(inputs_embeds)
        embeddings = self.LayerNorm(projected_embeddings)
        embeddings = self.dropout(embeddings)
        return embeddings

class MMBTModel(nn.Module):
    def __init__(self, config):
        super(MMBTModel, self).__init__()
        self.config = config
        self.modal_embeddings = ModalEmbeddings(config)
        self.transformer = BertModel(config)

    def forward(self, image_features, text_input_ids, text_attention_mask, text_token_type_ids):
        image_embeddings = self.modal_embeddings(image_features)
        text_embeddings = self.modal_embeddings(text_input_ids, text_attention_mask, text_token_type_ids)
        
        combined_embeddings = torch.cat((image_embeddings, text_embeddings), dim=1)
        combined_mask = torch.cat((torch.ones_like(image_attention_mask), text_attention_mask), dim=1)
        combined_token_type_ids = torch.cat((torch.zeros_like(image_token_type_ids), text_token_type_ids), dim=1)
        
        outputs = self.transformer(combined_embeddings, attention_mask=combined_mask, token_type_ids=combined_token_type_ids)
        return outputs

# Example usage
config = BertConfig.from_pretrained('bert-base-uncased')
model = MMBTModel(config)

# Dummy data
image_features = torch.randn(1, 10, 768)  # Batch size 1, 10 features, hidden size 768
text_input_ids = torch.randint(0, 1000, (1, 10))  # Batch size 1, 10 tokens
text_attention_mask = torch.ones_like(text_input_ids)
text_token_type_ids = torch.zeros_like(text_input_ids)

outputs = model(image_features, text_input_ids, text_attention_mask, text_token_type_ids)
print(outputs)
```

This code defines the `ModalEmbeddings` and `MMBTModel` classes as specified in the documentation. The `ModalEmbeddings` class handles the projection and combination of modal embeddings, while the `MMBTModel` class integrates these embeddings with a transformer model for multimodal classification tasks.
