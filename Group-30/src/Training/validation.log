  // Load the operator set from disk.
  auto opset_path = GetOpsetName(operator_set_id.domain(),
                                 operator_set_id.version());
  std::ifstream fin(opset_path, std::ios_base::binary);
  if (!fin.is_open()) {
    throw std::runtime_error("Error opening operator set file: " + opset_path);
  }
