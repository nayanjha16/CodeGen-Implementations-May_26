class ZapInfo:
    def __init__(self, ee_jit_info):
        self.m_pEEJitInfo = ee_jit_info

    def get_token_size(self, resolved_token):
        """
        Returns the size of a token.

        :param resolved_token: A pointer to the resolved token.
        :type resolved_token: CORINFO_RESOLVED_TOKEN
        :return: The size of the token.
        :rtype: int
        """
        return self.m_pEEJitInfo.getTokenSize(resolved_token)

    def get_token_scope(self, resolved_token):
        """
        Returns the scope of a token.

        :param resolved_token: A pointer to the resolved token.
        :type resolved_token: CORINFO_RESOLVED_TOKEN
        :return: The module handle representing the scope of the token.
        :rtype: CORINFO_MODULE_HANDLE
        """
        return self.m_pEEJitInfo.getTokenScope(resolved_token)

    def get_enclosing_method_module(self, method):
        """
        Returns the module handle of the enclosing method.

        :param method: A handle to the method.
        :type method: CORINFO_METHOD_HANDLE
        :return: The module handle of the enclosing method.
        :rtype: CORINFO_MODULE_HANDLE
        """
        return self.m_pEEJitInfo.getEnclosingMethodModule(method)

    def get_module_from_method(self, method):
        """
        Returns the module handle from a method handle.

        :param method: A handle to the method.
        :type method: CORINFO_METHOD_HANDLE
        :return: The module handle associated with the method.
        :rtype: CORINFO_MODULE_HANDLE
        """
        return self.m_pEEJitInfo.getModuleFromMethod(method)

    def get_module_from_function_pointer(self, function_pointer):
        """
        Returns the module handle from a function pointer.

        :param function_pointer: A handle to the function.
        :type function_pointer: CORINFO_FUNCTION_HANDLE
        :return: The module handle associated with the function.
        :rtype: CORINFO_MODULE_HANDLE
        """
        return self.m_pEEJitInfo.getModuleFromFunctionPointer(function_pointer)

    def get_module_from_type_name(self, type_name, namespace_name):
        """
        Returns the module handle from a type name and namespace.

        :param type_name: The name of the type.
        :type type_name: str
        :param namespace_name: The name of the namespace.
        :type namespace_name: str
        :return: The module handle associated with the type.
        :rtype: CORINFO_MODULE_HANDLE
        """
        return self.m_pEEJitInfo.getModuleFromTypeName(type_name, namespace_name)

    def get_module_from_assembly(self, assembly):
        """
        Returns the module handle from an assembly handle.

        :param assembly: A handle to the assembly.
        :type assembly: CORINFO_ASSEMBLY_HANDLE
        :return: The module handle associated with the assembly.
        :rtype: CORINFO_MODULE_HANDLE
        """
        return self.m_pEEJitInfo.getModuleFromAssembly(assembly)
