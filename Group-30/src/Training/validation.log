```python
from kafka import KafkaConsumer
import uuid

class Consumer:
    CLIENT_ID = "my-consumer"

    def __init__(self, topics, connection_data):
        """
        Initialize a new Kafka consumer.

        :param topics: Tuple of Kafka topics to subscribe to.
        :type topics: tuple[str]
        :param connection_data: Dictionary containing connection parameters.
        :type connection_data: dict
        """
        self._topics = topics
        self._connection_data = connection_data
        self._client_id = f"{self.CLIENT_ID}-{uuid.uuid4()}"
        self._consumer = None

    def __enter__(self):
        """
        Enter the context manager and start consuming messages.
        """
        self.connect()
        return self

    def __exit__(self, exc_type, exc_value, traceback):
        """
        Exit the context manager and close the consumer.
        """
        self.close()

    def connect(self):
        """
        Establish a connection to the Kafka brokers and start consuming messages.
        """
        self._consumer = KafkaConsumer(
            *self._topics,
            **self._connection_data,
            client_id=self._client_id
        )

    def change_topics(self, new_topics):
        """
        Change the topics to which the consumer is subscribed.

        :param new_topics: New tuple of Kafka topics to subscribe to.
        :type new_topics: tuple[str]
        """
        self._topics = new_topics
        if self._consumer:
            self._consumer.unsubscribe()
            self._consumer.subscribe(new_topics)

    def consume(self):
        """
        Consume messages from the subscribed topics.

        :return: Generator yielding consumed messages.
        :rtype: generator[dict]
        """
        for message in self._consumer:
            yield {
                'topic': message.topic,
                'partition': message.partition,
                'offset': message.offset,
                'value': message.value.decode('utf-8')
            }

    def close(self):
        """
        Close the Kafka consumer connection.
        """
        if self._consumer:
            self._consumer.close()
            self._consumer = None
```

This code defines a `Consumer` class that manages a Kafka consumer using the `kafka-python` library. The class includes methods for connecting to Kafka, changing the topics being consumed, consuming messages, and closing the connection. The `__enter__` and `__exit__` methods allow the class to be used as a context manager, ensuring proper resource management.
