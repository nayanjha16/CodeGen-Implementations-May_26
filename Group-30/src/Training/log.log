class FullyConnectedLatentVariable:
    def __init__(self, input_size, output_size):
        """
        Initializes a new instance of the FullyConnectedLatentVariable class.

        Parameters:
        - input_size (int): The number of inputs to the layer.
        - output_size (int): The number of outputs from the layer.
        """
        self.input_size = input_size
        self.output_size = output_size
        self.weights = None
        self.bias = None

    def initialize_weights(self, initializer):
        """
        Initializes the weights using the specified initializer.

        Parameters:
        - initializer (function): A function that takes the shape as an argument and returns initialized weights.
        """
        import numpy as np
        self.weights = initializer((self.input_size, self.output_size))
        self.bias = initializer((self.output_size,))

    def forward(self, inputs):
        """
        Computes the forward pass through the fully connected layer.

        Parameters:
        - inputs (numpy.ndarray): The input data to the layer.

        Returns:
        - numpy.ndarray: The output of the layer after applying the weights and bias.
        """
        return np.dot(inputs, self.weights) + self.bias

class ConvolutionalLatentVariable:
    def __init__(self, input_shape, filter_size, num_filters, stride=1, padding=0):
        """
        Initializes a new instance of the ConvolutionalLatentVariable class.

        Parameters:
        - input_shape (tuple): The shape of the input tensor (height, width, channels).
        - filter_size (tuple): The size of the filters (height, width).
        - num_filters (int): The number of filters.
        - stride (int): The stride of the convolution operation.
        - padding (int): The amount of zero-padding added to both sides of the input.
        """
        self.input_shape = input_shape
        self.filter_size = filter_size
        self.num_filters = num_filters
        self.stride = stride
        self.padding = padding
        self.filters = None
        self.biases = None

    def initialize_filters(self, initializer):
        """
        Initializes the filters using the specified initializer.

        Parameters:
        - initializer (function): A function that takes the shape as an argument and returns initialized filters.
        """
        import numpy as np
        self.filters = initializer((self.num_filters, *self.filter_size, self.input_shape[2]))
        self.biases = initializer((self.num_filters,))

    def forward(self, inputs):
        """
        Computes the forward pass through the convolutional layer.

        Parameters:
        - inputs (numpy.ndarray): The input data to the layer.

        Returns:
        - numpy.ndarray: The output of the layer after applying the filters and biases.
        """
        import numpy as np
        batch_size, input_height, input_width, input_channels = inputs.shape
        filter_height, filter_width, _, _ = self.filters.shape
        output_height = (input_height + 2 * self.padding - filter_height) // self.stride + 1
        output_width = (input_width + 2 * self.padding - filter_width) // self.stride + 1

        # Pad the input
        padded_inputs = np.pad(inputs, ((0, 0), (self.padding, self.padding), (self.padding, self.padding), (0, 0)), mode='constant')

        # Initialize the output tensor
        output = np.zeros((batch_size, output_height, output_width, self.num_filters))

        # Perform convolution
        for b in range(batch_size):
            for f in range(self.num_filters):
                for i in range(output_height):
                    for j in range(output_width):
                        start_i = i * self.stride
                        start_j = j * self.stride
                        end_i = start_i + filter_height
                        end_j = start_j + filter_width
                        output[b, i, j, f] = np.sum(padded_inputs[b, start_i:end_i, start_j:end_j, :] * self.filters[f]) + self.biases[f]

        return output
```

