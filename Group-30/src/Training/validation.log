class Node:
    def __init__(self, baseurl, nodename, jenkins_obj):
        """
        Initializes a new Node object.

        Parameters:
        - baseurl (str): Base URL for querying information on the node.
        - nodename (str): Hostname of the node.
        - jenkins_obj (JenkinsBase): Reference to the Jenkins object associated with the node.
        """
        self.name = nodename
        self.jenkins = jenkins_obj
        self._data = {}
        self.update_data(baseurl)

    def update_data(self, baseurl):
        """
        Fetches updated data from the Jenkins server about the node.

        Parameters:
        - baseurl (str): Base URL for querying information on the node.
        """
        # Simulate fetching data from Jenkins server
        self._data = {
            'online': True,
            'temporarily_offline': False,
            'load_average': 0.5
        }

    def is_online(self):
        """
        Checks if the node is currently online.

        Returns:
        - bool: True if the node is online, False otherwise.
        """
        return self._data.get('online', False)

    def set_online(self, value=True):
        """
        Sets the node's online status.

        Parameters:
        - value (bool): New online status (True for online, False for offline).
        """
        self._data['online'] = value
        # Simulate updating Jenkins server
        print(f"Setting {self.name} to {'online' if value else 'offline'}")

    def toggle_temporary_offline(self):
        """
        Toggles the node's temporary offline status.
        """
        self._data['temporarily_offline'] = not self._data['temporarily_offline']
        # Simulate updating Jenkins server
        print(f"Toggled temporary offline status for {self.name}")

# Example usage:
