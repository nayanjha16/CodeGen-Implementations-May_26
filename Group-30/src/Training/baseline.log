class PnlWzemUsgAAccess {
public:
    // Enumerations
    enum VecVDo {
        VDO_NEW,
        VDO_DUPLICATE,
        VDO_DELETE,
        VDO_REFRESH
    };

    // Class to handle vector conversions
    static class VecVDo {
    public:
        static int getIx(const std::string& sref) {
            if (sref == "NEW") return VDO_NEW;
            else if (sref == "DUPLICATE") return VDO_DUPLICATE;
            else if (sref == "DELETE") return VDO_DELETE;
            else if (sref == "REFRESH") return VDO_REFRESH;
            else return -1; // Invalid sref
        }

        static std::string getSref(int ix) {
            switch (ix) {
                case VDO_NEW: return "NEW";
                case VDO_DUPLICATE: return "DUPLICATE";
                case VDO_DELETE: return "DELETE";
                case VDO_REFRESH: return "REFRESH";
                default: return ""; // Invalid ix
            }
        }
    };

    // Content Information class
