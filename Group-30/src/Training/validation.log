import time

class AverageMeter:
    """Tracks the average value over time."""
    
    def __init__(self):
        self.val = 0
        self.avg = 0
        self.sum = 0
        self.count = 0
    
    def update(self, value, n=1):
        """Updates the meter with a new value."""
        self.val = value
        self.sum += value * n
        self.count += n
        self.avg = self.sum / self.count
    
    def reset(self):
        """Resets the meter to initial state."""
        self.val = 0
        self.avg = 0
        self.sum = 0
        self.count = 0

class StopwatchMeter:
    """Measures elapsed time."""
    
    def __init__(self):
        self.elapsed_time = 0
    
    def start(self):
        """Starts timing."""
        self.start_time = time.time()
    
    def stop(self):
        """Stops timing."""
        self.elapsed_time += time.time() - self.start_time
    
    def reset(self):
        """Resets the timer."""
        self.elapsed_time = 0

class TimeMeter:
    """Measures words processed per second."""
    
    def __init__(self):
        self.words_processed = 0
        self.start_time = None
        self.end_time = None
    
    def start(self):
        """Starts timing."""
        self.start_time = time.time()
        self.words_processed = 0
    
    def stop(self):
        """Stops timing."""
        self.end_time = time.time()
    
    def reset(self):
        """Resets the timer."""
        self.words_processed = 0
        self.start_time = None
        self.end_time = None
    
    @property
    def wps(self):
        """Words processed per second."""
        if self.start_time is not None and self.end_time is not None:
            return self.words_processed / (self.end_time - self.start_time)
        return 0
```

