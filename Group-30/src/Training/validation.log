import random

class GameSimulator:
    def __init__(self):
        """
        Initializes a new instance of the GameSimulator.
        """
        pass

    def play_game(self) -> bool:
        """
        Simulates a single round of the Higher-or-Lower game.
        
        Returns:
            bool: True if the player wins, False otherwise.
        """
        # Initialize the deck with cards numbered from 1 to 10
        deck = list(range(1, 11))
        random.shuffle(deck)
        
        # Draw two cards
        first_card = deck.pop()
        second_card = deck.pop()
        
        # Player's decision based on the first card
        if first_card < second_card:
            guess = 'higher'
        else:
            guess = 'lower'
        
        # Determine the result
        if (guess == 'higher' and second_card > first_card) or (guess == 'lower' and second_card < first_card):
            return True
        else:
            return False

