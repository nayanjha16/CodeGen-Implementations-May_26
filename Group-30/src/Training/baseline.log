import torch
import torch.nn as nn
import torch.nn.functional as F

class BaseBackbone(nn.Module):
    def __init__(self, data_channel, num_cells, num_planes, block, activation_name, bn_name, first_output):
        super(BaseBackbone, self).__init__()
        self.data_channel = data_channel
        self.num_cells = num_cells
        self.num_planes = num_planes
        self.block = block
        self.activation_name = activation_name
        self.bn_name = bn_name
        self.first_output = first_output

    def forward(self, x):
        raise NotImplementedError("Subclasses must implement forward method")

class CellA(nn.Module):
    def __init__(self, num_planes, reduction_p, reduction_a):
        super(CellA, self).__init__()
        self.reduction_p = reduction_p
        self.reduction_a = reduction_a
        # Define your CellA layers here

    def forward(self, x):
        # Implement forward pass for CellA
        return x

class CellB(nn.Module):
    def __init__(self, num_planes, reduction_p, reduction_a):
        super(CellB, self).__init__()
        self.reduction_p = reduction_p
        self.reduction_a = reduction_a
        # Define your CellB layers here

    def forward(self, x):
        # Implement forward pass for CellB
        return x

class PNASNet(BaseBackbone):
    def __init__(self, data_channel=3, num_cells=[4, 8, 20], num_planes=48, block='CellA', activation_name='relu', bn_name='BatchNorm2d', first_output=192):
        super(PNASNet, self).__init__(data_channel, num_cells, num_planes, block, activation_name, bn_name, first_output)
        self.stem_1x1 = nn.Sequential(
            nn.Conv2d(data_channel, num_planes, kernel_size=3, stride=2, padding=1),
            getattr(nn, activation_name)(),
            getattr(nn, bn_name)(num_planes)
        )
        self.cells = nn.ModuleList()
        for i, n in enumerate(num_cells):
            if block == 'CellA':
                cell = CellA(num_planes, reduction_p=(i + 1) % 3 == 0, reduction_a=(i + 1) % 6 == 0)
            else:
                cell = CellB(num_planes, reduction_p=(i + 1) % 3 == 0, reduction_a=(i + 1) % 6 == 0)
            self.cells.append(cell)

    def forward(self, x):
        x = self.stem_1x1(x)
        for cell in self.cells:
            x = cell(x)
        return x

def pnasnet_A():
    return PNASNet(block='CellA')

def pnasnet_B():
    return PNASNet(block='CellB')
