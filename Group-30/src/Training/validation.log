import os

# Constants
AUDIO_FILENAME_ENDINGS = (".aiff", ".flac", ".m4a", ".mp3", ".ogg", ".opus", ".wav")

# Function to get file paths based on specified filename endings
def get_file_paths(root_path, filename_endings=AUDIO_FILENAME_ENDINGS, traverse_subdirectories=True):
    """Return a list of paths to all files with the given filename extensions in a directory.
    Also traverses subdirectories by default.
    """
    file_paths = []
    
    for root, dirs, files in os.walk(root_path):
        for file in files:
            if file.endswith(filename_endings):
                file_paths.append(os.path.join(root, file))
                
    return file_paths

# Function to calculate the Root Mean Square (RMS) of an audio signal
def calculate_rms(audio_signal):
    """Calculate the Root Mean Square (RMS) of an audio signal."""
    return (sum(x ** 2 for x in audio_signal) / len(audio_signal)) ** 0.5

# Function to convert decibel values to amplitude ratios
def db_to_amplitude_ratio(db_value):
    """Convert decibel values to amplitude ratios."""
    return 10 ** (db_value / 20)

# Function to check if an audio waveform is multichannel
def is_multichannel(audio_waveform):
    """Check if an audio waveform is multichannel."""
    return isinstance(audio_waveform, list) and len(audio_waveform) > 1

# Function to check if a spectrogram is multichannel
def is_multichannel_spectrogram(spectrogram):
    """Check if a spectrogram is multichannel."""
    return isinstance(spectrogram, list) and len(spectrogram) > 1

# Function to convert floating-point audio samples to 16-bit integer format
def float_to_int16(audio_samples):
    """Convert floating-point audio samples to 16-bit integer format."""
    return [int(x * 32767) for x in audio_samples]
