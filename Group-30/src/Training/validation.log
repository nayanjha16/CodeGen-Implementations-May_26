#include <iostream>
#include <vector>
#include <memory>
#include <unordered_map>
#include <random>

// Forward declarations
class Graph;
class GraphData;

class BiasedRandomWalk {
public:
    // Constructor
    BiasedRandomWalk(const Graph* graph, double paramP, double paramQ);

    // Method to preprocess transition probabilities
    void preprocessTransitionProbabilities();

    // Method to simulate a random walk
    std::vector<int> simulateRandomWalk(int startNode, int walkLength) const;

private:
    const Graph* graph; // Constant pointer to the input graph
    std::unique_ptr<GraphData> graphData; // Unique pointer to store preprocessed data
    double paramP; // Parameter controlling the tendency to move back towards previously visited nodes
    double paramQ; // Parameter controlling the tendency to move away from previously visited nodes

    // Helper method to get neighbors of a node
    std::vector<int> getNeighbors(int node) const;

    // Helper method to calculate transition probability
    double calculateTransitionProbability(int currentNode, int nextNode) const;
};

class Graph {
public:
    // Constructor
    Graph(const std::vector<std::vector<int>>& adjacencyList);

    // Method to get neighbors of a node
    std::vector<int> getNeighbors(int node) const;

private:
    std::vector<std::vector<int>> adjacencyList; // Adjacency list representation of the graph
};

class GraphData {
public:
    // Constructor
    GraphData(const Graph& graph, double paramP, double paramQ);

    // Method to get transition probability between two nodes
    double getTransitionProbability(int currentNode, int nextNode) const;

private:
    std::unordered_map<int, std::unordered_map<int, double>> transitionProbabilities; // Transition probabilities
    double paramP; // Parameter controlling the tendency to move back towards previously visited nodes
    double paramQ; // Parameter controlling the tendency to move away from previously visited nodes
};

// Implementation of BiasedRandomWalk methods
BiasedRandomWalk::BiasedRandomWalk(const Graph* graph, double paramP, double paramQ)
    : graph(graph), paramP(paramP), paramQ(paramQ) {}

void BiasedRandomWalk::preprocessTransitionProbabilities() {
    graphData = std::make_unique<GraphData>(*graph, paramP, paramQ);
}

std::vector<int> BiasedRandomWalk::simulateRandomWalk(int startNode, int walkLength) const {
    std::vector<int> walk;
    walk.reserve(walkLength);
    walk.push_back(startNode);

    std::mt19937 rng(std::random_device{}());
    std::uniform_real_distribution<> dist(0.0, 1.0);

    int currentNode = startNode;
    for (int i = 1; i < walkLength; ++i) {
        std::vector<int> neighbors = getNeighbors(currentNode);
        if (neighbors.empty()) break;

        double totalProbability = 0.0;
        std::vector<double> probabilities(neighbors.size());

        for (size_t j = 0; j < neighbors.size(); ++j) {
            probabilities[j] = calculateTransitionProbability(currentNode, neighbors[j]);
            totalProbability += probabilities[j];
        }

        for (size_t j = 0; j < probabilities.size(); ++j) {
            probabilities[j] /= totalProbability;
        }

        double randValue = dist(rng);
        size_t nextIndex = 0;
        while (randValue > probabilities[nextIndex]) {
            randValue -= probabilities[nextIndex];
            ++nextIndex;
        }

        currentNode = neighbors[nextIndex];
        walk.push_back(currentNode);
    }

    return walk;
}

std::vector<int> BiasedRandomWalk::getNeighbors(int node) const {
    return graph->getNeighbors(node);
}

double BiasedRandomWalk::calculateTransitionProbability(int currentNode, int nextNode) const {
    return graphData->getTransitionProbability(currentNode, nextNode);
}

// Implementation of Graph methods
Graph::Graph(const std::vector<std::vector<int>>& adjacencyList)
    : adjacencyList(adjacencyList) {}

std::vector<int> Graph::getNeighbors(int node) const {
    return adjacencyList[node];
}

// Implementation of GraphData methods
GraphData::GraphData(const Graph& graph, double paramP, double paramQ)
    : paramP(paramP), paramQ(paramQ) {
    for (int node = 0; node < graph.adjacencyList.size(); ++node) {
        for (int neighbor : graph.adjacencyList[node]) {
            double prob = calculateTransitionProbability(node, neighbor);
            transitionProbabilities[node][neighbor] = prob;
        }
    }
}

double GraphData::getTransitionProbability(int currentNode, int nextNode) const {
    auto it = transitionProbabilities.find(currentNode);
    if (it != transitionProbabilities.end()) {
        auto neighborIt = it->second.find(nextNode);
        if (neighborIt != it->second.end()) {
            return neighborIt->second;
        }
    }
    return 0.0;
}
```

This code defines the `BiasedRandomWalk`, `Graph`, and `GraphData` classes according to the provided documentation. The `BiasedRandomWalk` class includes methods for preprocessing transition probabilities and simulating random walks. The `Graph` class represents a graph using an adjacency list, and the `GraphData` class stores preprocessed transition probabilities. The code uses standard C++ conventions and includes necessary headers.
