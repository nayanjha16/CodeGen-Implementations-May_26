            }
        } else {
            for (int i = 0; text[i] != '\0'; ++i) {
                drawChar(_cursor.x + i * _font.width, _cursor.y, text[i], _font.data, _font.width, _font.height);
                delay(_scrollDelay);
            }
        }
    }

    void printNumber(int number) {
        char buffer[12];
        sprintf(buffer, "%d", number);
        print(buffer);
    }

    void clearDisplay() {
        memset(_buffer, 0, sizeof(_buffer));
        if (!_directDraw) {
            sendBuffer();
        }
    }

    void scrollDisplay() {
        if (_enableBuffer) {
            for (int i = 0; i < 64; ++i) {
                memmove(_buffer + i * 128, _buffer + (i + 1) * 128, 128);
            }
            memset(_buffer + 63 * 128, 0, 128);
            sendBuffer();
        }
    }

private:
    void drawChar(int x, int y, char ch, const uint8_t* fontData, int fontWidth, int fontHeight) {
        for (int i = 0; i < fontHeight; ++i) {
            for (int j = 0; j < fontWidth; ++j) {
                if (bitRead(fontData[(ch - 32) * fontHeight / 8 + i], j)) {
                    if (_inverseMode) {
                        _buffer[y + i * 128 + x + j] = 0xFF;
                    } else {
                        _buffer[y + i * 128 + x + j] = 0x00;
                    }
                } else {
                    if (_inverseMode) {
                        _buffer[y + i * 128 + x + j] = 0x00;
                    } else {
                        _buffer[y + i * 128 + x + j] = 0xFF;
                    }
                }
            }
        }
    }

    void sendBuffer() {
        Wire.beginTransmission(_i2cAddress);
        Wire.write((uint8_t*)_buffer, sizeof(_buffer));
        Wire.endTransmission();
    }
};
```

This code defines the `OLED12864` class with methods to control an OLED display using I2C communication. It includes functionalities for setting display properties, printing text and numbers, and handling cursor positions. The class uses a buffer for efficient rendering and supports both direct drawing and buffered modes.
