#include <mutex>
#include <map>
#include <vector>
#include <string>

namespace Anvil {

struct ObjectAllocation {
    // Define the structure as needed based on the specific requirements
    // For example:
    // uint64_t object_id;
    // void*    object_ptr;
};

class CallbacksSupportProvider {
public:
    CallbacksSupportProvider(uint32_t num_supported_callbacks);
    virtual ~CallbacksSupportProvider();

protected:
    uint32_t m_num_supported_callbacks;
};

class ObjectTracker : public CallbacksSupportProvider {
public:
    ObjectTracker();
    ~ObjectTracker();

    void destroy();

    void registerObject(const std::string& object_type, const ObjectAllocation& allocation);
    void unregisterObject(const std::string& object_type, const ObjectAllocation& allocation);

    bool hasMemoryLeaks() const;

private:
    mutable std::mutex m_cs;
    std::map<std::string, uint32_t> m_n_objects_allocated_array;
    std::map<std::string, std::vector<ObjectAllocation>> m_object_allocations;
};

} // namespace Anvil
```

### Implementation

```cpp
#include "object_tracker.h"

namespace Anvil {

// Constructor
ObjectTracker::ObjectTracker()
    : CallbacksSupportProvider(0), // Initialize with 0 supported callbacks for now
      m_cs(),
      m_n_objects_allocated_array(),
      m_object_allocations()
{
}

// Destructor
ObjectTracker::~ObjectTracker()
{
    destroy();
}

// Destroy method
void ObjectTracker::destroy()
{
    // Clean up resources if necessary
}

// Register an object
void ObjectTracker::registerObject(const std::string& object_type, const ObjectAllocation& allocation)
{
    std::lock_guard<std::mutex> lock(m_cs);

    auto it = m_n_objects_allocated_array.find(object_type);
    if (it == m_n_objects_allocated_array.end()) {
        m_n_objects_allocated_array[object_type] = 1;
    } else {
        ++it->second;
    }

    m_object_allocations[object_type].push_back(allocation);
}

// Unregister an object
void ObjectTracker::unregisterObject(const std::string& object_type, const ObjectAllocation& allocation)
{
    std::lock_guard<std::mutex> lock(m_cs);

    auto it = m_n_objects_allocated_array.find(object_type);
    if (it != m_n_objects_allocated_array.end()) {
        --it->second;
        if (it->second == 0) {
            m_n_objects_allocated_array.erase(it);
        }
    }

    auto alloc_it = m_object_allocations.find(object_type);
    if (alloc_it != m_object_allocations.end()) {
        alloc_it->second.erase(std::remove(alloc_it->second.begin(), alloc_it->second.end(), allocation), alloc_it->second.end());
    }
}

// Check for memory leaks
bool ObjectTracker::hasMemoryLeaks() const
{
    std::lock_guard<std::mutex> lock(m_cs);

    for (const auto& pair : m_n_objects_allocated_array) {
        if (pair.second > 0) {
            return true;
        }
    }

    return false;
}

// Constructor for CallbacksSupportProvider
CallbacksSupportProvider::CallbacksSupportProvider(uint32_t num_supported_callbacks)
    : m_num_supported_callbacks(num_supported_callbacks)
{
}

// Destructor for CallbacksSupportProvider
CallbacksSupportProvider::~CallbacksSupportProvider()
{
}

} // namespace Anvil
```

