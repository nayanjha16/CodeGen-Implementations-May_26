import pytest
from typing import List, Callable, Any

# Global Variables
TEST_NETWORK = 'regtest'
EXPERIMENTAL_FEATURES = False
COMPAT = True
VALGRIND = False

def only_one(lst: List[Any]) -> Any:
    """Returns the single element from a list, raising an error if the list is empty or contains more than one element."""
    if len(lst) != 1:
        raise ValueError("List must contain exactly one element")
    return lst[0]

def wait_for(condition: Callable[[], bool], timeout: int = 60) -> None:
    """Waits until the provided condition returns True."""
    import time
    start_time = time.time()
    while not condition():
        if time.time() - start_time > timeout:
            raise TimeoutError("Condition not met within the specified timeout")
        time.sleep(0.1)

def sync_blockheight(bitcoind: Any, nodes: List[Any]) -> None:
    """Synchronizes the block heights of bitcoind and the given nodes."""
    target_height = bitcoind.getblockcount()
    for node in nodes:
        current_height = node.getblockcount()
        while current_height < target_height:
            node.generate(1)
            current_height += 1

