assistant
```python
class Animal:
    def __init__(self, name: str):
        self.name = name
        self.order = None

    def set_order(self, order: int):
        self.order = order

    def peek_order(self) -> int:
        return self.order

    def __str__(self) -> str:
        return self.name


class Node:
    def __init__(self, data: Animal):
        self.data = data
        self.next = None


class AnimalQueue:
    def __init__(self):
        self.dog_queue = []
        self.cat_queue = []
        self.order = 0

    def enqueue(self, animal: Animal):
        animal.set_order(self.order)
        self.order += 1
        if isinstance(animal, Dog):
            self.dog_queue.append(animal)
        elif isinstance(animal, Cat):
            self.cat_queue.append(animal)

    def dequeue_any(self) -> Animal:
        if not self.dog_queue and not self.cat_queue:
            raise Exception("No animals in the queue")
        if not self.dog_queue:
            return self.dequeue_cat()
        if not self.cat_queue:
            return self.dequeue_dog()
        dog = self.dog_queue[0]
        cat = self.cat_queue[0]
        if dog.peek_order() < cat.peek_order():
            return self.dequeue_dog()
        else:
            return self.dequeue_cat()

    def dequeue_dog(self) -> Animal:
        if not self.dog_queue:
            raise Exception("No dogs in the queue")
        return self.dog_queue.pop(0)

    def dequeue_cat(self) -> Animal:
        if not self.cat_queue:
            raise Exception("No cats in the queue")
        return self.cat_queue.pop(0)


class Dog(Animal):
    pass


class Cat(Animal):
    pass
```

This code defines the required classes and methods to implement the animal queue system as described. The `Animal` class is the base class for both `Dog` and `Cat`, and it includes methods for setting and getting the order of the animal. The `Node` class represents a node in a singly linked list. The `AnimalQueue` class manages the queues for dogs and cats, ensuring that animals are served in the correct order according to their type and the order they were added. The `enqueue` method adds an animal to the appropriate queue, and the `dequeue_any`, `dequeue_dog`, and `dequeue_cat` methods remove animals from the queues in FIFO order.
