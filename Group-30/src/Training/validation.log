// Process the input audio data
void EchoCanceller::process(const float* input, float* output, size_t frameSize) {
    if (!isOn) return;

    if (enableAEC) {
        aec->process(const_cast<float*>(input), output, frameSize);
    } else {
        std::copy(input, input + frameSize, output);
    }

    if (enableNS) {
        ns->process(output, output, frameSize);
    }

    if (enableAGC) {
        agc->process(output, output, frameSize);
    }
}

// Enable or disable echo cancellation
