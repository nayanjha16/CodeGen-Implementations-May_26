#include <iostream>
#include <cstring>

class strings_recursion {
public:
    // Method to calculate the length of a string using recursion
    int length(char s[]) {
        if (s[0] == '\0') {
            return 0;
        } else {
            return 1 + length(s + 1);
        }
    }

    // Method to remove all occurrences of 'x' from a string using recursion
    void removeX(char s[], int index = 0) {
        if (s[index] == '\0') {
            return;
        }
        if (s[index] == 'x') {
            for (int i = index; s[i] != '\0'; ++i) {
                s[i] = s[i + 1];
            }
            removeX(s, index); // Recursively call with the same index to check the next character
        } else {
            removeX(s, index + 1); // Move to the next character
        }
    }
};

int main() {
    char inputString[100];

    std::cout << "Enter a string: ";
    std::cin.getline(inputString, 100);

    strings_recursion sr;

    // Calculate the length of the string
    int length = sr.length(inputString);
    std::cout << "Length of the string: " << length << std::endl;

    // Remove all occurrences of 'x' from the string
    sr.removeX(inputString);
    std::cout << "String after removing 'x': " << inputString << std::endl;

    return 0;
}
```

