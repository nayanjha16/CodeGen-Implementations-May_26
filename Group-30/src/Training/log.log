# Function to generate and print the sequence of pairs
def generate_and_print_pairs(N, M):
    if M % 2 == 1:
        # M is odd
        for i in range(1, (M + 1) // 2 + 1):
            print(f"({i}, {M + 1 - i})")
    else:
        # M is even
        start_first_element = M + 2
        end_first_element = M + (M // 2) + 1
        start_second_element = 2 * M + 1
        end_second_element = M + (M // 2) + 1
        
        for i in range(start_first_element, end_first_element):
            print(f"({i}, {start_second_element - (i - start_first_element)})")

# Call the function with the read values of N and M
generate_and_print_pairs(N, M)
