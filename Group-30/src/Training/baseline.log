class ProductDetail(generics.RetrieveAPIView):
    """
    Class-based view that retrieves and returns details of a specific product.
    """

    queryset = Product.objects.all()
    serializer_class = ProductSerializer

    def get_object(self, category_slug, product_slug):
        """
        Retrieves a product object based on its slug within a given category.
        """
        return self.queryset.filter(category__slug=category_slug, slug=product_slug).first()
