from floodsystem.stationdata import build_station_list
from floodsystem.utils import sorted_by_key

def run():
    # Build a list of all river stations
    stations = build_station_list()

    # Determine the number of stations to consider (N)
    N = 10  # Example value, can be adjusted as needed

    # Identify the stations with the highest relative water levels
    stations_highest_rel_level = stations_highest_rel_level(stations, N)

    # Print the results
    for station, level in stations_highest_rel_level:
        print(f"Station: {station.name}, Water Level: {level}")

def stations_highest_rel_level(stations, N):
    """
    Identifies the stations with the highest relative water levels.

    Parameters:
    - stations: A list of station objects (list).
    - N: An integer representing the number of stations to return.

    Returns:
    - A list of tuples containing station name and relative water level.
    """
    # Calculate the relative water level for each station
    station_levels = [(station.name, station.relative_water_level()) for station in stations]

    # Sort the stations by their relative water levels in descending order
    sorted_stations = sorted_by_key(station_levels, 1, reverse=True)

    # Return the top N stations
    return sorted_stations[:N]

if __name__ == "__main__":
    run()
```

This code includes the `run` function, which fetches station data, identifies the stations with the highest relative water levels, and prints them. It also includes the `stations_highest_rel_level` function, which performs the core logic of identifying the highest relative water levels. The code uses standard Python conventions and leverages built-in functions and libraries where appropriate.
