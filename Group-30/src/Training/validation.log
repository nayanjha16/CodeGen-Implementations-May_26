```cpp
#include <iostream>
#include <functional>
#include <thread>
#include <chrono>

namespace FastTransport {
    namespace Protocol {

        class PeriodicExecutor {
        public:
            // Constructor to initialize the executor with a function and interval
            explicit PeriodicExecutor(std::function<void()> function, std::chrono::microseconds interval)
                : _function(function), _interval(interval) {}

            // Start the periodic execution
            void start() {
                auto now = std::chrono::high_resolution_clock::now();
                _start = std::chrono::duration_cast<std::chrono::microseconds>(now.time_since_epoch());
                _running = true;
                _executionThread = std::thread(&PeriodicExecutor::run, this);
            }

            // Stop the periodic execution
            void stop() {
                _running = false;
                if (_executionThread.joinable()) {
                    _executionThread.join();
                }
            }

        private:
            std::function<void()> _function; // Function to be executed periodically
            std::chrono::microseconds _interval; // Interval between executions
            std::chrono::microseconds _start; // Start time of the first execution
            bool _running; // Flag to indicate whether the executor is running
            std::thread _executionThread; // Thread that runs the periodic execution

            // Method to run the periodic execution
            void run() {
                while (_running) {
                    auto now = std::chrono::high_resolution_clock::now();
                    auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(now.time_since_epoch()).count() - _start.count();

                    if (elapsed >= _interval.count()) {
                        _function(); // Execute the function
                        _start = std::chrono::duration_cast<std::chrono::microseconds>(now.time_since_epoch()); // Reset start time
                    }

                    std::this_thread::sleep_for(std::chrono::microseconds(10)); // Sleep briefly to avoid busy-waiting
                }
            }
        };

    } // namespace Protocol
} // namespace FastTransport

int main() {
    FastTransport::Protocol::PeriodicExecutor executor([]() {
        static int count = 0;
        ++count;
        std::cout << "Function executed " << count << " times" << std::endl;
    }, std::chrono::milliseconds(1000));

    executor.start();
    std::this_thread::sleep_for(std::chrono::seconds(5));
    executor.stop();

    return 0;
}
```

This code defines a `PeriodicExecutor` class within the `FastTransport::Protocol` namespace. The class allows you to specify a function and an interval, and it will execute the function repeatedly at the specified interval. The `start` method begins the periodic execution, and the `stop` method stops it. The `main` function demonstrates how to use the `PeriodicExecutor` class by executing a simple function every second for five seconds.
