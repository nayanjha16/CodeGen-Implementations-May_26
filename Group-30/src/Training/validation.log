#include <vector>
#include <memory>
#include <unordered_set>
#include <chrono>

// Forward declarations
class CMemoryPool;
class CQueryContext;
class CSearchStage;
class CMemo;
class CExpressionEnforcerPattern;
class CTransformation;
class CPlan;

class CEngine {
public:
    CEngine(CMemoryPool* pmp, CQueryContext* pqc);
    ~CEngine();

    void Initialize();
    void ApplyTransformations();
    CPlan SelectBestPlan();

private:
    CMemoryPool* m_pmp; // Memory pool for dynamic memory allocation
    CQueryContext* m_pqc; // Query context containing the original query and required properties
    std::vector<CSearchStage*> m_pdrgpss; // Array of search stages, defining the optimization phases
    size_t m_ulCurrSearchStage; // Current search stage index
    CMemo* m_pmemo; // Memo structure managing the optimization state
    CExpressionEnforcerPattern* m_pexprEnforcerPattern; // Pattern for creating enforcer expressions
    std::unordered_set<CTransformation*> m_pxfs; // Set of active transformations
    std::vector<uint64_t> m_pdrgpulpXformCalls; // Array tracking the number of times each transformation is applied
    std::vector<std::chrono::duration<double>> m_pdrgpulpXformTimes; // Array tracking the total time each transformation takes

    void AddSearchStage(CSearchStage* pss);
    void ApplyTransformation(CTransformation* pxform);
    double EvaluatePlan(const CPlan& plan) const;
};

CEngine::CEngine(CMemoryPool* pmp, CQueryContext* pqc)
    : m_pmp(pmp), m_pqc(pqc), m_ulCurrSearchStage(0), m_pmemo(new CMemo()), m_pexprEnforcerPattern(new CExpressionEnforcerPattern()) {}

CEngine::~CEngine() {
    delete m_pmemo;
    delete m_pexprEnforcerPattern;
}

void CEngine::Initialize() {
    // Initialize search stages
    for (size_t i = 0; i < m_pdrgpss.size(); ++i) {
        m_pdrgpss[i]->Initialize(m_pmp, m_pqc);
    }
}

void CEngine::ApplyTransformations() {
    for (auto pxform : m_pxfs) {
        ApplyTransformation(pxform);
    }
}

CPlan CEngine::SelectBestPlan() {
    CPlan bestPlan;
    double bestScore = -1.0;

    for (const auto& plan : m_pmemo->GetAllPlans()) {
        double score = EvaluatePlan(plan);
        if (score > bestScore) {
            bestScore = score;
            bestPlan = plan;
        }
    }

    return bestPlan;
}

void CEngine::AddSearchStage(CSearchStage* pss) {
    m_pdrgpss.push_back(pss);
}

void CEngine::ApplyTransformation(CTransformation* pxform) {
    m_pdrgpulpXformCalls[pxform->GetId()]++;
    auto start = std::chrono::high_resolution_clock::now();
    pxform->Apply(m_pmemo);
    auto end = std::chrono::high_resolution_clock::now();
    m_pdrgpulpXformTimes[pxform->GetId()] += std::chrono::duration_cast<std::chrono::duration<double>>(end - start).count();
}

double CEngine::EvaluatePlan(const CPlan& plan) const {
    // Placeholder evaluation logic
    return plan.GetCost();
}
