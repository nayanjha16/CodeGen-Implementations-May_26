class ExpressionBuiltinGlobals:
    kind = "EXPRESSION_BUILTIN_GLOBALS"

    def __init__(self, source_ref):
        self.source_ref = source_ref

    def finalize(self):
        # Clean up resources if necessary
        pass

    def computeExpressionRaw(self, trace_collection):
        # Compute the raw expression value
        return globals()

    def mayHaveSideEffects(self):
        # Return False indicating that the expression does not have side effects
        return False

    def mayRaiseException(self, exception_type):
        # Return False indicating that the expression cannot raise exceptions
        return False


class ExpressionBuiltinLocals:
    kind = "EXPRESSION_BUILTIN_LOCALS"

    def __init__(self, source_ref):
        self.source_ref = source_ref

    def finalize(self):
        # Clean up resources if necessary
        pass

    def computeExpressionRaw(self, trace_collection):
        # Compute the raw expression value
        return locals()

    def mayHaveSideEffects(self):
        # Return False indicating that the expression does not have side effects
        return False

    def mayRaiseException(self, exception_type):
        # Return False indicating that the expression cannot raise exceptions
        return False
