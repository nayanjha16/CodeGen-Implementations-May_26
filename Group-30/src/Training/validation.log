import os
import time
import subprocess
import requests
from typing import List, Optional

DEFAULT_TIMEOUT = 60
DEFAULT_MULTI_CLUSTER_APP_TIMEOUT = 120
CATTLE_TEST_URL = "https://rancher.example.com"
ADMIN_TOKEN = "admin_token_here"
CATTLE_API_URL = f"{CATTLE_TEST_URL}/v3"
kube_fname = "/path/to/kube/config"
MACHINE_TIMEOUT = 300
TEST_IMAGE = "nginx:latest"
CLUSTER_NAME = "test-cluster"
RANCHER_CLEANUP_CLUSTER = True
env_file = "/path/to/env/config"
CLUSTER_NAME_2 = "second-cluster"

class RancherClient:
    def __init__(self, api_url: str, admin_token: str):
        self.api_url = api_url
        self.admin_token = admin_token
        self.headers = {
            "Authorization": f"Bearer {self.admin_token}",
            "Content-Type": "application/json"
        }

    def create_project(self, project_name: str) -> dict:
        url = f"{self.api_url}/projects"
        payload = {
            "name": project_name,
            "clusterId": CLUSTER_NAME
        }
        response = requests.post(url, headers=self.headers, json=payload)
        response.raise_for_status()
        return response.json()

    def create_namespace(self, namespace_name: str) -> dict:
        url = f"{self.api_url}/namespaces"
        payload = {
            "name": namespace_name,
            "projectId": self.get_project_id(CLUSTER_NAME)
        }
        response = requests.post(url, headers=self.headers, json=payload)
        response.raise_for_status()
        return response.json()

    def create_workload(self, workload_name: str, container_image: str) -> dict:
        url = f"{self.api_url}/workloads"
        payload = {
            "name": workload_name,
            "namespaceId": self.get_namespace_id(CLUSTER_NAME, "default"),
            "containers": [
                {
                    "image": container_image,
                    "name": workload_name
                }
            ]
        }
        response = requests.post(url, headers=self.headers, json=payload)
        response.raise_for_status()
        return response.json()

    def validate_state(self, resource_type: str, resource_id: str) -> bool:
        url = f"{self.api_url}/{resource_type}/{resource_id}"
        response = requests.get(url, headers=self.headers)
        response.raise_for_status()
        resource = response.json()
        return resource["state"] == "active"

    def execute_kubectl_command(self, command: str) -> str:
        result = subprocess.run(command.split(), capture_output=True, text=True)
        if result.returncode != 0:
            raise Exception(f"Kubectl command failed: {result.stderr}")
        return result.stdout

    def manage_cluster_configurations(self, action: str) -> None:
        if action == "apply":
            self.execute_kubectl_command("kubectl apply -f /path/to/cluster/config.yaml")
        elif action == "delete":
            self.execute_kubectl_command("kubectl delete -f /path/to/cluster/config.yaml")

    def check_network_connectivity(self, host: str) -> bool:
        try:
            response = requests.get(host, timeout=5)
            return response.status_code == 200
        except requests.RequestException:
            return False

    def validate_dns(self, domain: str) -> bool:
        try:
            response = requests.get(f"http://{domain}", timeout=5)
            return response.status_code == 200
        except requests.RequestException:
            return False

    def cleanup_operations(self) -> None:
        if RANCHER_CLEANUP_CLUSTER:
            self.execute_kubectl_command("kubectl delete ns default --grace-period=0 --force")
            self.execute_kubectl_command("kubectl delete project test-project --grace-period=0 --force")

    def get_project_id(self, project_name: str) -> str:
        url = f"{self.api_url}/projects"
        response = requests.get(url, headers=self.headers)
        response.raise_for_status()
        projects = response.json()["data"]
        for project in projects:
            if project["name"] == project_name:
                return project["id"]
        raise Exception(f"Project {project_name} not found")

    def get_namespace_id(self, project_name: str, namespace_name: str) -> str:
        project_id = self.get_project_id(project_name)
        url = f"{self.api_url}/namespaces?projectId={project_id}"
        response = requests.get(url, headers=self.headers)
        response.raise_for_status()
        namespaces = response.json()["data"]
        for namespace in namespaces:
            if namespace["name"] == namespace_name:
                return namespace["id"]
        raise Exception(f"Namespace {namespace_name} not found")
```

