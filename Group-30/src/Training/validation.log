    def do_GET(self):
        if self.path == '/metadata':
            response = self.get_metadata()
        elif self.path == '/lineup':
            response = self.get_lineup()
        elif self.path == '/stream':
            response = self.start_stream()
        else:
            response = "Not Found", 404
        self.send_response(response[1])
        self.send_header('Content-type', 'application/xml' if response[1] == 200 else 'text/plain')
        self.end_headers()
        self.wfile.write(response[0].encode())

    def do_POST(self):
        content_length = int(self.headers['Content-Length'])
        post_data = self.rfile.read(content_length)
        data = json.loads(post_data.decode())
        if data['action'] == 'start_scan':
            self.start_station_scan(data['sid'])
            response = "Scan started", 200
        elif data['action'] == 'abort_scan':
            self.abort_station_scan(data['sid'])
            response = "Scan aborted", 200
        else:
            response = "Invalid action", 400
        self.send_response(response[1])
        self.send_header('Content-type', 'text/plain')
        self.end_headers()
        self.wfile.write(response[0].encode())

    def do_DELETE(self):
        if self.path.startswith('/stop_scan/'):
            sid = self.path.split('/')[-1]
            self.stop_station_scan(sid)
            response = "Scan stopped", 200
        else:
            response = "Invalid request", 400
        self.send_response(response[1])
        self.send_header('Content-type', 'text/plain')
        self.end_headers()
        self.wfile.write(response[0].encode())

