class KeyEventHandler:
    def __init__(self, key_translator):
        """
        Constructor for KeyEventHandler.

        Parameters:
        - key_translator: An instance of KeyTranslator used to translate raw key events.
        """
        self.key_translator_ = key_translator
        self.is_non_modifier_key_pressed_ = False
        self.currently_pressed_modifiers_ = set()
        self.modifiers_to_be_sent_ = set()

    def process_key_press(self, key_event):
        """
        Processes a key press event.

        Parameters:
        - key_event: The key event to process.
        """
        if key_event.is_modifier():
            self.handle_modifier_key_press(key_event)
        else:
            self.handle_non_modifier_key_press(key_event)

    def process_key_release(self, key_event):
        """
        Processes a key release event.

        Parameters:
        - key_event: The key event to process.
        """
        if key_event.is_modifier():
            self.handle_modifier_key_release(key_event)
        else:
            self.handle_non_modifier_key_release(key_event)

    def handle_modifier_key_press(self, key_event):
        """
        Handles the pressing of a modifier key.

        Parameters:
        - key_event: The modifier key event to handle.
        """
        self.currently_pressed_modifiers_.add(key_event.key)
        if not self.is_non_modifier_key_pressed_:
            self.modifiers_to_be_sent_.update(self.currently_pressed_modifiers_)
        self.send_modifiers_to_server()

    def handle_modifier_key_release(self, key_event):
        """
        Handles the releasing of a modifier key.

        Parameters:
        - key_event: The modifier key event to handle.
        """
        self.currently_pressed_modifiers_.remove(key_event.key)
        if not self.currently_pressed_modifiers_:
            self.modifiers_to_be_sent_.clear()
        self.send_modifiers_to_server()

    def handle_non_modifier_key_press(self, key_event):
        """
        Handles the pressing of a non-modifier key.

        Parameters:
        - key_event: The non-modifier key event to handle.
        """
        self.is_non_modifier_key_pressed_ = True
        self.modifiers_to_be_sent_.update(self.currently_pressed_modifiers_)
        self.send_modifiers_to_server()

    def handle_non_modifier_key_release(self, key_event):
        """
        Handles the releasing of a non-modifier key.

        Parameters:
        - key_event: The non-modifier key event to handle.
        """
        self.is_non_modifier_key_pressed_ = False
        self.modifiers_to_be_sent_.clear()
        self.send_modifiers_to_server()

    def send_modifiers_to_server(self):
        """
        Sends the current modifiers to the server.
        """
        # Implementation of sending modifiers to the server
        pass

