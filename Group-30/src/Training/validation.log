#include "on_pch.h"
#include "rt_defines.h"
#include "on_global_variables.h"

#define DBLKSIZE 100

class ON_Matrix::DBLBLK {
public:
	int count;
	double *a;
	DBLBLK *next;
};

ON_Matrix::ON_Matrix() : m(NULL), m_row_count(0), m_col_count(0)
{
}

ON_Matrix::~ON_Matrix()
{
	if (m != NULL) {
		if ((char*)m >= (char*)this + sizeof(*this)) {
			ON_FREE_MEMORY(m);
		}
		else {
			DBLBLK *dblk = (DBLBLK *)m;
			while (dblk != NULL) {
				DBLBLK *tmp = dblk;
				dblk = dblk->next;
				ON_FREE_MEMORY(tmp);
			}
		}
	}
	m = NULL;
}

