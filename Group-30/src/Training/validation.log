import time
from tango import DeviceProxy, Database

# Global variable to store the timestamp when the server starts
START_TIME = None

class TestDeviceServer:
    def __init__(self):
        global START_TIME
        START_TIME = time.time()

    def init_callback(self):
        """Reports server startup times after the server has been initialized."""
        end_time = time.time()
        elapsed_time = end_time - START_TIME
        
        # List all devices
        db = Database()
        devices = db.list_devices()
        
        # Get the number of exported devices
        num_devices = len(devices)
        
        # Write the results to a file
        with open('results.txt', 'w') as file:
            file.write(f"Elapsed Time: {elapsed_time} seconds\n")
            file.write(f"Average Time Per Device: {elapsed_time / num_devices if num_devices > 0 else 0} seconds\n")
        
        # Print the results
        print(f"Total time taken to start devices: {elapsed_time} seconds")
        print(f"Average time per device: {elapsed_time / num_devices if num_devices > 0 else 0} seconds")

    def delete_server(self):
        """Deletes the TestDeviceServer from the Tango database."""
        timeout = 10  # Timeout for Tango database operations
        server_name = "TestDeviceServer/1"
        
        try:
            db = Database()
            servers = db.get_device_exported(server_name)
            
            if servers:
                db.delete_device(servers[0])
                print(f"Server {server_name} deleted successfully.")
            else:
                print(f"Server {server_name} not found.")
        except Exception as e:
            print(f"Error deleting server: {e}")

# Example usage
if __name__ == "__main__":
    server = TestDeviceServer()
    server.init_callback()
    server.delete_server()
```

