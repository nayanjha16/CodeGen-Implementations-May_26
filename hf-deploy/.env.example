# Base model (Hub id or local cache path)
HF_DEPLOY_BASE_MODEL=Salesforce/codegen-350M-multi

# Checkpoint version under models/checkpoints/<version>/
HF_DEPLOY_CHECKPOINT_VERSION=v3

# Absolute or repo-relative path to checkpoints root
HF_DEPLOY_CHECKPOINTS_ROOT=models/checkpoints

# local = models/checkpoints/<version>/  |  hub = care2achieve/*-lora
HF_DEPLOY_ADAPTER_SOURCE=local

# Load all adapters at startup (true) or on first request (false)
HF_DEPLOY_EAGER_LOAD=true

# Device: auto | cpu | cuda | mps
HF_DEPLOY_DEVICE=auto

# Classifier confidence floor (0–1)
HF_DEPLOY_CONFIDENCE_THRESHOLD=0.45

# Optional: override Hub org for publish script
HF_ORG=care2achieve

# Hugging Face token for publish (or use `hf auth login`)
# HF_TOKEN=
