import tango
from tango.server import run, Device, attribute, command
import time

# Global variable to store the timestamp when the server starts
START_TIME = None

class TestDeviceServer(Device):
    """
    A Tango device server designed for scalability testing.
    """

    def init_device(self):
        global START_TIME
        self.set_state(tango.DevState.ON)
        START_TIME = time.time()
        print("Server initialized at:", START_TIME)

    @command(dtype_in=str, docin="Device name to register")
    def register_device(self, dev_name):
        """
        Registers a new device with the Tango server.
        
        :param dev_name: Name of the device to register
        """
        # Simulate device registration
        time.sleep(0.1)  # Simulate delay
        print(f"Device {dev_name} registered")

    @attribute(dtype=float, doc="Total time taken to start devices")
    def total_time(self):
        """
        Returns the total time taken to start devices.
        """
        if START_TIME is not None:
            return time.time() - START_TIME
        else:
            return 0.0

def init_callback():
    """
    Reports server startup times after the server has been initialized.
    
    Algorithm:
    1. Retrieves the current time.
    2. Calculates the elapsed time since the server started.
    3. Lists all devices using the list_devices() function.
    4. Fetches the number of exported devices from the Tango database.
    5. Writes the elapsed time and average time per device to a file named results.txt.
    6. Prints the total time taken to start devices along with the average time per device.
    """
    current_time = time.time()
    elapsed_time = current_time - START_TIME
    devices = tango.DeviceProxy('test/device/server').list_devices()
    num_devices = len(devices)
    avg_time_per_device = elapsed_time / num_devices if num_devices > 0 else 0
    
    with open('results.txt', 'w') as file:
        file.write(f"Elapsed Time: {elapsed_time}\n")
        file.write(f"Average Time Per Device: {avg_time_per_device}\n")
    
    print(f"Total time taken to start devices: {elapsed_time:.2f}s")
    print(f"Average time per device: {avg_time_per_device:.2f}s")

def delete_server():
    """
    Deletes the TestDeviceServer from the Tango database.
    
    Algorithm:
    1. Sets a timeout for the Tango database operations.
    2. Constructs the server name (TestDeviceServer/1).
    3. Retrieves the list of servers matching the specified pattern.
    """
    timeout = 10  # Timeout in seconds
    server_name = "TestDeviceServer/1"
    servers = tango.Database().get_server_list(server_name)
    
    if servers:
        for server in servers:
            try:
                tango.Database().delete_server(server, timeout)
                print(f"Deleted server: {server}")
            except Exception as e:
                print(f"Failed to delete server {server}: {e}")

if __name__ == "__main__":
    run([TestDeviceServer], args=['--device-name=TestDeviceServer/1'])
