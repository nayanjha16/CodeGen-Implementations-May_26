```cpp
#include <iostream>
#include <fstream>
#include <sstream>
#include <map>
#include <string>

namespace base {
    using GeoObjectId = int; // Assuming GeoObjectId is an integer for simplicity
}

struct Maxspeed {
    double limit;
    std::string unit;

    Maxspeed(double l, const std::string& u) : limit(l), unit(u) {}
};

class OsmIdToMaxspeed {
public:
    std::map<base::GeoObjectId, Maxspeed> osmIdToMaxspeedMap;

    void addMaxspeed(base::GeoObjectId id, const Maxspeed& maxspeed) {
        osmIdToMaxspeedMap[id] = maxspeed;
    }

    Maxspeed getMaxspeed(base::GeoObjectId id) const {
        return osmIdToMaxspeedMap.at(id);
    }
};

bool ParseMaxspeeds(const std::string& maxspeedsFilename, OsmIdToMaxspeed& osmIdToMaxspeed) {
    std::ifstream file(maxspeedsFilename);
    if (!file.is_open()) {
        std::cerr << "Failed to open file: " << maxspeedsFilename << std::endl;
        return false;
    }

    std::string line;
    while (getline(file, line)) {
        std::istringstream iss(line);
        std::string token;
        std::vector<std::string> tokens;

        while (getline(iss, token, ',')) {
            tokens.push_back(token);
        }

        if (tokens.size() != 3) {
            std::cerr << "Invalid line format: " << line << std::endl;
            continue;
        }

        base::GeoObjectId id = std::stoi(tokens[0]);
        double limit = std::stod(tokens[1]);
        std::string unit = tokens[2];

        osmIdToMaxspeed.addMaxspeed(id, Maxspeed(limit, unit));
    }

    file.close();
    return true;
}
```

This code defines the required classes and functions according to the provided documentation. The `OsmIdToMaxspeed` class uses a `std::map` to store OSM IDs and their corresponding `Maxspeed` objects. The `ParseMaxspeeds` function reads a CSV file, parses each line, and populates the `OsmIdToMaxspeed` map with the parsed data.
