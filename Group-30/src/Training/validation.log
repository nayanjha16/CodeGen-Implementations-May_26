#include <iostream>
#include <unordered_map>
#include <string>

class count_uniform_size {
public:
    // Fields
    int num_active_uniforms = 0;
    int num_values = 0;
    int num_shader_samplers = 0;
    int num_shader_uniform_components = 0;
    std::unordered_map<std::string, int> map;

    // Methods
    void start_shader() {
        num_active_uniforms = 0;
        num_values = 0;
        num_shader_samplers = 0;
        num_shader_uniform_components = 0;
        map.clear();
    }

    void visit_field(const std::string& type, const std::string& name) {
        // Assuming type is one of "int", "float", "vec2", "vec3", "vec4", etc.
        if (type == "int" || type == "float") {
            num_values += 1;
        } else if (type == "vec2") {
            num_values += 2;
        } else if (type == "vec3") {
            num_values += 3;
        } else if (type == "vec4") {
            num_values += 4;
        }
        // Handle samplers separately
        if (type == "sampler2D" || type == "samplerCube") {
            num_shader_samplers += 1;
        }
        // Store the mapping of uniform names to indices
        map[name] = num_active_uniforms++;
    }
};

int main() {
    count_uniform_size counter;
    counter.start_shader();

    // Example usage
    counter.visit_field("int", "uniformInt");
    counter.visit_field("float", "uniformFloat");
    counter.visit_field("vec2", "uniformVec2");
    counter.visit_field("vec3", "uniformVec3");
    counter.visit_field("vec4", "uniformVec4");
    counter.visit_field("sampler2D", "uniformSampler2D");

    std::cout << "Number of Active Uniforms: " << counter.num_active_uniforms << std::endl;
    std::cout << "Number of Values: " << counter.num_values << std::endl;
    std::cout << "Number of Samplers: " << counter.num_shader_samplers << std::endl;
    std::cout << "Uniform Mapping: ";
    for (const auto& pair : counter.map) {
        std::cout << pair.first << " -> " << pair.second << ", ";
    }
    std::cout << std::endl;

    return 0;
}
```

