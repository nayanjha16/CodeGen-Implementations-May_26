        return age;
    }

    // Setter for student's age
    void setAge(int age) {
        this->age = age;
    }

    // Getter for student's GPA
    double getGPA() const {
        return gpa;
    }

    // Setter for student's GPA
    void setGPA(double gpa) {
        this->gpa = gpa;
    }
};

class Course {
private:
    std::string courseName;
    std::vector<Student> students;

public:
    // Constructor to initialize a course with a name
    Course(const std::string& courseName)
        : courseName(courseName) {}

    // Method to add a student to the course
    void addStudent(const Student& student) {
        students.push_back(student);
    }

    // Method to remove a student from the course by name
    bool removeStudent(const std::string& name) {
        for (auto it = students.begin(); it != students.end(); ++it) {
            if (it->getName() == name) {
                students.erase(it);
                return true;
            }
        }
        return false;
    }

    // Method to display all students in the course
    void displayStudents() const {
        std::cout << "Course: " << courseName << std::endl;
        for (const auto& student : students) {
            std::cout << "Student Name: " << student.getName()
                      << ", Age: " << student.getAge()
                      << ", GPA: " << student.getGPA() << std::endl;
        }
    }
};

int main() {
