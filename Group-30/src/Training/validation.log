```cpp
#include <vector>
#include <string>
#include <algorithm>

// Forward declarations
class Validator;
class Model;
class Compartment;

// Helper class to store lists of IDs
class IdList {
public:
    std::vector<std::string> ids;
};

// Constraint base class template
template <typename T>
class TConstraint {
protected:
    unsigned int mId;
    Validator& mValidator;

public:
    TConstraint(unsigned int id, Validator& v) : mId(id), mValidator(v) {}
    virtual ~TConstraint() = default;
    virtual void check_(const T& t1, const T& t2) = 0;
};

// Main class for checking compartment outside cycles
class CompartmentOutsideCycles : public TConstraint<Model> {
private:
    std::vector<IdList> mCycles;

    // Recursive function to check for cycles
    bool checkForCycle(const Model& m, const Compartment* c, std::vector<const Compartment*>& path);

public:
    CompartmentOutsideCycles(unsigned int id, Validator& v);
    ~CompartmentOutsideCycles();
    void check_(const Model& m, const Model&);
};

// Constructor implementation
CompartmentOutsideCycles::CompartmentOutsideCycles(unsigned int id, Validator& v)
    : TConstraint<Model>(id, v) {}

// Destructor implementation
CompartmentOutsideCycles::~CompartmentOutsideCycles() {}

// Check function implementation
void CompartmentOutsideCycles::check_(const Model& m, const Model&) {
    for (const auto& compartment : m.getCompartments()) {
        if (!compartment.outside.empty()) {
            std::vector<const Compartment*> path;
            if (checkForCycle(m, &compartment, path)) {
                IdList cycle;
                for (const auto* comp : path) {
                    cycle.ids.push_back(comp->getId());
                }
                mCycles.push_back(cycle);
            }
        }
    }
}

// Recursive cycle checking function
bool CompartmentOutsideCycles::checkForCycle(const Model& m, const Compartment* c, std::vector<const Compartment*>& path) {
    path.push_back(c);
    for (const auto& compartment : m.getCompartments()) {
        if (compartment.getId() == c->outside) {
            if (std::find(path.begin(), path.end(), &compartment) != path.end()) {
                return true; // Cycle detected
            }
            if (checkForCycle(m, &compartment, path)) {
                return true;
            }
        }
    }
    path.pop_back();
    return false;
