```python
import random

class Card:
    SUITS = ['Hearts', 'Diamonds', 'Clubs', 'Spades']
    RANKS = ['2', '3', '4', '5', '6', '7', '8', '9', '10', 'Jack', 'Queen', 'King', 'Ace']

    def __init__(self, suit, rank):
        self.suit = suit
        self.rank = rank

    def __str__(self):
        return f"{self.rank} of {self.suit}"

class Deck:
    _FULL_DECK = []

    @staticmethod
    def GetFullDeck():
        if not Deck._FULL_DECK:
            Deck._FULL_DECK = [Card(suit, rank) for suit in Card.SUITS for rank in Card.RANKS]
        return Deck._FULL_DECK.copy()

    def __init__(self):
        self.cards = self.shuffle()

    def shuffle(self):
        full_deck = Deck.GetFullDeck()
        random.shuffle(full_deck)
        return full_deck

    def draw(self, n=1):
        if n == 1:
            return self.cards.pop()
        else:
            return [self.draw() for _ in range(n)]
```

This code defines a `Card` class to represent individual playing cards and a `Deck` class to manage a collection of cards. The `Deck` class includes methods to shuffle the deck and draw cards, ensuring that each instance starts with a shuffled copy of a full deck.
