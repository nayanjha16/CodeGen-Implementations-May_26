```python
import asyncio
from tempfile import TemporaryDirectory
from typing import List, Optional

class FingerprintComparisonResult:
    def __init__(self, force_training: bool, core: bool, nlu: List[str]):
        self.force_training = force_training
        self.core = core
        self.nlu = nlu

class TempDirectoryPath:
    def __enter__(self):
        self.temp_dir = TemporaryDirectory()
        return self.temp_dir.name

    def __exit__(self, exc_type, exc_val, exc_tb):
        self.temp_dir.cleanup()

async def train(domain_path: str, config_path: str, training_data_path: str, output_path: str, fingerprint: Optional[dict] = None) -> FingerprintComparisonResult:
    # Placeholder for actual implementation
    async def train_core():
        print("Training Core model...")
        await asyncio.sleep(1)
        return True

    async def train_nlu(languages: List[str]):
        print(f"Training NLU models for languages: {', '.join(languages)}")
        await asyncio.sleep(1)
        return languages

    async def compare_fingerprints(current_fingerprint: dict, new_fingerprint: dict) -> FingerprintComparisonResult:
        # Placeholder comparison logic
        force_training = current_fingerprint != new_fingerprint
        core_retrain = force_training or 'core' not in new_fingerprint
        nlu_retrain = [lang for lang in new_fingerprint.get('nlu', []) if lang not in current_fingerprint.get('nlu', [])]
        return FingerprintComparisonResult(force_training, core_retrain, nlu_retrain)

    if fingerprint is None:
        fingerprint = {}

    temp_dir = TempDirectoryPath()
    try:
        new_fingerprint = {
            'core': True,
            'nlu': ['en']
        }

        result = await compare_fingerprints(fingerprint, new_fingerprint)

        if result.force_training or result.core:
            await train_core()

        if result.nlu:
            await train_nlu(result.nlu)

        return result
    finally:
        pass  # Cleanup can be done here if needed

def train_sync(domain_path: str, config_path: str, training_data_path: str, output_path: str, fingerprint: Optional[dict] = None) -> FingerprintComparisonResult:
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    try:
        return loop.run_until_complete(train(domain_path, config_path, training_data_path, output_path, fingerprint))
    finally:
        loop.close()
```

This code defines the required classes and functions based on the provided documentation. The `train` function serves as the main entry point for synchronous model training, using an asynchronous helper function `train_async` to perform the actual training tasks. The `compare_fingerprints` function is used to determine whether retraining is necessary based on the current and new fingerprints. The `TempDirectoryPath` class manages temporary directories for model training.
