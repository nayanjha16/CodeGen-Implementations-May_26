i = 0

# Main function to calculate the sum of the first five non-negative integers
def calculate_sum():
    global summary, i
    
    # Step 1: Initialize variables
    summary = 0
    i = 0
    
    # Step 2: Enter the while loop
    while i < 5:
        # Step 3: Inside the loop
        # Add the current value of i to summary
        summary += i
        
        # Print the updated value of summary
        print(f"Current sum: {summary}")
        
        # Increment i by 1
        i += 1

# Call the main function to execute the program
calculate_sum()
