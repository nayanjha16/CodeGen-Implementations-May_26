#include <iostream>
#include <vector>
#include <opencv2/opencv.hpp>

// Structure representing a 2D point with floating-point coordinates
struct Point2f {
    float x;
    float y;

    Point2f(float x = 0.0f, float y = 0.0f) : x(x), y(y) {}
};

// Class representing a rotated rectangle
class RotatedRect {
public:
    cv::RotatedRect rect;

    RotatedRect(const cv::RotatedRect& rect) : rect(rect) {}

    void draw(cv::Mat& img, const cv::Scalar& color = cv::Scalar(0, 255, 0), int thickness = 2) const {
        cv::ellipse(img, rect, color, thickness);
    }
};

// Struct representing a single LED stick
struct LED_Stick {
    Point2f start;
    Point2f end;
    float length;
    float angle;

    LED_Stick(Point2f start, Point2f end) : start(start), end(end) {
        length = std::sqrt((end.x - start.x) * (end.x - start.x) + (end.y - start.y) * (end.y - start.y));
        angle = std::atan2(end.y - start.y, end.x - start.x) * 180 / CV_PI;
    }

    bool match(const LED_Stick& other, float threshold = 10.0f) const {
        return std::abs(length - other.length) < threshold && std::abs(angle - other.angle) < threshold;
    }
};

// Class representing an armor plate, derived from two LED sticks
class armor {
private:
    LED_Stick stick1;
    LED_Stick stick2;
    cv::RotatedRect boundingBox;

public:
    armor(LED_Stick stick1, LED_Stick stick2) : stick1(stick1), stick2(stick2) {
        if (stick1.match(stick2)) {
            boundingBox = cv::minAreaRect(std::vector<cv::Point2f>{stick1.start, stick1.end, stick2.start, stick2.end});
        }
    }

    void draw_rect(cv::Mat& img, const cv::Scalar& color = cv::Scalar(0, 255, 0), int thickness = 2) const {
        boundingBox.draw(img, color, thickness);
    }

    void draw_spot(cv::Mat& img, const cv::Scalar& color = cv::Scalar(0, 0, 255), int radius = 5) const {
        cv::circle(img, stick1.start, radius, color, -1);
        cv::circle(img, stick1.end, radius, color, -1);
        cv::circle(img, stick2.start, radius, color, -1);
        cv::circle(img, stick2.end, radius, color, -1);
    }

    double avg_intensity(const cv::Mat& img) const {
        cv::Mat roi;
        cv::getRectSubPix(img, boundingBox.size(), boundingBox.center, roi);
        cv::Scalar meanIntensity = cv::mean(roi);
        return meanIntensity[0];
    }

    bool match(const armor& other, float threshold = 10.0f) const {
        return boundingBox.boundingRect().area() > threshold && boundingBox.boundingRect().area() == other.boundingBox.boundingRect().area();
    }
};

// Class responsible for detecting armor plates in video frames
class ArmorDetector {
private:
    cv::VideoCapture cap;
    cv::Mat frame;
    cv::Mat grayFrame;

public:
    ArmorDetector(const std::string& videoPath) : cap(videoPath) {
        if (!cap.isOpened()) {
            throw std::runtime_error("Could not open video file");
        }
    }

    ~ArmorDetector() {
        cap.release();
    }

    cv::Mat get_ROI() {
        cap >> frame;
        cv::cvtColor(frame, grayFrame, cv::COLOR_BGR2GRAY);
        return grayFrame;
    }

    std::vector<armor> detect_armor() {
        std::vector<armor> armors;
        // Placeholder for actual detection logic
        // This should include feature extraction and object detection
        // For simplicity, we'll just create some dummy data
        LED_Stick stick1(Point2f(100, 100), Point2f(200, 200));
        LED_Stick stick2(Point2f(150, 150), Point2f(250, 250));
        armors.emplace_back(stick1, stick2);
        return armors;
    }

    void adjust_brightness(int value) {
        brightAdjust(grayFrame, value);
    }

    static void brightAdjust(cv::Mat& img, int value) {
        cv::Mat adjustedImg;
        img.convertTo(adjustedImg, -1, 1, value);
        cv::threshold(adjustedImg, adjustedImg, 255, 255, cv::THRESH_TRUNC);
        img = adjustedImg.clone();
    }
};
```

