import torch
import torch.nn as nn

class FullyConnectedHead(nn.Module):
    def __init__(self, unique_id: str, num_classes: int = None, in_plane: int = 512):
        super(FullyConnectedHead, self).__init__()
        self.unique_id = unique_id
        self.num_classes = num_classes
        self.in_plane = in_plane
        
        if num_classes is not None:
            self.fc = nn.Linear(in_plane, num_classes)
        
        self.avgpool = nn.AdaptiveAvgPool2d((1, 1))

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.avgpool(x)
        x = x.view(x.size(0), -1)
        
        if self.num_classes is not None:
            x = self.fc(x)
        
        return x
```

This code defines a `FullyConnectedHead` class that inherits from `nn.Module`. The class includes an adaptive average pooling layer and an optional fully connected layer for classification. The `forward` method processes the input tensor through these layers and returns the output.
