            cv::Vec4i l = lines[i];
            LED_Stick stick(Point2f(l[0], l[1]), Point2f(l[2], l[3]));
            armors.push_back(armor(stick, stick)); // Simplified for example
        }

        return armors;
    }

    // Method to adjust brightness
    static void brightAdjust(cv::Mat& img, int value) {
        img.convertTo(img, -1, 1, value);
        cv::threshold(img, img, 255, 255, cv::THRESH_TRUNC);
        cv::threshold(img, img, 0, 255, cv::THRESH_BINARY);
    }
};

