#ifndef CLI_ARGS_HPP
#define CLI_ARGS_HPP

#include <string>

struct cli_args {
    // Network and Routing Options
    std::string net;  // Network file name
    int units;        // Number of units
    bool gd;          // Generic Dijkstra search algorithm flag
    bool bf;          // Brute force search algorithm flag
    bool ee;          // Edge exclusion search algorithm flag

    // Traffic Options
    double mcat;       // Mean client arrival time
    double ol;         // Offered load
    double mht;        // Mean holding time
    double mnu;        // Mean number of units

    // Simulation Options
