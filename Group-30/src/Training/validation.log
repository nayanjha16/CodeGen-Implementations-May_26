import argparse
import os
from github import Github
from github.GithubException import UnknownObjectException

# Global Variables
THIS_FILE_DIRECTORY = os.path.dirname(os.path.abspath(__file__))
GH_REPO_IDENT = "owner/repo"
GH_USERNAME = "your_github_username"
GH_API_TOKEN = os.getenv("GITHUB_API_TOKEN")

def deploy_binaries(version: str):
    """
    Purpose: Deploys staged binaries to a new GitHub Release.

    Parameters:
    - version: A string representing the version number of the artifact to be deployed.
    """
    # Initialize Github object
    g = Github(GH_API_TOKEN)
    
    # Retrieve the repository
    repo = g.get_repo(GH_REPO_IDENT)
    
    # Wait until the specified version tag becomes available
    while True:
        try:
            repo.get_git_ref(f"refs/tags/v{version}")
            break
        except UnknownObjectException:
            print(f"Tag v{version} not found. Waiting...")
            time.sleep(10)  # Wait for 10 seconds before checking again
    
    # Create a new Git release
    release = repo.create_release(
        tag_name=f"v{version}",
        title=f"Release {version}",
        body=f"This is the release for version {version}.",
        draft=False,
        prerelease=False
    )
    
    # Upload binary assets (assuming they are in the THIS_FILE_DIRECTORY)
    for filename in os.listdir(THIS_FILE_DIRECTORY):
        if filename.endswith(".bin"):  # Adjust the filter as needed
            filepath = os.path.join(THIS_FILE_DIRECTORY, filename)
            release.upload_asset(filepath)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Deploy binaries to a GitHub release.")
    parser.add_argument("version", type=str, help="Version number of the artifact to be deployed")
    args = parser.parse_args()
    
    deploy_binaries(args.version)
```

