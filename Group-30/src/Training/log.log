#include <iostream>
#include <fstream>
#include <vector>
#include <string>
#include <thread>
#include <chrono>

// Forward declarations
class Transform;
class Source;
class Mapper;
class Joiner;
class Sink;

struct pipeline_config {
    int records_per_interval;
    double target_tput;
    int record_size;
    std::string input_file;
};

class Pipeline {
public:
    static Pipeline* create(Pipeline* parent);
    void apply1(Transform* transform);

private:
    Pipeline();
    ~Pipeline();

    std::vector<Transform*> transforms;
};

class Transform {
public:
    virtual ~Transform() {}
    virtual void process(const std::vector<std::string>& input, std::vector<std::string>& output) = 0;
};

class Source : public Transform {
public:
    Source(pipeline_config& config);
    void process(const std::vector<std::string>& input, std::vector<std::string>& output) override;

private:
    pipeline_config& config;
    std::ifstream infile;
};

class Mapper : public Transform {
public:
    Mapper();
    void process(const std::vector<std::string>& input, std::vector<std::string>& output) override;
};

class Joiner : public Transform {
public:
    Joiner();
    void process(const std::vector<std::string>& input, std::vector<std::string>& output) override;
};

class Sink : public Transform {
public:
    Sink();
    void process(const std::vector<std::string>& input, std::vector<std::string>& output) override;
};

Pipeline* Pipeline::create(Pipeline* parent) {
    return new Pipeline();
}

void Pipeline::apply1(Transform* transform) {
    transforms.push_back(transform);
}

Pipeline::Pipeline() {}

Pipeline::~Pipeline() {
    for (auto transform : transforms) {
        delete transform;
    }
}

Source::Source(pipeline_config& config) : config(config), infile(config.input_file) {}

void Source::process(const std::vector<std::string>& input, std::vector<std::string>& output) {
    std::string line;
    while (std::getline(infile, line)) {
        output.push_back(line);
    }
}

Mapper::Mapper() {}

void Mapper::process(const std::vector<std::string>& input, std::vector<std::string>& output) {
    for (const auto& item : input) {
        // Simple mapping example: convert to uppercase
        std::string upper_item = item;
        std::transform(upper_item.begin(), upper_item.end(), upper_item.begin(),
                       [](unsigned char c){ return std::toupper(c); });
        output.push_back(upper_item);
    }
}

Joiner::Joiner() {}

void Joiner::process(const std::vector<std::string>& input, std::vector<std::string>& output) {
    // Simple join example: concatenate with a separator
    std::string joined = "";
    for (size_t i = 0; i < input.size(); ++i) {
        if (i > 0) joined += ",";
        joined += input[i];
    }
    output.push_back(joined);
}

Sink::Sink() {}

void Sink::process(const std::vector<std::string>& input, std::vector<std::string>& output) {
    for (const auto& item : input) {
        std::cout << item << std::endl;
    }
}

int main() {
    pipeline_config config = {100, 1000.0, 1024, "data.txt"};

    Pipeline* pipeline = Pipeline::create(nullptr);
    pipeline->apply1(new Source(config));
    pipeline->apply1(new Mapper());
    pipeline->apply1(new Joiner());
    pipeline->apply1(new Sink());

    delete pipeline;

    return 0;
}
```

This code defines a simple data processing pipeline using custom components such as sources, mappers, joins, and sinks. The `pipeline_config` struct holds configuration settings for the pipeline. The `Pipeline` class manages the transformation and connection of various components. Each component is derived from the `Transform` base class and implements the `process` method to perform specific transformations. The `main` function sets up the pipeline with these components and processes the input data accordingly.
