#include <iostream>
#include <string>

class Point {
private:
    int x; // The x-coordinate of the point
    int y; // The y-coordinate of the point
    std::string text; // Text displayed at the point's position

public:
    // Constructor to initialize the point with default coordinates
    Point(int px = 0, int py = 0) : x(px), y(py), text("") {}

    // Method to set the position of the point
    Point& setPos(int px, int py) {
        x = px;
        y = py;
        return *this;
    }

    // Method to get the x-coordinate of the point
    int getX() const {
        return x;
    }

    // Method to get the y-coordinate of the point
    int getY() const {
        return y;
    }

    // Method to print text at the point's position
    void printText(const std::string& txt) {
        text = txt;
        std::cout << "Text '" << text << "' printed at (" << x << ", " << y << ")" << std::endl;
    }

    // Method to clear the text at the point's position
    void clearText() {
        text.clear();
        std::cout << "Text cleared at (" << x << ", " << y << ")" << std::endl;
    }

    // Method to set the cursor to the point's position
    void setCursor() const {
        std::cout << "Cursor moved to (" << x << ", " << y << ")" << std::endl;
    }

    // Method to move the point relative to its current position
    void moveRel(int dx, int dy) {
        x += dx;
        y += dy;
        std::cout << "Moved to (" << x << ", " << y << ")" << std::endl;
    }
};

int main() {
    Point p;
    p.setPos(3, 4).printText("Hello").moveRel(-1, 1).clearText().setCursor();
    return 0;
}
```

