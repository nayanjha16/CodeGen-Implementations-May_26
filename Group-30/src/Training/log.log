    void draw(cv::Mat& img, const cv::Scalar& color = cv::Scalar(0, 255, 0)) const {
        stick1.draw(img, color);
        stick2.draw(img, color);

        cv::circle(img, stick1.midpoint(), 3, color, -1);
        cv::circle(img, stick2.midpoint(), 3, color, -1);
    }

    // Method to calculate the average intensity of the armor plate
    double avg_intensity(const cv::Mat& img) const {
        cv::Rect roi(std::min(stick1.start.x, stick2.start.x), std::min(stick1.start.y, stick2.start.y),
                      std::max(stick1.end.x, stick2.end.x) - std::min(stick1.start.x, stick2.start.x),
                      std::max(stick1.end.y, stick2.end.y) - std::min(stick1.start.y, stick2.start.y));

        cv::Mat roiImg = img(roi);
        cv::Scalar meanIntensity = cv::mean(roiImg);
        return meanIntensity[0];
    }

    // Method to match LED sticks
    bool match_sticks() const {
        return std::abs(stick1.angle - stick2.angle) < 0.1 && std::abs(stick1.length - stick2.length) < 10.0;
    }
};

