#include <boost/geometry.hpp>
#include <iostream>

namespace bg = boost::geometry;

// Forward declaration of the assign_values function
template <typename Geometry, typename CoordinateType>
void assign_values(Geometry& geometry, CoordinateType const& value);

// Specialization for 2D points
template <typename CoordinateType>
void assign_values(bg::model::point<CoordinateType, 2, bg::cs::cartesian>& point, CoordinateType const& value) {
    bg::set<0>(point, value);
    bg::set<1>(point, value);
}

// Specialization for 3D points
template <typename CoordinateType>
void assign_values(bg::model::point<CoordinateType, 3, bg::cs::cartesian>& point, CoordinateType const& value) {
    bg::set<0>(point, value);
    bg::set<1>(point, value);
    bg::set<2>(point, value);
}

// Specialization for 2D boxes
template <typename CoordinateType>
void assign_values(bg::model::box<bg::model::point<CoordinateType, 2, bg::cs::cartesian>>& box, CoordinateType const& value) {
    bg::assign_min_corner(box, bg::model::point<CoordinateType, 2, bg::cs::cartesian>(value, value));
    bg::assign_max_corner(box, bg::model::point<CoordinateType, 2, bg::cs::cartesian>(value, value));
}

// Specialization for 3D boxes
template <typename CoordinateType>
void assign_values(bg::model::box<bg::model::point<CoordinateType, 3, bg::cs::cartesian>>& box, CoordinateType const& value) {
    bg::assign_min_corner(box, bg::model::point<CoordinateType, 3, bg::cs::cartesian>(value, value, value));
    bg::assign_max_corner(box, bg::model::point<CoordinateType, 3, bg::cs::cartesian>(value, value, value));
}

int main() {
    // Example usage
    bg::model::point<double, 2, bg::cs::cartesian> point;
    assign_values(point, 1.0);
    std::cout << "Point (2D): (" << bg::get<0>(point) << ", " << bg::get<1>(point) << ")" << std::endl;

    bg::model::point<double, 3, bg::cs::cartesian> point3d;
    assign_values(point3d, 2.0);
    std::cout << "Point (3D): (" << bg::get<0>(point3d) << ", " << bg::get<1>(point3d) << ", " << bg::get<2>(point3d) << ")" << std::endl;

    bg::model::box<bg::model::point<double, 2, bg::cs::cartesian>> box;
    assign_values(box, 3.0);
    std::cout << "Box (2D): Min(" << bg::get<0>(bg::min_corner(box)) << ", " << bg::get<1>(bg::min_corner(box)) << "), Max(" 
              << bg::get<0>(bg::max_corner(box)) << ", " << bg::get<1>(bg::max_corner(box)) << ")" << std::endl;

    bg::model::box<bg::model::point<double, 3, bg::cs::cartesian>> box3d;
    assign_values(box3d, 4.0);
    std::cout << "Box (3D): Min(" << bg::get<0>(bg::min_corner(box3d)) << ", " << bg::get<1>(bg::min_corner(box3d)) << ", " 
              << bg::get<2>(bg::min_corner(box3d)) << "), Max(" 
              << bg::get<0>(bg::max_corner(box3d)) << ", " << bg::get<1>(bg::max_corner(box3d)) << ", " 
              << bg::get<2>(bg::max_corner(box3d)) << ")" << std::endl;

    return 0;
}
