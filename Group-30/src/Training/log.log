```python
from collections import deque, defaultdict
import sys

# Global variables
N = 0
V = defaultdict(list)
visited = [0] * 100010
path = []
ans = []
ans2 = []

def longest(v):
    global visited, V, path
    queue = deque([v])
    visited[v] = 1
    farthest_node = v
    
    while queue:
        current = queue.popleft()
        for neighbor in V[current]:
            if not visited[neighbor]:
                visited[neighbor] = visited[current] + 1
                queue.append(neighbor)
                if visited[neighbor] > visited[farthest_node]:
                    farthest_node = neighbor
                    
    return farthest_node

def find_diameter():
    global N, V, path
    start = longest(1)
    end = longest(start)
    
    # Find the path from start to end
    visited = [False] * 100010
    stack = [end]
    while stack:
        current = stack[-1]
        if current == start:
            path.extend(reversed(stack))
            break
        for neighbor in V[current]:
            if not visited[neighbor]:
                visited[neighbor] = True
                stack.append(neighbor)
                break
        else:
            stack.pop()

def assign_numbers():
    global ans, ans2, path
    n = len(path)
    mid = n // 2
    
    # Assign numbers for the first scheme
    for i in range(n):
        if i <= mid:
            ans.append(mid - i + 1)
        else:
            ans.append(i - mid)
    
    # Assign numbers for the second scheme
    for i in range(n):
        if i <= mid:
            ans2.append(mid - i + 1)
        else:
            ans2.append(i - mid)

def main():
    global N, V
    input = sys.stdin.read
    data = input().split()
    
    index = 0
    N = int(data[index])
    index += 1
    
    for _ in range(N - 1):
        u = int(data[index]) - 1
        v = int(data[index + 1]) - 1
        V[u].append(v)
        V[v].append(u)
        index += 2
    
    find_diameter()
    assign_numbers()
    
    print(" ".join(map(str, ans)))
    print(" ".join(map(str, ans2)))

if __name__ == "__main__":
    main()
```

This Python code implements the described functionality, including reading input, performing BFS to find the diameter of the tree, constructing the path along the diameter, and assigning numbers to the nodes based on their positions relative to this path. The code follows idiomatic Python conventions and uses standard naming practices.
