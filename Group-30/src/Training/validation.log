#include <ArduinoJson.h>

template <typename TImpl>
class VariantCasts {
public:
    // Constructor is implicitly defined

    /**
     * Casts the variant to a boolean value.
     * @return The boolean representation of the variant.
     */
    bool asBool() const {
        return static_cast<const TImpl*>(this)->as<bool>();
    }

    /**
     * Casts the variant to a long integer value.
     * @return The long integer representation of the variant.
     */
    long asLong() const {
        return static_cast<const TImpl*>(this)->as<long>();
    }

    /**
     * Casts the variant to a double value.
     * @return The double representation of the variant.
     */
    double asDouble() const {
        return static_cast<const TImpl*>(this)->as<double>();
    }

    /**
     * Casts the variant to a string value.
     * @return The string representation of the variant.
     */
    String asString() const {
        return static_cast<const TImpl*>(this)->as<String>();
    }
};
```

This code defines the `VariantCasts` class template with methods to cast a variant object to different data types (boolean, long, double, and string). The actual casting logic is delegated to the implementation class `TImpl`, which must inherit from `VariantCasts` and implement the necessary type conversion methods.
