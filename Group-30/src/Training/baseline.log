```python
class BoletoHTML:
    def __init__(self, width=750, width_canhoto=0, font_size_title=9, height_line=27, font_size_value=12, title="Boleto bancário"):
        self.width = width
        self.width_canhoto = width_canhoto
        self.font_size_title = font_size_title
        self.height_line = height_line
        self.font_size_value = font_size_value
        self.title = title
        self.content = []

    def add_header(self, text):
        # Add header content to the boleto
        self.content.append(f'<div style="font-size: {self.font_size_title}px;">{text}</div>')

    def add_body(self, text):
        # Add body content to the boleto
        self.content.append(f'<div style="font-size: {self.font_size_value}px;">{text}</div>')

    def add_footer(self, text):
        # Add footer content to the boleto
        self.content.append(f'<div style="font-size: {self.font_size_value}px;">{text}</div>')

    def add_page_break(self):
        # Add a page break to the boleto
        self.content.append('<div style="page-break-after: always;"></div>')

    def save_to_file(self, filename):
        # Save the generated HTML content to a file
        with open(filename, 'w') as file:
            file.write('<html><head><title>{}</title></head><body>'.format(self.title))
            file.write('\n'.join(self.content))
            file.write('</body></html>')
```

This code defines a `BoletoHTML` class with the specified fields and methods. The class allows for adding headers, bodies, footers, and page breaks to the boleto, and saving the generated HTML content to a file. The default values for the fields are provided as specified in the documentation.
