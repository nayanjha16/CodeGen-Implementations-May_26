```cpp
#include <iostream>
#include <thread>
#include <functional>
#include <chrono>
#include <unordered_map>
#include <mutex>
#include <condition_variable>

namespace carla {
    namespace rpc {

        template<typename Request, typename Response>
        using SyncHandler = std::function<Response(Request)>;

        template<typename Request, typename Response>
        using AsyncHandler = std::function<void(Response)>;

        class Server {
        public:
            explicit Server(int port);

            template<typename Request, typename Response>
            void BindSync(const std::string& name, SyncHandler<Request, Response> func);

            void AsyncRun(size_t num_threads);
            void SyncRunFor(std::chrono::milliseconds duration);

        private:
            int _port;
            std::unordered_map<std::string, std::pair<SyncHandler<void, void>, AsyncHandler<void, void>>> _handlers;
            std::vector<std::thread> _threads;
            std::mutex _mutex;
            std::condition_variable _cv;
            bool _running;
        };

        template<typename Request, typename Response>
        void Server::BindSync(const std::string& name, SyncHandler<Request, Response> func) {
            std::lock_guard<std::mutex> lock(_mutex);
            _handlers[name] = {std::bind(func, std::placeholders::_1), nullptr};
        }

        void Server::AsyncRun(size_t num_threads) {
            _running = true;
            for (size_t i = 0; i < num_threads; ++i) {
                _threads.emplace_back([this]() {
                    while (_running) {
                        std::unique_lock<std::mutex> lock(_mutex);
                        _cv.wait(lock, [this]() { return !_handlers.empty(); });
                        auto handler = std::move(_handlers.begin()->second.first);
                        _handlers.erase(_handlers.begin());
                        lock.unlock();

                        if (handler) {
                            // Simulate processing time
                            std::this_thread::sleep_for(std::chrono::milliseconds(10));
                            handler(nullptr); // Assuming no response needed for simplicity
                        }
                    }
                });
            }
        }

        void Server::SyncRunFor(std::chrono::milliseconds duration) {
            _running = true;
            auto end_time = std::chrono::steady_clock::now() + duration;
            while (std::chrono::steady_clock::now() < end_time) {
                std::unique_lock<std::mutex> lock(_mutex);
                _cv.wait_until(lock, end_time, [this]() { return !_handlers.empty(); });
                auto handler = std::move(_handlers.begin()->second.first);
                _handlers.erase(_handlers.begin());
                lock.unlock();

                if (handler) {
                    // Simulate processing time
                    std::this_thread::sleep_for(std::chrono::milliseconds(10));
                    handler(nullptr); // Assuming no response needed for simplicity
                }
            }
            _running = false;
            for (auto& thread : _threads) {
                if (thread.joinable()) {
                    thread.join();
                }
            }
        }

        Server::Server(int port) : _port(port), _running(false) {}

    } // namespace rpc
} // namespace carla
```

This code defines a `Server` class within the `carla::rpc` namespace that handles both synchronous and asynchronous RPC requests. The `BindSync` method allows binding synchronous handlers to specific names, while `AsyncRun` and `SyncRunFor` manage the execution of these handlers in asynchronous and synchronous modes, respectively.
