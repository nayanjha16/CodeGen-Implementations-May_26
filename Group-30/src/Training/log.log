```cpp
#include <base/files/file_path.h>
#include <base/files/file_util.h>
#include <vector>

// Define the CopyOverWriteOption enum
enum class CopyOverWriteOption {
    kOverwrite,
    kSkip,
    kBackup
};

// Define the CopyTreeWorkItem class
class CopyTreeWorkItem {
public:
    // Constructor
    CopyTreeWorkItem(const base::FilePath& source_path, const base::FilePath& dest_path, CopyOverWriteOption overwrite_option)
        : source_path_(source_path), dest_path_(dest_path), temp_dir_(base::GenerateUniqueTempDir()), overwrite_option_(overwrite_option) {}

    // Destructor
    ~CopyTreeWorkItem() {
        if (temp_dir_.IsValid()) {
            base::DeletePathRecursively(temp_dir_);
        }
    }

    // Method to perform the copy operation
    bool Copy() {
        if (!base::DirectoryExists(source_path_)) {
            return false; // Source does not exist
        }

        if (base::DirectoryExists(dest_path_)) {
            switch (overwrite_option_) {
                case CopyOverWriteOption::kOverwrite:
                    break;
                case CopyOverWriteOption::kSkip:
                    return true; // Skip if already exists
                case CopyOverWriteOption::kBackup:
                    if (!CreateBackup()) {
                        return false;
                    }
                    break;
            }
        }

        return CopyDirectory(source_path_, dest_path_);
    }

private:
    base::FilePath source_path_;
    base::FilePath dest_path_;
    base::FilePath temp_dir_;
    CopyOverWriteOption overwrite_option_;

    // Helper method to create a backup of the destination directory
    bool CreateBackup() {
        if (!base::Move(dest_path_, temp_dir_)) {
            return false;
        }
        return true;
    }

    // Helper method to recursively copy a directory
    bool CopyDirectory(const base::FilePath& src_dir, const base::FilePath& dst_dir) {
        if (!base::CreateDirectory(dst_dir)) {
            return false;
        }

        std::vector<base::FilePath> entries;
        if (!base::ReadDirectory(src_dir, &entries)) {
            return false;
        }

        for (const auto& entry : entries) {
            base::FilePath src_entry = src_dir.Append(entry);
            base::FilePath dst_entry = dst_dir.Append(entry);

            if (base::IsDirectory(src_entry)) {
                if (!CopyDirectory(src_entry, dst_entry)) {
                    return false;
                }
            } else {
                if (!base::CopyFile(src_entry, dst_entry)) {
                    return false;
                }
            }
        }

        return true;
    }
};
```

This code defines the `CopyTreeWorkItem` class with the specified fields and methods. The `Copy` method handles the copying logic based on the `overwrite_option_`. The `CreateBackup` and `CopyDirectory` helper methods are used to manage the backup and recursive copying of directories, respectively.
