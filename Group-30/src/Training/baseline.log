Status ImportGraphDefToMlir(const FunctionDefLibrary& flib_def, const DebugInfo& debug_info,
                           const GraphImportConfig& specs, mlir::ModuleOp module,
                           std::unordered_map<std::string, std::string>* tf_name_to_mlir_name) {
    std::unordered_set<std::pair<string, int>> outputs;
    for (const auto& output : specs.outputs) {
        outputs.insert({output.first, output.second});
    }
    llvm::sort(outputs.begin(), outputs.end(),
              [](const auto& lhs, const auto& rhs) {
                  return lhs.first.size() < rhs.first || lhs.first > rhs.first;
              });

    NameUniquifier function_name_uniquifier(flib_def);
    GraphDefImporter importer(flib_def, debug_info, specs, module, tf_name_to_mlir_name,
                              &function_name_uniquifier);

    TF_RETURN_IF_ERROR(importer.PrepareConvert(graphdef));

    auto fn_names = graphdef.library().function_names();
    for (const auto& fn_name : fn_names) {
        TF_RETURN_IF_ERROR(importer.ConvertLibFunction(fn_name));
    }

    return Status::OK();
}

}  // namespace tensorflow
