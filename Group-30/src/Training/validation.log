        assert isinstance(self.oblate_spheroid, oblate)
        assert np.isclose(self.oblate_spheroid.a, self.a)
        assert np.isclose(self.oblate_spheroid.f, self.f)
        assert np.isclose(self.oblate_spheroid.b, self.a * (1 - self.f))

    def test_volume_calculation(self):
        # Test volume calculation of the oblate spheroid
        expected_volume = (4/3) * np.pi * self.a**2 * (self.a * (1 - self.f))
        calculated_volume = self.oblate_spheroid.volume()
        assert np.isclose(calculated_volume, expected_volume)

    def test_surface_area_calculation(self):
        # Test surface area calculation of the oblate spheroid
        e_squared = self.f * (2 - self.f)
        expected_surface_area = 2 * np.pi * self.a**2 * (1 + (e_squared / 3))
        calculated_surface_area = self.oblate_spheroid.surface_area()
        assert np.isclose(calculated_surface_area, expected_surface_area)

if __name__ == "__main__":
    pytest.main()
```

