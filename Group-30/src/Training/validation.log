import time
import json
from robolink import Robolink, ItemTypes

# Global Variables and Standalone Functions

AxesOptimSettings = {
    "active": True,
    "algorithm_type": "Gradient Descent",
    "iteration_limits": 1000,
    "tolerance": 0.001,
    "absolute_joint_references": [0, 0, 0],
    "weights": [1, 1, 1],
    "relative_motion_settings": {"max_speed": 100, "acceleration": 50}
}

ToUpdate = {}

def pause(seconds):
    """
    Pauses the execution of the script for a specified duration.

    Parameters:
    - seconds (float): Number of seconds to pause execution.

    Returns:
    - None
    """
    time.sleep(seconds)

# Classes and Structs

class Robolink:
    def __init__(self):
        self.link = Robolink()

    def get_item(self, name, item_type=ItemTypes.Robot):
        return self.link.Item(name, item_type)

    def set_value(self, key, value):
        setattr(self, key, value)

    def get_value(self, key):
        return getattr(self, key)

# Functions and Methods

def main():
    # Create an instance of Robolink
    rl = Robolink()
    
    # Select a robot arm from the RoboDK interface
    robot_name = input("Enter the name of the robot arm: ")
    robot = rl.get_item(robot_name)
    
    if not robot:
        print(f"Robot '{robot_name}' not found.")
        return
    
    # Update axes optimization settings
    update_axes_optim_settings(rl, robot)
    
    # Read and display updated axes optimization settings
    current_settings = rl.get_value("AxesOptimSettings")
    print("Updated Axes Optimization Settings:")
    print(json.dumps(current_settings, indent=4))

def update_axes_optim_settings(rl, robot):
    global ToUpdate
    
    # Pause for user input
    pause(2)
    
    # Prompt user for new settings
    print("Current Axes Optimization Settings:")
    print(json.dumps(AxesOptimSettings, indent=4))
    
    for key, value in AxesOptimSettings.items():
        new_value = input(f"Enter new value for {key} ({value}): ") or str(value)
        try:
            ToUpdate[key] = eval(new_value)  # Evaluate the input to convert it to the appropriate type
        except Exception as e:
            print(f"Invalid input for {key}. Using default value.")
            ToUpdate[key] = value
    
    # Apply updates to the axes optimization settings
    rl.set_value("AxesOptimSettings", {**AxesOptimSettings, **ToUpdate})
    ToUpdate.clear()

if __name__ == "__main__":
    main()
```

This Python script uses the RoboDK API to interact with a robot arm, allowing users to update and read the axes optimization settings through a JSON string representation. The script includes a `Robolink` class to provide access to RoboDK functionalities, a `main` function to orchestrate the process, and helper functions to pause execution and update settings.
