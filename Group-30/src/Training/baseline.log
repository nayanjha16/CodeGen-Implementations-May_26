# Program 1: Checking Armstrong Numbers

def is_armstrong_number(n):
    # Calculate the hundreds, tens, and units digits
    i = n // 100
    j = (n // 10) % 10
    k = n % 10
    
    # Check if the number is an Armstrong number
    return n == i**3 + j**3 + k**3

def check_armstrong_numbers(start, end):
    # Loop through the range from start to end
    for n in range(start, end + 1):
        if is_armstrong_number(n):
            print(n)

# Example usage
check_armstrong_numbers(400, 500)
```

