from setuptools import setup, find_packages

# Global Variables
NAME = "pysyrenn"
PACKAGES = ["syrenn_proto", "pysyrenn", "pysyrenn.frontend", "pysyrenn.helpers"]
META_PATH = "__metadata__.py"
