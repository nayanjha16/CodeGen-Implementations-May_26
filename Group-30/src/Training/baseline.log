#include "CLI_ARGS_HPP"
#include <iostream>
#include <vector>
#include <algorithm>
#include <cctype>

void parse_cli_args(int argc, char* argv[], cli_args& args) {
    std::vector<std::string> tokens;
    for (int i = 1; i < argc; ++i) {
        tokens.push_back(std::string(argv[i]));
    }

    auto it = tokens.begin();
    while (it != tokens.end()) {
        if (*it == "--network" || *it == "-n") {
            if (++it != tokens.end()) {
                args.net = *it++;
            } else {
                std::cerr << "Error: Missing value for --network option." << std::endl;
                exit(1);
            }
        } else if (*it == "--units" || *it == "-u") {
            if (++it != tokens.end()) {
                args.units = std::stoi(*it++);
            } else {
                std::cerr << "Error: Missing value for --units option." << std::endl;
                exit(1);
            }
        } else if (*it == "--generic-dijkstra" || *it == "-g") {
            args.gd = true;
        } else if (*it == "--brute-force" || *it == "-b") {
            args.bf = true;
        } else if (*it == "--edge-exclusion" || *it == "-e") {
            args.ee = true;
        } else if (*it == "--mean-client-arrival-time" || *it == "-mcat") {
            if (++it != tokens.end()) {
                args.mcat = std::stod(*it++);
            } else {
                std::cerr << "Error: Missing value for --mean-client-arrival-time option." << std::endl;
                exit(1);
            }
        } else if (*it == "--offered-load" || *it == "-ol") {
            if (++it != tokens.end()) {
                args.ol = std::stod(*it++);
            } else {
                std::cerr << "Error: Missing value for --offered-load option." << std::endl;
                exit(1);
            }
        } else if (*it == "--mean-holding-time" || *it == "-mht") {
            if (++it != tokens.end()) {
                args.mht = std::stod(*it++);
            } else {
                std::cerr << "Error: Missing value for --mean-holding-time option." << std::endl;
                exit(1);
            }
        } else if (*it == "--mean-number-of-units" || *it == "-mnu") {
            if (++it != tokens.end()) {
                args.mnu = std::stod(*it++);
            } else {
                std::cerr << "Error: Missing value for --mean-number-of-units option." << std::endl;
                exit(1);
            }
        } else if (*it == "--verbose" || *it == "-v") {
            args.verbose = true;
        } else if (*it == "--seed" || *it == "-s") {
            if (++it != tokens.end()) {
                args.seed = std::stoi(*it++);
            } else {
                std::cerr << "Error: Missing value for --seed option." << std::endl;
                exit(1);
            }
        } else {
            std::cerr << "Error: Unknown option: " << *it << std::endl;
            exit(1);
        }
    }
}
