import threading
import time
import requests
from map_download.cmd.BaseDownloader import BaseDownloaderThread

class TerrainDownloaderThread(BaseDownloaderThread):
    URL = "https://api.terraindata.com/download"

    def __init__(self, tile_id, output_dir, token=None):
        super().__init__()
        self.tile_id = tile_id
        self.output_dir = output_dir
        self.token = token

    def run(self):
        try:
            access_token = get_access_token(self.token)
            if not access_token:
                print(f"Failed to obtain access token for tile {self.tile_id}")
                return

            download_url = f"{self.URL}/{self.tile_id}"
            headers = {
                "Authorization": f"Bearer {access_token}"
            }
            response = requests.get(download_url, headers=headers)

            if response.status_code == 200:
                file_path = f"{self.output_dir}/tile_{self.tile_id}.dat"
                with open(file_path, 'wb') as file:
                    file.write(response.content)
                print(f"Downloaded tile {self.tile_id} to {file_path}")
            else:
                print(f"Failed to download tile {self.tile_id}, status code: {response.status_code}")

        except Exception as e:
            print(f"Error downloading tile {self.tile_id}: {e}")

def get_access_token(token):
    max_retries = 4
    retry_delay = 2

    for attempt in range(max_retries + 1):
        try:
            response = requests.get("https://api.terraindata.com/token", params={"initial_token": token})
            if response.status_code == 200:
                return response.json().get("access_token")
            elif response.status_code == 429:
                print("Rate limit exceeded, retrying...")
                time.sleep(retry_delay * (2 ** attempt))
            else:
                print(f"Failed to retrieve access token, status code: {response.status_code}")
                break
        except requests.RequestException as e:
            print(f"Request exception: {e}")
            break

    return None
```

This code defines a `TerrainDownloaderThread` class that inherits from `BaseDownloaderThread`. It includes a `run` method to perform the download task. The `get_access_token` function handles obtaining an access token with retries for rate limiting.
