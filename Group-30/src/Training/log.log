class Solution:
    def finalPrices(self, prices):
        """
        :type prices: List[int]
        :rtype: List[int]
        """
        n = len(prices)
        result = []
        
        for i in range(n):
            discount_found = False
            for j in range(i + 1, n):
                if prices[j] <= prices[i]:
                    result.append(prices[i] - prices[j])
                    discount_found = True
                    break
            if not discount_found:
                result.append(prices[i])
        
        return result
```

