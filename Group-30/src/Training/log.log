from eoxserver.services.ows.wps.parameters import LiteralData, ComplexData, BoundingBoxData
from eoxserver.services.ows.wps.v10.util import AllowedAny, AllowedEnum, AllowedRange, AllowedRangeCollection, AllowedByReference
from xml.etree.ElementTree import Element, SubElement, tostring

def encode_input_descr(prm):
    """
    Encodes a process description input parameter into an XML element.
    
    Parameters:
    - prm: A parameter object which can be either LiteralData, ComplexData, or BoundingBoxData
    
    Returns:
    - An XML element representing the encoded parameter
    """
    if isinstance(prm, LiteralData):
        return _encode_literal_data(prm)
    elif isinstance(prm, ComplexData):
        return _encode_complex_data(prm)
    elif isinstance(prm, BoundingBoxData):
        return _encode_bounding_box_data(prm)
    else:
        raise ValueError("Unsupported parameter type")

def _encode_literal_data(literal_data):
    """
    Encodes a LiteralData parameter into an XML element.
    
    Parameters:
    - literal_data: A LiteralData object
    
    Returns:
    - An XML element representing the encoded LiteralData parameter
    """
    element = Element('Input')
    sub_element = SubElement(element, 'Identifier')
    sub_element.text = literal_data.identifier
    
    if literal_data.title:
        sub_element = SubElement(element, 'Title')
        sub_element.text = literal_data.title
    
    if literal_data.abstract:
        sub_element = SubElement(element, 'Abstract')
        sub_element.text = literal_data.abstract
    
    data_type = SubElement(element, 'DataType')
    data_type.text = literal_data.data_type
    
    if literal_data.uom:
        uom = SubElement(data_type, 'UOM')
        uom.text = literal_data.uom
    
    if literal_data.allowed_values:
        allowed_values = SubElement(element, 'AllowedValues')
        for value in literal_data.allowed_values:
            sub_element = SubElement(allowed_values, 'Value')
            sub_element.text = str(value)
    
    return element

def _encode_complex_data(complex_data):
    """
    Encodes a ComplexData parameter into an XML element.
    
    Parameters:
    - complex_data: A ComplexData object
    
    Returns:
    - An XML element representing the encoded ComplexData parameter
    """
    element = Element('Input')
    sub_element = SubElement(element, 'Identifier')
    sub_element.text = complex_data.identifier
    
    if complex_data.title:
        sub_element = SubElement(element, 'Title')
        sub_element.text = complex_data.title
    
    if complex_data.abstract:
        sub_element = SubElement(element, 'Abstract')
        sub_element.text = complex_data.abstract
    
    schema = SubElement(element, 'Schema')
    schema.text = complex_data.schema
    
    encoding = SubElement(element, 'Encoding')
    encoding.text = complex_data.encoding
    
    mime_type = SubElement(element, 'MimeType')
    mime_type.text = complex_data.mime_type
    
    if complex_data.allowed_formats:
        allowed_formats = SubElement(element, 'AllowedFormats')
        for format in complex_data.allowed_formats:
            sub_element = SubElement(allowed_formats, 'Format')
            sub_element.text = format
    
    return element

def _encode_bounding_box_data(bounding_box_data):
    """
    Encodes a BoundingBoxData parameter into an XML element.
    
    Parameters:
    - bounding_box_data: A BoundingBoxData object
    
    Returns:
    - An XML element representing the encoded BoundingBoxData parameter
    """
    element = Element('Input')
    sub_element = SubElement(element, 'Identifier')
    sub_element.text = bounding_box_data.identifier
    
    if bounding_box_data.title:
        sub_element = SubElement(element, 'Title')
        sub_element.text = bounding_box_data.title
    
    if bounding_box_data.abstract:
        sub_element = SubElement(element, 'Abstract')
        sub_element.text = bounding_box_data.abstract
    
    crs = SubElement(element, 'CRS')
    crs.text = bounding_box_data.crs
    
    lower_corner = SubElement(element, 'LowerCorner')
    lower_corner.text = f"{bounding_box_data.lower_corner[0]} {bounding_box_data.lower_corner[1]}"
    
    upper_corner = SubElement(element, 'UpperCorner')
    upper_corner.text = f"{bounding_box_data.upper_corner[0]} {bounding_box_data.upper_corner[1]}"
    
    return element
```

This code defines the required classes and functions to encode different types of parameters into XML elements for a Web Processing Service (WPS) version 1.0. Each function handles the specific encoding logic for `LiteralData`, `ComplexData`, and `BoundingBoxData`.
