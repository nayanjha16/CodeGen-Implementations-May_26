                  | expression MINUS expression
                  | expression TIMES expression
                  | expression DIVIDE expression'''
    if p[2] == '+':
        p[0] = TreeNode(data=p[1], input_type='int', isLvalue=False, children=[p[1], p[3]], TAC=f"{p[1]} + {p[3]}")
