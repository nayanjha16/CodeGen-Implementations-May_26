#include <iostream>
#include <vector>

// Define the DENSE_STORAGE struct
struct DENSE_STORAGE {
    int dim;          // Number of dimensions in the matrix
    std::vector<int> shape;  // Array of sizes for each dimension
    std::string dtype;      // Data type of the matrix elements (e.g., "int", "float", "complex")
    std::vector<int> offset;   // Offset for each dimension
    std::vector<int> stride;   // Stride for each dimension
    size_t count;         // Total number of elements in the matrix
    void* src;            // Pointer to the original storage (used for slicing)
    double* elements;     // Pointer to the matrix elements

    // Constructor for creating a dummy storage object without allocating memory for elements
    DENSE_STORAGE(std::string dtype, const std::vector<int>& shape, int dim)
        : dim(dim), shape(shape), dtype(dtype), offset(dim, 0), stride(dim, 1), count(1) {
        for (int i = dim - 1; i >= 0; --i) {
            if (i != dim - 1) {
                stride[i] = stride[i + 1] * shape[i + 1];
            }
            count *= shape[i];
        }
    }

    // Destructor
    ~DENSE_STORAGE() {
        delete[] elements;
    }

    // Method to allocate memory for elements
    void allocate_elements() {
        elements = new double[count];
    }

    // Method to set the value at a specific index
    void set(int index, double value) {
        if (index >= 0 && index < count) {
            elements[index] = value;
        } else {
            throw std::out_of_range("Index out of range");
        }
    }

    // Method to get the value at a specific index
    double get(int index) const {
        if (index >= 0 && index < count) {
            return elements[index];
        } else {
            throw std::out_of_range("Index out of range");
        }
    }
};

// Function to create a dummy storage object without allocating memory for elements
DENSE_STORAGE nm_dense_storage_create_dummy(const std::string& dtype, const std::vector<int>& shape, int dim) {
    return DENSE_STORAGE(dtype, shape, dim);
}

int main() {
    // Example usage
    std::vector<int> shape = {2, 3};
    DENSE_STORAGE matrix = nm_dense_storage_create_dummy("double", shape, 2);
    matrix.allocate_elements();

    // Set values
    matrix.set(0, 1.0);
    matrix.set(1, 2.0);
    matrix.set(2, 3.0);
    matrix.set(3, 4.0);
    matrix.set(4, 5.0);
    matrix.set(5, 6.0);

    // Get values
    std::cout << "Element at index 0: " << matrix.get(0) << std::endl;
    std::cout << "Element at index 1: " << matrix.get(1) << std::endl;
    std::cout << "Element at index 2: " << matrix.get(2) << std::endl;
    std::cout << "Element at index 3: " << matrix.get(3) << std::endl;
    std::cout << "Element at index 4: " << matrix.get(4) << std::endl;
    std::cout << "Element at index 5: " << matrix.get(5) << std::endl;

    return 0;
}
```

