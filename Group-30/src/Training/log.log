#include <iostream>
#include <string>
#include <vector>
#include <map>

// Forward declaration of godot_variant if it's not defined elsewhere
typedef void* godot_variant;

class Variant {
private:
    godot_variant _godot_variant; // Private field to hold the internal variant data

public:
    // Default constructor initializing with a nil value
    Variant() : _godot_variant(nullptr) {}

    // Copy constructor
    Variant(const Variant &v) {
        // Assuming there's a function to copy godot_variant
        _godot_variant = godot_variant_copy(v._godot_variant);
    }

    // Destructor to handle cleanup
    ~Variant() {
        if (_godot_variant != nullptr) {
            godot_variant_free(_godot_variant);
        }
    }

