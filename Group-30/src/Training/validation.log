```python
import time
from ioexpander import IOExpander
from colorama import Fore, Style, init
init(autoreset=True)

class Logger:
    def __init__(self):
        self.log_level = "INFO"

    def log(self, message, level="INFO"):
        if level == self.log_level:
            print(f"{level}: {message}")

class Potentiometer:
    def __init__(self, i2c_addr, pin_red, pin_green, pin_blue, pot_enc_a, pot_enc_b):
        self._log = Logger()
        self._i2c_addr = i2c_addr
        self._pin_red = pin_red
        self._pin_green = pin_green
        self._pin_blue = pin_blue
        self._pot_enc_a = pot_enc_a
        self._pot_enc_b = pot_enc_b
        self.io_expander = IOExpander(i2c_addr)
        self.scale_factor = 255 / (self.io_expander.read_analog(pot_enc_a) - self.io_expander.read_analog(pot_enc_b))

    def update_rgb_led(self):
        pot_value = self.io_expander.read_analog(self._pot_enc_a)
        scaled_value = int((pot_value - self.io_expander.read_analog(self._pot_enc_b)) * self.scale_factor)
        
        red = min(max(scaled_value, 0), 255)
        green = min(max(scaled_value, 0), 255)
        blue = min(max(scaled_value, 0), 255)
        
        self.io_expander.set_digital_output(self._pin_red, red)
        self.io_expander.set_digital_output(self._pin_green, green)
        self.io_expander.set_digital_output(self._pin_blue, blue)
        
        self._log.log(f"RGB LED set to ({red}, {green}, {blue})")

# Example usage
if __name__ == "__main__":
    potentiometer = Potentiometer(0x20, 0, 1, 2, 3, 4)
    try:
        while True:
            potentiometer.update_rgb_led()
            time.sleep(0.1)
    except KeyboardInterrupt:
        pass
```

### Explanation:
1. **Logger Class**:
   - A simple logger class that can log messages at different levels.
   
2. **Potentiometer Class**:
   - Initializes with the I2C address and GPIO pins for the RGB LED and potentiometer.
   - Calculates a scaling factor based on the minimum and maximum values read from the potentiometer.
   - Updates the RGB LED's color based on the potentiometer's current position.

3. **Example Usage**:
   - Demonstrates how to create an instance of `Potentiometer` and continuously update the RGB LED based on the potentiometer's position.
