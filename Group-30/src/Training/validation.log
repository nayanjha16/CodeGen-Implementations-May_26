```python
import numpy as np
import pandas as pd
from scipy.stats import mode

# Global variable
path = 'loan_data.csv'

def load_dataset(file_path):
    """Load the dataset from a CSV file."""
    return pd.read_csv(file_path)

def separate_variables(dataframe):
    """Separate the dataset into categorical and numerical variables."""
    categorical_vars = dataframe.select_dtypes(include=['object', 'category']).columns.tolist()
    numerical_vars = dataframe.select_dtypes(include=[np.number]).columns.tolist()
    return categorical_vars, numerical_vars

def handle_missing_values(dataframe, strategy='mean'):
    """Handle missing values in the dataset."""
    if strategy == 'mean':
        return dataframe.fillna(dataframe.mean())
    elif strategy == 'mode':
        return dataframe.fillna(dataframe.mode().iloc[0])
    else:
        raise ValueError("Unsupported strategy for handling missing values")

def calculate_averages(dataframe, columns):
    """Calculate the average values for specified columns."""
    return dataframe[columns].mean()

def count_approvals_by_employment_status(dataframe, approval_column, employment_column):
    """Count approvals based on employment status."""
    return dataframe.groupby(employment_column)[approval_column].sum()

def convert_loan_terms(dataframe, term_column, new_term_column):
    """Convert loan terms to a standardized format."""
    dataframe[new_term_column] = dataframe[term_column].apply(lambda x: int(x.strip(' months')))
    return dataframe

def group_data(dataframe, group_columns, agg_column, agg_function='mean'):
    """Group data by specified columns and aggregate another column."""
    return dataframe.groupby(group_columns)[agg_column].agg(agg_function).reset_index()

def compute_mean_values(dataframe, columns):
    """Compute mean values for specified columns."""
    return dataframe[columns].mean()

# Main block of code
if __name__ == "__main__":
    # Load the dataset
    bank = load_dataset(path)
    
    # Separate the dataset into categorical and numerical variables
    categorical_vars, numerical_vars = separate_variables(bank)
    
    # Handle missing values
    bank = handle_missing_values(bank, strategy='mean')
    
    # Calculate averages
    avg_income = calculate_averages(bank, ['annual_income'])
    print(f"Average Annual Income: {avg_income}")
    
    # Count approvals based on employment status
    approvals_by_employment = count_approvals_by_employment_status(bank, 'approved', 'employment_status')
    print(f"Approvals by Employment Status:\n{approvals_by_employment}")
    
    # Convert loan terms
    bank = convert_loan_terms(bank, 'loan_term', 'loan_term_months')
    
    # Group data
    grouped_data = group_data(bank, ['employment_status'], 'loan_amount', 'sum')
    print(f"Sum of Loan Amounts by Employment Status:\n{grouped_data}")
    
    # Compute mean values
    mean_loan_amount = compute_mean_values(bank, ['loan_amount'])
    print(f"Mean Loan Amount: {mean_loan_amount}")
```
