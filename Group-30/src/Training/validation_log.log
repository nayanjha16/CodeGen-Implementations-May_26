import torch
from torch import nn
from transformers import BertConfig, BertTokenizer, BertModel

class ModalEmbeddings(nn.Module):
    def __init__(self, config):
        super(ModalEmbeddings, self).__init__()
        self.config = config
        self.encoder = BertModel.from_pretrained('bert-base-uncased')
        self.proj_embeddings = nn.Linear(config.hidden_size, config.embedding_dim)
        self.position_embeddings = nn.Embedding(config.max_position_embeddings, config.embedding_dim)
        self.token_type_embeddings = nn.Embedding(2, config.embedding_dim)
        self.word_embeddings = nn.Embedding(config.vocab_size, config.embedding_dim)
        self.LayerNorm = nn.LayerNorm(config.embedding_dim, eps=config.layer_norm_eps)
        self.dropout = nn.Dropout(config.hidden_dropout_prob)

    def forward(self, input_ids=None, position_ids=None, token_type_ids=None, inputs_embeds=None):
        if input_ids is not None:
            seq_length = input_ids.size(1)
        else:
            seq_length = inputs_embeds.size(1)

        if position_ids is None:
            position_ids = torch.arange(seq_length, dtype=torch.long, device=input_ids.device).unsqueeze(0).expand_as(input_ids)

        if token_type_ids is None:
            token_type_ids = torch.zeros_like(input_ids)

        if inputs_embeds is None:
            inputs_embeds = self.word_embeddings(input_ids)

        projected_embeddings = self.proj_embeddings(inputs_embeds)
        position_embeddings = self.position_embeddings(position_ids)
        token_type_embeddings = self.token_type_embeddings(token_type_ids)

        embeddings = projected_embeddings + position_embeddings + token_type_embeddings
        embeddings = self.LayerNorm(embeddings)
        embeddings = self.dropout(embeddings)

        return embeddings

class MMBTForClassification(nn.Module):
    def __init__(self, config):
        super(MMBTForClassification, self).__init__()
        self.modal_embeddings = ModalEmbeddings(config)
        self.classifier = nn.Linear(config.embedding_dim, config.num_labels)

    def forward(self, image_input_ids=None, image_token_type_ids=None, image_attention_mask=None,
                text_input_ids=None, text_token_type_ids=None, text_attention_mask=None):
        image_embeddings = self.modal_embeddings(image_input_ids, token_type_ids=image_token_type_ids, attention_mask=image_attention_mask)
        text_embeddings = self.modal_embeddings(text_input_ids, token_type_ids=text_token_type_ids, attention_mask=text_attention_mask)

        # Concatenate image and text embeddings
        combined_embeddings = torch.cat((image_embeddings, text_embeddings), dim=1)

        # Pass through classifier
        logits = self.classifier(combined_embeddings)

        return logits

# Example usage
config = BertConfig()
model = MMBTForClassification(config)

# Dummy data
image_input_ids = torch.randint(0, config.vocab_size, (1, 10))
image_token_type_ids = torch.zeros_like(image_input_ids)
image_attention_mask = torch.ones_like(image_input_ids)

text_input_ids = torch.randint(0, config.vocab_size, (1, 10))
text_token_type_ids = torch.zeros_like(text_input_ids)
text_attention_mask = torch.ones_like(text_input_ids)

output = model(image_input_ids, image_token_type_ids, image_attention_mask, 
               text_input_ids, text_token_type_ids, text_attention_mask)
print(output)
```

