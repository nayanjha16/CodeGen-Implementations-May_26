import os
import torch

def save_model(net, optim, scheduler, recorder, is_best=False):
    """
    Purpose: Saves the current state of a neural network along with its optimizer, scheduler, and training recorder to a file.

    Parameters:
    - net: The neural network model to save.
    - optim: The optimizer associated with the model.
    - scheduler: The learning rate scheduler.
    - recorder: An object containing information about the training process, such as the working directory and current epoch.
    - is_best (optional): A boolean indicating whether this checkpoint is the best so far. If True, it saves the model as "best.pth"; otherwise, it saves it as the current epoch number.
    """
    # Construct the path to the checkpoint directory
    model_dir = os.path.join(recorder.working_dir, 'checkpoints')
    
    # Create the checkpoint directory if it doesn't exist
    if not os.path.exists(model_dir):
        os.makedirs(model_dir)
    
    # Define the filename based on whether it's the best model or not
    if is_best:
        filename = 'best.pth'
    else:
        filename = f'epoch_{recorder.current_epoch}.pth'
    
    # Construct the full path to the checkpoint file
    filepath = os.path.join(model_dir, filename)
    
    # Save the model, optimizer, scheduler, and recorder to the file
    torch.save({
        'model_state_dict': net.state_dict(),
        'optimizer_state_dict': optim.state_dict(),
        'scheduler_state_dict': scheduler.state_dict(),
        'recorder': recorder.__dict__
    }, filepath)

class Recorder:
    def __init__(self, working_dir, current_epoch):
        self.working_dir = working_dir
        self.current_epoch = current_epoch
```

This code defines a function `save_model` that saves the state of a neural network along with its optimizer, scheduler, and training recorder to a file. It also includes a simple `Recorder` class to hold the necessary information about the training process.
