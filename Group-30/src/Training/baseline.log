import os
from rlpy.Domains import Domain
from rlpy.Tools import load_layout

class Pacman(Domain):
    def __init__(self, layout_file=None, noise=0.0, episode_cap=100):
        super().__init__()
        self._max_scared_time = 40
        self.actions = ["Stop", "North", "East", "South", "West"]
        self.actions_num = len(self.actions)
        self.episodeCap = episode_cap
        self.default_layout_dir = os.path.join(os.path.dirname(__file__), "layouts")
        self.noise = noise
        self.layoutFile = layout_file if layout_file else os.path.join(self.default_layout_dir, "mediumClassic.lay")

        # Initialize game state
        self.layout = load_layout(self.layoutFile)
        self.pacman_position = None
        self.ghost_positions = []
        self.capsules = []
        self.score = 0
        self.episode_step = 0

        self.reset()

    def reset(self):
        # Reset game state
        self.layout = load_layout(self.layoutFile)
        self.pacman_position = self.find_pacman()
        self.ghost_positions = self.find_ghosts()
        self.capsules = self.find_capsules()
        self.score = 0
        self.episode_step = 0
        return self.get_state()

    def find_pacman(self):
        # Find initial position of Pacman
        for y, row in enumerate(self.layout):
            for x, cell in enumerate(row):
                if cell == 'P':
                    return (x, y)
        raise ValueError("No Pacman found in the layout")

    def find_ghosts(self):
        # Find initial positions of ghosts
        ghosts = []
        for y, row in enumerate(self.layout):
            for x, cell in enumerate(row):
                if cell == 'G':
                    ghosts.append((x, y))
        return ghosts

    def find_capsules(self):
        # Find positions of capsules
        capsules = []
        for y, row in enumerate(self.layout):
            for x, cell in enumerate(row):
                if cell == '.':
                    capsules.append((x, y))
        return capsules

    def get_state(self):
        # Get current state of the environment
        return {
            "pacman_position": self.pacman_position,
            "ghost_positions": self.ghost_positions,
            "capsules": self.capsules,
            "score": self.score
        }

    def perform_action(self, action_index):
        # Perform the given action
        action = self.actions[action_index]
        if action == "Stop":
            pass
        elif action == "North":
            new_pos = (self.pacman_position[0], self.pacman_position[1] - 1)
        elif action == "East":
            new_pos = (self.pacman_position[0] + 1, self.pacman_position[1])
        elif action == "South":
            new_pos = (self.pacman_position[0], self.pacman_position[1] + 1)
        elif action == "West":
            new_pos = (self.pacman_position[0] - 1, self.pacman_position[1])

        # Apply noise
        if self.noise > 0 and np.random.rand() < self.noise:
            action = np.random.choice(self.actions)

        # Move Pacman
        if self.is_valid_move(new_pos):
            self.pacman_position = new_pos
            self.update_score_and_capsules()

        # Check for episode end
        if not self.capsules and self.episode_step >= self.episodeCap:
            return True

        self.episode_step += 1
        return False

    def is_valid_move(self, pos):
        # Check if the move is valid
        x, y = pos
        if x < 0 or x >= len(self.layout[0]) or y < 0 or y >= len(self.layout):
            return False
        if self.layout[y][x] == '%':  # Wall
            return False
        return True

    def update_score_and_capsules(self):
        # Update score and handle capsules
        x, y = self.pacman_position
        if (x, y) in self.capsules:
            self.score += 10
            self.capsules.remove((x, y))

    def get_reward(self):
        # Calculate reward based on current state
        if not self.capsules:
            return 100  # Win condition
        return -1  # Penalty for each step

    def is_terminal(self):
        # Check if the episode has ended
        return not self.capsules or self.episode_step >= self.episodeCap

    def visualize(self):
        # Visualize the current state of the environment
        print("Score:", self.score)
        for y, row in enumerate(self.layout):
            for x, cell in enumerate(row):
                if (x, y) == self.pacman_position:
                    print('P', end='')
                elif (x, y) in self.ghost_positions:
                    print('G', end='')
                elif (x, y) in self.capsules:
                    print('.', end='')
                else:
                    print(cell, end='')
            print()
```

This code defines a `Pacman` class that extends the `Domain` class from the RLPy framework. The class encapsulates the game logic, state management, and interaction with the agent. It includes methods for resetting the game state, finding the initial positions of Pacman, ghosts, and capsules, performing actions, checking for valid moves, updating the score and handling capsules, calculating rewards, checking for terminal states, and visualizing the current state of the environment.
