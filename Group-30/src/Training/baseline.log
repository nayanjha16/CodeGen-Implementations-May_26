// Class representing a summary of key statistics from the blockchain snapshot
class SnapshotSummary {
public:
    // Constructor
    SnapshotSummary(
        size_t numBalanceOwners,
        size_t numAssetBalances,
        size_t numVestingBalances,
        size_t numCanceledAsks,
        size_t numCanceledBids,
        size_t numCanceledShorts,
        size_t numAccountNames,
        size_t numWitnesses,
        size_t numWorkers,
