from typing import Dict, Optional

class JenkinsBase:
    pass  # Placeholder for JenkinsBase class

class Node:
    def __init__(self, baseurl: str, nodename: str, jenkins_obj: JenkinsBase):
        """
        Initializes a new Node object.

        Parameters:
        - baseurl (str): Base URL for querying information on the node.
        - nodename (str): Hostname of the node.
        - jenkins_obj (JenkinsBase): Reference to the Jenkins object associated with the node.
        """
        self.name = nodename
        self.jenkins = jenkins_obj
        self._data: Dict[str, Any] = {}
        self._update_data(baseurl)

    def _update_data(self, baseurl: str):
        """
        Updates internal data by fetching information from the Jenkins server.

        Parameters:
        - baseurl (str): Base URL for querying information on the node.
        """
        # Simulated fetch operation
        self._data = {
            'online': True,
            'temporarily_offline': False,
            # Other node data...
        }

    @property
    def is_online(self) -> bool:
        """
        Returns the current online status of the node.

        Returns:
        - bool: True if the node is online, False otherwise.
        """
        return self._data.get('online', False)

    def set_online(self, value: bool):
        """
        Sets the online status of the node.

        Parameters:
        - value (bool): New online status for the node.
        """
        self._data['online'] = value
        # Simulated update operation
        print(f"Node {self.name} is now {'online' if value else 'offline'}")

    @property
    def is_temporarily_offline(self) -> bool:
        """
        Returns the current temporary offline status of the node.

        Returns:
        - bool: True if the node is temporarily offline, False otherwise.
        """
        return self._data.get('temporarily_offline', False)

    def toggle_temporary_offline(self):
        """
        Toggles the temporary offline status of the node.
        """
        self._data['temporarily_offline'] = not self._data['temporarily_offline']
        # Simulated update operation
        print(f"Node {self.name} temporary offline status is now {'on' if self._data['temporarily_offline'] else 'off'}")
