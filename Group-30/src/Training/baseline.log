```python
import sys
from contextlib import contextmanager

class _stdchannel_redirected:
    def __init__(self, stdchannel=None, dest_filename=None, mode="w"):
        self.stdchannel = stdchannel
        self.dest_filename = dest_filename
        self.mode = mode
        self._original_stdchannel = None
        self._redirected_file = None

    @contextmanager
    def __call__(self):
        if self.stdchannel is None:
            yield None
            return
        
        # Save the original stdchannel
        self._original_stdchannel = getattr(sys, self.stdchannel.__name__)
        
        # Open the destination file
        self._redirected_file = open(self.dest_filename, self.mode)
        
        # Redirect the stdchannel
        setattr(sys, self.stdchannel.__name__, self._redirected_file)
        
        try:
            yield None
        finally:
            # Restore the original stdchannel
            setattr(sys, self.stdchannel.__name__, self._original_stdchannel)
            
            # Close the redirected file
            self._redirected_file.close()

class RedirectStdout(_stdchannel_redirected):
    def __init__(self, dest_filename=None, mode="w"):
        super().__init__(stdchannel=sys.stdout, dest_filename=dest_filename, mode=mode)

# Example usage:
if __name__ == "__main__":
    with RedirectStdout("output.txt"):
        print("This will be written to 'output.txt'")
    
    print("This will be printed to the console")
```

### Explanation:
1. **_stdchannel_redirected Class**:
   - **Fields**: 
     - `stdchannel`: The file-like object to redirect (e.g., `sys.stdout`).
     - `dest_filename`: The path to the file where the output should be written.
     - `mode`: The mode in which the destination file should be opened (default is "w" for write mode).
   - **Methods**:
     - `__init__`: Initializes the instance with the provided parameters.
     - `__call__`: A context manager that redirects the specified standard channel to the destination file and restores it after exiting the context.

2. **RedirectStdout Class**:
   - Inherits from `_stdchannel_redirected`.
   - Specifically handles the redirection of `stdout`.

### Usage:
The example demonstrates how to use the `RedirectStdout` context manager to redirect `stdout` to a file named "output.txt". After the block, the output is restored to the console.
