```python
import torch

def normalize(x, axis=-1):
    """
    Normalizes a tensor along a specified axis using L2 norm.

    Parameters:
    - x: A PyTorch tensor to be normalized.
    - axis: The axis along which to compute the L2 norm (default is -1).

    Return Value: A normalized tensor where each element is divided by its L2 norm along the specified axis.
    """
    # Compute the L2 norm of the input tensor x along the specified axis
    norm = torch.norm(x, dim=axis, keepdim=True)
    
    # Add a small constant to avoid division by zero
    eps = 1e-12
    norm += eps
    
    # Divide the original tensor by the computed norm to get the normalized tensor
    normalized_tensor = x / norm
    return normalized_tensor

def euclidean_dist(x, y):
    """
    Computes the Euclidean distance between two sets of tensors.

    Parameters:
    - x: A PyTorch tensor representing the first set of points.
    - y: A PyTorch tensor representing the second set of points.

    Return Value: A tensor containing the Euclidean distances between corresponding elements of x and y.
    """
    # Ensure that both tensors have the same shape
    assert x.shape == y.shape, "Input tensors must have the same shape"
    
    # Compute the squared difference between the two tensors
    diff = x - y
    squared_diff = diff ** 2
    
    # Sum the squared differences along the last dimension to get the Euclidean distance
    euclidean_distance = torch.sqrt(torch.sum(squared_diff, dim=-1))
    return euclidean_distance

def cosine_dist(x, y):
    """
    Computes the Cosine similarity between two sets of tensors.

    Parameters:
    - x: A PyTorch tensor representing the first set of points.
    - y: A PyTorch tensor representing the second set of points.

    Return Value: A tensor containing the Cosine similarities between corresponding elements of x and y.
    """
    # Ensure that both tensors have the same shape
    assert x.shape == y.shape, "Input tensors must have the same shape"
    
    # Normalize the tensors
    x_normalized = normalize(x)
    y_normalized = normalize(y)
    
    # Compute the dot product of the normalized tensors
    dot_product = torch.sum(x_normalized * y_normalized, dim=-1)
    
    # The cosine similarity is the dot product itself since the tensors are already normalized
    cosine_similarity = dot_product
    return cosine_similarity
```

This code includes the `normalize`, `euclidean_dist`, and `cosine_dist` functions as described in the documentation. Each function is implemented with clear parameter names and follows idiomatic Python conventions.
