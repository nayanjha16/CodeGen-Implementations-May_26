assistant
```python
import libindex

class NumericIndex:
    def __init__(self):
        self._typ = "numericindex"
        self._engine_type = None
        self._dtype_validation_metadata = None
        self._can_hold_na = False

class RangeIndex(NumericIndex):
    def __init__(self, start, stop, step=1):
        super().__init__()
        self._typ = "rangeindex"
        self._engine_type = libindex.Int64Engine
        self._dtype_validation_metadata = {"type": "signed integer"}
        self._can_hold_na = False
        self._range = range(start, stop, step)

    @property
    def start(self):
        return self._range.start

    @property
    def stop(self):
        return self._range.stop

    @property
    def step(self):
        return self._range.step

    def contains(self, value):
        return value in self._range

    def __add__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start + other, self.stop + other, self.step)
        elif isinstance(other, RangeIndex):
            if self.step == other.step:
                return RangeIndex(min(self.start, other.start), max(self.stop, other.stop), self.step)
            else:
                raise ValueError("Cannot add RangeIndexes with different steps")
        else:
            raise TypeError("Unsupported operand type for +")

    def __sub__(self, other):
        if isinstance(other, int):
            return RangeIndex(self.start - other, self.stop - other, self.step)
        elif isinstance(other, RangeIndex):
            if self.step == other.step:
                return RangeIndex(max(self.start, other.start), min(self.stop, other.stop), self.step)
            else:
                raise ValueError("Cannot subtract RangeIndexes with different steps")
        else:
            raise TypeError("Unsupported operand type for -")

    def __getitem__(self, key):
        return self._range[key]

    def __len__(self):
        return len(self._range)

    def __repr__(self):
        return f"RangeIndex({self.start}, {self.stop}, {self.step})"
```

This code defines the `RangeIndex` class, which inherits from `NumericIndex`. It includes properties for `start`, `stop`, and `step`, methods for containment checks (`contains`), arithmetic operations (`__add__`, `__sub__`), and slicing (`__getitem__`). The class also ensures that the index values are stored using a Python `range` object for efficient memory usage and computation.
