```python
import usocket
import ujson

class Response:
    def __init__(self, sock):
        self.sock = sock
        self.status_code = None
        self.headers = {}
        self.body = b''

    @property
    def content(self):
        return self.body

    @property
    def text(self):
        return self.body.decode('utf-8')

    def close(self):
        self.sock.close()

    def json(self):
        return ujson.loads(self.text)

def delete(url, **kwargs):
    return _request('DELETE', url, **kwargs)

def _request(method, url, **kwargs):
    parsed_url = urlparse(url)
    host = parsed_url.hostname
    port = parsed_url.port or (80 if parsed_url.scheme == 'http' else 443)
    path = parsed_url.path + ('?' + parsed_url.query if parsed_url.query else '')

    # Create socket
    s = usocket.socket(usocket.AF_INET, usocket.SOCK_STREAM)
    s.connect((host, port))

    # Build headers
    headers = {
        'Host': host,
        'Connection': 'close'
    }
    headers.update(kwargs.get('headers', {}))

    # Send request
    request = f"{method} {path} HTTP/1.1\r\n"
    request += "\r\n".join(f"{k}: {v}" for k, v in headers.items()) + "\r\n\r\n"
    s.sendall(request.encode('utf-8'))

    # Receive response
    response = s.recv(4096).decode('utf-8')
    lines = response.split('\r\n')
    status_line = lines[0]
    headers_lines = lines[1:-2]
    body = '\r\n'.join(lines[-2:])

    # Parse status line
    parts = status_line.split()
    if len(parts) != 3:
        raise ValueError("Invalid status line")
    status_code = int(parts[1])
    reason_phrase = parts[2]

    # Parse headers
    for header_line in headers_lines:
        key, value = header_line.split(': ', 1)
        headers[key] = value

    # Close socket
    s.close()

    # Return response object
    resp = Response(s)
    resp.status_code = status_code
    resp.headers = headers
    resp.body = body.encode('utf-8')
    return resp
```

This code defines the `Response` class and the `delete` function as described in the documentation. The `_request` function is a helper function used by both `get`, `post`, `put`, and `delete` to perform the actual HTTP request. Note that this implementation assumes the use of the `usocket` and `ujson` libraries, which are part of MicroPython.
