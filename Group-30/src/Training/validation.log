        text_surface = font.render(self.text, True, (255, 255, 255))
        text_rect = text_surface.get_rect(center=self.rect.center)
        surface.blit(text_surface, text_rect)

    def handle_event(self, event: pygame.event.Event):
        if event.type == pygame.MOUSEBUTTONDOWN:
            if self.rect.collidepoint(event.pos):
                if self.action:
                    self.action()

class App_window:
    def __init__(self, width: int, height: int):
        self.width = width
        self.height = height
        self.window = pygame.display.set_mode((width, height))

    def clear(self):
        self.window.fill((0, 0, 0))

    def update(self):
        pygame.display.flip()

class App:
    def __init__(self):
        pygame.init()
        self.clock = pygame.time.Clock()
        self.window = App_window(800, 600).window
        self.gameover = pygame.font.Font(None, 72)
        self.font = pygame.font.Font(None, 36)
        self.running = True
        self.state = "intro"
        self.intro_buttons = []
        self.playing_buttons = []
        self.gameover_buttons = []
        self.active_buttons = []
        self.app_window = App_window(800, 600)
        self.snake = None
        self.food = None

    def run(self):
        while self.running:
            self.handle_events()
            self.update()
            self.draw()

    def handle_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False
            elif event.type == pygame.KEYDOWN:
                if self.state == "play":
                    self.snake.move(event.key)
            elif event.type == pygame.MOUSEBUTTONDOWN:
                for button in self.active_buttons:
                    button.handle_event(event)

    def update(self):
        self.clock.tick(10)
        if self.state == "play":
            self.snake.update()
            if self.snake.check_collision(self.food):
                self.snake.grow()
                self.generate_food()

    def draw(self):
        self.app_window.clear()
        if self.state == "intro":
            self.draw_intro_screen()
        elif self.state == "play":
            self.draw_gameplay_screen()
        elif self.state == "dead":
            self.draw_game_over_screen()
        self.app_window.update()

    def draw_intro_screen(self):
        # Draw intro screen elements
        pass

    def draw_gameplay_screen(self):
