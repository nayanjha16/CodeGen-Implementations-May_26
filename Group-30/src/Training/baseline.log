#include <iostream>
#include <cmath>

// Constants
const long long INF = static_cast<long long>(1e18);
const double EPS = 1e-10;

// Macros
#define _USE_MATH_DEFINES
#define FOR(i, a, b) for (int i = a; i < b; ++i)
#define ROF(i, a, b) for (int i = b - 1; i >= a; --i)
#define FORE(a, x) for (auto &a : x)
#define eb emplace_back
#define mp make_pair

// Function to find the smallest number greater than or equal to 'a' that ends with exactly 'n' digits and is divisible by 'b'
long long findSmallestNumber(long long a, int n, long long b) {
    // Calculate the lower bound of the number
    long long lowerBound = std::pow(10, n - 1);
    
    // Adjust 'a' to be at least the lower bound
    if (a < lowerBound) {
        a = lowerBound;
    }
    
    // Find the smallest number greater than or equal to 'a' that ends with exactly 'n' digits
    while (true) {
        if ((a % 10) == 0 && a >= lowerBound) {
            break;
        }
        ++a;
    }
    
    // Check if the number is divisible by 'b'
    if (a % b == 0) {
        return a;
    } else {
        // If not, find the next number that meets the criteria
        long long nextMultiple = ((a / b) + 1) * b;
        if (nextMultiple >= lowerBound && (nextMultiple % 10) != 0) {
            return nextMultiple;
        }
    }
    
    // If no such number exists, return -1
    return -1;
}

int main() {
    // Example usage
    long long a = 123;
    int n = 3;
    long long b = 7;
    
    long long result = findSmallestNumber(a, n, b);
    std::cout << "Result: " << result << std::endl;
    
    return 0;
}
```

