                    f.write('test content')

            uploader.upload_gallery(files_to_upload)

            # Assuming the upload_gallery method calls subprocess.run to interact with AWS CLI
            subprocess_run.assert_called_once()

        finally:
            temp_dir.cleanup()

if __name__ == '__main__':
