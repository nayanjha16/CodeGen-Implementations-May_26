```cpp
#include <vector>
#include <cmath>

// Define necessary structures
struct Point {
    float x, y, z;
};

struct Spectrum {
    float r, g, b;
};

class CatmullRomCurve {
public:
    // Constructor
    CatmullRomCurve() {}

    // Add a point with its properties
    void addPoint(const Point& p, float size, const Spectrum& col) {
        points.push_back(p);
        sizes.push_back(size);
        cols.push_back(col);
    }

    // Evaluate the curve at a given parameter t (0 <= t <= 1)
    Point evaluate(float t) const {
        int n = points.size();
        if (n < 4) throw std::runtime_error("Not enough points to evaluate the curve");

        int i = static_cast<int>(t * (n - 3));
        t -= i / static_cast<float>(n - 3);

        Point p0 = points[i];
        Point p1 = points[(i + 1) % n];
        Point p2 = points[(i + 2) % n];
        Point p3 = points[(i + 3) % n];

        return catmullRomInterpolate(t, p0, p1, p2, p3);
    }

private:
    std::vector<Point> points;
    std::vector<float> sizes;
    std::vector<Spectrum> cols;

    // Catmull-Rom interpolation function
    Point catmullRomInterpolate(float t, const Point& p0, const Point& p1, const Point& p2, const Point& p3) const {
        float tt = t * t;
        float ttt = tt * t;

        Point result;
        result.x = 0.5f * (
            (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * ttt +
            (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * tt +
            (-p0.x + p2.x) * t +
            2 * p1.x
        );

        result.y = 0.5f * (
            (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * ttt +
            (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * tt +
            (-p0.y + p2.y) * t +
            2 * p1.y
        );

        result.z = 0.5f * (
            (-p0.z + 3 * p1.z - 3 * p2.z + p3.z) * ttt +
            (2 * p0.z - 5 * p1.z + 4 * p2.z - p3.z) * tt +
            (-p0.z + p2.z) * t +
            2 * p1.z
        );

        return result;
    }
};

