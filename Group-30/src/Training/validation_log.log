from abc import ABC, abstractmethod
from typing import Any, Dict, Tuple, Type

class BaseBeaconChainDB(ABC):
    @abstractmethod
    def get_block(self, block_root: bytes) -> Any:
        pass

    @abstractmethod
    def save_block(self, block: Any) -> None:
        pass

class StateMachine(ABC):
    @abstractmethod
    def process_block(self, block: Any) -> None:
        pass

class BeaconChain(ABC):
    chaindb_class = BaseBeaconChainDB

    def __init__(self, chaindb: BaseBeaconChainDB, sm_configuration: Tuple[Tuple[int, Type[StateMachine]]]):
        self.chaindb = chaindb
        self.sm_configuration = sm_configuration

    @abstractmethod
    def get_state_machine(self, slot: int) -> StateMachine:
        pass

    @abstractmethod
    def get_block_by_root(self, block_root: bytes) -> Any:
        pass

    @abstractmethod
    def create_block_from_parent(self, parent_block: Any) -> Any:
        pass

class ConcreteState(StateMachine):
    def process_block(self, block: Any) -> None:
        # Implementation of processing a block
        pass

class ConcreteBeaconChain(BeaconChain):
    def __init__(self, chaindb: BaseBeaconChainDB, sm_configuration: Tuple[Tuple[int, Type[ConcreteState]]]):
        super().__init__(chaindb, sm_configuration)

    def get_state_machine(self, slot: int) -> ConcreteState:
        for s, sm_class in self.sm_configuration:
            if s == slot:
                return sm_class()
        raise ValueError(f"No state machine found for slot {slot}")

    def get_block_by_root(self, block_root: bytes) -> Any:
        return self.chaindb.get_block(block_root)

    def create_block_from_parent(self, parent_block: Any) -> Any:
        # Implementation of creating a new block from a parent block
        pass
```

This code defines the `BaseBeaconChain`, `BaseBeaconChainDB`, `StateMachine`, and `BeaconChain` classes as per the provided documentation. The `ConcreteBeaconChain` class inherits from `BeaconChain` and implements the abstract methods. The `ConcreteState` class inherits from `StateMachine` and provides an implementation for the `process_block` method.
