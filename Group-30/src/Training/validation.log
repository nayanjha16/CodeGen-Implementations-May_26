```python
from abc import ABC, abstractmethod
from sqlalchemy.orm import aliased
from sqlalchemy.sql.expression import select, join
from typing import Any, List, Tuple, Type, Optional

class Loader(ABC):
    def __init__(self, model: Type, distinct: Optional[Tuple] = None, columns: Optional[List[str]] = None, extras: Optional[List['Loader']] = None, on_clause: Optional[Any] = None):
        self.model = model
        self._distinct = distinct
        self.columns = columns or []
        self.extras = extras or []
        self.on_clause = on_clause

    @abstractmethod
    def get(self, value: Any) -> 'Loader':
        pass

    def query(self) -> select:
        query = select(*self.columns)
        if self._distinct:
            query = query.distinct(*self._distinct)
        if self.extras:
            for extra in self.extras:
                query = query.join(extra.model, extra.on_clause)
        return query

    def do_load(self, session):
        query = self.query()
        result = session.execute(query).fetchall()
        return result

class ModelLoader(Loader):
    def get(self, value: Any) -> 'Loader':
        if isinstance(value, type):
            return ModelLoader(model=value)
        return super().get(value)

class AliasLoader(Loader):
    def get(self, value: Any) -> 'Loader':
        if isinstance(value, str):
            alias = aliased(self.model)
            return AliasLoader(model=alias, columns=[getattr(alias, col) for col in self.columns])
        return super().get(value)

class ColumnLoader(Loader):
    def get(self, value: Any) -> 'Loader':
        if isinstance(value, str):
            return ColumnLoader(model=self.model, columns=[getattr(self.model, value)])
        return super().get(value)

class TupleLoader(Loader):
    def get(self, value: Any) -> 'Loader':
        if isinstance(value, tuple):
            return TupleLoader(model=self.model, columns=value)
        return super().get(value)

class CallableLoader(Loader):
    def get(self, value: Any) -> 'Loader':
        if callable(value):
            return CallableLoader(model=self.model, columns=[value])
        return super().get(value)

class ValueLoader(Loader):
    def get(self, value: Any) -> 'Loader':
        if isinstance(value, Any):
            return ValueLoader(model=self.model, columns=[value])
        return super().get(value)
```

This code defines a base class `Loader` and several subclasses that implement specific behaviors for loading data based on the type of input provided. Each subclass overrides the `get` method to create the appropriate loader instance based on the input type. The `query` method constructs a SQLAlchemy query object based on the loader's configuration, and the `do_load` method executes the query using a given session.
