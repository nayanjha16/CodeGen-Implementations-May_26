```cpp
#include <iostream>
#include <vector>
#include <string>
#include <fstream>
#include <cmath>

// Forward declarations
class MultiVarTransferFunctionWindow;
enum class PointType { Color, Opacity };

struct ColorPoint {
    float value;
    float r, g, b;
};

struct OpacityPoint {
    float value;
    float alpha;
};

class GuiVarData {
public:
    MultiVarTransferFunctionWindow* window;
    std::array<float, 256> transferFunctionMap_sRGB;
    std::array<float, 256> transferFunctionMap_linearRGB;
    std::vector<ColorPoint> colorPoints;
    std::vector<OpacityPoint> opacityPoints;
    PointType selectedPointType;
    int currentSelectionIndex;

    std::string attributeName;

    GuiVarData(MultiVarTransferFunctionWindow* w) : window(w), selectedPointType(PointType::Color), currentSelectionIndex(-1) {}

    void addColorPoint(float value, float r, float g, float b) {
        colorPoints.push_back({value, r, g, b});
        updateTransferFunctionMaps();
    }

    void addOpacityPoint(float value, float alpha) {
        opacityPoints.push_back({value, alpha});
        updateTransferFunctionMaps();
    }

    void removeSelectedPoint() {
        if (selectedPointType == PointType::Color && currentSelectionIndex >= 0 && currentSelectionIndex < colorPoints.size()) {
            colorPoints.erase(colorPoints.begin() + currentSelectionIndex);
        } else if (selectedPointType == PointType::Opacity && currentSelectionIndex >= 0 && currentSelectionIndex < opacityPoints.size()) {
            opacityPoints.erase(opacityPoints.begin() + currentSelectionIndex);
        }
        updateTransferFunctionMaps();
    }

    void selectPoint(int index, PointType type) {
        selectedPointType = type;
        currentSelectionIndex = index;
    }

    void updateTransferFunctionMaps() {
        // Clear existing transfer function maps
        std::fill(transferFunctionMap_sRGB.begin(), transferFunctionMap_sRGB.end(), 0.0f);
        std::fill(transferFunctionMap_linearRGB.begin(), transferFunctionMap_linearRGB.end(), 0.0f);

        // Update transfer function maps based on color and opacity points
        for (const auto& point : colorPoints) {
            int index = static_cast<int>(point.value * 255.0f);
            transferFunctionMap_sRGB[index] = point.r;
            transferFunctionMap_linearRGB[index] = pow(point.r, 2.2f);
        }

        for (const auto& point : opacityPoints) {
            int index = static_cast<int>(point.value * 255.0f);
            transferFunctionMap_sRGB[index] = point.alpha;
            transferFunctionMap_linearRGB[index] = point.alpha;
        }
    }

    void saveToXML(const std::string& filename) const {
        std::ofstream file(filename);
        if (!file.is_open()) {
            std::cerr << "Failed to open file for writing: " << filename << std::endl;
            return;
        }

        file << "<TransferFunction>" << std::endl;
        file << "  <AttributeName>" << attributeName << "</AttributeName>" << std::endl;
        file << "  <ColorPoints>" << std::endl;
        for (const auto& point : colorPoints) {
            file << "    <ColorPoint value=\"" << point.value << "\" r=\"" << point.r << "\" g=\"" << point.g << "\" b=\"" << point.b << "\" />" << std::endl;
        }
        file << "  </ColorPoints>" << std::endl;
        file << "  <OpacityPoints>" << std::endl;
        for (const auto& point : opacityPoints) {
            file << "    <OpacityPoint value=\"" << point.value << "\" alpha=\"" << point.alpha << "\" />" << std::endl;
        }
        file << "  </OpacityPoints>" << std::endl;
        file << "</TransferFunction>" << std::endl;

        file.close();
    }

    void loadFromXML(const std::string& filename) {
        std::ifstream file(filename);
        if (!file.is_open()) {
            std::cerr << "Failed to open file for reading: " << filename << std::endl;
            return;
        }

        std::string line;
        while (std::getline(file, line)) {
            if (line.find("<AttributeName>") != std::string::npos) {
                size_t start = line.find('>') + 1;
                size_t end = line.find('<', start);
                attributeName = line.substr(start, end - start);
            } else if (line.find("<ColorPoint") != std::string::npos) {
                float value, r, g, b;
                sscanf(line.c_str(), "<ColorPoint value=\"%f\" r=\"%f\" g=\"%f\" b=\"%f\" />", &value, &r, &g, &b);
                addColorPoint(value, r, g, b);
            } else if (line.find("<OpacityPoint") != std::string::npos) {
                float value, alpha;
                sscanf(line.c_str(), "<OpacityPoint value=\"%f\" alpha=\"%f\" />", &value, &alpha);
                addOpacityPoint(value, alpha);
            }
        }

        file.close();
    }
};
```

