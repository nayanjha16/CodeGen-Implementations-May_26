#include <vulkan/vulkan.h>
#include <unordered_map>

namespace reshade::vulkan {

    // Enumerations for API-specific formats
    enum class api {
        FORMAT_R8G8B8A8_UNORM,
        FORMAT_D32_SFLOAT_S8_UINT,
        // Add other formats as needed
    };

    // Enumerations for Vulkan-specific formats
    enum class VkFormat {
        VK_FORMAT_R8G8B8A8_UNORM,
        VK_FORMAT_D32_SFLOAT_S8_UINT,
        // Add other formats as needed
    };

    // Helper map to convert API formats to Vulkan formats
    static const std::unordered_map<api, VkFormat> format_mapping = {
        {api::FORMAT_R8G8B8A8_UNORM, VkFormat::VK_FORMAT_R8G8B8A8_UNORM},
        {api::FORMAT_D32_SFLOAT_S8_UINT, VkFormat::VK_FORMAT_D32_SFLOAT_S8_UINT}
        // Add other mappings as needed
    };

    // Class containing methods for converting Vulkan pipeline creation information
    class device_impl {
    public:
        // Method to convert pipeline creation information to a higher-level API representation
        void convert_pipeline_creation_info(const VkGraphicsPipelineCreateInfo& vk_create_info, api::pipeline_desc& api_desc) {
            // Convert input attachments
            for (const auto& attachment : vk_create_info.pInputAttachments) {
                api_desc.input_attachments.push_back(convert_input_attachment(attachment));
            }

            // Convert vertex bindings
            for (const auto& binding : vk_create_info.pVertexBindingDescriptions) {
                api_desc.vertex_bindings.push_back(convert_vertex_binding(binding));
            }

            // Convert vertex attributes
            for (const auto& attribute : vk_create_info.pVertexAttributeDescriptions) {
                api_desc.vertex_attributes.push_back(convert_vertex_attribute(attribute));
            }

            // Convert color blend state
            if (vk_create_info.pColorBlendState != nullptr) {
                api_desc.color_blend_state = convert_color_blend_state(*vk_create_info.pColorBlendState);
            }
        }

    private:
        // Helper method to convert input attachment
        api::input_attachment convert_input_attachment(const VkAttachmentReference& attachment) {
            return {static_cast<api::format>(attachment.format)};
        }

        // Helper method to convert vertex binding
        api::vertex_binding convert_vertex_binding(const VkVertexInputBindingDescription& binding) {
            return {binding.binding, binding.stride, static_cast<api::input_rate>(binding.inputRate)};
        }

        // Helper method to convert vertex attribute
        api::vertex_attribute convert_vertex_attribute(const VkVertexInputAttributeDescription& attribute) {
            return {attribute.location, attribute.binding, static_cast<api::format>(attribute.format), attribute.offset};
        }

        // Helper method to convert color blend state
        api::color_blend_state convert_color_blend_state(const VkPipelineColorBlendStateCreateInfo& blend_state) {
            api::color_blend_state result;
            result.logic_op_enable = blend_state.logicOpEnable;
            result.logic_op = static_cast<api::logic_op>(blend_state.logicOp);

            for (uint32_t i = 0; i < blend_state.attachmentCount; ++i) {
                result.attachments.push_back(convert_color_blend_attachment(blend_state.pAttachments[i]));
            }

            result.blend_constants[0] = blend_state.blendConstants[0];
            result.blend_constants[1] = blend_state.blendConstants[1];
            result.blend_constants[2] = blend_state.blendConstants[2];
            result.blend_constants[3] = blend_state.blendConstants[3];

            return result;
        }

        // Helper method to convert color blend attachment
        api::color_blend_attachment convert_color_blend_attachment(const VkPipelineColorBlendAttachmentState& attachment) {
            api::color_blend_attachment result;
            result.blend_enable = attachment.blendEnable;
            result.src_color_blend_factor = static_cast<api::blend_factor>(attachment.srcColorBlendFactor);
            result.dst_color_blend_factor = static_cast<api::blend_factor>(attachment.dstColorBlendFactor);
            result.color_blend_op = static_cast<api::blend_op>(attachment.colorBlendOp);
            result.src_alpha_blend_factor = static_cast<api::blend_factor>(attachment.srcAlphaBlendFactor);
            result.dst_alpha_blend_factor = static_cast<api::blend_factor>(attachment.dstAlphaBlendFactor);
            result.alpha_blend_op = static_cast<api::blend_op>(attachment.alphaBlendOp);
            result.color_write_mask = attachment.colorWriteMask;

            return result;
        }
    };

    // Function to convert a format from the API to its corresponding Vulkan format
    VkFormat convert_format(api::format format) {
        auto it = format_mapping.find(format);
        if (it != format_mapping.end()) {
            return it->second;
        } else {
            throw std::invalid_argument("Unsupported format");
        }
    }

} // namespace reshade::vulkan
```

