```python
import argparse
from torchvision import datasets, transforms
from torch.utils.data import DataLoader
import torch.nn.functional as F
import torch

class ImageNetInference:
    def __init__(self, model_path, batch_size=32):
        self.model_path = model_path
        self.batch_size = batch_size
        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        self.transform = transforms.Compose([
            transforms.Resize(256),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
        ])
        self.model = self.load_model()
        self.model.eval()

    def load_model(self):
        # Assuming the model architecture is ResNet50
        model = torch.hub.load('pytorch/vision:v0.10.0', 'resnet50', pretrained=False)
        state_dict = torch.load(self.model_path)
        model.load_state_dict(state_dict)
        return model.to(self.device)

    def load_dataset(self, root_dir):
        dataset = datasets.ImageFolder(root=root_dir, transform=self.transform)
        dataloader = DataLoader(dataset, batch_size=self.batch_size, shuffle=True)
        return dataloader

    def evaluate(self, dataloader):
        correct_top1 = 0
        correct_top5 = 0
        total_samples = 0

        with torch.no_grad():
            for inputs, labels in dataloader:
                inputs = inputs.to(self.device)
                labels = labels.to(self.device)

                outputs = self.model(inputs)
                _, predicted = outputs.max(1)
                total_samples += labels.size(0)
                correct_top1 += (predicted == labels).sum().item()

                _, top5_indices = outputs.topk(5, dim=1)
                correct_top5 += (top5_indices.t() == labels.view(-1, 1)).any(dim=1).sum().item()

        top1_accuracy = 100 * correct_top1 / total_samples
        top5_accuracy = 100 * correct_top5 / total_samples

        return top1_accuracy, top5_accuracy

def main():
    parser = argparse.ArgumentParser(description="ImageNet Inference Script")
    parser.add_argument('--model-path', type=str, required=True, help='Path to the pre-trained model')
    parser.add_argument('--data-root', type=str, required=True, help='Root directory of the ImageNet dataset')
    args = parser.parse_args()

    inference = ImageNetInference(model_path=args.model_path)
    dataloader = inference.load_dataset(args.data_root)
    top1_acc, top5_acc = inference.evaluate(dataloader)

    print(f'Top-1 Accuracy: {top1_acc:.2f}%')
    print(f'Top-5 Accuracy: {top5_acc:.2f}%')

if __name__ == "__main__":
    main()
```

This code defines a class `ImageNetInference` that handles the loading of a pre-trained model, dataset, and evaluation process. The `main` function uses `argparse` to parse command-line arguments and runs the inference script.
