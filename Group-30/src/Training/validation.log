```python
import unittest
from frappe import get_doc, db_get_value
from frappe.website.doctype.website_route_meta.website_route_meta import WebsiteRouteMeta

class TestWebsiteRouteMeta(unittest.TestCase):
    def test_meta_tag_generation(self):
        # Fetch a published blog post from the database
        blog_post_name = db_get_value("Blog Post", {"published": 1}, "name")
        if not blog_post_name:
            self.fail("No published blog post found")

        blog_post = get_doc("Blog Post", blog_post_name)

        # Create a new Website Route Meta document
        website_route_meta = WebsiteRouteMeta()
        website_route_meta.route = f"/blog/{blog_post.name}"
        website_route_meta.append("meta_tags", {
            "key": "og:type",
            "value": "article"
        })
        website_route_meta.append("meta_tags", {
            "key": "og:title",
            "value": blog_post.title
        })
        website_route_meta.save()

        # Set the request path to the blog post route and retrieve the response
        from frappe.test_runner import make_test_client
        client = make_test_client()
        response = client.get(f"/blog/{blog_post.name}")

        # Assert that the response status code is 200 and that the expected meta tags are present in the HTML response
        self.assertEqual(response.status_code, 200)
        self.assertIn('<meta property="og:type" content="article">', response.text)
        self.assertIn(f'<meta property="og:title" content="{blog_post.title}">', response.text)

if __name__ == '__main__':
    unittest.main()
```

This code defines a test class `TestWebsiteRouteMeta` with a single method `test_meta_tag_generation`. The method fetches a published blog post, creates a `WebsiteRouteMeta` document with the necessary meta tags, sets up a test client, makes a GET request to the blog post route, and asserts that the response status code is 200 and that the expected meta tags are present in the HTML response.
