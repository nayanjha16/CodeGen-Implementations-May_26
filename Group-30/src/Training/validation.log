```python
import time
from ioexpander import IOExpander
from colorama import Fore, Style, init
from lib.logger import Logger

class Potentiometer:
    def __init__(self, i2c_addr, pin_red, pin_green, pin_blue, pot_enc_a, pot_enc_b):
        self._log = Logger(__name__)
        self._i2c_addr = i2c_addr
        self._pin_red = pin_red
        self._pin_green = pin_green
        self._pin_blue = pin_blue
        self._pot_enc_a = pot_enc_a
        self._pot_enc_b = pot_enc_b
        
        self.io_expander = IOExpander(i2c_addr)
        init(autoreset=True)

    def read_potentiometer(self):
        # Read the raw value from the potentiometer
        raw_value = self.io_expander.analog_read(self._pot_enc_a)
        return raw_value

    def scale_value(self, raw_value, min_val=0, max_val=255):
        # Scale the raw value to the desired range
        scaled_value = int((raw_value / 1023) * (max_val - min_val))
        return scaled_value

    def map_to_rgb(self, scaled_value):
        # Map the scaled value to an RGB color
        red = scaled_value
        green = 255 - scaled_value
        blue = 0
        return red, green, blue

    def set_led_color(self, red, green, blue):
        # Set the RGB LED color
        self.io_expander.digital_write(self._pin_red, red)
        self.io_expander.digital_write(self._pin_green, green)
        self.io_expander.digital_write(self._pin_blue, blue)

    def run(self):
        try:
            while True:
                raw_value = self.read_potentiometer()
                scaled_value = self.scale_value(raw_value)
                rgb_values = self.map_to_rgb(scaled_value)
                self.set_led_color(*rgb_values)
                
                self._log.info(f"Raw Value: {raw_value}, Scaled Value: {scaled_value}, RGB: {rgb_values}")
                time.sleep(0.1)
        except KeyboardInterrupt:
            self._log.info("Exiting...")
            self.io_expander.close()

# Example usage
if __name__ == "__main__":
    potentiometer = Potentiometer(i2c_addr=0x20, pin_red=0, pin_green=1, pin_blue=2, pot_enc_a=3, pot_enc_b=4)
    potentiometer.run()
```

### Explanation:
- **Class `Potentiometer`**:
  - **Fields**:
    - `_log`: Instance of `Logger` for logging messages.
    - `_i2c_addr`: I2C address of the IO Expander board.
    - `_pin_red`, `_pin_green`, `_pin_blue`: GPIO pins connected to the RGB LED.
    - `_pot_enc_a`, `_pot_enc_b`: GPIO pins connected to the potentiometer encoder.
  - **Methods**:
    - `read_potentiometer()`: Reads the raw value from the potentiometer.
    - `scale_value(raw_value, min_val=0, max_val=255)`: Scales the raw value to a specified range.
    - `map_to_rgb(scaled_value)`: Maps the scaled value to an RGB color.
    - `set_led_color(red, green, blue)`: Sets the RGB LED color.
    - `run()`: Main loop that continuously reads the potentiometer, scales the value, maps it to an RGB color, and sets the LED color. Logs the values and handles keyboard interrupts gracefully.

### Dependencies:
- Ensure you have the `ioexpander`, `colorama`, and `lib.logger` libraries installed.
- You may need to adjust the I2C address and pin numbers according to your specific setup.
