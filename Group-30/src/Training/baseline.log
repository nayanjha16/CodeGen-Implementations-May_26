#include <iostream>
#include <systemc.h>

using namespace std;

// Function to represent the deepest level of the process hierarchy
void p3() {
    cout << sc_time_stamp() << " entering p3" << endl;
    wait(30, SC_NS);
    cout << sc_time_stamp() << " exiting p3" << endl;
}

// Function to spawn p3 and wait for 20 nanoseconds before exiting
void p2() {
    cout << sc_time_stamp() << " entering p2" << endl;
    sc_spawn(sc_bind(&p3));
    wait(20, SC_NS);
    cout << sc_time_stamp() << " exiting p2" << endl;
}

// Function to spawn p2 and wait for 10 nanoseconds before exiting
void p1() {
    cout << sc_time_stamp() << " entering p1" << endl;
    sc_spawn(sc_bind(&p2));
    wait(10, SC_NS);
    cout << sc_time_stamp() << " exiting p1" << endl;
}

// Main function to start the simulation
int sc_main(int argc, char* argv[]) {
    cout << sc_time_stamp() << " starting simulation" << endl;
    sc_spawn(sc_bind(&p1));
    wait(50, SC_NS); // Let the simulation run for 50 nanoseconds
    cout << sc_time_stamp() << " simulation finished" << endl;
    return 0;
}
```

This code defines four functions `p3`, `p2`, `p1`, and `sc_main`. Each function represents a process in the hierarchy and prints timestamps indicating when it enters and exits. The `sc_main` function starts the simulation and runs for 50 nanoseconds. The `sc_spawn` function is used to create new processes.
