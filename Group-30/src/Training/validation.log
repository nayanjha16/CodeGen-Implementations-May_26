#include <iostream>
#include <vector>
#include <queue>

class DataBuffer {
public:
    std::queue<int> buffer;

    void push(int data) {
        buffer.push(data);
    }

    int pop() {
        if (!buffer.empty()) {
            int data = buffer.front();
            buffer.pop();
            return data;
        }
        throw std::runtime_error("Buffer is empty");
    }

    bool isEmpty() const {
        return buffer.empty();
    }
};

class PipelineStage {
public:
    virtual ~PipelineStage() {}
    virtual void process(DataBuffer& input, DataBuffer& output) = 0;
};

class StageA : public PipelineStage {
public:
    void process(DataBuffer& input, DataBuffer& output) override {
        while (!input.isEmpty()) {
            int data = input.pop();
            // Perform some operation (e.g., increment)
            data++;
            output.push(data);
        }
    }
};

class StageB : public PipelineStage {
public:
    void process(DataBuffer& input, DataBuffer& output) override {
        while (!input.isEmpty()) {
            int data = input.pop();
            // Perform some operation (e.g., square)
            data *= data;
            output.push(data);
        }
    }
};

void compute(
    std::ostream& to_chan_0_bank_0,
    std::ostream& to_chan_0_bank_1,
    std::ostream& to_chan_0_bank_2,
    std::ostream& to_chan_0_bank_3,
    std::istream& from_chan_0_bank_0,
    std::istream& from_chan_0_bank_1,
    std::istream& from_chan_0_bank_2,
    std::istream& from_chan_0_bank_3,
    int coalesced_data_num,
    int tile_data_num,
    int tile_num_dim_0,
    int input_size_dim
) {
    DataBuffer buffer0, buffer1, buffer2, buffer3;

    std::vector<PipelineStage*> stages = {new StageA(), new StageB()};

    for (int epoch = 0; epoch < coalesced_data_num; ++epoch) {
        // Read data from inputs
        for (int i = 0; i < 4; ++i) {
            int data;
            from_chan_0_bank_0 >> data;
            buffer0.push(data);
        }

        // Process data through stages
        for (auto stage : stages) {
            stage->process(buffer0, buffer1);
            buffer0 = buffer1;
            buffer1.clear();
        }

        // Write data to outputs
        for (int i = 0; i < 4; ++i) {
            int data = buffer0.pop();
            to_chan_0_bank_0 << data << " ";
        }
        to_chan_0_bank_0 << std::endl;
    }

    // Clean up
    for (auto stage : stages) {
        delete stage;
    }
}

int main() {
    std::istringstream from_chan_0_bank_0("1 2 3 4");
    std::ostringstream to_chan_0_bank_0;

    compute(to_chan_0_bank_0, std::cout, std::cout, std::cout, from_chan_0_bank_0, std::cin, std::cin, std::cin, 1, 0, 0, 0);

    std::cout << to_chan_0_bank_0.str(); // Output should be "2 4 6 8"

    return 0;
}
```

