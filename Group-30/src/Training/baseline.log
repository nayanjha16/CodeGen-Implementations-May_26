from oslo_config import cfg

# Define the configuration group
hyperv_opt_group = cfg.OptGroup(name='hyperv',
                                title='Hyper-V Configuration',
                                help='Settings specific to the Hyper-V feature in an OpenStack environment')

# Define the configuration options
hyperv_opts = [
    cfg.FloatOpt('dynamic_memory_ratio',
                 default=1.0,
                 min=0.1,
                 max=10.0,
                 help='Controls whether dynamic memory allocation (ballooning) is enabled and sets the ratio of total RAM assigned to an instance compared to its startup RAM.'),
    cfg.BoolOpt('enable_instance_metrics_collection',
                default=True,
                help='Determines whether to collect metrics for instances using Hyper-V\'s metric APIs.'),
    cfg.StrOpt('instances_path_share',
               default='\\\\target_host\\share',
               help='Specifies a Windows share used by the resize feature to copy files to the target host.'),
    cfg.IntOpt('limit_cpu',
               default=None,
               min=1,
               help='Limits the number of CPUs allocated to an instance.')
]

# Register the configuration group and options
CONF = cfg.CONF
CONF.register_group(hyperv_opt_group)
CONF.register_opts(hyperv_opts, group=hyperv_opt_group)

# Example usage
if __name__ == "__main__":
    CONF(sys.argv[1:])
    print(f'Dynamic Memory Ratio: {CONF.hyperv.dynamic_memory_ratio}')
    print(f'Enable Instance Metrics Collection: {CONF.hyperv.enable_instance_metrics_collection}')
    print(f'Instances Path Share: {CONF.hyperv.instances_path_share}')
    print(f'Limit CPU: {CONF.hyperv.limit_cpu}')
