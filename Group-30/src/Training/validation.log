```python
from flask import Flask, render_template, redirect, request, session, jsonify
from functools import wraps

class AuthDecorator:
    def __init__(self, app, excluded_resources_endpoints=()):
        self.app = app
        self.excluded_resources_endpoints = excluded_resources_endpoints
        
        # Add authentication endpoints
        self.add_login_route()
        self.add_logout_route()
        
        # Decorate other routes with authentication check
        for rule in self.app.url_map.iter_rules():
            if rule.endpoint not in self.excluded_resources_endpoints:
                self.app.view_functions[rule.endpoint] = self.auth_required(self.app.view_functions[rule.endpoint])
    
    def add_login_route(self):
        @self.app.route('/login', methods=['GET'])
        def login():
            if 'username' in session:
                return redirect('/')
            else:
                return render_template('login.html')
    
    def add_logout_route(self):
        @self.app.route('/logout', methods=['POST'])
        def logout():
            session.pop('username', None)
            return redirect('/')
    
    def auth_required(self, func):
        @wraps(func)
        def decorated_function(*args, **kwargs):
            if 'username' not in session:
                return jsonify({'error': 'Unauthorized'}), 401
            return func(*args, **kwargs)
        return decorated_function

# Example usage
if __name__ == '__main__':
    app = Flask(__name__)
    app.secret_key = 'your_secret_key'
    
    @AuthDecorator(app, excluded_resources_endpoints=('login',))
    @app.route('/')
    def home():
        return f"Hello, {session.get('username', 'Guest')}!"
    
    @app.route('/dashboard')
    def dashboard():
        return "Welcome to the Dashboard!"
    
    app.run(debug=True)
```

This code defines an `AuthDecorator` class that adds login, logout, and authentication endpoints to a Flask application. It also decorates other endpoints to ensure they require valid authentication before being accessed. The `login` and `logout` methods handle the respective requests, while the `auth_required` method ensures that only authenticated users can access protected routes.
