#include <iostream>
#include <vector>

class BasicBlock {
public:
    std::vector<int> instructions; // Simplified representation of instructions as integers
};

class InstructionWalker {
private:
    BasicBlock* basicBlock;
    std::vector<int>::iterator pos;

public:
    // Constructor
    InstructionWalker(BasicBlock* block, std::vector<int>::iterator initialPos)
        : basicBlock(block), pos(initialPos) {}

    // Get the current basic block
    BasicBlock* getBasicBlock() const {
        return basicBlock;
    }

    // Move to the next instruction within the current block
    void nextInBlock() {
        if (pos != basicBlock->instructions.end()) {
            ++pos;
        }
    }

    // Move to the previous instruction within the current block
    void previousInBlock() {
        if (pos != basicBlock->instructions.begin()) {
            --pos;
        }
    }

    // Move to the next instruction within the method, handling block boundaries
    void nextInMethod() {
        if (pos != basicBlock->instructions.end()) {
            ++pos;
        } else {
            // Assuming there's a method to get the next block
            BasicBlock* nextBlock = getNextBlock();
            if (nextBlock != nullptr) {
                pos = nextBlock->instructions.begin();
            }
        }
    }

    // Move to the previous instruction within the method, handling block boundaries
    void previousInMethod() {
        if (pos != basicBlock->instructions.begin()) {
            --pos;
        } else {
            // Assuming there's a method to get the previous block
            BasicBlock* prevBlock = getPreviousBlock();
            if (prevBlock != nullptr) {
                pos = prevBlock->instructions.end() - 1;
            }
        }
    }

