```python
from pytorch_lightning.plugins.environments.cluster_environment import ClusterEnvironment

class SLURMEnvironment(ClusterEnvironment):
    def creates_processes_externally(self) -> bool:
        """
        Indicates whether the processes are created externally by the environment.
        
        Returns:
            bool: True
        """
        return True

    def detect(self) -> bool:
        """
        Detects if the current process was launched on a SLURM cluster.
        
        Returns:
            bool: True if the environment variable 'SLURM_NTASKS' is set, False otherwise.
        """
        import os
        return 'SLURM_NTASKS' in os.environ

    def master_address(self) -> str:
        """
        Retrieves the main address for communication.
        
        Returns:
            str: The value of the environment variable 'SLURM_NODEID'.
        """
        import os
        return os.environ.get('SLURM_NODEID', '')

    def master_port(self) -> int:
        """
        Retrieves the main port for communication.
        
        Returns:
            int: The value of the environment variable 'SLURM_PORT', converted to an integer.
        """
        import os
        return int(os.environ.get('SLURM_PORT', 0))

    def world_size(self) -> int:
        """
        Retrieves the total number of processes across all nodes.
        
        Returns:
            int: The value of the environment variable 'SLURM_NTASKS', converted to an integer.
        """
        import os
        return int(os.environ.get('SLURM_NTASKS', 1))

    def global_rank(self) -> int:
        """
        Retrieves the global rank of the current process.
        
        Returns:
            int: The value of the environment variable 'SLURM_PROCID', converted to an integer.
        """
        import os
        return int(os.environ.get('SLURM_PROCID', 0))

    def local_rank(self) -> int:
        """
        Retrieves the local rank of the current process within its node.
        
        Returns:
            int: The value of the environment variable 'SLURM_LOCALID', converted to an integer.
        """
        import os
        return int(os.environ.get('SLURM_LOCALID', 0))

    def node_rank(self) -> int:
        """
        Retrieves the rank of the current node within the cluster.
        
        Returns:
            int: The value of the environment variable 'SLURM_NODEID', converted to an integer.
        """
        import os
        return int(os.environ.get('SLURM_NODEID', 0))
```

This code defines the `SLURMEnvironment` class as specified, inheriting from `ClusterEnvironment` and implementing the required methods to handle SLURM-specific environment details.
