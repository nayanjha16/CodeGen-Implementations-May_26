import subprocess

class PlexHttpHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        self.config = load_config()
        self.hdhr_station_scan = False
        self.rmg_station_scans = ['Idle'] * len(self.config['tuners'])
        self.local_locast = LocastService()
        self.location = get_location_data()
