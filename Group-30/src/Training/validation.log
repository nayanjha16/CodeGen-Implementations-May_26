#include <iostream>
#include <vector>
#include <queue>

using namespace std;

int N;
vector<vector<int>> V(100010);
vector<int> visited(100010), path, ans, ans2;

// Function to perform BFS and find the farthest node from the given start node
int longest(int v) {
    queue<int> q;
    q.push(v);
    visited[v] = 0;
    
    int farthestNode = -1;
    while (!q.empty()) {
        int u = q.front();
        q.pop();
        
        for (int neighbor : V[u]) {
            if (visited[neighbor] == -1) {
                visited[neighbor] = visited[u] + 1;
                q.push(neighbor);
                
                // Update the farthest node
                if (visited[neighbor] > visited[farthestNode]) {
                    farthestNode = neighbor;
                }
            }
        }
    }
    return farthestNode;
}

// Function to construct the path from the root to the farthest node
void getPath(int v, int target) {
    if (v == target) {
        path.push_back(v);
        return;
    }
    for (int neighbor : V[v]) {
        if (visited[neighbor] == visited[v] - 1) {
            getPath(neighbor, target);
            path.push_back(v);
            break;
        }
    }
}

// Function to assign numbering schemes based on the path
void assignNumbers() {
    int n = path.size();
    for (int i = 0; i < n; ++i) {
        ans[path[i]] = i + 1;
        ans2[path[n - 1 - i]] = n - i;
    }
}

int main() {
    cin >> N;
    for (int i = 1; i < N; ++i) {
        int u, v;
        cin >> u >> v;
        V[u].push_back(v);
        V[v].push_back(u);
    }

    // Find one end of the diameter
    int end1 = longest(1);
    // Find the other end of the diameter
    int end2 = longest(end1);

    // Clear visited array for reuse
    fill(visited.begin(), visited.end(), -1);

    // Construct the path from the root to the farthest node
    getPath(1, end2);

    // Assign numbering schemes
    assignNumbers();

    // Output the results
    for (int i = 1; i <= N; ++i) {
        cout << ans[i] << " ";
    }
    cout << endl;
    for (int i = 1; i <= N; ++i) {
        cout << ans2[i] << " ";
    }
    cout << endl;

    return 0;
}
```

