import pickle
import torch as t
import torch.nn as nn
import torch.nn.functional as F
import torchvision
import torchvision.datasets as datasets
import numpy as np
import matplotlib.pyplot as plt
import cProfile
import pandas as pd
import datetime
from scipy.sparse import csr_matrix
import os.path
import embedding_help_functions as ehf
import scipy.io as sio
unsq = t.unsqueeze
sq = t.squeeze

# Settings
alpha_vec = [0.75, 0.76, 0.77, 0.78]
data_location = 'path/to/bitcoin/data'
evaluation_criteria = ['Precision', 'Recall', 'F1-score', 'MAP', 'MRR']

class LinkPredictionModel(nn.Module):
    def __init__(self, num_features, hidden_size, num_classes):
        super(LinkPredictionModel, self).__init__()
        self.fc1 = nn.Linear(num_features, hidden_size)
        self.fc2 = nn.Linear(hidden_size, num_classes)

    def forward(self, x):
        x = F.relu(self.fc1(x))
        x = self.fc2(x)
        return x

def load_data(data_location):
    # Load preprocessed data
    with open(os.path.join(data_location, 'features.pkl'), 'rb') as f:
        features = pickle.load(f)
    with open(os.path.join(data_location, 'edges.pkl'), 'rb') as f:
        edges = pickle.load(f)
    return features, edges

def create_node_features(features):
    # Create node features tensor
    node_features = t.tensor(features, dtype=t.float32)
    return node_features

def augment_edges(edges):
    # Augment the edge set
    augmented_edges = []
    for u, v in edges:
        augmented_edges.extend([(u, v), (v, u)])
    return t.tensor(augmented_edges, dtype=t.long).t().contiguous()

def train_model(model, node_features, augmented_edges, epochs=100, lr=0.01):
    optimizer = t.optim.Adam(model.parameters(), lr=lr)
    criterion = nn.CrossEntropyLoss()
    
    for epoch in range(epochs):
        model.train()
        optimizer.zero_grad()
        outputs = model(node_features[augmented_edges[0]])
        loss = criterion(outputs, augmented_edges[1])
        loss.backward()
        optimizer.step()
        
        if (epoch+1) % 10 == 0:
            print(f'Epoch [{epoch+1}/{epochs}], Loss: {loss.item():.4f}')
    
    return model

def evaluate_model(model, node_features, test_edges, metric='Accuracy'):
    model.eval()
    with t.no_grad():
        outputs = model(node_features[test_edges[0]])
        predictions = t.argmax(outputs, dim=1)
        accuracy = (predictions == test_edges[1]).float().mean()
    
    return accuracy.item()

def main():
    features, edges = load_data(data_location)
    node_features = create_node_features(features)
    augmented_edges = augment_edges(edges)
    
    results = {}
    for alpha in alpha_vec:
        model = LinkPredictionModel(num_features=node_features.size(1), hidden_size=64, num_classes=2)
        trained_model = train_model(model, node_features, augmented_edges, epochs=100, lr=alpha)
        accuracy = evaluate_model(trained_model, node_features, augmented_edges, metric='Accuracy')
        results[alpha] = accuracy
    
    print("Evaluation Results:")
    for alpha, acc in results.items():
        print(f'Alpha: {alpha}, Accuracy: {acc:.4f}')

if __name__ == "__main__":
    main()
```

This code includes the `LinkPredictionModel` class for the GCN model, functions to load and process data, train the model, and evaluate its performance. The `main` function orchestrates the entire process, training multiple models with different learning rates (`alpha`) and evaluating their accuracy.
