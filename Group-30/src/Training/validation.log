#include <iostream>
#include <fstream>
#include <sstream>
#include <map>
#include <vector>
#include <regex>

class SatelliteGraph {
public:
    // Constructor
    SatelliteGraph() {}

    // Method to add an edge to the graph
    void addEdge(const std::string& center, const std::string& satellite) {
        graph[center].push_back(satellite);
    }

    // Method to calculate the sum of distances from COM to all other satellites
    int calculateTotalOrbits() const {
        return dfs("COM", 0);
    }

private:
    // Private member variable to store the graph
    std::map<std::string, std::vector<std::string>> graph;

    // Helper function to perform DFS and calculate the total orbits
    int dfs(const std::string& node, int distance) const {
        if (graph.find(node) == graph.end()) {
            return distance;
        }
        int total = distance;
        for (const auto& neighbor : graph.at(node)) {
            total += dfs(neighbor, distance + 1);
        }
        return total;
    }
};

// Function to parse the input stream and construct the satellite graph
SatelliteGraph map2graph(std::istream& map) {
    SatelliteGraph graph;
    std::string line;
    std::regex pattern(R"((\w+)\)\s*(\w+))");

    while (std::getline(map, line)) {
        std::smatch matches;
        if (std::regex_match(line, matches, pattern)) {
            std::string center = matches.str(1);
            std::string satellite = matches.str(2);
            graph.addEdge(center, satellite);
        }
    }

    return graph;
}

int main() {
    std::ifstream inputFile("satellites.txt");
    if (!inputFile.is_open()) {
        std::cerr << "Failed to open file!" << std::endl;
        return 1;
    }

    SatelliteGraph satelliteGraph = map2graph(inputFile);

    std::cout << "Total orbits: " << satelliteGraph.calculateTotalOrbits() << std::endl;

    inputFile.close();
    return 0;
}
```

