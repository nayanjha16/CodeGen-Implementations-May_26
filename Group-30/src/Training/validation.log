import os
import re
from datetime import datetime

class Message:
    def __init__(self, created_time, m_type, n_workers, processing_time, queued_time, source):
        self.created_time = created_time
        self.m_type = m_type
        self.n_workers = n_workers
        self.processing_time = processing_time
        self.queued_time = queued_time
        self.source = source

class LogParser:
    def __init__(self, log_directory):
        self.log_directory = log_directory
        self.messages = []

    def parse_logs(self):
        log_files = sorted([f for f in os.listdir(self.log_directory) if f.startswith('log')])
        start_time = None

        for log_file in log_files:
            with open(os.path.join(self.log_directory, log_file), 'r') as file:
                lines = file.readlines()
                if not start_time:
                    start_time = self.parse_timestamp(lines[0])

                for line in lines:
                    message_info = self.parse_message(line)
                    if message_info:
                        self.messages.append(message_info)

        return self.messages

    def parse_timestamp(self, line):
        timestamp_pattern = r'\[(.*?)\]'
        match = re.search(timestamp_pattern, line)
        if match:
            timestamp_str = match.group(1)
            timestamp = datetime.strptime(timestamp_str, '%Y-%m-%d %H:%M:%S,%f')
            return timestamp.timestamp()
        return None

    def parse_message(self, line):
        message_pattern = r'(\d+\.\d+)\s+(\w+)\s+(\d+)\s+(\d+\.\d+)\s+(\d+\.\d+)\s+(.*)'
        match = re.search(message_pattern, line)
        if match:
            created_time = float(match.group(1))
            m_type = match.group(2)
            n_workers = int(match.group(3))
            processing_time = float(match.group(4))
            queued_time = float(match.group(5))
            source = match.group(6)
            return Message(created_time, m_type, n_workers, processing_time, queued_time, source)
        return None

def summarize_messages(messages):
    summary = {}
    for message in messages:
        key = (message.m_type, message.source)
        if key not in summary:
            summary[key] = {
                'total_messages': 0,
                'total_processing_time': 0,
                'total_queued_time': 0
            }
        summary[key]['total_messages'] += 1
        summary[key]['total_processing_time'] += message.processing_time
        summary[key]['total_queued_time'] += message.queued_time

    return summary

if __name__ == "__main__":
    log_directory = 'path/to/log/directory'
    parser = LogParser(log_directory)
    messages = parser.parse_logs()
    summary = summarize_messages(messages)

    for (m_type, source), stats in summary.items():
        print(f"Type: {m_type}, Source: {source}")
        print(f"Total Messages: {stats['total_messages']}")
        print(f"Total Processing Time: {stats['total_processing_time']} seconds")
        print(f"Total Queued Time: {stats['total_queued_time']} seconds")
        print()
```

This code includes the `Message` class to store individual message details and the `LogParser` class to parse log files and extract message data. The `summarize_messages` function calculates summary statistics for each message type and source. The main block demonstrates how to use the `LogParser` to parse logs and print the summary statistics.
