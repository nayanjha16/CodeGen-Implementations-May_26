```python
import aiohttp
from typing import Optional

# Global variable to hold the ClientSession
session: Optional[aiohttp.ClientSession] = None

async def initialize_session():
    """Initialize the global ClientSession."""
    global session
    if session is None:
        session = aiohttp.ClientSession()

async def make_request(url: str) -> dict:
    """Make an asynchronous HTTP GET request using the global ClientSession."""
    if session is None:
        raise ValueError("ClientSession has not been initialized. Call initialize_session() first.")
    
    async with session.get(url) as response:
        if response.status == 200:
            return await response.json()
        else:
            response.raise_for_status()

# Example usage
if __name__ == "__main__":
    import asyncio
    
    async def main():
        await initialize_session()
        result = await make_request('https://api.example.com/data')
        print(result)
    
    asyncio.run(main())
```

This code includes:
- A global variable `session` of type `Optional[aiohttp.ClientSession]`.
- A function `initialize_session()` to create and initialize the `ClientSession`.
- A function `make_request(url: str)` to make an asynchronous HTTP GET request using the initialized `ClientSession`.
- Example usage within an `if __name__ == "__main__":` block to demonstrate how to use these functions.
