using namespace std;

string a,b;
int c;

int main(){
    cin >> a >> b >> c;
    if(a.size()!=b.size()) return cout << "NO\n",0;
    int dif = 0;
    for(int i=0;i<a.size();i++)
        if(a[i]!=b[i]) dif++;
    if(dif>c) return cout << "NO\n",0;
    else return cout << "YES\n",0;
}
