#include <ros/ros.h>
#include <nodelet/nodelet.h>
#include <std_msgs/String.h>
#include <sensor_msgs/Image.h>
#include <sensor_msgs/CameraInfo.h>

namespace image_processor {

class AdvertisementChecker {
public:
    void start(const std::vector<std::string>& topics, double timeout) {
        ros::NodeHandle nh;
        for (const auto& topic : topics) {
            ros::topic::waitForMessage<ros::Message>(topic, nh, ros::Duration(timeout));
        }
    }
};

class ImageProcessorNodelet : public nodelet::Nodelet {
private:
    ros::Subscriber image_sub_;
    ros::Subscriber info_sub_;
    AdvertisementChecker checker_;

public:
    virtual void onInit() {
        ros::NodeHandle nh = getNodeHandle();
        ros::NodeHandle private_nh = getPrivateNodeHandle();

        // Check for required topics
        std::vector<std::string> required_topics = {"image_raw", "camera_info"};
        checker_.start(required_topics, 10.0);

        // Subscribe to image and camera info topics
        image_sub_ = nh.subscribe("image_raw", 1, &ImageProcessorNodelet::imageCallback, this);
        info_sub_ = nh.subscribe("camera_info", 1, &ImageProcessorNodelet::infoCallback, this);
    }

    void imageCallback(const sensor_msgs::ImageConstPtr& msg) {
        // Process the image
        saveImage(msg);
    }

    void infoCallback(const sensor_msgs::CameraInfoConstPtr& msg) {
        // Process the camera info
        saveCameraInfo(msg);
    }

    void saveImage(const sensor_msgs::ImageConstPtr& msg) {
        // Save the image to a file
        std::ofstream file("image.raw", std::ios::binary);
        if (file.is_open()) {
            file.write(reinterpret_cast<const char*>(msg->data.data()), msg->data.size());
            file.close();
            ROS_INFO("Image saved successfully.");
        } else {
            ROS_ERROR("Failed to open file for writing.");
        }
    }

    void saveCameraInfo(const sensor_msgs::CameraInfoConstPtr& msg) {
        // Save the camera info to a file
        std::ofstream file("camera_info.yaml");
        if (file.is_open()) {
            file << *msg;
            file.close();
            ROS_INFO("Camera info saved successfully.");
        } else {
            ROS_ERROR("Failed to open file for writing.");
        }
    }
};

}  // namespace image_processor

PLUGINLIB_EXPORT_CLASS(image_processor::ImageProcessorNodelet, nodelet::Nodelet)
```

