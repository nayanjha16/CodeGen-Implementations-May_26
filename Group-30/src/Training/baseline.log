```cpp
#include <iostream>

// Class representing a node in the binary search tree
class Node {
public:
    int data;         // Integer value stored at this node
    Node *left;       // Pointer to the left child node
    Node *right;      // Pointer to the right child node

    // Constructor to initialize a new node with the given integer value
    Node(int d) : data(d), left(NULL), right(NULL) {}
};

// Class containing methods to manipulate the binary search tree
class Solution {
public:
    // Method to insert a new node with the specified integer value into the BST
    Node* insert(Node* root, int data) {
        if (root == NULL) {
            return new Node(data);
        } else {
            if (data <= root->data) {
                root->left = insert(root->left, data);
            } else {
                root->right = insert(root->right, data);
            }
            return root;
        }
    }

    // Method to perform pre-order traversal of the BST and print the elements
    void preOrder(Node* root) {
        if (root != NULL) {
            std::cout << root->data << " ";
            preOrder(root->left);
            preOrder(root->right);
        }
    }
};

// Main function to demonstrate the usage of the Binary Search Tree
int main() {
    Solution solution;
    Node* root = NULL;

    // Inserting elements into the BST
    root = solution.insert(root, 10);
    root = solution.insert(root, 5);
    root = solution.insert(root, 15);
    root = solution.insert(root, 3);
    root = solution.insert(root, 7);
    root = solution.insert(root, 12);
    root = solution.insert(root, 18);

    // Performing pre-order traversal
    std::cout << "Pre-order traversal of the BST: ";
    solution.preOrder(root);
    std::cout << std::endl;

    return 0;
}
```

This code defines a `Node` class to represent each node in the binary search tree and a `Solution` class that contains methods to insert nodes into the BST and perform a pre-order traversal. The `main` function demonstrates how to use these classes to create a BST and traverse it.
