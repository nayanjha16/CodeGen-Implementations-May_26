import tensorflow as tf
from garage.tf.models import GaussianMLPModel

class GaussianMLPRegressorModel(GaussianMLPModel):
    def __init__(self,
                 input_shape,
                 output_dim,
                 name='GaussianMLPRegressorModel',
                 hidden_sizes=(32, 32),
                 hidden_nonlinearity=tf.nn.tanh,
                 hidden_w_init=tf.initializers.glorot_uniform(seed=None)):
        super().__init__(
            input_shape=input_shape,
            output_dim=output_dim,
            name=name,
            hidden_sizes=hidden_sizes,
            hidden_nonlinearity=hidden_nonlinearity,
            hidden_w_init=hidden_w_init)

    def build(self, state_input):
        with tf.compat.v1.variable_scope(self.name):
            # Build the MLP part of the model
            x = state_input
            for size in self.hidden_sizes:
                x = tf.layers.dense(x, units=size, activation=self.hidden_nonlinearity, kernel_initializer=self.hidden_w_init)
            
            # Mean and log_std outputs
            mean = tf.layers.dense(x, units=self.output_dim, kernel_initializer=self.hidden_w_init)
            log_std = tf.layers.dense(x, units=self.output_dim, kernel_initializer=self.hidden_w_init)
            
            # Clamp log_std to prevent numerical instability
            log_std = tf.clip_by_value(log_std, -20., 2.)
        
        return mean, log_std

    def dist_info_sym(self, state_input, name=None):
        with tf.compat.v1.variable_scope(self.name or 'dist_info_sym'):
            mean, log_std = self.build(state_input)
            std = tf.exp(0.5 * log_std)
            dist = tf.distributions.Normal(loc=mean, scale=std)
        return dict(mean=mean, log_std=log_std, std=std, dist=dist)
