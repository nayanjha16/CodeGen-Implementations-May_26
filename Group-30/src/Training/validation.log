from vanilla import Window, Slider, Button, Group
import mojo.roboFont

class slideGlyphsDialog:
    def __init__(self):
        self.font = mojo.roboFont.getCurrentFont()
        self.font_name = self.font.info.familyName
        
        self._moveX = 0
        self._moveY = 0
        self._xMax = 100
        self._xMin = -100
        self._yMax = 100
        self._yMin = -100
        
        self.w = Window((200, 150), "Slide Glyphs")
        
        group = Group((10, 10, 180, 130))
        self.xSlider = Slider((10, 10, 160, 22), callback=self.updateMoveX)
        self.ySlider = Slider((10, 40, 160, 22), callback=self.updateMoveY)
        resetButton = Button((10, 70, 160, 22), title="Reset", callback=self.resetSliders)
        
        self.w.open()
    
    def updateMoveX(self, sender):
        self._moveX = sender.get()
        self.applyTransformations()
    
    def updateMoveY(self, sender):
        self._moveY = sender.get()
        self.applyTransformations()
    
    def resetSliders(self, sender):
        self._moveX = 0
        self._moveY = 0
        self.xSlider.set(0)
        self.ySlider.set(0)
        self.applyTransformations()
    
    def applyTransformations(self):
        if not self.font.selection:
            return
        
        for glyph in self.font.selection:
            glyph.transform([1, 0, 0, 1, self._moveX, self._moveY])

# Example usage
if __name__ == "__main__":
    dialog = slideGlyphsDialog()
```

