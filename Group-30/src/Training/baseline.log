```python
import unittest
from unittest.mock import patch, Mock
from testfixtures import TempDirectory
from gallery_management.aws_uploader import get_uploader

class AWSUploaderTestCase(unittest.TestCase):
    def test_no_location(self):
        # Create an instance of the AWS uploader
        uploader = get_uploader('aws')
        
        # Call check_location with an empty string and assert it returns False
        self.assertFalse(uploader.check_location(''))

    @patch('gallery_management.aws_uploader.subprocess.run')
    def test_upload_gallery(self, subprocess_run):
        # Create a temporary directory for testing
        with TempDirectory() as temp_dir:
            # Create some test files
            file_path = temp_dir.write('test_file.jpg', b'content')
            
            # Create an instance of the AWS uploader
            uploader = get_uploader('aws')
            
            # Call upload_gallery with the test file path
            uploader.upload_gallery(file_path)
            
            # Assert that subprocess.run was called with the expected arguments
            subprocess_run.assert_called_once_with(
                ['aws', 's3', 'cp', file_path, 's3://bucket-name/'],
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE
