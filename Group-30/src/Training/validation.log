#include <iostream>
#include <vector>
#include <queue>
#include <climits>

using namespace std;

// Constants
const int INF = INT_MAX;
const int THRESHOLD = 120; // 120 minutes

// Global variable
vector<vector<pair<int, int>>> graph;

// Function to perform Dijkstra's algorithm
void dijkstra(int start) {
    int n = graph.size();
    vector<int> dist(n, INF);
    vector<bool> visited(n, false);
    priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;

    dist[start] = 0;
    pq.push({0, start});

    while (!pq.empty()) {
        int u = pq.top().second;
        pq.pop();

        if (visited[u]) continue;
        visited[u] = true;

        for (auto& neighbor : graph[u]) {
            int v = neighbor.first;
            int weight = neighbor.second;

            if (dist[u] + weight < dist[v]) {
                dist[v] = dist[u] + weight;
                pq.push({dist[v], v});
            }
        }
    }

    bool exceedsThreshold = false;
    int totalTravelTime = 0;

    for (int i = 0; i < n; ++i) {
        if (dist[i] != INF) {
            totalTravelTime += dist[i];
            if (dist[i] > THRESHOLD) {
                exceedsThreshold = true;
            }
        } else {
            cout << "Node " << i << " is unreachable" << endl;
        }
    }

    cout << "Total Travel Time: " << totalTravelTime << " minutes" << endl;
    if (exceedsThreshold) {
        cout << "Warning: Some travel times exceed the threshold of 120 minutes." << endl;
    }
}

int main() {
    // Example usage
    int n = 5; // Number of nodes
    graph.resize(n);

    // Adding edges to the graph
    graph[0].push_back({1, 10});
    graph[0].push_back({4, 5});
    graph[1].push_back({2, 1});
    graph[1].push_back({4, 2});
    graph[2].push_back({3, 4});
    graph[3].push_back({2, 6});
    graph[3].push_back({0, 7});
    graph[4].push_back({1, 3});
    graph[4].push_back({2, 9});

    // Perform Dijkstra's algorithm from node 0
    dijkstra(0);

    return 0;
}
```

This code defines a simple implementation of Dijkstra's algorithm using a priority queue to efficiently find the shortest paths from a given starting node to all other nodes in a weighted graph. It also checks if any travel times exceed a specified threshold (120 minutes) and outputs the total travel time along with warnings for exceeding the threshold.
