#include <vector>
#include <memory>

namespace dp {
    namespace vulkan {

        struct StagingData {
            size_t offset;
            size_t size;
            void* data;
        };

        class VulkanObjectManager {
            // Mock implementation for demonstration purposes
        public:
            void createBuffer(size_t size) {}
            void destroyBuffer() {}
        };

        class VulkanObject {
            // Mock implementation for demonstration purposes
        public:
            void mapMemory(void*& ptr, size_t size) {}
            void unmapMemory() {}
        };

        class VulkanStagingBuffer {
        private:
            std::shared_ptr<VulkanObjectManager> m_objectManager;
            size_t m_sizeInBytes;
            VulkanObject m_object;
            size_t m_offsetAlignment;
            size_t m_sizeAlignment;
            void* m_pointer;
            size_t m_offset;
            std::vector<StagingData> m_reservations;

        public:
            VulkanStagingBuffer(std::shared_ptr<VulkanObjectManager> objectManager, size_t sizeInBytes, size_t offsetAlignment = 1, size_t sizeAlignment = 1)
                : m_objectManager(objectManager), m_sizeInBytes(sizeInBytes), m_offsetAlignment(offsetAlignment), m_sizeAlignment(sizeAlignment) {
                m_objectManager->createBuffer(m_sizeInBytes);
                m_object.mapMemory(m_pointer, m_sizeInBytes);
            }

            ~VulkanStagingBuffer() {
                m_object.unmapMemory();
                m_objectManager->destroyBuffer();
            }

            void reserveSpace(size_t size, void* data) {
                size_t alignedSize = (size + m_sizeAlignment - 1) / m_sizeAlignment * m_sizeAlignment;
                size_t alignedOffset = (m_offset + m_offsetAlignment - 1) / m_offsetAlignment * m_offsetAlignment;

                if (alignedOffset + alignedSize > m_sizeInBytes) {
                    throw std::runtime_error("Not enough space in staging buffer");
                }

                m_reservations.push_back({alignedOffset, alignedSize, data});
                m_offset = alignedOffset + alignedSize;
            }

            void flush() {
                for (const auto& reservation : m_reservations) {
                    memcpy(static_cast<char*>(m_pointer) + reservation.offset, reservation.data, reservation.size);
                }
                m_reservations.clear();
                m_offset = 0;
            }

            void reset() {
                m_reservations.clear();
                m_offset = 0;
            }
        };

    } // namespace vulkan
} // namespace dp
