```cpp
#include <vector>
#include <memory>
#include <string>
#include "mrpt/serialization/CSerializable.h"

namespace mrpt::maps {

class CMHPropertiesValuesList {
public:
    struct TPropertyValueIDTriplet {
        std::string name;
        std::shared_ptr<mrpt::serialization::CSerializable> value;
        int ID;

        TPropertyValueIDTriplet(const std::string& n, const std::shared_ptr<mrpt::serialization::CSerializable>& v, int id)
            : name(n), value(v), ID(id) {}
    };

private:
    std::vector<TPropertyValueIDTriplet> m_properties;

public:
    void writeToStream(mrpt::serialization::CArchive& out) const {
        out << static_cast<uint32_t>(m_properties.size());
        for (const auto& triplet : m_properties) {
            out << triplet.name << *triplet.value << triplet.ID;
        }
    }

    void readFromStream(mrpt::serialization::CArchive& in) {
        uint32_t size;
        in >> size;
        m_properties.resize(size);
        for (auto& triplet : m_properties) {
            in >> triplet.name;
            triplet.value = std::make_shared<mrpt::serialization::CSerializable>();
            in >> *triplet.value;
            in >> triplet.ID;
        }
    }

    void setValue(const std::string& name, const std::shared_ptr<mrpt::serialization::CSerializable>& value, int ID) {
        for (auto& triplet : m_properties) {
            if (triplet.name == name) {
                triplet.value = value;
                triplet.ID = ID;
                return;
            }
        }
        m_properties.emplace_back(name, value, ID);
    }

    std::shared_ptr<mrpt::serialization::CSerializable> getValue(const std::string& name) const {
        for (const auto& triplet : m_properties) {
            if (triplet.name == name) {
                return triplet.value;
            }
        }
        return nullptr;
    }

    bool removeProperty(const std::string& name) {
        auto it = std::remove_if(m_properties.begin(), m_properties.end(),
                                 [name](const TPropertyValueIDTriplet& triplet) { return triplet.name == name; });
        if (it != m_properties.end()) {
            m_properties.erase(it, m_properties.end());
            return true;
        }
        return false;
    }

    std::vector<std::string> getPropertyNames() const {
        std::vector<std::string> names;
        for (const auto& triplet : m_properties) {
            names.push_back(triplet.name);
        }
        return names;
    }
};

} // namespace mrpt::maps
```

