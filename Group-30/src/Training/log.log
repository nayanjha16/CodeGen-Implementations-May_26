    def transform(self, data, sep=','):
        """
        Transforms the input data into a CSV format.

        Parameters:
        - data: A list of dictionaries representing the submissions to be transformed.
        - sep: A string specifying the separator character for the CSV output (default is comma).

        Returns:
        - A string containing the transformed CSV data.
        """
        # Map each submission through get_data
        mapped_data = [self.get_data(submission) for submission in data]
        
        # Format the mapped data using pretty_format
        formatted_data = [self.pretty_format(item) for item in mapped_data]
        
        # Filter out None values
        filtered_data = [item for item in formatted_data if item is not None]
        
        # Normalize the data using normalize
        normalized_data = [self.normalize(item) for item in filtered_data]
        
        # Convert the normalized data to CSV
        csv_output = self.convert_to_csv(normalized_data, sep=sep)
        
        return csv_output
