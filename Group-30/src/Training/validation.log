#include "CoreMinimal.h"
#include "GameFramework/Character.h"
#include "AEmpty_AMC_Character.generated.h"

// Forward declaration of UAMC_MovementComponent
class UAMC_MovementComponent;

UCLASS()
class YOURPROJECT_API AEmpty_AMC_Character : public ACharacter
{
    GENERATED_BODY()

public:
    // Constructor
    AEmpty_AMC_Character(const FObjectInitializer& ObjectInitializer);

protected:
    virtual void BeginPlay() override;

public:
    // Method to start sprinting
    void StartSprinting();

private:
    // Pointer to the custom movement component
    UPROPERTY(VisibleAnywhere)
    UAMC_MovementComponent* MovementComponent;
};

// Implementation of the constructor
AEmpty_AMC_Character::AEmpty_AMC_Character(const FObjectInitializer& ObjectInitializer)
    : Super(ObjectInitializer)
{
    // Set the default subobject class for the character's movement component
    MovementComponent = CreateDefaultSubobject<UAMC_MovementComponent>(TEXT("MovementComponent"));
    MovementComponent->SetupAttachment(RootComponent);

    // Enable tick events for the character
    PrimaryActorTick.bCanEverTick = true;
}

// Implementation of BeginPlay
void AEmpty_AMC_Character::BeginPlay()
{
    Super::BeginPlay();
}

// Implementation of StartSprinting
void AEmpty_AMC_Character::StartSprinting()
{
    if (MovementComponent)
    {
        MovementComponent->StartSprint();
    }
}
```

