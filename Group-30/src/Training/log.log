class gpudevice {
public:
    // Constructor
    gpudevice() : device(nullptr), context(nullptr) {}

    // Destructor
    ~gpudevice() {
        if (context) {
            context->Release();
        }
        if (device) {
            device->Release();
        }
    }

    // Method to initialize the GPU device
    bool init() {
        if (device && context) {
            return true; // Device already initialized
        }

        UINT createDeviceFlags = 0;
#ifdef _DEBUG
        createDeviceFlags |= D3D11_CREATE_DEVICE_DEBUG;
#endif

        D3D_DRIVER_TYPE driverTypes[] = {
            D3D_DRIVER_TYPE_HARDWARE,
            D3D_DRIVER_TYPE_WARP,
            D3D_DRIVER_TYPE_REFERENCE,
        };
        UINT numDriverTypes = ARRAYSIZE(driverTypes);

        D3D_FEATURE_LEVEL featureLevels[] = {
            D3D_FEATURE_LEVEL_11_1,
            D3D_FEATURE_LEVEL_11_0,
            D3D_FEATURE_LEVEL_10_1,
            D3D_FEATURE_LEVEL_10_0,
        };
        UINT numFeatureLevels = ARRAYSIZE(featureLevels);

        HRESULT hr = D3D11CreateDevice(
            nullptr,                    // use default adapter
            driverTypes[0],             // use hardware devices
            nullptr,                    // no software rasterizer
            createDeviceFlags,          // enable debug and Direct2D compatibility
            featureLevels,              // list of feature levels this app can support
            numFeatureLevels,           // number of feature levels
            D3D11_SDK_VERSION,          // always set this to D3D11_SDK_VERSION
            &device,                    // returns the Direct3D device created
            &featureLevel,              // returns feature level of device created
            &context                    // returns the device immediate context
        );

        if (FAILED(hr)) {
            std::cerr << "Failed to create Direct3D device." << std::endl;
            return false;
        }

        return true;
    }

    // Method to get the Direct3D 11 device object
    ID3D11Device* get_device() const {
        return device;
    }

    // Method to get the device context
    ID3D11DeviceContext* get_context() const {
        return context;
    }

private:
    ID3D11Device* device;
    ID3D11DeviceContext* context;
};
