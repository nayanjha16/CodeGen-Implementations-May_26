#include <vector>
#include <memory>

namespace chai3d {

class cGenericTool;
class cMesh;
class cAudioSource;

class cHapticPoint {
public:
    // Constructor
    cHapticPoint(cGenericTool* parentTool);

    // Destructor
    ~cHapticPoint();

    // Methods
    void update();
    void computeForces();
    void handleCollision(const std::vector<cMesh*>& contacts);
    void playImpactSound();
    void playFrictionSound();
    void render() const;

private:
    // Fields
    cGenericTool* m_parentTool; // Pointer to the parent tool associated with this haptic point
    double m_radiusDisplay;     // Radius used for display rendering
    double m_radiusContact;     // Radius used for contact computation
    cVector3d m_lastComputedGlobalForce; // Last computed global force
    std::vector<std::shared_ptr<cMesh>> m_meshProxyContacts; // Array of pointers to mesh objects currently in contact with the proxy
    std::vector<std::shared_ptr<cAudioSource>> m_audioSourceImpact; // Array of pointers to audio sources for impact sounds
    std::vector<std::shared_ptr<cAudioSource>> m_audioSourceFriction; // Array of pointers to audio sources for friction sounds
    std::vector<std::shared_ptr<cMesh>> m_audioProxyContacts; // Array of pointers to mesh objects currently in contact with the proxy for audio purposes
    bool m_useAudioSources; // Flag to indicate whether to use audio sources
};

} // namespace chai3d
```

