#include <iostream>
#include <cstring>

class LogStream {
public:
    // Constructor initializes the buffer and its pointer
    LogStream() : buf_size_(1024), buf_pointer_(0) {
        buf_ = new char[buf_size_];
        buf_[buf_pointer_] = '\0';
    }

    // Destructor ensures the buffer is properly terminated before destruction
    ~LogStream() {
        delete[] buf_;
    }

    // Overloaded insertion operator for integers
    LogStream& operator<<(int value) {
        snprintf(buf_ + buf_pointer_, buf_size_ - buf_pointer_, "%d", value);
        buf_pointer_ += strlen(buf_ + buf_pointer_);
        return *this;
    }

    // Overloaded insertion operator for floating-point numbers
    LogStream& operator<<(double value) {
        snprintf(buf_ + buf_pointer_, buf_size_ - buf_pointer_, "%.2f", value);
        buf_pointer_ += strlen(buf_ + buf_pointer_);
        return *this;
    }

    // Overloaded insertion operator for strings
    LogStream& operator<<(const std::string& value) {
        strncpy(buf_ + buf_pointer_, value.c_str(), buf_size_ - buf_pointer_);
        buf_pointer_ += strlen(value.c_str());
        return *this;
    }

    // Overloaded insertion operator for booleans
    LogStream& operator<<(bool value) {
        if (value) {
            strcpy(buf_ + buf_pointer_, "true");
        } else {
            strcpy(buf_ + buf_pointer_, "false");
        }
        buf_pointer_ += strlen(buf_ + buf_pointer_);
        return *this;
    }

    // Method to get the constructed log message
    const char* str() const {
        return buf_;
    }

private:
    char* buf_;          // Character array used as the internal buffer
    size_t buf_pointer_; // Index indicating the current position within the buffer
    size_t buf_size_;     // Total size of the buffer
};

// Global output function defaults to writing to standard output
void g_out(const LogStream& logStream) {
    std::cout << logStream.str();
}

// Global flush function defaults to flushing standard output
void g_flush() {
    std::cout.flush();
}
```

This code defines a `LogStream` class that allows constructing log messages by chaining insertions of various data types. It also includes global functions `g_out` and `g_flush` for outputting and flushing the log messages, respectively. The implementation uses standard C++ conventions and idioms.
