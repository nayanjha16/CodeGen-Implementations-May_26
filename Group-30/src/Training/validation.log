def get_local_contigs(assembler, polisher, contig_dir, vcf_parsed, out, sample_name, bam):
    """
    Main function to perform local assembly of non-reference TE loci.

    Parameters:
    assembler (str): Specifies the assembler to use ("wtdbg2" or "flye").
