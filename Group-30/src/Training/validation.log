template<typename T>
class aligned_allocator {
public:
    using value_type = T;

    T* allocate(std::size_t n) {
        void* ptr;
        if (posix_memalign(&ptr, alignof(T), n * sizeof(T)) != 0) {
            throw std::bad_alloc();
        }
        return static_cast<T*>(ptr);
    }

    void deallocate(T* p, std::size_t n) noexcept {
        free(p);
    }
};

