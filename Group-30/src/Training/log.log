#include <QApplication>
#include <QWidget>
#include <QVBoxLayout>
#include <QLabel>
#include <QSlider>
#include <QDial>
#include <QwtThermo>
#include <QwtSlider>
#include <QwtWheel>

class TuningThermo : public QWidget {
    Q_OBJECT
public:
    TuningThermo(QWidget *parent = nullptr) : QWidget(parent), m_thermo(new QwtThermo(this)), m_label(new QLabel("Tuning", this)) {
        QVBoxLayout *layout = new QVBoxLayout(this);
        layout->addWidget(m_label);
        layout->addWidget(m_thermo);

        m_thermo->setScale(0, 100); // Assuming scale is from 0 to 100
        m_thermo->setBarColor(Qt::green);
    }

    void setValue(int value) {
        m_thermo->setValue(value);
    }

private:
    QwtThermo *m_thermo;
    QLabel *m_label;
};

class TunerFrame : public QWidget {
    Q_OBJECT
public:
    TunerFrame(QWidget *parent = nullptr) : QWidget(parent) {
        QVBoxLayout *layout = new QVBoxLayout(this);

        m_slider = new QwtSlider(this);
        m_wheel = new QwtWheel(this);
        m_thermo = new TuningThermo(this);

        m_slider->setScale(875, 10800); // Scale in Hz
        m_wheel->setScale(875, 10800); // Scale in Hz

        connect(m_slider, &QwtSlider::valueChanged, this, &TunerFrame::updateThermo);
        connect(m_wheel, &QwtWheel::valueChanged, this, &TunerFrame::updateThermo);

        layout->addWidget(m_slider);
        layout->addWidget(m_wheel);
        layout->addWidget(m_thermo);
    }

private slots:
    void updateThermo(int value) {
        int fieldValue = calculateFieldValue(value);
        m_thermo->setValue(fieldValue);
    }

private:
    QwtSlider *m_slider;
    QwtWheel *m_wheel;
    TuningThermo *m_thermo;

    int calculateFieldValue(int frequency) {
        // Example calculation: map frequency to a value between 0 and 100
        return static_cast<int>((frequency - 875) / (10800 - 875) * 100);
    }
};

int main(int argc, char *argv[]) {
    QApplication app(argc, argv);

    TunerFrame frame;
    frame.show();

    return app.exec();
}

#include "main.moc"
```

