// Class extending Eigen::Array to represent an image buffer
class Buffer : public Eigen::Array<uint8_t, Eigen::Dynamic, Eigen::Dynamic> {
public:
    using Base = Eigen::Array<uint8_t, Eigen::Dynamic, Eigen::Dynamic>;

    // Constructor initializing the buffer with specified width and height
    Buffer(int width, int height) : Base(width, height) {}

    // Method to read a PNG image from a file
    bool readPNG(const char* filename) {
        png_structp png_ptr = nullptr;
        png_infop info_ptr = nullptr;
        FILE* fp = fopen(filename, "rb");
        if (!fp) return false;

        png_ptr = png_create_read_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
        if (!png_ptr) {
            fclose(fp);
            return false;
        }

        info_ptr = png_create_info_struct(png_ptr);
        if (!info_ptr) {
            png_destroy_read_struct(&png_ptr, nullptr, nullptr);
            fclose(fp);
            return false;
        }

        if (setjmp(png_jmpbuf(png_ptr))) {
            png_destroy_read_struct(&png_ptr, &info_ptr, nullptr);
            fclose(fp);
            return false;
        }

        png_init_io(png_ptr, fp);
        png_read_info(png_ptr, info_ptr);

        int width = png_get_image_width(png_ptr, info_ptr);
        int height = png_get_image_height(png_ptr, info_ptr);
        this->resize(width, height);

        png_bytepp row_pointers = new png_bytep[height];
        for (int i = 0; i < height; ++i) {
            row_pointers[i] = this->data() + i * width;
        }

        png_read_image(png_ptr, row_pointers);
        png_read_end(png_ptr, nullptr);

        delete[] row_pointers;
        png_destroy_read_struct(&png_ptr, &info_ptr, nullptr);
        fclose(fp);
        return true;
    }

    // Method to write a PNG image to a file
    bool writePNG(const char* filename) const {
        png_structp png_ptr = nullptr;
        png_infop info_ptr = nullptr;
        FILE* fp = fopen(filename, "wb");
        if (!fp) return false;

        png_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
        if (!png_ptr) {
            fclose(fp);
            return false;
        }

        info_ptr = png_create_info_struct(png_ptr);
        if (!info_ptr) {
            png_destroy_write_struct(&png_ptr, nullptr);
            fclose(fp);
            return false;
        }

        if (setjmp(png_jmpbuf(png_ptr))) {
            png_destroy_write_struct(&png_ptr, &info_ptr);
            fclose(fp);
            return false;
        }

        png_init_io(png_ptr, fp);

        png_set_IHDR(png_ptr, info_ptr, this->cols(), this->rows(),
                    8, PNG_COLOR_TYPE_RGB, PNG_INTERLACE_NONE,
                    PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);

        png_write_info(png_ptr, info_ptr);

        png_bytepp row_pointers = new png_bytep[this->rows()];
        for (int i = 0; i < this->rows(); ++i) {
            row_pointers[i] = this->data() + i * this->cols();
        }

        png_write_image(png_ptr, row_pointers);
        png_write_end(png_ptr, nullptr);

        delete[] row_pointers;
        png_destroy_write_struct(&png_ptr, &info_ptr);
        fclose(fp);
        return true;
    }

    // Method to convert the buffer to grayscale
    void toGrayscale() {
        for (int i = 0; i < this->rows(); ++i) {
            for (int j = 0; j < this->cols(); ++j) {
                uint8_t gray = (this->coeffRef(i, j * 3) * 0.299 +
                               this->coeffRef(i, j * 3 + 1) * 0.587 +
                               this->coeffRef(i, j * 3 + 2) * 0.114);
                this->coeffRef(i, j * 3) = gray;
                this->coeffRef(i, j * 3 + 1) = gray;
                this->coeffRef(i, j * 3 + 2) = gray;
            }
        }
    }
};

} // namespace ndb
```

