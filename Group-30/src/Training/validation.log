import os

# Global variable
AUDIO_FILENAME_ENDINGS = (".aiff", ".flac", ".m4a", ".mp3", ".ogg", ".opus", ".wav")

def get_file_paths(root_path, filename_endings=AUDIO_FILENAME_ENDINGS, traverse_subdirectories=True):
    """Return a list of paths to all files with the given filename extensions in a directory.
    Also traverses subdirectories by default.
    """
    file_paths = []
    
    for root, dirs, files in os.walk(root_path):
        for file in files:
            if file.endswith(filename_endings):
                file_paths.append(os.path.join(root, file))
                
    return file_paths

def calculate_rms(audio_samples):
    """Calculate the Root Mean Square (RMS) value of a list of audio samples."""
    sum_of_squares = sum(sample ** 2 for sample in audio_samples)
    rms_value = (sum_of_squares / len(audio_samples)) ** 0.5
    return rms_value

def db_to_amplitude_ratio(db_value):
    """Convert a decibel (dB) value to its corresponding amplitude ratio."""
    amplitude_ratio = 10 ** (db_value / 20)
    return amplitude_ratio

def is_multichannel(audio_waveform):
    """Check if the given audio waveform is multichannel."""
    return isinstance(audio_waveform, list) and len(audio_waveform[0]) > 1

def is_multichannel_spectrogram(spectrogram):
    """Check if the given spectrogram is multichannel."""
    return isinstance(spectrogram, list) and len(spectrogram[0][0]) > 1

def float_to_int16(audio_samples):
    """Convert a list of floating-point audio samples to 16-bit integer format."""
    int16_samples = [int(sample * 32768) for sample in audio_samples]
    return int16_samples
