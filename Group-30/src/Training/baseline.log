#include <vector>
#include <cmath>

// Class representing an Average Pooling operation
class AveragePool {
public:
    // Constructor with parameters
    AveragePool(int filterHeight, int filterWidth, int strideH, int strideW)
        : filterHeight(filterHeight), filterWidth(filterWidth), strideH(strideH), strideW(strideW) {}

    // Method to perform the average pooling operation
    std::vector<std::vector<float>> apply(const std::vector<std::vector<float>>& input) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int outputHeight = (inputHeight + strideH - 1) / strideH;
        int outputWidth = (inputWidth + strideW - 1) / strideW;

        std::vector<std::vector<float>> output(outputHeight, std::vector<float>(outputWidth));

        for (int i = 0; i < outputHeight; ++i) {
            for (int j = 0; j < outputWidth; ++j) {
                float sum = 0.0f;
                int count = 0;
                for (int k = 0; k < filterHeight && i * strideH + k < inputHeight; ++k) {
                    for (int l = 0; l < filterWidth && j * strideW + l < inputWidth; ++l) {
                        sum += input[i * strideH + k][j * strideW + l];
                        ++count;
                    }
                }
                output[i][j] = sum / count;
            }
        }

        return output;
    }

private:
    int filterHeight;
    int filterWidth;
    int strideH;
    int strideW;
};

// Class representing a Convolution operation
class Convolution {
public:
    // Constructor with parameters
    Convolution(const std::vector<std::vector<float>>& weights, const std::vector<std::vector<float>>& biases)
        : weights(weights), biases(biases) {}

    // Method to perform the convolution operation
    std::vector<std::vector<float>> apply(const std::vector<std::vector<float>>& input) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int kernelHeight = weights.size();
        int kernelWidth = weights[0].size();

        std::vector<std::vector<float>> output(inputHeight, std::vector<float>(inputWidth));

        for (int i = 0; i < inputHeight; ++i) {
            for (int j = 0; j < inputWidth; ++j) {
                float sum = 0.0f;
                for (int k = 0; k < kernelHeight; ++k) {
                    for (int l = 0; l < kernelWidth; ++l) {
                        if (i + k >= 0 && i + k < inputHeight && j + l >= 0 && j + l < inputWidth) {
                            sum += input[i + k][j + l] * weights[k][l];
                        }
                    }
                }
                output[i][j] = sum + biases[i % biases.size()][j % biases[0].size()];
            }
        }

        return output;
    }

private:
    std::vector<std::vector<float>> weights;
    std::vector<std::vector<float>> biases;
};

// Class representing a Depthwise Convolution operation
class DepthwiseConvolution {
public:
    // Constructor with parameters
    DepthwiseConvolution(const std::vector<std::vector<float>>& weights, const std::vector<std::vector<float>>& biases)
        : weights(weights), biases(biases) {}

    // Method to perform the depthwise convolution operation
    std::vector<std::vector<float>> apply(const std::vector<std::vector<float>>& input) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int kernelHeight = weights.size();
        int kernelWidth = weights[0].size();

        std::vector<std::vector<float>> output(inputHeight, std::vector<float>(inputWidth));

        for (int i = 0; i < inputHeight; ++i) {
            for (int j = 0; j < inputWidth; ++j) {
                float sum = 0.0f;
                for (int k = 0; k < kernelHeight; ++k) {
                    for (int l = 0; l < kernelWidth; ++l) {
                        if (i + k >= 0 && i + k < inputHeight && j + l >= 0 && j + l < inputWidth) {
                            sum += input[i + k][j + l] * weights[k][l];
                        }
                    }
                }
                output[i][j] = sum + biases[i % biases.size()][j % biases[0].size()];
            }
        }

        return output;
    }

private:
    std::vector<std::vector<float>> weights;
    std::vector<std::vector<float>> biases;
};

// Class representing an Add operation
class Add {
public:
    // Method to perform element-wise addition
    std::vector<std::vector<float>> apply(const std::vector<std::vector<float>>& input1, const std::vector<std::vector<float>>& input2) {
        int height = input1.size();
        int width = input1[0].size();

        std::vector<std::vector<float>> result(height, std::vector<float>(width));

        for (int i = 0; i < height; ++i) {
            for (int j = 0; j < width; ++j) {
                result[i][j] = input1[i][j] + input2[i][j];
            }
        }

        return result;
    }
};

// Class representing a SpaceToBatchND operation
class SpaceToBatchND {
public:
    // Constructor with parameters
    SpaceToBatchND(const std::vector<int>& blockShape, const std::vector<int>& paddings)
        : blockShape(blockShape), paddings(paddings) {}

    // Method to convert spatial dimensions to batch dimensions
    std::vector<std::vector<float>> apply(const std::vector<std::vector<float>>& input) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int batchSize = blockShape[0] * blockShape[1];

        std::vector<std::vector<float>> output(batchSize, std::vector<float>(inputHeight * blockShape[0], inputWidth * blockShape[1]));

        for (int b = 0; b < batchSize; ++b) {
            int blockIdxY = b / blockShape[1];
            int blockIdxX = b % blockShape[1];
            for (int i = 0; i < inputHeight; ++i) {
                for (int j = 0; j < inputWidth; ++j) {
                    output[b][(blockIdxY * inputHeight + i) * inputWidth + blockIdxX * inputWidth + j] = input[i][j];
                }
            }
        }

        return output;
    }

private:
    std::vector<int> blockShape;
    std::vector<int> paddings;
};

// Class representing a BatchToSpaceND operation
class BatchToSpaceND {
public:
    // Constructor with parameters
    BatchToSpaceND(const std::vector<int>& blockShape, const std::vector<int>& crops)
        : blockShape(blockShape), crops(crops) {}

    // Method to convert batch dimensions back to spatial dimensions
    std::vector<std::vector<float>> apply(const std::vector<std::vector<float>>& input) {
        int batchSize = input.size();
        int inputHeight = input[0].size() / blockShape[0];
        int inputWidth = input[0][0].size() / blockShape[1];

        std::vector<std::vector<float>> output(inputHeight, std::vector<float>(inputWidth));

        for (int b = 0; b < batchSize; ++b) {
            int blockIdxY = b / blockShape[1];
            int blockIdxX = b % blockShape[1];
            for (int i = 0; i < inputHeight; ++i) {
                for (int j = 0; j < inputWidth; ++j) {
                    output[i][j] = input[b][(blockIdxY * inputHeight + i) * inputWidth + blockIdxX * inputWidth + j];
                }
            }
        }

        return output;
    }

private:
    std::vector<int> blockShape;
    std::vector<int> crops;
};

// Class representing a Concatenation operation
class Concatenation {
public:
    // Constructor with parameters
    Concatenation(int axis) : axis(axis) {}

    // Method to concatenate tensors along a specified dimension
    std::vector<std::vector<float>> apply(const std::vector<std::vector<std::vector<float>>>& inputs) {
        int totalHeight = 0;
        int totalWidth = 0;
        for (const auto& input : inputs) {
            totalHeight = std::max(totalHeight, static_cast<int>(input.size()));
            totalWidth = std::max(totalWidth, static_cast<int>(input[0].size()));
        }

        std::vector<std::vector<float>> output(totalHeight, std::vector<float>(totalWidth));

        for (const auto& input : inputs) {
            for (int i = 0; i < input.size(); ++i) {
                for (int j = 0; j < input[0].size(); ++j) {
                    output[i][j] = input[i][j];
                }
            }
        }

        return output;
    }

private:
    int axis;
};

// Class representing a Fully Connected layer
class FullyConnected {
public:
    // Constructor with parameters
    FullyConnected(const std::vector<std::vector<float>>& weights, const std::vector<std::vector<float>>& biases)
        : weights(weights), biases(biases) {}

    // Method to implement fully connected layers
    std::vector<float> apply(const std::vector<float>& input) {
        int inputSize = input.size();
        int outputSize = weights.size();

        std::vector<float> output(outputSize);

        for (int i = 0; i < outputSize; ++i) {
            float sum = 0.0f;
            for (int j = 0; j < inputSize; ++j) {
                sum += input[j] * weights[i][j];
            }
            output[i] = sum + biases[i][0];
        }

        return output;
    }

private:
    std::vector<std::vector<float>> weights;
    std::vector<std::vector<float>> biases;
};

// Class representing a Gather operation
class Gather {
public:
    // Constructor with parameters
    Gather(const std::vector<int>& indices) : indices(indices) {}

    // Method to gather slices from a tensor according to indices
    std::vector<float> apply(const std::vector<float>& input) {
        std::vector<float> output;

        for (int index : indices) {
            output.push_back(input[index]);
        }

        return output;
    }

private:
    std::vector<int> indices;
};

// Class representing an L2 Normalization operation
class L2Normalization {
public:
    // Method to apply L2 normalization
    std::vector<std::vector<float>> apply(const std::vector<std::vector<float>>& input) {
        int height = input.size();
        int width = input[0].size();

        std::vector<std::vector<float>> output(height, std::vector<float>(width));

        for (int i = 0; i < height; ++i) {
            for (int j = 0; j < width; ++j) {
                float norm = 0.0f;
                for (int k = 0; k < height; ++k) {
                    for (int l = 0; l < width; ++l) {
                        norm += input[k][l] * input[k][l];
                    }
                }
                norm = std::sqrt(norm);
                output[i][j] = input[i][j] / norm;
            }
        }

        return output;
    }
};

// Class representing an L2 Pooling operation
class L2Pool {
public:
    // Constructor with parameters
    L2Pool(int filterHeight, int filterWidth, int strideH, int strideW)
        : filterHeight(filterHeight), filterWidth(filterWidth), strideH(strideH), strideW(strideW) {}

    // Method to perform L2 pooling
    std::vector<std::vector<float>> apply(const std::vector<std::vector<float>>& input) {
        int inputHeight = input.size();
        int inputWidth = input[0].size();
        int outputHeight = (inputHeight + strideH - 1) / strideH;
        int outputWidth = (inputWidth + strideW - 1) / strideW;

        std::vector<std::vector<float>> output(outputHeight, std::vector<float>(outputWidth));

        for (int i = 0; i < outputHeight; ++i) {
            for (int j = 0; j < outputWidth; ++j) {
                float sum = 0.0f;
                int count = 0;
                for (int k = 0; k < filterHeight && i * strideH + k < inputHeight; ++k) {
                    for (int l = 0; l < filterWidth && j * strideW + l < inputWidth; ++l) {
                        sum += input[i * strideH + k][j * strideW + l] * input[i * strideH + k][j * strideW + l];
                        ++count;
                    }
                }
                output[i][j] = std::sqrt(sum / count);
            }
        }

        return output;
    }

private:
    int filterHeight;
    int filterWidth;
    int strideH;
    int strideW;
};

// Class representing a Local Response Normalization operation
class LocalResponseNormalization {
public:
    // Method to apply local response normalization
    std::vector<std::vector<float>> apply(const std::vector<std::vector<float>>& input) {
        int height = input.size();
        int width = input[0].size();

        std::vector<std::vector<float>> output(height, std::vector<float>(width));

        for (int i = 0; i < height; ++i) {
            for (int j = 0; j < width; ++j) {
                float sum = 0.0f;
                for (int k = std::max(0, i - halfWindowSize); k <= std::min(height - 1, i + halfWindowSize); ++k) {
                    for (int l = std::max(0, j - halfWindowSize); l <= std::min(width - 1, j + halfWindowSize); ++l) {
                        sum += input[k][l] * input[k][l];
                    }
                }
                output[i][j] = input[i][j] / (alpha + beta * sum);
            }
        }

        return output;
    }

private:
    int halfWindowSize = 2;
    float alpha = 1e-4f;
    float beta = 0.75f;
};
