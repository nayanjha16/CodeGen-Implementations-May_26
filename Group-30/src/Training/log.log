#include "base/android/jni_android.h"
#include "base/android/scoped_java_ref.h"
#include "chrome/browser/profiles/profile.h"
#include "components/most_visited_sites/most_visited_sites.h"
#include "components/rappor/rappor_service_impl.h"

class MostVisitedURLsObserver {
 public:
  virtual void OnURLsUpdated() = 0;
};

class ThumbnailListSource {
 public:
  static std::vector<std::string> GetMostVisitedURLs();
};

class RapporServiceImpl {
 public:
  static void RecordSample(const std::string& sample);
};

class MostVisitedSitesBridge {
 public:
  explicit MostVisitedSitesBridge(Profile* profile)
      : most_visited_(new MostVisitedSites(profile)),
        java_observer_(nullptr) {}

  ~MostVisitedSitesBridge() {
    delete most_visited_;
  }

  void Initialize(JNIEnv* env, jobject java_observer) {
    java_observer_.Reset(env, java_observer);
    most_visited_->AddObserver(this);
    UpdateMostVisitedURLs();
  }

 private:
  void UpdateMostVisitedURLs() {
    std::vector<std::string> urls = ThumbnailListSource::GetMostVisitedURLs();
    for (const auto& url : urls) {
      RapporServiceImpl::RecordSample(url);
    }
    if (!java_observer_.is_null()) {
      JNIEnv* env = base::android::AttachCurrentThread();
      env->CallVoidMethod(java_observer_, MethodID::GetInstance().OnURLsUpdated());
    }
  }

  MostVisitedSites* most_visited_;
  base::android::ScopedJavaGlobalRef<jobject> java_observer_;
};
