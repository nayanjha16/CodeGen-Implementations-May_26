import numpy as np
from PIL import Image
import os

# Global variable
cls_to_clr_map = get_color()

def get_color():
    """
    Purpose: Returns a predefined list of RGB color codes representing different classes.

    Parameters: None

    Return Value: A NumPy array of shape (22, 3) where each row represents an RGB color code.
    """
    # Define a list of RGB color codes
    color_codes = [
        [0, 0, 0],       # Background
        [128, 0, 0],     # Class 1
        [0, 128, 0],     # Class 2
        [128, 128, 0],   # Class 3
        [0, 0, 128],     # Class 4
        [128, 0, 128],   # Class 5
        [0, 128, 128],   # Class 6
        [192, 192, 192], # Class 7
        [128, 128, 128], # Class 8
        [64, 64, 64],    # Class 9
        [192, 128, 128], # Class 10
        [64, 192, 128],  # Class 11
        [64, 64, 192],   # Class 12
        [192, 64, 128],  # Class 13
        [192, 128, 64],  # Class 14
        [0, 64, 128],    # Class 15
        [128, 64, 0],    # Class 16
        [192, 0, 64],    # Class 17
        [64, 128, 192],  # Class 18
        [128, 192, 64],  # Class 19
        [64, 192, 192]   # Class 20
    ]
    
    # Convert the list into a NumPy array and return it
    return np.array(color_codes)

def encode_label(label):
    """
    Purpose: Encodes pixel values in a label image to corresponding class numbers. Assumes the input label image is in 3D format.

    Parameters:
    - label: A 3D NumPy array representing the label image with shape (height, width, channels).

    Return Value: A 2D NumPy array of shape (height, width) where each element represents the class ID.
    """
    # Initialize an empty array to store the encoded labels
    encoded_labels = np.zeros((label.shape[0], label.shape[1]), dtype=int)
    
    # Iterate over each pixel in the label image
    for i in range(label.shape[0]):
        for j in range(label.shape[1]):
            # Find the index of the color code that matches the current pixel value
            color_code = tuple(label[i, j])
            class_id = np.where(np.all(cls_to_clr_map == color_code, axis=1))[0]
            
            # Assign the class ID to the corresponding position in the encoded labels array
            if len(class_id) > 0:
                encoded_labels[i, j] = class_id[0]
    
    return encoded_labels

def process_dataset(image_dir, label_dir, output_train_file, output_val_file, train_ratio=0.8):
    """
    Purpose: Processes a dataset for semantic segmentation tasks by reading image files and corresponding label images,
             encoding the labels into numerical class IDs, and generating text files listing paths to these processed images and labels for training and validation sets.

    Parameters:
    - image_dir: The directory containing the image files.
    - label_dir: The directory containing the label images.
    - output_train_file: The path to the output file for the training set.
    - output_val_file: The path to the output file for the validation set.
    - train_ratio: The ratio of images to include in the training set (default is 0.8).

    Return Value: None
    """
    # Get a list of image filenames
    image_files = sorted([f for f in os.listdir(image_dir) if f.endswith('.png')])
    label_files = sorted([f for f in os.listdir(label_dir) if f.endswith('.png')])
    
    # Ensure the number of image and label files match
    assert len(image_files) == len(label_files), "Number of image and label files must match"
    
    # Shuffle the image and label files
    combined = list(zip(image_files, label_files))
    np.random.shuffle(combined)
    image_files, label_files = zip(*combined)
    
    # Split the data into training and validation sets
    split_index = int(len(image_files) * train_ratio)
    train_image_files = image_files[:split_index]
    val_image_files = image_files[split_index:]
    train_label_files = label_files[:split_index]
    val_label_files = label_files[split_index:]
    
    # Process and save the training set
    with open(output_train_file, 'w') as f:
        for img_file, lbl_file in zip(train_image_files, train_label_files):
            img_path = os.path.join(image_dir, img_file)
            lbl_path = os.path.join(label_dir, lbl_file)
            encoded_lbl = encode_label(np.array(Image.open(lbl_path)))
            f.write(f"{img_path} {lbl_path}\n")
    
    # Process and save the validation set
    with open(output_val_file, 'w') as f:
        for img_file, lbl_file in zip(val_image_files, val_label_files):
            img_path = os.path.join(image_dir, img_file)
            lbl_path = os.path.join(label_dir, lbl_file)
            encoded_lbl = encode_label(np.array(Image.open(lbl_path)))
            f.write(f"{img_path} {lbl_path}\n")

# Example usage
image_directory = 'path/to/images'
label_directory = 'path/to/labels'
output_train_set = 'train.txt'
output_validation_set = 'val.txt'

process_dataset(image_directory, label_directory, output_train_set, output_validation_set)
```

