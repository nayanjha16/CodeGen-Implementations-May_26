# Program 1: Checking Armstrong Numbers

def is_armstrong_number(n):
    """Check if a number is an Armstrong number."""
    # Calculate the number of digits
    num_digits = len(str(n))
    
    # Extract individual digits
    i = n // 100
    j = (n // 10) % 10
    k = n % 10
    
    # Check if the number is equal to the sum of its digits each raised to the power of the number of digits
    return n == i**num_digits + j**num_digits + k**num_digits

def check_armstrong_numbers(start, end):
    """Check for Armstrong numbers within a given range."""
    for n in range(start, end + 1):
        if is_armstrong_number(n):
            print(n)

# Example usage
check_armstrong_numbers(400, 500)
```

