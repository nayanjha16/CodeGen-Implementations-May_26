import logging
import math
import json
from datetime import datetime, timedelta
import time
from emission.core.wrapper.user import User
from emission.clients.leaderboard import Leaderboard
from emission.clients.gamified import Gamified
from emission.analysis.result.carbon import calculate_carbon_emissions
from emission.storage.decorations import get_uuid_from_request
from emission.storage.timeseries import TimeSeries

class UserManager:
    def __init__(self):
        self.users = {}

    def add_user(self, uuid, user_data):
        if uuid not in self.users:
            self.users[uuid] = User()
            self.users[uuid].setClientSpecificProfileFields(user_data)
        else:
            logging.warning(f"User with UUID {uuid} already exists.")

    def get_user_profile(self, uuid):
        return self.users.get(uuid, None).getProfile()

class BackgroundTaskManager:
    def __init__(self):
        self.background_tasks = []

    def register_task(self, task_function):
        self.background_tasks.append(task_function)

    def run_all_tasks(self):
        for task in self.background_tasks:
            task()

class LeaderboardManager(Leaderboard):
    def run_background_tasks_for_day(self, uuid, today):
        super().runBackgroundTasksForDay(uuid, today)
        # Additional custom logic can be added here

class GamifiedManager(Gamified):
    def run_background_tasks_for_day(self, uuid, today):
        super().runBackgroundTasksForDay(uuid, today)
        # Additional custom logic can be added here

def handle_results(results):
    carbon_emissions = calculate_carbon_emissions(results)
    print(f"Total Carbon Emissions: {carbon_emissions}")

def main():
    user_manager = UserManager()
    background_task_manager = BackgroundTaskManager()

    # Example usage
    user_data = {
        "name": "John Doe",
        "age": 30,
        "email": "john.doe@example.com"
    }
    user_manager.add_user("user1", user_data)
    user_profile = user_manager.get_user_profile("user1")
    print(f"User Profile: {user_profile}")

    leaderboard_manager = LeaderboardManager()
    gamified_manager = GamifiedManager()

    # Register background tasks
    background_task_manager.register_task(lambda: leaderboard_manager.run_background_tasks_for_day("user1", datetime.now()))
    background_task_manager.register_task(lambda: gamified_manager.run_background_tasks_for_day("user1", datetime.now()))

    # Run all registered background tasks
    background_task_manager.run_all_tasks()

if __name__ == "__main__":
    main()
```

