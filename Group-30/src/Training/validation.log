```python
class Fragments:
    def __init__(self, mz, intensities):
        self.mz = mz
        self.intensities = intensities


class SpectrumType:
    def __init__(self, peaks, metadata):
        self.peaks = peaks
        self.metadata = metadata


def add_losses(spectrum, mz_range=None):
    if mz_range is None:
        mz_range = (0, float('inf'))

    precursor_mass = spectrum.metadata.get('precursor_mz')
    if precursor_mass is None:
        raise ValueError("Precursor mass not found in spectrum metadata")

    min_mz, max_mz = mz_range
    loss_mz = []
    loss_intensities = []

    for peak in spectrum.peaks:
        peak_mz = peak['mz']
        if min_mz <= peak_mz < max_mz:
            loss = precursor_mass - peak_mz
            if loss > 0:
                loss_mz.append(loss)
                # Assuming some simple intensity scaling for demonstration
                loss_intensities.append(peak['intensity'] * 0.1)

    fragments = Fragments(mz=loss_mz, intensities=loss_intensities)
    return fragments
```

This code defines two classes, `Fragments` and `SpectrumType`, and a function `add_losses`. The `add_losses` function processes a spectrum to derive potential loss ions based on the precursor mass and specified m/z range, adding them to a new `Fragments` object which is returned.
