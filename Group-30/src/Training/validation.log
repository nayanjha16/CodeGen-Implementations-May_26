#include <iostream>
#include <memory>

namespace Flick {

class Renderer {
public:
    enum class API { None, OpenGL };

    static API GetAPI() {
        // Simulated method to get the current renderer API
        return API::OpenGL;
    }
};

class VertexArray {
public:
    virtual ~VertexArray() = default;

    static VertexArray* Create() {
        auto api = Renderer::GetAPI();
        switch (api) {
            case Renderer::API::None:
                assert(false && "No renderer API set");
                return nullptr;
            case Renderer::API::OpenGL:
                return new OpenGLVertexArray();
            default:
                assert(false && "Unknown renderer API");
                return nullptr;
        }
    }

protected:
    VertexArray() = default;
};

class OpenGLVertexArray : public VertexArray {
public:
    OpenGLVertexArray() {
        // Initialize OpenGL vertex array
        std::cout << "Initializing OpenGL Vertex Array" << std::endl;
    }

    ~OpenGLVertexArray() override {
        // Clean up OpenGL vertex array
        std::cout << "Cleaning up OpenGL Vertex Array" << std::endl;
    }
};

} // namespace Flick

int main() {
    Flick::VertexArray* vertexArray = Flick::VertexArray::Create();
    delete vertexArray;
    return 0;
}
