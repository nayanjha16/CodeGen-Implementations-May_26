```cpp
#include <gtest/gtest.h>
#include "base_test.h" // Assuming BaseTest is defined here

// Define the StackTestArg struct
struct StackTestArg {
    uint8_t initialValue;
    uint8_t expectedValue;
};

// Define the StackTest class
class StackTest : public BaseTest, public ::testing::WithParamInterface<StackTestArg> {
protected:
    RegisterState expected_regs; // Represents the expected state of the CPU registers
    CPU cpu; // The CPU object being tested
    size_t expected_code_length; // The expected length of the instruction being executed

    void SetUp() override {
        BaseTest::SetUp(); // Call base class setup
        cpu.reset(); // Reset the CPU state
        cpu.sp = GetParam().initialValue; // Set the initial stack pointer value
        expected_regs = cpu.getRegisters(); // Capture the current register state as expected
        expected_code_length = 1; // Default expected code length for single-byte instructions
    }
};

// Test case for PHA (Push Accumulator)
TEST_P(StackTest, PHATest) {
    cpu.a = GetParam().expectedValue; // Set the accumulator to the expected value
    cpu.executeInstruction(0x48); // Execute PHA instruction
    EXPECT_EQ(cpu.sp, expected_regs.sp - 1); // Check stack pointer decremented
    EXPECT_EQ(cpu.memory[cpu.sp], cpu.a); // Check accumulator pushed onto stack
}

// Test case for PLA (Pull Accumulator)
TEST_P(StackTest, PLATest) {
    cpu.memory[cpu.sp] = GetParam().expectedValue; // Push expected value onto stack
    cpu.sp++; // Increment stack pointer
    cpu.executeInstruction(0x68); // Execute PLA instruction
    EXPECT_EQ(cpu.sp, expected_regs.sp + 1); // Check stack pointer incremented
    EXPECT_EQ(cpu.a, GetParam().expectedValue); // Check accumulator pulled from stack
}

// Test case for PHP (Push Processor Status)
TEST_P(StackTest, PHPTest) {
    cpu.status = GetParam().expectedValue; // Set the status register to the expected value
    cpu.executeInstruction(0x08); // Execute PHP instruction
    EXPECT_EQ(cpu.sp, expected_regs.sp - 1); // Check stack pointer decremented
    EXPECT_EQ(cpu.memory[cpu.sp], cpu.status); // Check status register pushed onto stack
}

// Test case for PLP (Pull Processor Status)
TEST_P(StackTest, PLPTest) {
    cpu.memory[cpu.sp] = GetParam().expectedValue; // Push expected value onto stack
    cpu.sp++; // Increment stack pointer
    cpu.executeInstruction(0x28); // Execute PLP instruction
    EXPECT_EQ(cpu.sp, expected_regs.sp + 1); // Check stack pointer incremented
    EXPECT_EQ(cpu.status, GetParam().expectedValue); // Check status register pulled from stack
}

// Instantiate the test cases with specific parameters
INSTANTIATE_TEST_SUITE_P(
    StackOperations,
    StackTest,
    ::testing::Values(
        StackTestArg{0xFD, 0x00}, // Example values for PHA and PLA
        StackTestArg{0xF9, 0x00}  // Example values for PHP and PLP
    )
);
```

This code defines a test fixture class `StackTest` using Google Test's `WithParamInterface` to handle different test cases. It includes methods to set up the test environment and test cases for the `PHA`, `PLA`, `PHP`, and `PLP` instructions. The test cases verify that the stack operations behave as specified by the 6502 architecture.
