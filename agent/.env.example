# Copy to agent/.env or reuse repo root .env (settings loads both)

# --- TEND Postgres (Docker) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tend
POSTGRES_PASSWORD=tend
POSTGRES_ADMIN_DB=postgres

# --- TEND MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=tend
MONGO_PASSWORD=tend

# --- CodeGen API (LoRA v3 after publish) ---
CODEGEN_API_URL=https://codegen-api-161349047936.asia-south2.run.app
CODEGEN_TIMEOUT_SEC=120
CODEGEN_MAX_TOKENS=256
CODEGEN_TEMPERATURE=0.2
CODEGEN_MODEL=codegen-text2sql

# --- Orchestrator (Ollama, local) ---
OLLAMA_BASE_URL=http://localhost:11434
AGENT_ORCHESTRATOR_MODEL=gemma3:4b

# --- Agent defaults (standalone demo) ---
# One file controls everything. Default demo = Chinook.
# Switch at runtime: python -m agent.main --db-id northwind "your question"
# Or change AGENT_DEMO_DB_ID below (Postgres/Mongo DB names default to the same value).
AGENT_DB_PROFILE=standalone
AGENT_DEMO_DB_ID=chinook
# AGENT_DEMO_POSTGRES_DATABASE=chinook   # optional — defaults to AGENT_DEMO_DB_ID
# AGENT_DEMO_MONGO_DATABASE=chinook      # optional — defaults to AGENT_DEMO_DB_ID
AGENT_DEMO_POSTGRES_SCHEMA=public
AGENT_DEMO_SQL_DUMP=agent/data/standalone/chinook/test.sql

AGENT_DEFAULT_DATASET=spider
AGENT_MAX_RESULT_ROWS=100
AGENT_MAX_RETRIES=3
AGENT_QUERY_TIMEOUT_MS=10000

# --- Web UI (optional) ---
# AGENT_WEB_HOST=127.0.0.1
# AGENT_WEB_PORT=8080
# AGENT_WEB_RELOAD=true
