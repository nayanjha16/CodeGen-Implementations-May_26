# Optional seed values — copied to .local/settings.json on first run if set.

# PostgreSQL connection (SQLAlchemy URL)
# Run ./tool/scripts/setup_dvd_database.sh to create database "dvd" from tool/test.sql
DATABASE_URL=postgresql+psycopg://tend:tend@localhost:5432/dvd

# FastAPI inference endpoint (OpenAI-compatible)
FASTAPI_BASE_URL=http://localhost:8000/v1
FASTAPI_HEALTH_URL=http://localhost:8000/health
FASTAPI_API_KEY=
FASTAPI_MODEL=codegen-text2sql
FASTAPI_INTENT=text2sql
FASTAPI_TIMEOUT_SEC=60
FASTAPI_MAX_TOKENS=256

# Schema selection
SCHEMA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional override for persisted embedding model cache (default: tool/.local/models)
# SCHEMA_EMBEDDING_CACHE_DIR=tool/.local/models
SCHEMA_TOP_K=8
SCHEMA_MIN_SCORE=0.3

# Execution limits
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SEC=30
SCHEMA_MAX_TABLES=100
