```cpp
#include <ts/ts.h>
#include <string>
#include <queue>
#include <chrono>

class TxnRateLimiter {
public:
    int limit;
    int max_queue;
    int error;
    int retry;
    std::string header;
    int max_age;

private:
    TSCont _queue_cont;
    TSTime _last_processed_time;
    std::queue<TSHttpTxn> _transaction_queue;

    void processQueue();
    static int queueHandler(TSCont contp, TSEvent event, void *edata);

public:
    TxnRateLimiter() : limit(0), max_queue(0), error(0), retry(0), header(""), max_age(0), _queue_cont(nullptr), _last_processed_time(TSInstantGet()) {}

    void initialize(int argc, const char *argv[]);
    void setupTxnCont(TSHttpTxn txn);
};

void TxnRateLimiter::processQueue() {
    auto now = TSInstantGet();
    while (!_transaction_queue.empty() && TSInstantSub(now, _transaction_queue.front()->getStartTime()) > std::chrono::seconds(max_age)) {
        TSHttpTxn txnp = _transaction_queue.front();
        _transaction_queue.pop();
        TSHttpTxnReenable(txnp, TS_EVENT_HTTP_CONTINUE);
    }

    if (!_transaction_queue.empty()) {
        TSContSchedule(_queue_cont, retry, TS_THREAD_POOL_DEFAULT);
    }
}

int TxnRateLimiter::queueHandler(TSCont contp, TSEvent event, void *edata) {
    TxnRateLimiter *limiter = static_cast<TxnRateLimiter *>(TSContDataGet(contp));
    limiter->processQueue();
    return TS_SUCCESS;
}

void TxnRateLimiter::initialize(int argc, const char *argv[]) {
    // Parse command-line arguments to set up the rate limiter
    // For simplicity, assume the arguments are provided as environment variables
    limit = std::stoi(getenv("RATE_LIMIT"));
    max_queue = std::stoi(getenv("MAX_QUEUE"));
    error = std::stoi(getenv("ERROR_CODE"));
    retry = std::stoi(getenv("RETRY_MS")) * 1000; // Convert ms to us
    header = getenv("HEADER_NAME");
    max_age = std::stoi(getenv("MAX_AGE"));

    _queue_cont = TSContCreate(queueHandler, TSMutexCreate());
}

void TxnRateLimiter::setupTxnCont(TSHttpTxn txn) {
    if (_transaction_queue.size() >= max_queue) {
        TSHttpTxnSetErrorPage(txn, error);
        TSHttpTxnReenable(txn, TS_EVENT_HTTP_ERROR);
        return;
    }

    _transaction_queue.push(txn);
    TSContSchedule(_queue_cont, retry, TS_THREAD_POOL_DEFAULT);
}
```

This code defines a `TxnRateLimiter` class that manages transaction rate limiting, including parsing configuration, handling transaction queues, and scheduling periodic processing of the queue. The `processQueue` method ensures that transactions are processed based on the configured maximum age, and the `queueHandler` method is used to schedule periodic execution of the queue processing logic.
