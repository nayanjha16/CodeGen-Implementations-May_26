#ifndef HALODATAORGANIZER_HPP
#define HALODATAORGANIZER_HPP

#include <map>
#include <iostream>

template <typename T>
class HaloDataObject {
public:
    // Constructor
    HaloDataObject() {}

    // Destructor
    ~HaloDataObject() {}

    // Add data to the HaloDataObject
    void add_data(const T& data) {
        data_ = data;
    }

    // Get data from the HaloDataObject
    T get_data() const {
        return data_;
    }

private:
    T data_; // Data to be exchanged
};

template <typename T>
class HaloDataOrganizer {
public:
    // Constructor
    HaloDataOrganizer() {}

    // Destructor
    ~HaloDataOrganizer() {}

    // Add a new neighboring partition
    void add_neighbor(int ngbNum) {
        Halo[ngbNum] = HaloDataObject<T>();
    }

    // Get the HaloDataObject for a specific neighboring partition
    HaloDataObject<T>& get_neighbor(int ngbNum) {
        return Halo[ngbNum];
    }

    // Check if a neighboring partition exists
    bool has_neighbor(int ngbNum) const {
        return Halo.find(ngbNum) != Halo.end();
    }

private:
    std::map<int, HaloDataObject<T>> Halo; // Map of neighboring partitions and their data objects
};

#endif // HALODATAORGANIZER_HPP
```

This code defines the `HaloDataObject` and `HaloDataOrganizer` classes as per the provided documentation. The `HaloDataObject` class manages data for a single neighboring partition, while the `HaloDataOrganizer` class manages multiple such partitions using a `std::map`. The `add_neighbor` method adds a new neighboring partition, and the `get_neighbor` method retrieves the `HaloDataObject` for a specific partition. The `has_neighbor` method checks if a neighboring partition exists in the map.
