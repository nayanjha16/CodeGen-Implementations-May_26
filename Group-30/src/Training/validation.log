from web import handler, GET, redirect
import bson.objectid as ObjectId
from helper import create_render, PRIV_USER, TALKBOT

class Handler(handler):
    @GET('/delete_chat_rule')
    def get(self):
        # Check if the user is logged in with the required privilege
        if not self.user_has_privilege(PRIV_USER) and not self.user_has_privilege(TALKBOT):
            return redirect('/')
        
        # Create a render object
        render = create_render()
        
        # Retrieve the news_id parameter from the request input
        news_id = self.get_argument('news_id', default=None)
        
        if news_id is None:
            return render.text("Error: news_id parameter is missing")
        
        try:
            # Convert news_id to ObjectId
            news_id = ObjectId(news_id)
        except ValueError:
            return render.text("Error: Invalid news_id format")
        
        # Delete the chat rule from the database
        result = self.db.chat_rules.delete_one({'_id': news_id})
        
        if result.deleted_count == 0:
            return render.text("Error: Chat rule not found")
        
        return render.text("Chat rule deleted successfully")

