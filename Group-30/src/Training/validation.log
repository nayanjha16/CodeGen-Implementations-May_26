#include <libgba-sprite-engine/scene.h>
#include "song1.h"
#include "Gameplay.h"

// Constructor that initializes the scene with necessary parameters
song1::song1(const std::shared_ptr<GBAEngine> &engine) : Scene(engine) {}

// Function called when the scene starts
void song1::tick(u16 keys) {
    // Update sprite animations
    animation->update();
    animation2->update();
    animation3->update();
    animation4->update();

    // Handle button presses
    if(keys & KEY_A){
        pressed++;
        if(pressed == 1) {
            engine->subSprites().push_back(animation);
        }
        else if(pressed == 2) {
            engine->subSprites().push_back(animation2);
        }
        else if(pressed == 3) {
            engine->subSprites().push_back(animation3);
        }
        else if(pressed == 4) {
            engine->subSprites().push_back(animation4);
        }
        else if(pressed > 50) {
            engine->subSprites().clear();
            pressed = 0;
            score1++;
