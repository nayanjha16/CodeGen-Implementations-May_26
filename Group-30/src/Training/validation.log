```python
import torch
import torch.nn as nn

class MaxFeature(nn.Module):
    def __init__(self, in_channels, out_channels, filter_type):
        super(MaxFeature, self).__init__()
        self.filter_type = filter_type
        if filter_type == 'conv2d':
            self.weight = nn.Parameter(torch.randn(out_channels, in_channels, kernel_size=3, padding=1))
        elif filter_type == 'linear':
            self.weight = nn.Parameter(torch.randn(out_channels, in_channels))

    def forward(self, x):
        if self.filter_type == 'conv2d':
            return F.conv2d(x, self.weight)
        elif self.filter_type == 'linear':
            return F.linear(x, self.weight)

class LightCNN(nn.Module):
    def __init__(self, config):
        super(LightCNN, self).__init__()
        self.config = config
        self.layers = []
        for layer_config in config['layers']:
            if layer_config['type'] == 'maxfeature':
                self.layers.append(MaxFeature(layer_config['in_channels'], layer_config['out_channels'], layer_config['filter_type']))
            # Add other layers as needed

    def initialize_weights(self):
        for m in self.modules():
            if isinstance(m, nn.Conv2d) or isinstance(m, nn.Linear):
                nn.init.xavier_uniform_(m.weight.data)
                if m.bias is not None:
                    m.bias.data.zero_()

    def forward(self, x):
        for layer in self.layers:
            x = layer(x)
        return x
```

This code defines the `MaxFeature` and `LightCNN` classes based on the provided documentation. The `MaxFeature` class supports both `conv2d` and `linear` filter types, while the `LightCNN` class uses a configuration dictionary to build its layers and initializes weights using Xavier uniform initialization.
