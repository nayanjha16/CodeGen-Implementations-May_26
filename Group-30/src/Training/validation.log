import urllib.request
from typing import Dict, Any

class DBClient:
    def __init__(self, host: str, port: int):
        self.host = host
        self.port = port

    def set_key(self, bucket: int, key: str, value: Any) -> None:
        """Sets a key-value pair in the specified bucket."""
        check_bucket(bucket)
        url = f"http://{self.host}:{self.port}/{bucket}/{key}"
        urllib.request.urlopen(f"{url}?value={value}", data=None)

    def get_key(self, bucket: int, key: str) -> Any:
        """Retrieves the value associated with a key from the specified bucket."""
        check_bucket(bucket)
        url = f"http://{self.host}:{self.port}/{bucket}/{key}"
        response = urllib.request.urlopen(url)
        return response.read().decode()

    def manage_buckets(self, action: str, bucket: int) -> None:
        """Manages buckets by creating or deleting them."""
        check_bucket(bucket)
        url = f"http://{self.host}:{self.port}/buckets/{action}/{bucket}"
        urllib.request.urlopen(url, data=None)

    def retrieve_statistics(self) -> Dict[str, Any]:
        """Retrieves statistics from the Memcached server."""
        url = f"http://{self.host}:{self.port}/stats"
        response = urllib.request.urlopen(url)
        stats = {}
        for line in response.read().decode().split('\n'):
            if line:
                key, value = line.split(': ', 1)
                stats[key] = value
        return stats

    def perform_garbage_collection(self) -> None:
        """Performs garbage collection on the Memcached server."""
        url = f"http://{self.host}:{self.port}/gc"
        urllib.request.urlopen(url, data=None)

def get_url_content(url: str) -> str:
    """Fetches the content of a given URL using urllib.urlopen."""
    response = urllib.request.urlopen(url)
    return response.read().decode()

def check_bucket(bucket: int) -> None:
    """Asserts that the provided bucket number is within the valid range (0-15)."""
    assert 0 <= bucket <= 15, "Bucket number must be between 0 and 15"

def dir_to_dict(dir_str: str) -> Dict[str, Any]:
    """Converts a directory string into a dictionary where keys are filenames and values are file contents."""
    # This function is not fully implemented as it requires specific details about the directory structure
    pass

# Test function to demonstrate usage
def test_db_client():
    db_client = DBClient("localhost", 11211)
    db_client.set_key(0, "test_key", "test_value")
    print(db_client.get_key(0, "test_key"))
    db_client.manage_buckets("create", 1)
    print(db_client.retrieve_statistics())
    db_client.perform_garbage_collection()

if __name__ == "__main__":
    test_db_client()
